/* ===== 全局主题 ===== */
page { 
  background: #0d1117; 
  min-height: 100vh; 
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; 
  color: #e6edf3; 
}
.page {
  min-height: 100vh;
  padding-bottom: calc(200rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(200rpx + env(safe-area-inset-bottom));
  background: #0d1117;
  /* 轻量入场：仅 opacity，不占额外内存 */
  animation: pageFadeIn 0.28s ease-out both;
}

@keyframes pageFadeIn { 
  from { opacity: 0; } 
  to { opacity: 1; } 
}

/* 底部安全区域适配 */
.safe-area-bottom {
  padding-bottom: constant(safe-area-inset-bottom) !important;
  padding-bottom: env(safe-area-inset-bottom) !important;
}
.safe-area-bottom-margin {
  margin-bottom: constant(safe-area-inset-bottom) !important;
  margin-bottom: env(safe-area-inset-bottom) !important;
}
.container { padding: 24rpx; }

/* 全局按钮 */
button {
  transition: opacity 0.15s;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  /* 微信 button 默认 line-height / 上下 padding 会把文字顶偏，统一压平 */
  line-height: 1;
  padding-top: 0;
  padding-bottom: 0;
}
button text {
  line-height: 1.2;
  display: block;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
button:active { opacity: 0.8; }
button::after { border: none !important; }

/* 卡片 */
.card { background: linear-gradient(145deg, rgba(20,25,60,0.9), rgba(15,18,45,0.95)); border: 1rpx solid rgba(0,212,255,0.15); border-radius: 16rpx; padding: 28rpx; margin-bottom: 20rpx; box-shadow: 0 4px 24px rgba(0,212,255,0.08), inset 0 1px 0 rgba(255,255,255,0.05); transition: transform 0.2s cubic-bezier(0.25, 0.8, 0.25, 1), box-shadow 0.2s; }
.card:active { transform: scale(0.98); box-shadow: 0 2px 12px rgba(0,212,255,0.04), inset 0 1px 0 rgba(255,255,255,0.02); }

/* 标题 */
.stitle { font-size: 30rpx; font-weight: 700; color: #00d4ff; margin-bottom: 20rpx; text-transform: uppercase; letter-spacing: 2rpx; }

/* 快捷入口 */
.actions { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16rpx; }
.act { display: flex; flex-direction: column; align-items: center; font-size: 22rpx; color: rgba(255,255,255,0.8); }
.act-icon { width: 96rpx; height: 96rpx; background: rgba(0,212,255,0.1); border: 1rpx solid rgba(0,212,255,0.2); border-radius: 20rpx; display: flex; align-items: center; justify-content: center; font-size: 44rpx; margin-bottom: 12rpx; box-shadow: 0 0 12px rgba(0,212,255,0.15); }
.act:active .act-icon { background: rgba(0,212,255,0.2); box-shadow: 0 0 20px rgba(0,212,255,0.3); }

/* 统计行 */
.stats-row { display: flex; gap: 16rpx; margin-bottom: 20rpx; }
.stat-box { flex: 1; text-align: center; background: rgba(0,0,0,0.3); border: 1rpx solid rgba(0,212,255,0.1); border-radius: 12rpx; padding: 20rpx 8rpx; }
.sval { font-size: 36rpx; font-weight: 700; color: #00d4ff; display: block; text-shadow: 0 0 8px rgba(0,212,255,0.5); }
.sval.purple { color: #9945ff; text-shadow: 0 0 8px rgba(153,69,255,0.5); }
.sval.orange { color: #ffab40; text-shadow: 0 0 8px rgba(255,171,64,0.5); }
.sval.dark { color: rgba(255,255,255,0.5); text-shadow: none; }
.slb { font-size: 20rpx; color: rgba(255,255,255,0.55); margin-top: 8rpx; display: block; }

/* 公告栏 - 简洁美观版 */
.announcement-card { border: 1rpx solid rgba(0,200,255,0.12); overflow: hidden; }
.announce-count { font-size: 20rpx; color: rgba(0,200,255,0.5); background: rgba(0,200,255,0.08); padding: 4rpx 12rpx; border-radius: 20rpx; }
.announce-list { display: flex; flex-direction: column; gap: 10rpx; margin-top: 8rpx; }
.announce-item { 
  border-radius: 12rpx; overflow: hidden;
  background: rgba(255,255,255,0.025);
  padding: 0 18rpx;
}
.announce-item + .announce-item { border-top: none; }
.announce-item.expanded { background: rgba(0,200,255,0.04); }
.announce-header { display: flex; align-items: center; padding: 18rpx 0; gap: 10rpx; }
.announce-header:active { opacity: 0.55; }
.announce-tag { 
  padding: 2rpx 8rpx; border-radius: 4rpx; font-size: 18rpx; font-weight: 600; flex-shrink: 0;
  background: none; color: rgba(255,255,255,0.4); border: 1rpx solid rgba(255,255,255,0.08);
}
.announce-tag.pinned { color: #ff6b7a; border-color: rgba(255,71,87,0.2); }
.announce-tag.notice { color: #00c8ff; border-color: rgba(0,200,255,0.15); }
.announce-tag.update { color: #00e676; border-color: rgba(0,230,118,0.15); }
.announce-tag.event { color: #b47aff; border-color: rgba(153,69,255,0.15); }
.announce-tag.tip { color: #ffab40; border-color: rgba(255,171,64,0.15); }
.announce-title { 
  font-size: 26rpx; color: rgba(255,255,255,0.78); font-weight: 500;
  flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.announce-item.expanded .announce-title { color: #e8edf3; }
.announce-time { font-size: 20rpx; color: rgba(255,255,255,0.18); flex-shrink: 0; }
.announce-item.expanded .announce-time { color: rgba(255,255,255,0.3); }
.announce-arrow { font-size: 20rpx; color: rgba(255,255,255,0.15); transition: transform 0.2s ease; flex-shrink: 0; width: 24rpx; text-align: center; }
.announce-arrow.up { transform: rotate(90deg); color: rgba(255,255,255,0.4); }
.announce-body { padding: 0 0 16rpx; overflow: hidden; }
.announce-content { 
  background: rgba(0,0,0,0.25); border-radius: 10rpx; padding: 18rpx; 
  box-sizing: border-box; width: 100%; max-height: 480rpx; overflow-y: auto;
}
.announce-source { margin-top: 10rpx; padding: 8rpx 12rpx; background: rgba(255,171,64,0.04); border-radius: 6rpx; font-size: 20rpx; color: rgba(255,171,64,0.45); }
.announce-cover { width: 100%; border-radius: 10rpx; margin-top: 12rpx; display: block; }
@keyframes announceFadeIn { from { opacity: 0; } to { opacity: 1; } }
.news-detail-rich img { max-width: 100%; border-radius: 12rpx; margin: 12rpx 0; }
.news-detail-rich a { color: #00d4ff; text-decoration: underline; }
.news-detail-rich blockquote { border-left: 4rpx solid rgba(0,212,255,0.3); padding-left: 12rpx; margin: 12rpx 0; color: rgba(255,255,255,0.6); }
.news-detail-rich hr { border: none; border-top: 1rpx dashed rgba(255,255,255,0.15); margin: 20rpx 0; }
.news-detail-rich table { width: 100%; border-collapse: collapse; margin: 12rpx 0; font-size: 24rpx; }
.news-detail-rich th { padding: 10rpx 8rpx; background: rgba(0,200,255,0.1); border: 1rpx solid rgba(0,200,255,0.2); font-weight: 700; color: #00d4ff; }
.news-detail-rich td { padding: 8rpx; border: 1rpx solid rgba(255,255,255,0.06); }

/* 底部 */
.foot { text-align: center; font-size: 20rpx; color: rgba(0,212,255,0.5); padding: 24rpx 0; }

/* 导航栏 (备用) */
.navbar { 
  position: fixed; 
  bottom: 0; 
  left: 0; 
  right: 0; 
  height: calc(100rpx + env(safe-area-inset-bottom));
  padding-bottom: env(safe-area-inset-bottom);
  background: linear-gradient(180deg, rgba(10,14,39,0.9), rgba(10,14,39,1)); 
  display: flex; 
  box-shadow: 0 -2px 16px rgba(0,212,255,0.1); 
  z-index: 999; 
  border-top: 1rpx solid rgba(0,212,255,0.15); 
  box-sizing: border-box;
}
.nav-item { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; position: relative; }
.nav-item.on::before { content: ''; position: absolute; top: 4rpx; width: 32rpx; height: 4rpx; background: linear-gradient(90deg, #00d4ff, #9945ff); border-radius: 2rpx; box-shadow: 0 0 8px rgba(0,212,255,0.6); }
.nav-icon { font-size: 36rpx; margin-bottom: 2rpx; }
.nav-text { font-size: 20rpx; color: rgba(255,255,255,0.55); }
.nav-item.on .nav-text { color: #00d4ff; font-weight: bold; text-shadow: 0 0 8px rgba(0,212,255,0.5); }

/* Banner */
.banner-card { border-radius: 20rpx; overflow: hidden; margin-bottom: 20rpx; border: 1rpx solid rgba(153,69,255,0.2); width: 100%; position: relative; }
.banner-image { width: 100%; display: block; }
.banner-edit { position: absolute; top: 16rpx; right: 16rpx; display: flex; align-items: center; gap: 6rpx; padding: 8rpx 16rpx; background: rgba(0,0,0,0.6); border-radius: 16rpx; z-index: 3; }
.banner-edit-icon { font-size: 24rpx; }
.banner-edit-text { font-size: 20rpx; color: rgba(255,255,255,0.8); }

/* 公告栏 - 空状态 */
.empty-notice { display: flex; align-items: center; justify-content: space-between; padding: 20rpx; background: rgba(255,171,64,0.05); border-radius: 12rpx; }
.empty-notice-text { font-size: 24rpx; color: rgba(255,255,255,0.55); }
.empty-notice-btn { padding: 10rpx 24rpx; background: linear-gradient(135deg, #ffab40, #ff9100); border-radius: 8rpx; font-size: 22rpx; color: #fff; }
.banner-bg { background: linear-gradient(135deg, #1a1040, #2d1b69, #0a0e27); border-radius: 20rpx; padding: 32rpx 28rpx 24rpx; min-height: 340rpx; position: relative; overflow: hidden; }
.banner-deco-1 { position: absolute; top: -40rpx; right: -20rpx; width: 200rpx; height: 200rpx; background: radial-gradient(circle, rgba(0,212,255,0.15), transparent 70%); border-radius: 50%; }
.banner-deco-2 { position: absolute; bottom: 16rpx; left: -24rpx; width: 140rpx; height: 140rpx; background: radial-gradient(circle, rgba(153,69,255,0.12), transparent 70%); border-radius: 50%; }
.banner-deco-3 { position: absolute; top: 50rpx; right: 32rpx; width: 80rpx; height: 80rpx; background: radial-gradient(circle, rgba(224,64,251,0.1), transparent 70%); border-radius: 50%; }
.banner-content { position: relative; z-index: 2; }
.banner-sub { font-size: 22rpx; color: rgba(0,212,255,0.8); display: block; margin-bottom: 12rpx; letter-spacing: 2rpx; }
.banner-title { font-size: 52rpx; font-weight: 900; color: #fff; display: block; line-height: 1.1; text-shadow: 0 0 20px rgba(0,212,255,0.3); }
.banner-title-2 { font-size: 52rpx; font-weight: 900; color: #00d4ff; display: block; line-height: 1.1; margin-bottom: 16rpx; text-shadow: 0 0 20px rgba(0,212,255,0.5); }
.banner-desc { font-size: 22rpx; color: rgba(255,255,255,0.6); display: block; margin-bottom: 20rpx; }
.banner-tags { display: flex; gap: 12rpx; flex-wrap: wrap; }
.banner-tag { display: flex; align-items: center; gap: 6rpx; background: rgba(0,212,255,0.1); border: 1rpx solid rgba(0,212,255,0.2); border-radius: 20rpx; padding: 8rpx 16rpx; }
.tag-icon { font-size: 22rpx; }
.tag-text { font-size: 20rpx; color: rgba(0,212,255,0.9); }
.banner-bottom { position: absolute; bottom: 24rpx; left: 28rpx; right: 28rpx; z-index: 2; display: flex; justify-content: space-between; align-items: center; }
.banner-slogan { font-size: 22rpx; font-weight: 600; color: #00d4ff; }
.banner-slogan-sub { font-size: 18rpx; color: rgba(255,255,255,0.55); }

/* 按钮 */
button { border-radius: 999rpx !important; position: relative; overflow: hidden; }
button::after { border: none; }

/* 流光特效 */
@keyframes btn-shine { 0% { left: -100%; } 50%, 100% { left: 100%; } }

/* 输入框 */
input { color: #fff; }
input::placeholder { color: rgba(255,255,255,0.35); }
.ql-placeholder,
[data-placeholder]::before,
.ql-editor.ql-blank::before { color: rgba(255,255,255,0.6) !important; }

/* 富文本排版块公共样式 */
.rich-text-block { font-size: 28rpx; color: rgba(255,255,255,0.9); line-height: 1.8; display: block; margin: 16rpx 0; word-break: break-all; white-space: pre-wrap; }
.rich-quote-block { border-left: 4rpx solid rgba(0,212,255,0.3); padding: 8rpx 16rpx; color: rgba(255,255,255,0.6); font-size: 26rpx; margin: 16rpx 0; background: rgba(0,0,0,0.15); border-radius: 0 12rpx 12rpx 0; }

/* 音乐块 */
.rich-music-block { box-sizing: border-box; display: flex; align-items: center; background: linear-gradient(135deg, rgba(0,212,255,0.12), rgba(153,69,255,0.08) 55%, rgba(0,212,255,0.05)); border: 1rpx solid rgba(0,212,255,0.28); border-radius: 28rpx; padding: 22rpx 26rpx; margin: 24rpx 0; position: relative; overflow: hidden; box-shadow: 0 12rpx 40rpx rgba(0,0,0,0.28), inset 0 1rpx 0 rgba(255,255,255,0.14); backdrop-filter: blur(20px); transition: all 0.4s cubic-bezier(0.25, 0.8, 0.25, 1); }
.rich-music-block::before { content: ''; position: absolute; top: 0; left: 8%; right: 8%; height: 1rpx; background: linear-gradient(90deg, transparent, rgba(255,255,255,0.4), transparent); }
/* 底部播放进度流光 */
.rich-music-block::after { content: ''; position: absolute; left: 0; bottom: 0; height: 4rpx; width: 100%; background: linear-gradient(90deg, #00d4ff, #9945ff, #00d4ff); background-size: 200% 100%; opacity: 0; transition: opacity 0.35s; pointer-events: none; }
.rich-music-block.playing::after { opacity: 0.9; animation: musicProgressFlow 2.4s linear infinite; }
@keyframes musicProgressFlow { from { background-position: 0% 0; } to { background-position: 200% 0; } }
.rich-music-block:active { transform: scale(0.985); }

.music-cover { width: 104rpx; height: 104rpx; border-radius: 50%; margin-right: 24rpx; flex-shrink: 0; box-shadow: 0 0 0 6rpx rgba(0,212,255,0.08), 0 10rpx 28rpx rgba(0,0,0,0.45); animation: musicCoverRotate 14s linear infinite; animation-play-state: paused; border: 4rpx solid rgba(0,212,255,0.35); object-fit: cover; }
@keyframes musicCoverRotate { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
.rich-music-block.playing .music-cover { animation-play-state: running; border-color: rgba(153,69,255,0.85); box-shadow: 0 0 0 6rpx rgba(153,69,255,0.12), 0 0 32rpx rgba(153,69,255,0.55); }
.music-icon { font-size: 40rpx; margin-right: 24rpx; flex-shrink: 0; width: 96rpx; height: 96rpx; display: flex; align-items: center; justify-content: center; background: linear-gradient(135deg, rgba(0,212,255,0.22), rgba(153,69,255,0.16)); border-radius: 50%; box-shadow: inset 0 2rpx 8rpx rgba(255,255,255,0.28), 0 8rpx 20rpx rgba(0,0,0,0.35); }
.music-info { flex: 1; min-width: 0; display: flex; flex-direction: column; justify-content: center; gap: 8rpx; }
.music-name { font-size: 30rpx; color: #fff; font-weight: 700; display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; line-height: 1.3; text-shadow: 0 2rpx 8rpx rgba(0,0,0,0.5); letter-spacing: 1rpx; }
.music-url { display: none; }
/* 播放均衡器动画 */
.music-eq { display: flex; align-items: flex-end; gap: 5rpx; height: 26rpx; margin-left: 16rpx; flex-shrink: 0; opacity: 0; transition: opacity 0.35s; }
.music-eq view { width: 6rpx; height: 100%; border-radius: 4rpx; background: linear-gradient(180deg, #00d4ff, #9945ff); transform: scaleY(0.4); transform-origin: bottom; }
.rich-music-block.playing .music-eq { opacity: 1; }
.rich-music-block.playing .music-eq view { animation: eqBar 0.9s ease-in-out infinite; }
.rich-music-block.playing .music-eq view:nth-child(2) { animation-delay: 0.22s; }
.rich-music-block.playing .music-eq view:nth-child(3) { animation-delay: 0.44s; }
@keyframes eqBar { 0%, 100% { transform: scaleY(0.4); } 50% { transform: scaleY(1); } }
.music-play-btn { font-size: 28rpx; color: #fff; min-width: 84rpx; height: 84rpx; padding: 0 22rpx; background: linear-gradient(135deg, #00d4ff, #9945ff); border: none; border-radius: 44rpx; font-weight: 700; flex-shrink: 0; margin-left: 18rpx; box-shadow: 0 8rpx 22rpx rgba(0,212,255,0.4), inset 0 2rpx 4rpx rgba(255,255,255,0.35); display: flex; align-items: center; justify-content: center; white-space: nowrap; transition: all 0.3s; }
.rich-music-block.playing .music-play-btn { background: linear-gradient(135deg, #9945ff, #ff4757); box-shadow: 0 8rpx 24rpx rgba(153,69,255,0.45), inset 0 2rpx 4rpx rgba(255,255,255,0.35); animation: playBtnPulse 2s ease-in-out infinite; }
@keyframes playBtnPulse { 0%, 100% { box-shadow: 0 8rpx 24rpx rgba(153,69,255,0.45), inset 0 2rpx 4rpx rgba(255,255,255,0.35); } 50% { box-shadow: 0 8rpx 36rpx rgba(153,69,255,0.7), inset 0 2rpx 4rpx rgba(255,255,255,0.35); } }

/* 视频块 */
.rich-video-block { box-sizing: border-box; display: flex; align-items: center; background: linear-gradient(135deg, rgba(255,71,87,0.12), rgba(255,107,129,0.06) 55%, rgba(255,71,87,0.04)); border: 1rpx solid rgba(255,71,87,0.28); border-radius: 28rpx; padding: 22rpx 26rpx; margin: 24rpx 0; position: relative; overflow: hidden; box-shadow: 0 12rpx 40rpx rgba(0,0,0,0.28), inset 0 1rpx 0 rgba(255,255,255,0.14); backdrop-filter: blur(20px); transition: all 0.4s cubic-bezier(0.25, 0.8, 0.25, 1); }
.rich-video-block:active { transform: scale(0.97); box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.2); }
.rich-video-block::before { content: ''; position: absolute; top: 0; left: -100%; width: 50%; height: 100%; background: linear-gradient(90deg, transparent, rgba(255,255,255,0.12), transparent); transform: skewX(-20deg); animation: blockShine 4s cubic-bezier(0.25, 0.8, 0.25, 1) infinite; animation-delay: 1s; }
.video-thumb { width: 104rpx; height: 76rpx; border-radius: 14rpx; margin-right: 22rpx; flex-shrink: 0; background: rgba(255,255,255,0.06); object-fit: cover; box-shadow: 0 8rpx 20rpx rgba(0,0,0,0.35); border: 1rpx solid rgba(255,255,255,0.1); }
.video-icon { font-size: 40rpx; margin-right: 24rpx; flex-shrink: 0; width: 96rpx; height: 96rpx; display: flex; align-items: center; justify-content: center; background: linear-gradient(135deg, rgba(255,71,87,0.24), rgba(255,107,129,0.16)); border-radius: 24rpx; box-shadow: inset 0 2rpx 8rpx rgba(255,255,255,0.28), 0 8rpx 20rpx rgba(0,0,0,0.35); }
.video-info { flex: 1; min-width: 0; display: flex; flex-direction: column; justify-content: center; gap: 8rpx; }
.video-name { font-size: 30rpx; color: #fff; font-weight: 700; display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; line-height: 1.3; text-shadow: 0 2rpx 8rpx rgba(0,0,0,0.5); letter-spacing: 1rpx; }
.video-platform { font-size: 22rpx; color: rgba(255,255,255,0.65); display: flex; align-items: center; font-weight: 600; letter-spacing: 1rpx; }
.video-platform::before { content: ''; display: inline-block; width: 12rpx; height: 12rpx; border-radius: 50%; background: #ff4757; margin-right: 12rpx; box-shadow: 0 0 12rpx #ff4757; animation: liveDot 1.8s ease-in-out infinite; }
@keyframes liveDot { 0%, 100% { opacity: 1; } 50% { opacity: 0.35; } }
.video-play-btn { font-size: 26rpx; color: #fff; min-width: 84rpx; height: 84rpx; padding: 0 22rpx; background: linear-gradient(135deg, #ff4757, #ff6b81); border: none; border-radius: 44rpx; font-weight: 700; flex-shrink: 0; margin-left: 18rpx; box-shadow: 0 8rpx 22rpx rgba(255,71,87,0.42), inset 0 2rpx 4rpx rgba(255,255,255,0.35); display: flex; align-items: center; justify-content: center; white-space: nowrap; animation: pulseVideoBtn 2.5s infinite cubic-bezier(0.25, 0.8, 0.25, 1); }
@keyframes pulseVideoBtn { 0% { box-shadow: 0 0 0 0 rgba(255,71,87,0.5), inset 0 2rpx 4rpx rgba(255,255,255,0.35); } 70% { box-shadow: 0 0 0 16rpx rgba(255,71,87,0), inset 0 2rpx 4rpx rgba(255,255,255,0.35); } 100% { box-shadow: 0 0 0 0 rgba(255,71,87,0), inset 0 2rpx 4rpx rgba(255,255,255,0.35); } }

/* 联动活动特效 - 美化版 */
.collab-theme {
  background: linear-gradient(135deg, rgba(255,215,0,0.1), rgba(255,105,180,0.1), rgba(153,69,255,0.1));
  border: 1rpx solid rgba(255,215,0,0.4);
  box-shadow: 0 12rpx 40rpx rgba(255,105,180,0.2), inset 0 2rpx 0 rgba(255,255,255,0.2), inset 0 0 40rpx rgba(255,215,0,0.05);
}
.collab-theme::before {
  background: linear-gradient(90deg, transparent, rgba(255,215,0,0.3), transparent);
  animation: collabShine 3s cubic-bezier(0.25, 0.8, 0.25, 1) infinite;
}
@keyframes collabShine { 0% { left: -100%; } 30%, 100% { left: 200%; } }
.collab-theme::after {
  content: '联动专属';
  position: absolute;
  right: -50rpx;
  top: 16rpx;
  background: linear-gradient(90deg, #ffd700, #ff69b4);
  color: #fff;
  font-size: 16rpx;
  font-weight: 900;
  padding: 4rpx 50rpx;
  transform: rotate(45deg);
  box-shadow: 0 4rpx 12rpx rgba(255,105,180,0.4);
  letter-spacing: 2rpx;
  z-index: 2;
}
.collab-theme .music-icon, .collab-theme .video-icon {
  background: linear-gradient(135deg, rgba(255,215,0,0.25), rgba(255,105,180,0.25));
  box-shadow: inset 0 2rpx 8rpx rgba(255,255,255,0.4), 0 8rpx 24rpx rgba(255,105,180,0.3);
}
.collab-icon-box {
  background: transparent !important;
  box-shadow: none !important;
  padding: 0 !important;
}
.collab-logo-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
  box-shadow: 0 8rpx 24rpx rgba(255,105,180,0.4);
}
.collab-logo-image.circle {
  border-radius: 50%;
}
.collab-logo-image.rounded {
  border-radius: 24rpx;
}
.collab-theme .music-name, .collab-theme .video-name {
  background: linear-gradient(90deg, #fff, #ffd700);
  -webkit-background-clip: text;
  color: transparent;
  text-shadow: none;
}
.collab-theme .video-platform::before {
  background: #ffd700;
  box-shadow: 0 0 12rpx #ffd700;
}
.collab-theme .music-play-btn, .collab-theme .video-play-btn {
  background: linear-gradient(135deg, #ffd700, #ff69b4);
  box-shadow: 0 6rpx 24rpx rgba(255,105,180,0.4), inset 0 2rpx 6rpx rgba(255,255,255,0.5);
  color: #fff;
  text-shadow: 0 2rpx 4rpx rgba(0,0,0,0.2);
  animation: pulseCollabBtn 2.5s infinite cubic-bezier(0.25, 0.8, 0.25, 1);
}
@keyframes pulseCollabBtn { 0% { box-shadow: 0 0 0 0 rgba(255,105,180,0.5), inset 0 2rpx 6rpx rgba(255,255,255,0.5); } 70% { box-shadow: 0 0 0 16rpx rgba(255,105,180,0), inset 0 2rpx 6rpx rgba(255,255,255,0.5); } 100% { box-shadow: 0 0 0 0 rgba(255,105,180,0), inset 0 2rpx 6rpx rgba(255,255,255,0.5); } }
.rich-music-block.collab-theme.playing .music-cover {
  border-color: #ffd700;
  box-shadow: 0 0 40rpx rgba(255,105,180,0.6);
}
.rich-music-block.collab-theme.playing {
  background: linear-gradient(135deg, rgba(255,215,0,0.15), rgba(255,105,180,0.2));
  border-color: rgba(255,215,0,0.8);
  box-shadow: 0 12rpx 48rpx rgba(255,105,180,0.3), inset 0 0 40rpx rgba(255,215,0,0.1);
}

/* 编辑器后台音乐块特殊标记 */
.music-block-item { border: 1rpx dashed rgba(0,212,255,0.4) !important; background: rgba(0,212,255,0.05) !important; }
.block-music-icon { font-size: 32rpx; margin-right: 12rpx; color: #00d4ff; }
.music-text-info { color: #00d4ff !important; font-weight: bold; }

/* 富文本排版块 iframe 网页插件样式 */
.rich-iframe-block { display: flex; align-items: center; background: linear-gradient(135deg, rgba(0,212,255,0.08), rgba(0,230,118,0.05)); border: 1rpx solid rgba(0,212,255,0.2); border-radius: 20rpx; padding: 24rpx; margin: 20rpx 0; box-shadow: 0 4rpx 16rpx rgba(0,212,255,0.06); }
.iframe-icon { font-size: 44rpx; margin-right: 20rpx; flex-shrink: 0; width: 64rpx; height: 64rpx; display: flex; align-items: center; justify-content: center; background: rgba(0,230,118,0.1); border-radius: 50%; }
.iframe-info { flex: 1; min-width: 0; }
.iframe-name { font-size: 28rpx; color: #fff; font-weight: 700; display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; line-height: 1.4; }
.iframe-url { display: none; }
.iframe-actions { display: flex; gap: 10rpx; flex-shrink: 0; margin-left: 16rpx; }
.iframe-btn { font-size: 22rpx; padding: 12rpx 24rpx; border-radius: 24rpx; font-weight: 600; text-align: center; letter-spacing: 1rpx; }
.iframe-btn.open { background: rgba(0,230,118,0.12); border: 1rpx solid rgba(0,230,118,0.3); color: #00e676; }
.iframe-btn.copy { background: rgba(0,212,255,0.12); border: 1rpx solid rgba(0,212,255,0.3); color: #00d4ff; }

/* 后台编辑器 iframe 网页插件预览 */
.iframe-block-item { border: 1rpx dashed rgba(0,230,118,0.4) !important; background: rgba(0,230,118,0.05) !important; }
.block-iframe-icon { font-size: 32rpx; margin-right: 12rpx; color: #00e676; }
.iframe-text-info { color: #00e676 !important; font-weight: bold; }

/* 音乐播放状态与动画 */
.music-icon.rotating {
  animation: musicRotate 4s linear infinite;
}
@keyframes musicRotate {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}
.rich-music-block.playing {
  background: linear-gradient(135deg, rgba(153,69,255,0.25), rgba(0,212,255,0.2));
  border-color: rgba(153,69,255,0.5);
  box-shadow: 0 8rpx 32rpx rgba(153,69,255,0.3);
}
.rich-music-block.playing .music-icon { background: rgba(153,69,255,0.2); }
.rich-music-block.playing .music-play-btn {
  background: linear-gradient(135deg, #9945ff, #ff4757);
  box-shadow: 0 4rpx 12rpx rgba(153,69,255,0.4);
  color: #fff;
}

/* 视频播放器弹窗 */
.video-player-box {
  background: linear-gradient(180deg, #1e2440 0%, #171b30 40%, #14172a 100%);
  /* 勿用 overflow:hidden，会裁掉 video 原生控制条 */
  overflow: visible;
  max-height: 88vh;
  box-sizing: border-box;
  padding-bottom: calc(28rpx + env(safe-area-inset-bottom));
}
.video-player-header {
  padding: 32rpx 28rpx 0;
  margin-bottom: 18rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
  flex-shrink: 0;
}
.video-player-title {
  color: #fff;
  font-size: 30rpx;
  font-weight: 700;
  flex: 1;
  min-width: 0;
  /* 单行，超出横向滚动看完整标题 */
  white-space: nowrap;
  overflow-x: auto;
  overflow-y: hidden;
  -webkit-overflow-scrolling: touch;
}
.video-player-owner { padding: 8rpx 28rpx; display: flex; align-items: center; gap: 10rpx; margin: 0 28rpx 18rpx; flex-shrink: 0; }
.video-player-owner-bar { display: none; }
.video-player-owner-text { font-size: 24rpx; color: rgba(255,255,255,0.5); }
.video-player-video {
  width: calc(100% - 56rpx);
  margin: 0 28rpx 8rpx;
  height: 400rpx;
  display: block;
  border-radius: 16rpx;
  background: #000;
  flex-shrink: 0;
  /* 原生控制条贴在 video 内，overflow 会裁掉进度条 */
  overflow: visible;
  box-shadow: 0 16rpx 48rpx rgba(0,0,0,0.45), 0 0 0 1rpx rgba(255,255,255,0.08);
}
.video-player-desc {
  margin: 12rpx 28rpx 0;
  padding: 20rpx 24rpx;
  /* scroll-view 需要明确高度才能滚 */
  height: 220rpx;
  box-sizing: border-box;
  overflow-y: auto;
  position: relative;
  background: rgba(255,255,255,0.04);
  border: 1rpx solid rgba(255,255,255,0.07);
  border-radius: 16rpx;
}
.video-player-desc::after { content: ''; position: absolute; bottom: 0; left: 0; right: 0; height: 40rpx; background: linear-gradient(transparent, rgba(20,23,42,0.95)); pointer-events: none; border-radius: 0 0 16rpx 16rpx; }
.video-player-desc-text { font-size: 26rpx; color: rgba(255,255,255,0.6); line-height: 1.8; word-break: break-all; white-space: pre-wrap; padding-bottom: 12rpx; }

/* 表格块 */
.rich-table-block { margin: 16rpx 0; overflow-x: auto; }
.rich-table { display: flex; flex-direction: column; border: 1rpx solid rgba(0,200,255,0.15); border-radius: 10rpx; overflow: hidden; }
.rich-table-row { display: flex; }
.rich-table-header { background: rgba(0,200,255,0.1); }
.rich-table-cell { flex: 1; padding: 10rpx 12rpx; font-size: 22rpx; color: rgba(255,255,255,0.8); text-align: center; border-right: 1rpx solid rgba(0,200,255,0.06); border-bottom: 1rpx solid rgba(0,200,255,0.06); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.rich-table-cell:last-child { border-right: none; }
.rich-table-header .rich-table-cell { font-weight: 700; color: #00d4ff; font-size: 24rpx; }
.rich-table-row:last-child .rich-table-cell { border-bottom: none; }

/* 图片块 (无缝) */
.rich-image-block { margin: 0; display: block; font-size: 0; line-height: 0; }
.rich-image { width: 100%; border-radius: 0; display: block; margin: 0; padding: 0; vertical-align: top; }

/* 全局分割线样式 */
.divider-block {
  padding: 30rpx 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  box-sizing: border-box;
}
.divider-line {
  width: 100%;
  height: 0;
  position: relative;
}
.divider-line.solid {
  border-bottom: 2rpx solid rgba(255, 255, 255, 0.15);
}
.divider-line.dashed {
  border-bottom: 2rpx dashed rgba(255, 255, 255, 0.3);
}
.divider-line.dotted {
  border-bottom: 4rpx dotted rgba(255, 255, 255, 0.35);
}
.divider-line.double {
  border-bottom: 6rpx double rgba(255, 255, 255, 0.25);
  height: 2rpx;
}
.divider-line.gradient {
  height: 2rpx;
  background: linear-gradient(to right, transparent, rgba(0, 212, 255, 0.5), transparent);
}
.divider-line.star {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 30rpx;
}
.divider-line.star::before {
  content: "";
  position: absolute;
  left: 0;
  right: 0;
  height: 2rpx;
  background: linear-gradient(to right, transparent, rgba(255,255,255,0.12), transparent);
  z-index: 1;
}
.divider-line.star::after {
  content: "✦ ✦ ✦";
  color: #ffab40;
  font-size: 20rpx;
  background: #0a0e27;
  padding: 0 24rpx;
  z-index: 2;
  text-shadow: 0 0 6px rgba(255,171,64,0.5);
}

/* 链接分块样式 */
.rich-link-block {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 28rpx;
  background: rgba(0, 212, 255, 0.08);
  border: 1rpx solid rgba(0, 212, 255, 0.15);
  border-radius: 16rpx;
  margin: 16rpx 0;
  box-sizing: border-box;
  transition: all 0.2s cubic-bezier(0.25, 0.8, 0.25, 1);
}
.rich-link-block:active {
  background: rgba(0, 212, 255, 0.15);
  transform: scale(0.99);
}
.rich-link-block.video-link {
  background: rgba(153, 69, 255, 0.08);
  border-color: rgba(153, 69, 255, 0.18);
}
.rich-link-block.video-link:active {
  background: rgba(153, 69, 255, 0.15);
}
.link-icon {
  font-size: 32rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}
.link-text {
  flex: 1;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.95);
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.rich-link-block.video-link .link-text {
  color: #c084fc;
}
.link-badge {
  font-size: 22rpx;
  color: #00d4ff;
  background: rgba(0, 212, 255, 0.15);
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
  margin-left: 16rpx;
  font-weight: bold;
}
.rich-link-block.video-link .link-badge {
  color: #d8b4fe;
  background: rgba(168, 85, 247, 0.2);
}

/* 后台预览区链接卡片样式 */
.link-block-preview {
  display: flex;
  align-items: center;
  padding: 12rpx 16rpx;
  background: rgba(255, 255, 255, 0.05);
  border-radius: 10rpx;
  border-left: 6rpx solid #00d4ff;
  box-sizing: border-box;
}
.link-block-preview.video-style {
  border-left-color: #a855f7;
}
.link-preview-icon {
  font-size: 26rpx;
  margin-right: 12rpx;
}
.link-preview-text {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.7);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 附件分块前后台样式 */
.rich-link-block.attachment-link {
  background: rgba(255, 171, 64, 0.08);
  border-color: rgba(255, 171, 64, 0.18);
}
.rich-link-block.attachment-link:active {
  background: rgba(255, 171, 64, 0.15);
}
.rich-link-block.attachment-link .link-text {
  color: #ffab40;
}
.rich-link-block.attachment-link .link-badge {
  color: #ffab40;
  background: rgba(255, 171, 64, 0.2);
}
.attachment-block-preview {
  display: flex;
  align-items: center;
  padding: 12rpx 16rpx;
  background: rgba(255, 255, 255, 0.05);
  border-radius: 10rpx;
  border-left: 6rpx solid #ffab40;
  box-sizing: border-box;
}

/* 轮播图块：完整比例、无裁切 */
.rich-swiper-block { margin: 16rpx 0; border: none; border-radius: 0; overflow: visible; background: transparent; box-shadow: none; }
.rich-swiper { width: 100%; background: transparent; }
.rich-swiper-image { width: 100%; height: auto; display: block; background: transparent; }

/* ===== 平板适配：由根节点 class 驱动（layout-pad / layout-wide），支持「我的」页切换 ===== */

/* ── 平板基础尺寸帽 ── */
.layout-pad {
  font-size: 15px;
}

.layout-pad .container,
.layout-pad.page > .container,
.page.layout-pad > .container {
  max-width: 768px;
  margin: 0 auto;
  padding: 20px;
  box-sizing: border-box;
}

/* 排版：正文 15 / 次要 13 / 小字 11–12 / 标题 17 / 大标题 22 */
.layout-pad .stitle { font-size: 17px !important; margin-bottom: 12px !important; letter-spacing: 0.5px; }
.layout-pad .foot { font-size: 12px !important; padding: 20px 0 !important; }
.layout-pad .sval { font-size: 22px !important; }
.layout-pad .slb { font-size: 13px !important; }
.layout-pad .announce-title { font-size: 15px !important; }
.layout-pad .rich-text-block { font-size: 15px !important; }
.layout-pad .item-name,
.layout-pad .card-title,
.layout-pad .card-author { font-size: 15px !important; }
.layout-pad .card-meta,
.layout-pad .card-desc,
.layout-pad .card-time { font-size: 13px !important; }

/* 卡片 */
.layout-pad .card {
  padding: 16px !important;
  margin-bottom: 12px !important;
  border-radius: 12px !important;
  box-sizing: border-box;
}

/* 按钮：高 40–44px（class 级覆盖，压过页内 rpx） */
.layout-pad button,
.layout-pad .modal-submit,
.layout-pad .modal-btn,
.layout-pad .privacy-btn-cancel,
.layout-pad .privacy-btn-confirm,
.layout-pad .submit-btn {
  min-height: 40px !important;
  height: 40px !important;
  font-size: 14px !important;
  padding: 0 18px !important;
  box-sizing: border-box;
  line-height: 1 !important;
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
}
.layout-pad button text {
  line-height: 1.2;
  display: block;
}

/* Banner */
.layout-pad .banner-bg { min-height: 200px !important; padding: 20px !important; box-sizing: border-box; }
.layout-pad .banner-title { font-size: 22px !important; }
.layout-pad .banner-title-2 { font-size: 22px !important; margin-bottom: 10px !important; }
.layout-pad .banner-desc { font-size: 14px !important; }
.layout-pad .banner-sub { font-size: 13px !important; }
.layout-pad .tag-text { font-size: 12px !important; }

/* 活动/统计图标 */
.layout-pad .act-icon { width: 44px !important; height: 44px !important; font-size: 22px !important; border-radius: 12px !important; }
.layout-pad .act { font-size: 13px !important; }

/* 弹窗：居中卡片，不全屏拉满 */
.layout-pad .modal-mask {
  align-items: center !important;
  justify-content: center !important;
}
.layout-pad .modal-box {
  max-width: 100% !important;
  width: 100% !important;
  margin: 0 auto !important;
  border-radius: 12px !important;
  box-sizing: border-box;
}
.layout-pad .form-editor {
  height: 220px !important;
  min-height: 200px !important;
  max-height: 320px !important;
}
.layout-pad .title-input {
  height: 40px !important;
  min-height: 40px !important;
  font-size: 14px !important;
}

/* 快捷入口：竖屏 3 列 */
.layout-pad .quick-nav { display: grid !important; grid-template-columns: repeat(3, 1fr) !important; }
.layout-pad .nav-item { padding: 16px 8px; border-right: 1px solid #21262d; border-bottom: 1px solid #21262d; }
.layout-pad .nav-item:nth-child(3n) { border-right: none; }
.layout-pad .nav-item:nth-child(4n) { border-right: 1px solid #21262d; }
.layout-pad .nav-item:nth-child(n+4) { border-bottom: none; }
.layout-pad .nav-item:nth-child(n+5) { border-bottom: 1px solid #21262d; }
.layout-pad .nav-emoji { font-size: 28px; }
.layout-pad .nav-label { font-size: 13px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 100%; }

/* 商品网格：竖屏 2 列 */
.layout-pad .item-list { grid-template-columns: repeat(2, 1fr) !important; }
.layout-pad .selling-items { grid-template-columns: repeat(2, 1fr) !important; }

/* 登录/通知卡片限宽 */
.layout-pad .login-card,
.layout-pad .user-card,
.layout-pad .notify-section,
.layout-pad .display-section,
.layout-pad .notice-box {
  max-width: 100%;
  margin-left: auto;
  margin-right: auto;
  box-sizing: border-box;
}

/* ── 平板横屏：限宽放宽到 1080px ── */
.layout-wide .container,
.layout-wide.page > .container,
.page.layout-wide > .container {
  max-width: 1080px;
  margin: 0 auto;
  padding: 24px;
}

.layout-wide .card { padding: 20px !important; margin-bottom: 16px !important; }

.layout-wide .modal-box { max-width: 720px !important; width: 100% !important; }

.layout-wide .quick-nav { grid-template-columns: repeat(4, 1fr) !important; }
.layout-wide .nav-item:nth-child(3n) { border-right: 1px solid #21262d; }
.layout-wide .nav-item:nth-child(4n) { border-right: none; }
.layout-wide .nav-item:nth-child(n+5) { border-bottom: none; }

.layout-wide .item-list { grid-template-columns: repeat(3, 1fr) !important; }
.layout-wide .selling-items { grid-template-columns: repeat(3, 1fr) !important; }
.layout-wide .activity-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; }
.layout-wide .stats-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; }

.layout-wide .login-card,
.layout-wide .user-card,
.layout-wide .notify-section,
.layout-wide .display-section,
.layout-wide .notice-box { max-width: 720px; }

.layout-wide.page,
.page.layout-wide { padding-bottom: calc(80px + env(safe-area-inset-bottom)); }

.layout-wide .feed-item-header { padding: 16px 18px; }
.layout-wide .feed-content { padding: 0 18px 14px; }

/* Dock：固定 px 尺寸（apply-shared，可被 layout-pad 覆盖） */
.layout-pad .dock {
  bottom: 16px;
  bottom: calc(16px + env(safe-area-inset-bottom));
}
.layout-pad .dock-inner {
  gap: 12px;
  padding: 10px 18px;
  border-radius: 28px;
}
.layout-pad .dock-item {
  width: 48px;
  height: 48px;
  border-radius: 16px;
}
.layout-pad .dock-icon {
  font-size: 22px;
}


/* ── 兼容：未挂 Behavior 的页面仍按宽度自动适配 ── */
@media (min-width: 768px) {
  .page:not(.layout-phone) {
    font-size: 15px;
  }
}


/* ===== 轻量全局过渡（纯 CSS，不加 JS） ===== */
@keyframes uiFadeUp {
  from { opacity: 0; transform: translateY(8rpx); }
  to { opacity: 1; transform: translateY(0); }
}
@keyframes uiFadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}
@keyframes uiModalUp {
  from { opacity: 0; transform: translateY(24rpx); }
  to { opacity: 1; transform: translateY(0); }
}

/* 列表卡片轻浮入（首次渲染） */
.feed-item,
.act-card,
.broadcast-item,
.swarm-item-card,
.ball-item-card,
.card-item {
  animation: uiFadeUp 0.22s ease-out both;
}

/* 弹窗 */
.modal-mask { animation: uiFadeIn 0.18s ease-out both; }
.modal-box,
.video-player-box {
  animation: uiModalUp 0.24s cubic-bezier(0.16, 1, 0.3, 1) both;
}

/* 按压反馈：只动 transform/opacity，不增加内存 */
.nav-item:active,
.act:active,
.tab:active,
.sub-tab:active,
.sub-tab-p:active,
.method-chip:active,
.feed-item-header:active,
.broadcast-goods:active,
.list-item:active {
  opacity: 0.72;
  transform: scale(0.98);
  transition: opacity 0.12s ease, transform 0.12s ease;
}

/* 链接/按钮过渡 */
.nav-item,
.tab,
.sub-tab-p,
.method-chip,
.feed-item-header,
.broadcast-goods {
  transition: opacity 0.15s ease, transform 0.15s ease, background 0.2s ease, border-color 0.2s ease;
  will-change: auto;
}

/* 系统减弱动态时关闭动画，省资源 */
@media (prefers-reduced-motion: reduce) {
  .page,
  .feed-item,
  .act-card,
  .broadcast-item,
  .swarm-item-card,
  .ball-item-card,
  .card-item,
  .modal-mask,
  .modal-box,
  .video-player-box {
    animation: none !important;
  }
}
