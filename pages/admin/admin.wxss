}

/* 类型选择标签 */
.announce-type-tabs {
  display: flex;
  gap: 10rpx;
  margin-top: 20rpx;
  position: relative;
  z-index: 2;
}
.type-tab {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  padding: 12rpx 8rpx;
  background: rgba(0, 0, 0, 0.2);
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  border-radius: 12rpx;
  transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
}
.type-tab:active {
  transform: scale(0.95);
}
.type-tab.active {
  background: rgba(0, 212, 255, 0.12);
  border-color: rgba(0, 212, 255, 0.35);
  box-shadow: 0 0 12rpx rgba(0, 212, 255, 0.1);
}
.type-icon {
  font-size: 22rpx;
}
.type-text {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.4);
  font-weight: 600;
}
.type-tab.active .type-text {
  color: #00d4ff;
}

/* 弹窗主体 */
.announce-modal-body {
  padding: 20rpx 24rpx;
  flex: 1;
}

/* 表单区块 */
.announce-form-section {
  margin-bottom: 24rpx;
}
.section-label {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 12rpx;
}
.label-icon {
  font-size: 20rpx;
}
.label-text {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.5);
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 1rpx;
}
.char-count {
  font-size: 18rpx;
  color: rgba(255, 255, 255, 0.25);
  margin-left: auto;
}
.label-tag {
  font-size: 16rpx;
  color: rgba(255, 171, 64, 0.6);
  background: rgba(255, 171, 64, 0.1);
  border: 1rpx solid rgba(255, 171, 64, 0.2);
  border-radius: 8rpx;
  padding: 2rpx 8rpx;
  margin-left: auto;
}

/* 标题输入 */
.title-input-wrap {
  background: rgba(0, 0, 0, 0.2);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 14rpx;
  padding: 0 20rpx;
  transition: border-color 0.2s;
}
.title-input-wrap:focus-within {
  border-color: rgba(0, 212, 255, 0.4);
}
.title-input {
  width: 100%;
  height: 80rpx;
  font-size: 30rpx;
  color: #fff;
  font-weight: 600;
}
.title-input::placeholder {
  color: rgba(255, 255, 255, 0.25);
}

/* 来源输入 */
.source-input-wrap {
  background: rgba(0, 0, 0, 0.2);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 12rpx;
  padding: 0 16rpx;
  transition: border-color 0.2s;
}
.source-input-wrap:focus-within {
  border-color: rgba(0, 212, 255, 0.3);
}
.source-input {
  width: 100%;
  height: 68rpx;
  font-size: 24rpx;
  color: #fff;
}
.source-input::placeholder {
  color: rgba(255, 255, 255, 0.25);
}

/* 编辑器底部 */
.editor-footer {
  display: flex;
  justify-content: flex-end;
  margin-top: 6rpx;
}

/* 选项区域 */
.announce-options-section {
  margin-bottom: 24rpx;
}
.option-card {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 20rpx;
  background: rgba(0, 0, 0, 0.15);
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  border-radius: 14rpx;
  transition: all 0.2s;
}
.option-card:active {
  background: rgba(0, 0, 0, 0.25);
  transform: scale(0.98);
}
.option-icon-wrap {
  width: 48rpx;
  height: 48rpx;
  background: rgba(255, 255, 255, 0.06);
