}
.option-icon-wrap.active {
  background: rgba(255, 171, 64, 0.2);
  box-shadow: 0 0 10rpx rgba(255, 171, 64, 0.15);
}
.option-icon {
  font-size: 24rpx;
}
.option-info {
  flex: 1;
}
.option-name {
  font-size: 24rpx;
  font-weight: 700;
  color: rgba(255, 255, 255, 0.9);
  display: block;
}
.option-desc {
  font-size: 18rpx;
  color: rgba(255, 255, 255, 0.3);
  display: block;
  margin-top: 2rpx;
}
.option-toggle {
  width: 52rpx;
  height: 28rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 14rpx;
  padding: 3rpx;
  transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
}
.option-toggle.on {
  background: linear-gradient(135deg, #ffab40 0%, #ff8c00 100%);
