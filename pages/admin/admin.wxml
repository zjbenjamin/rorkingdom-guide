<view class="page {{padLayoutClass}}">
  <view class="container">
    <view class="no-access" wx:if="{{!loading && !isAdmin}}">
      <text class="no-icon">🔒</text>
      <text class="no-title">{{_l.noAccess}}</text>
      <text class="no-desc">{{_l.noAccessDesc}}</text>
    </view>

    <view class="loading" wx:if="{{loading && isAdmin}}">
      <view class="loading-spinner"></view>
      <text class="loading-text">{{_l.loadingText}}</text>
    </view>

    <view wx:if="{{isAdmin}}">
      <!-- 顶部标题栏 (Hero) -->
      <view class="admin-hero">
        <view class="admin-hero-bg"></view>
        <view class="admin-hero-content">
          <view class="admin-hero-left">
            <view class="admin-avatar">
              <text class="admin-avatar-icon">👑</text>
            </view>
            <view class="admin-hero-info">
              <text class="admin-hero-title">{{_l.adminTitle}}</text>
              <text class="admin-hero-sub">Control Panel</text>
            </view>
          </view>
          <view class="admin-hero-right">
            <view class="admin-stat-pill">
              <text class="stat-pill-num">{{announcements.length || 0}}</text>
              <text class="stat-pill-label">{{_l.announcements}}</text>
            </view>
            <view class="admin-stat-pill">
              <text class="stat-pill-num">{{adminActivities.length || 0}}</text>
              <text class="stat-pill-label">{{_l.activityCalendar}}</text>
            </view>
            <view class="refresh-btn" bindtap="refreshData">
              <text class="refresh-icon">🔄</text>
            </view>
          </view>
        </view>
      </view>

      <!-- Tab 栏 + 发布按钮 -->
      <scroll-view scroll-x class="admin-tabs-scroll">
        <view class="admin-tabs">
          <view class="admin-tab {{activeTab === 'announce' ? 'on' : ''}}" bindtap="switchTab" data-tab="announce">{{_l.announceTab}}</view>
          <view class="admin-tab {{activeTab === 'balls' ? 'on' : ''}}" bindtap="switchTab" data-tab="balls">{{_l.items}}</view>
          <view class="admin-tab {{activeTab === 'subscribe' ? 'on' : ''}}" bindtap="switchTab" data-tab="subscribe">{{_l.subscribeAdd}}</view>
          <view class="admin-tab {{activeTab === 'users' ? 'on' : ''}}" bindtap="switchTab" data-tab="users">{{_l.playerUID}}</view>
          <view class="admin-tab {{activeTab === 'pages' ? 'on' : ''}}" bindtap="switchTab" data-tab="pages">{{_l.pageConfig}}</view>
          <view class="admin-tab {{activeTab === 'stats' ? 'on' : ''}}" bindtap="switchTab" data-tab="stats">{{_l.dataStats}}</view>
          <view class="admin-tab {{activeTab === 'swarm' ? 'on' : ''}}" bindtap="switchTab" data-tab="swarm">{{_l.preserve}}</view>
          <view class="admin-tab {{activeTab === 'site' ? 'on' : ''}}" bindtap="switchTab" data-tab="site">{{_l.settings}}</view>
        </view>
      </scroll-view>
      <!-- 发布按钮：仅公告 Tab 显示 -->
      <view class="global-publish-bar" wx:if="{{activeTab === 'announce'}}">
        <view class="global-publish-btn" bindtap="openModal">
          <text>{{_l.addBtnPublish}}</text>
        </view>
      </view>

      <!-- 公告管理 -->
      <view wx:if="{{activeTab === 'announce'}}">
        <view class="section-header">
          <text class="section-title">{{_l.announceList}}</text>
        </view>
        <view class="card-item" wx:for="{{announcements}}" wx:key="_id">
          <view class="card-top">
            <view class="tag tag-{{item.type}}">{{item.type === 'notice' ? _l.announceTab : item.type === 'update' ? _l.update : item.type === 'event' ? _l.activityCalendar : _l.tip}}</view>
            <view class="pin-tag {{item.pinned ? 'on' : ''}}" bindtap="togglePinnedStatus" data-item="{{item}}">{{item.pinned ? _l.pinnedDone : _l.pinned}}</view>
          </view>
          <text class="card-title">{{item.title}}</text>
          <text class="card-desc">{{item.previewText || item.content}}</text>
          <view class="card-bottom">
            <text class="card-time">{{item.timeStr}}</text>
            <view class="card-actions">
              <view class="btn-edit" bindtap="openModal" data-item="{{item}}">{{_l.edit}}</view>
              <view class="btn-delete" bindtap="deleteAnnouncement" data-item="{{item}}">{{_l.delete}}</view>
            </view>
          </view>
        </view>
        <view class="empty" wx:if="{{announcements.length === 0}}"><text class="empty-text">{{_l.noAnnounce}}</text></view>
      </view>


      <!-- 活动管理 -->
      <view wx:if="{{activeTab === 'activity'}}">
        <view class="section-header">
          <text class="section-title">{{_l.activityList}}</text>
          <view class="add-btn" bindtap="openActivityModal"><text>{{_l.addBtnNew}}</text></view>
        </view>
        <view class="card-item" wx:for="{{adminActivities}}" wx:key="_id">
          <view class="card-top">
            <view class="tag tag-event">{{item.type || _l.activityCalendar}}</view>
            <view class="pin-tag {{item.pinned ? 'on' : ''}}" bindtap="toggleActivityPinned" data-item="{{item}}">{{item.pinned ? _l.pinnedDone : _l.pinned}}</view>
          </view>
          <text class="card-title">{{item.title}}</text>
          <text class="card-desc">{{item.previewText || item.content}}</text>
          <view class="card-bottom">
            <text class="card-time">{{item.timeStr}}</text>
            <view class="card-actions">
              <view class="btn-edit" wx:if="{{item.isCloud}}" bindtap="openActivityModal" data-item="{{item}}">{{_l.edit}}</view>
              <view class="btn-delete" bindtap="deleteActivity" data-item="{{item}}">{{_l.delete}}</view>
            </view>
          </view>
        </view>
        <view class="empty" wx:if="{{adminActivities.length === 0}}"><text class="empty-text">{{_l.noActivityAdmin}}</text></view>
      </view>

      <!-- 捕捉预设（异色精灵预设置顶 + 咕噜球管理） -->
      <view wx:if="{{activeTab === 'balls'}}">
        <!-- 异色精灵预设（置顶） -->
        <view class="section-header">
          <text class="section-title">📌 异色精灵预设</text>
          <view class="add-btn" bindtap="openPetModal"><text>{{_l.addBtnNew}}</text></view>
        </view>

        <!-- 赛季分类：点击切换/收起赛季 · 支持暂时隐藏 / 编辑名称 / 新增 / 删除 -->
        <view style="margin: 16rpx 0 24rpx;">
          <view style="display:flex; align-items:center; justify-content:space-between; margin-bottom: 12rpx;">
            <text style="font-size:24rpx; color:#aaa;">赛季分类（点击切换 · 👁 暂时隐藏/显示）</text>
            <view class="add-btn" style="padding: 6rpx 20rpx;" bindtap="openSeasonModal"><text>+ 新增赛季</text></view>
          </view>
          <view style="display:flex; flex-wrap:wrap; gap:12rpx;">
            <view wx:for="{{petSeasons}}" wx:key="index"
              bindtap="onSelectAdminPetSeason" data-season="{{item}}"
              style="display:flex; align-items:center; gap:10rpx; padding:10rpx 20rpx; border-radius:999rpx; opacity:{{hiddenSeasonMap[item] ? '0.55' : '1'}}; background:{{selectedPetSeason === item ? 'rgba(0,212,255,0.25)' : (hiddenSeasonMap[item] ? 'rgba(255,255,255,0.02)' : 'rgba(255,255,255,0.05)')}}; border:1rpx {{hiddenSeasonMap[item] ? 'dashed' : 'solid'}} {{selectedPetSeason === item ? '#00d4ff' : 'rgba(255,255,255,0.16)'}};">
              <text style="font-size:24rpx; font-weight:{{selectedPetSeason === item ? 'bold' : 'normal'}}; color:{{selectedPetSeason === item ? '#00d4ff' : (hiddenSeasonMap[item] ? '#94a3b8' : '#cbd5e1')}}; {{hiddenSeasonMap[item] ? 'text-decoration:line-through;' : ''}}">{{item}} ({{petSeasonCounts[item] || 0}})</text>
              <text wx:if="{{hiddenSeasonMap[item]}}" style="font-size:18rpx; color:#fbbf24; background:rgba(251,191,36,0.15); padding:2rpx 8rpx; border-radius:6rpx;">已隐藏</text>
              <text catchtap="toggleHideSeason" data-item="{{item}}" style="font-size:20rpx; color:{{hiddenSeasonMap[item] ? '#fbbf24' : '#94a3b8'}}; padding:0 4rpx;">{{hiddenSeasonMap[item] ? '显' : '隐'}}</text>
              <text catchtap="openSeasonModal" data-item="{{item}}" style="font-size:20rpx; color:#79c0ff; padding:0 4rpx;">✎</text>
              <text catchtap="deleteSeason" data-item="{{item}}" style="font-size:20rpx; color:#f87171; padding:0 4rpx;">✕</text>
            </view>
          </view>
        </view>
        <view class="card-item" wx:for="{{filteredShinyPets}}" wx:key="id" style="{{item.pinned ? 'border-color: rgba(251, 191, 36, 0.45); background: rgba(251, 191, 36, 0.05);' : ''}}">
          <view class="card-top" style="justify-content: space-between;">
            <view style="display:flex; align-items:center;">
              <image wx:if="{{item.img}}" src="{{item.img}}" style="width:48rpx; height:48rpx; margin-right:12rpx; border-radius:8rpx;" mode="aspectFill" />
              <text wx:else style="margin-right:12rpx; font-size: 32rpx;">✨</text>
              <text style="font-weight:bold;">{{item.name}}</text>
              <view class="tag tag-pinned" wx:if="{{item.pinned}}" style="margin-left:12rpx;">置顶</view>
            </view>
            <view class="tag tag-update">{{item.season}}</view>
          </view>
          <view style="padding: 16rpx 24rpx; background: rgba(0,0,0,0.2); border-radius: 12rpx; margin-bottom: 24rpx;">
            <view style="font-size:22rpx; color:#aaa; word-break:break-all;" wx:if="{{item.img}}">图: {{item.img}}</view>
            <view style="font-size:22rpx; color:#666;" wx:else>未设置图片</view>
          </view>
          <view class="card-actions">
            <view class="btn-pin" bindtap="togglePetPin" data-id="{{item.id}}">{{item.pinned ? '取消置顶' : '置顶'}}</view>
            <view class="btn-edit" bindtap="openPetModal" data-item="{{item}}">{{_l.edit}}</view>
            <view class="btn-delete" bindtap="deletePet" data-id="{{item.id}}">{{_l.delete}}</view>
          </view>
        </view>
        <view class="empty" wx:if="{{!selectedPetSeason}}"><text class="empty-text">请点击上方赛季分类展开对应异色精灵预设</text></view>
        <view class="empty" wx:elif="{{filteredShinyPets.length === 0}}"><text class="empty-text">「{{selectedPetSeason}}」暂无异色精灵，点右上角新增</text></view>
        <view class="modal-submit" bindtap="saveShinyPets" style="margin: 40rpx 0; width: 100%; box-sizing: border-box; justify-content:center; {{shinyPetSubmitting ? 'opacity: 0.5; filter: grayscale(1);' : ''}}">
          <text>{{shinyPetSubmitting ? _l.submitting : _l.saveToCloud}}</text>
        </view>

        <!-- 咕噜球仓库配置 -->
        <view class="section-header" style="margin-top: 48rpx;">
          <text class="section-title">{{_l.ballsConfigTitle}}</text>
          <view class="add-btn" bindtap="openBallModal"><text>{{_l.addBtnNew}}</text></view>
        </view>
        <view class="card-item" wx:for="{{ballsConfig}}" wx:key="id">
          <view class="card-top" style="justify-content: space-between;">
            <view style="display:flex; align-items:center;">
              <image wx:if="{{item.img}}" src="{{item.img}}" style="width:40rpx; height:40rpx; margin-right:12rpx;" mode="aspectFit" />
              <text wx:else style="margin-right:12rpx; font-size: 32rpx;">{{item.icon || '⚪'}}</text>
              <text style="font-weight:bold; color:{{item.color || '#fff'}}">{{item.name}}</text>
            </view>
            <view style="display:flex; gap:10rpx; flex-wrap:wrap;">
              <view class="tag tag-notice" wx:if="{{item.isBuy}}">{{_l.ballBuy}}</view>
              <view class="tag tag-update" wx:if="{{item.isCraft}}">{{_l.ballCraft}}</view>
              <view class="tag tag-notice" wx:if="{{item.isCraft && item.craftCostRoco}}" style="background:rgba(255,171,64,0.18); color:#ffab40;">合成耗洛克贝</view>
              <view class="tag tag-notice" wx:if="{{item.isSpecial}}" style="background:rgba(233,30,99,0.2); color:#f48fb1;">{{_l.ballSpecial}}</view>
              <view class="tag tag-notice" wx:if="{{item.isActivity}}" style="background:rgba(255,193,7,0.15); color:#ffd54f;">{{_l.catchActivityType}}</view>
            </view>
          </view>
          <view style="padding: 24rpx; background: rgba(0,0,0,0.2); border-radius: 12rpx; margin-bottom: 24rpx;">
            <view style="font-size:24rpx; color:#aaa; margin-bottom: 8rpx;" wx:if="{{item.isBuy}}">{{_l.ballPrice}} ({{_l.priceRoco}}): {{item.price}}</view>
            <view style="font-size:24rpx; color:#ffab40; margin-bottom: 8rpx;" wx:if="{{item.isCraft && item.craftCostRoco}}">合成消耗 ({{_l.priceRoco}}): {{item.craftPrice || item.price || 0}}</view>
            <view style="font-size:24rpx; color:#aaa; margin-bottom: 8rpx;" wx:if="{{item.isCraft && !item.craftCostRoco}}">合成消耗: {{_l.catchFreeTag}}（不耗洛克贝）</view>
            <view style="font-size:24rpx; color:#aaa; margin-bottom: 8rpx;" wx:if="{{item.isCraft && item.craftMaterials}}">合成材料: {{item.craftMaterials}}</view>
            <view style="font-size:24rpx; color:#aaa; margin-bottom: 8rpx;" wx:if="{{item.isSpecial}}">{{_l.ballPrice}} ({{_l.priceCNY}}): {{item.cnyPrice || 0}}</view>
            <view style="font-size:24rpx; color:#aaa; margin-bottom: 8rpx;" wx:if="{{item.isActivity && !item.isBuy && !item.isSpecial && !item.isCraft}}">{{_l.ballPrice}}: {{_l.catchFreeTag}}（活动）</view>
            <view style="font-size:24rpx; color:#aaa; margin-bottom: 8rpx;" wx:if="{{!item.isBuy && !item.isSpecial && !item.isActivity && !item.isCraft}}">{{_l.ballPrice}}: {{item.price}} {{_l.currency}}</view>
            <view style="font-size:24rpx; color:#aaa; margin-bottom: 8rpx;">{{_l.ballDesc}}: {{item.desc}}</view>
            <view style="font-size:24rpx; color:#aaa;">{{_l.ballSource}}: {{item.source || _l.unknown}}</view>
          </view>
          <view class="card-actions">
            <view class="btn-edit" bindtap="openBallModal" data-item="{{item}}">{{_l.edit}}</view>
            <view class="btn-delete" bindtap="deleteBall" data-id="{{item.id}}">{{_l.delete}}</view>
          </view>
        </view>
        <view class="modal-submit" bindtap="saveBallsConfig" style="margin: 40rpx 0; width: 100%; box-sizing: border-box; justify-content:center; {{ballsSubmitting ? 'opacity: 0.5; filter: grayscale(1);' : ''}}">
          <text>{{ballsSubmitting ? _l.submitting : _l.saveToCloud}}</text>
        </view>
      </view>

      <!-- 订阅管理 -->
      <view wx:if="{{activeTab === 'subscribe'}}">
        <view class="sub-section">
          <view class="sub-section-title">
            <text class="sub-section-icon">🔔</text>
            <text>{{_l.subscribeSwitch}}</text>
          </view>
          <text class="sub-section-hint">{{_l.subscribeHint}}</text>
          <view class="sub-grid">
            <view class="sub-toggle-card {{subscribeConfig['announcement'] ? 'active' : ''}}" catchtap="toggleSubscribeType" data-type="announcement">
              <text class="sub-toggle-icon">📢</text>
              <text class="sub-toggle-name">公告</text>
              <view class="toggle {{subscribeConfig['announcement'] ? 'on' : ''}}"><view class="toggle-dot"></view></view>
            </view>
            <view class="sub-toggle-card {{subscribeConfig['activity'] ? 'active' : ''}}" catchtap="toggleSubscribeType" data-type="activity">
              <text class="sub-toggle-icon">📅</text>
              <text class="sub-toggle-name">活动</text>
              <view class="toggle {{subscribeConfig['activity'] ? 'on' : ''}}"><view class="toggle-dot"></view></view>
            </view>
            <view class="sub-toggle-card {{subscribeConfig['merchant'] ? 'active' : ''}}" catchtap="toggleSubscribeType" data-type="merchant">
              <text class="sub-toggle-icon">🛒</text>
              <text class="sub-toggle-name">商人</text>
              <view class="toggle {{subscribeConfig['merchant'] ? 'on' : ''}}"><view class="toggle-dot"></view></view>
            </view>
          </view>
        </view>

        <view class="sub-section">
          <view class="sub-section-title">
            <text class="sub-section-icon">🧪</text>
            <text>{{_l.testPush}}</text>
          </view>
          <view class="sub-test-grid">
            <view class="sub-test-btn" catchtap="testPush" data-type="announcement">
              <text class="sub-test-icon">📢</text>
              <text class="sub-test-text">{{_l.testAnnounce}}</text>
            </view>
            <view class="sub-test-btn" catchtap="testPush" data-type="activity">
              <text class="sub-test-icon">📅</text>
              <text class="sub-test-text">{{_l.testActivity}}</text>
            </view>
            <view class="sub-test-btn" catchtap="testPush" data-type="merchant">
              <text class="sub-test-icon">🛒</text>
              <text class="sub-test-text">{{_l.testMerchant}}</text>
            </view>
          </view>
        </view>

        <view class="sub-section">
          <view class="sub-section-title">
            <text class="sub-section-icon">👥</text>
            <text>{{_l.subscribeUsers}}</text>
            <view class="sub-refresh-btn" catchtap="loadSubscribers"><text>{{_l.refresh}}</text></view>
          </view>
          <view class="sub-user-list" wx:if="{{subscribers.length > 0}}">
            <view class="sub-user-item" wx:for="{{subscribers}}" wx:key="_id">
              <view class="sub-user-left">
                <view class="sub-user-type-tag {{item.type}}">{{item.type === 'announcement' ? '公告' : item.type === 'activity' ? '活动' : item.type === 'merchant' ? '商人' : (item.type === 'system' ? '系统' : (item.type === 'interaction' ? '互动' : item.type))}}</view>
                <view class="sub-user-info">
                  <text class="sub-user-count">订阅 {{item.count || 0}} 次</text>
                  <text class="sub-user-time">{{item.timeStr}}</text>
                </view>
              </view>
              <view class="sub-user-right">
                <view class="sub-user-status {{item.status === 'active' ? 'active' : 'expired'}}">{{item.status === 'active' ? '有效' : '过期'}}</view>
                <view class="sub-user-del" catchtap="deleteSubscriber" data-item="{{item}}">删除</view>
              </view>
            </view>
          </view>
          <view class="sub-empty" wx:if="{{subscribers.length === 0}}">
            <text class="sub-empty-text">暂无订阅用户</text>
          </view>
        </view>
      </view>



      <!-- 用户管理 -->
      <view wx:if="{{activeTab === 'users'}}">
        <view class="section-header"><text class="section-title">{{_l.userList}}</text></view>
        <view class="card-item" wx:for="{{users}}" wx:key="_id">
          <view class="card-top">
            <image class="card-avatar" src="{{item.avatarUrl || '/images/default-avatar.png'}}" mode="aspectFill" />
            <view class="card-user-info">
              <text class="card-author">{{item.nickName}}</text>
              <text class="card-meta">Lv.{{item.level}} · 登录{{item.loginDays ? item.loginDays.length : 0}}天 · {{item.timeStr}}</text>
            </view>
            <view class="ban-tag {{item.banned ? 'banned' : ''}}">{{item.banned ? _l.banned : _l.normal}}</view>
          </view>
          <view class="card-bottom">
            <view class="card-actions">
              <view class="btn-edit" wx:if="{{!item.banned}}" bindtap="banUser" data-item="{{item}}">{{_l.ban}}</view>
              <view class="btn-edit" wx:if="{{item.banned}}" bindtap="unbanUser" data-item="{{item}}">{{_l.unban}}</view>
              <view class="btn-edit" wx:if="{{item.role !== 'editor'}}" bindtap="setEditor" data-item="{{item}}">{{_l.setEditor}}</view>
              <view class="btn-edit" wx:if="{{item.role === 'editor'}}" bindtap="removeEditor" data-item="{{item}}">{{_l.removeEditor}}</view>
              <view class="btn-delete" bindtap="deleteUser" data-item="{{item}}">{{_l.delete}}</view>
            </view>
          </view>
        </view>
        <view class="empty" wx:if="{{users.length === 0}}"><text class="empty-text">暂无用户</text></view>
      </view>

      <!-- 页面管理 -->
      <view wx:if="{{activeTab === 'pages'}}">
        <view class="section-header"><text class="section-title">{{_l.pageConfig}}</text></view>
        <view class="card-item" wx:for="{{pageConfigs}}" wx:key="id">
          <view class="card-top">
            <view class="page-icon">{{item.icon}}</view>
            <view class="card-user-info">
              <text class="card-author">{{item.name}}</text>
              <text class="card-meta" wx:if="{{item.isNav}}">状态：{{item.maintenance ? '已隐藏' : '显示中'}}</text>
              <text class="card-meta" wx:elif="{{item.id === 'captureImage'}}">状态：{{item.maintenance ? '已开启' : '已关闭'}}</text>
              <text class="card-meta" wx:else>状态：{{item.maintenance ? '维护中（已下线）' : '运行中'}}</text>
            </view>
            <view class="toggle {{item.maintenance ? 'on' : ''}}" catchtap="togglePageMaintenance" data-id="{{item.id}}">
              <view class="toggle-dot"></view>
            </view>
          </view>
          <view class="page-actions" wx:if="{{!item.isNav && item.id !== 'captureImage'}}">
            <view class="btn-edit" catchtap="togglePageCustom" data-id="{{item.id}}">自定义：{{item.useCustom ? '开' : '关'}}</view>
          </view>
        </view>

        <!-- 首页头图（多图轮播 · 支持置顶 / 选择当前赛季 / 隐藏） -->
        <view class="section-header" style="margin-top: 32rpx;">
          <text class="section-title">首页头图</text>
          <view style="display:flex; gap:12rpx; align-items:center;">
            <view class="add-btn" style="padding: 8rpx 20rpx;" bindtap="addBannerSeason"><text>+ 赛季</text></view>
            <view class="add-btn" bindtap="addBannerItem"><text>+ 添加图片</text></view>
          </view>
        </view>
        <view class="card-item">
          <!-- 当前生效赛季选择 -->
          <view style="margin-bottom: 20rpx;">
            <view style="display:flex; align-items:center; justify-content:space-between; margin-bottom: 10rpx;">
              <text style="font-size:22rpx; color:#94a3b8;">当前首页展示赛季（点击切换 · 置顶图片优先轮播）</text>
              <text style="font-size:20rpx; color:#00d4ff;">生效中：{{bannerCurrentSeason}}（{{bannerPreviewUrls.length}}张）</text>
            </view>
            <view style="display:flex; flex-wrap:wrap; gap:10rpx;">
              <view bindtap="selectBannerCurrentSeason" data-season="全部"
                style="padding:8rpx 22rpx; border-radius:999rpx; font-size:22rpx; font-weight:{{bannerCurrentSeason === '全部' ? 'bold' : 'normal'}}; color:{{bannerCurrentSeason === '全部' ? '#00d4ff' : '#cbd5e1'}}; background:{{bannerCurrentSeason === '全部' ? 'rgba(0,212,255,0.22)' : 'rgba(255,255,255,0.05)'}}; border:1rpx solid {{bannerCurrentSeason === '全部' ? '#00d4ff' : 'rgba(255,255,255,0.14)'}};">
                全部赛季
              </view>
              <view wx:for="{{bannerSeasons}}" wx:key="*this" bindtap="selectBannerCurrentSeason" data-season="{{item}}"
                style="padding:8rpx 22rpx; border-radius:999rpx; font-size:22rpx; font-weight:{{bannerCurrentSeason === item ? 'bold' : 'normal'}}; color:{{bannerCurrentSeason === item ? '#00d4ff' : '#cbd5e1'}}; background:{{bannerCurrentSeason === item ? 'rgba(0,212,255,0.22)' : 'rgba(255,255,255,0.05)'}}; border:1rpx solid {{bannerCurrentSeason === item ? '#00d4ff' : 'rgba(255,255,255,0.14)'}};">
                {{item}}
              </view>
            </view>
          </view>

          <!-- 生效头图实时预览 -->
          <view class="banner-preview" wx:if="{{bannerPreviewUrls.length > 0}}" style="width: 100%; height: 220rpx; border-radius: 12rpx; overflow: hidden; margin-bottom: 20rpx; border: 1rpx solid #30363d; background: #0d1117;">
            <swiper style="width:100%;height:100%;" autoplay circular interval="3000">
              <swiper-item wx:for="{{bannerPreviewUrls}}" wx:key="index">
                <image lazy-load src="{{item}}" mode="aspectFit" style="width:100%;height:100%;" />
              </swiper-item>
            </swiper>
          </view>
          <view wx:else style="width: 100%; height: 120rpx; border-radius: 12rpx; margin-bottom: 20rpx; border: 1rpx dashed #30363d; background: #0d1117; display: flex; align-items: center; justify-content: center;">
            <text style="font-size: 24rpx; color: #64748b;">当前赛季「{{bannerCurrentSeason}}」暂无可展示头图（或已全部隐藏）</text>
          </view>

          <!-- 头图条目列表 -->
          <view wx:for="{{bannerItems}}" wx:key="index"
            style="padding: 16rpx; border-radius: 14rpx; margin-bottom: 16rpx; opacity: {{item.hidden ? '0.58' : '1'}}; background: {{item.pinned ? 'rgba(251,191,36,0.06)' : 'rgba(255,255,255,0.03)'}}; border: 1rpx {{item.hidden ? 'dashed' : 'solid'}} {{item.pinned ? 'rgba(251,191,36,0.48)' : 'rgba(255,255,255,0.09)'}};">
            <view style="display:flex; gap:12rpx; align-items:center; margin-bottom: 12rpx;">
              <text style="flex-shrink:0; font-size:22rpx; font-weight:bold; color:{{item.pinned ? '#fbbf24' : '#64748b'}}; width:40rpx;">#{{index + 1}}</text>
              <image wx:if="{{item.url}}" src="{{item.url}}" mode="aspectFill" catchtap="previewBlockImage" data-src="{{item.url}}"
                style="flex-shrink:0; width:108rpx; height:68rpx; border-radius:8rpx; border:1rpx solid #30363d; background:#0d1117;" />
              <view wx:else style="flex-shrink:0; width:108rpx; height:68rpx; border-radius:8rpx; border:1rpx dashed #30363d; background:#0d1117;"></view>
              <input class="form-input" style="flex:1; min-width:0; box-sizing:border-box; background:rgba(0,0,0,0.25); border:1rpx solid rgba(255,255,255,0.12); border-radius:12rpx; padding:14rpx 16rpx; color:#fff; font-size:22rpx;"
                placeholder="图片 URL（https:// 或 cloud://）" value="{{item.url}}" bindinput="onBannerItemInput" data-index="{{index}}" />
            </view>

            <view style="display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:10rpx; padding-left: 40rpx;">
              <view style="display:flex; align-items:center; gap:10rpx; flex-wrap:wrap;">
                <picker range="{{bannerSeasons}}" bindchange="onBannerItemSeasonChange" data-index="{{index}}">
                  <view style="display:inline-flex; align-items:center; gap:6rpx; padding:4rpx 16rpx; border-radius:999rpx; font-size:20rpx; color:#79c0ff; background:rgba(56,189,248,0.12); border:1rpx solid rgba(56,189,248,0.3);">
                    <text>赛季: {{item.season || '通用'}} ▾</text>
                  </view>
                </picker>
                <view wx:if="{{item.pinned}}" style="padding:2rpx 12rpx; border-radius:6rpx; font-size:18rpx; font-weight:bold; color:#fbbf24; background:rgba(251,191,36,0.16); border:1rpx solid rgba(251,191,36,0.4);">📌 已置顶</view>
                <view wx:if="{{item.hidden}}" style="padding:2rpx 12rpx; border-radius:6rpx; font-size:18rpx; color:#f87171; background:rgba(248,113,113,0.14); border:1rpx solid rgba(248,113,113,0.35);">🙈 已隐藏</view>
              </view>

              <view style="display:flex; align-items:center; gap:12rpx;">
                <view bindtap="toggleBannerItemPin" data-index="{{index}}"
                  style="padding:6rpx 18rpx; border-radius:999rpx; font-size:21rpx; color:{{item.pinned ? '#fbbf24' : '#cbd5e1'}}; background:{{item.pinned ? 'rgba(251,191,36,0.18)' : 'rgba(255,255,255,0.06)'}}; border:1rpx solid {{item.pinned ? 'rgba(251,191,36,0.45)' : 'rgba(255,255,255,0.14)'}};">
                  {{item.pinned ? '取消置顶' : '📌 置顶'}}
                </view>
                <view bindtap="toggleBannerItemHide" data-index="{{index}}"
                  style="padding:6rpx 18rpx; border-radius:999rpx; font-size:21rpx; color:{{item.hidden ? '#4ade80' : '#94a3b8'}}; background:{{item.hidden ? 'rgba(74,222,128,0.14)' : 'rgba(255,255,255,0.06)'}}; border:1rpx solid {{item.hidden ? 'rgba(74,222,128,0.35)' : 'rgba(255,255,255,0.14)'}};">
                  {{item.hidden ? '👁 显示' : '🙈 隐藏'}}
                </view>
                <view bindtap="removeBannerItem" data-index="{{index}}"
                  style="padding:6rpx 16rpx; border-radius:999rpx; font-size:21rpx; color:#ff5050; background:rgba(255,80,80,0.1); border:1rpx solid rgba(255,80,80,0.28);">
                  删除
                </view>
              </view>
            </view>
          </view>

          <view class="form-actions" style="margin-top: 24rpx;">
            <button class="btn-primary" style="width:100%;height:80rpx;background:rgba(0,200,255,0.12);color:#00d4ff;border:1rpx solid rgba(0,200,255,0.2);border-radius:40rpx;display:flex;align-items:center;justify-content:center;font-size:28rpx;"
              bindtap="saveBanner" disabled="{{bannerLoading}}">{{bannerLoading ? '保存中...' : '保存头图配置'}}</button>
          </view>
        </view>

        <!-- 赛季LOGO板块（固定应用于：活动日历倒计时卡片 & 生成图片） -->
        <view class="section-header" style="margin-top: 32rpx;">
          <text class="section-title">赛季LOGO板块（固定位置）</text>
          <text class="section-title-hint" style="font-size:22rpx; color:#94a3b8;">同步应用于：活动日历倒计时卡片 & 异色战报生成图片</text>
        </view>
        <view class="card" style="padding: 28rpx; margin-bottom: 24rpx;">
          <view style="display:flex; align-items:center; gap:24rpx; margin-bottom:20rpx; padding:20rpx; background:rgba(255,255,255,0.04); border-radius:16rpx; border:1rpx solid rgba(255,255,255,0.08);">
            <image src="{{seasonLogoInput || 'https://img.remit.ee/i/WX0FEAjMVvvY'}}" mode="aspectFit" style="width:180rpx; height:100rpx; flex-shrink:0;" />
            <view style="flex:1; min-width:0; display:flex; flex-direction:column; gap:8rpx;">
              <text style="font-size:24rpx; font-weight:700; color:#f8fafc;">当前生效赛季透明 LOGO</text>
              <text style="font-size:21rpx; color:#94a3b8;">固定展示在：① 活动日历倒计时卡片标题栏左侧 ② 捕捉统计生成战报图片顶部</text>
            </view>
          </view>
          <view style="display:flex; align-items:center; gap:12rpx; margin-bottom:20rpx;">
            <input class="form-input" style="flex:1; margin-bottom:0;" placeholder="粘贴赛季透明LOGO图片URL" value="{{seasonLogoInput}}" bindinput="onSeasonLogoInput" />
            <view class="add-btn" bindtap="uploadSeasonLogoImage" style="padding:14rpx 22rpx; white-space:nowrap;"><text>📷 上传</text></view>
          </view>
          <button class="btn-primary" style="width:100%;height:76rpx;background:rgba(0,200,255,0.12);color:#00d4ff;border:1rpx solid rgba(0,200,255,0.2);border-radius:38rpx;display:flex;align-items:center;justify-content:center;font-size:26rpx;"
            bindtap="saveSeasonLogo" disabled="{{seasonLogoSaving}}">{{seasonLogoSaving ? '保存中...' : '保存赛季LOGO配置'}}</button>
        </view>

        <!-- 活动倒计时（赛季日历） -->
        <view class="section-header" style="margin-top: 32rpx;">
          <text class="section-title">活动倒计时（赛季日历）</text>
          <view class="add-btn" bindtap="addCalendarSeason"><text>+ 新增赛季</text></view>
        </view>
        <view class="card-item" wx:for="{{calendarSeasons}}" wx:key="_id">
          <view class="card-top">
            <view class="page-icon">📅</view>
            <view class="card-user-info">
              <text class="card-author">{{item.name}}</text>
              <text class="card-meta">{{item.start}} ~ {{item.end}} · 活动 {{item.itemsCount}} 条</text>
            </view>
          </view>
          <view class="page-actions">
            <view class="btn-edit" catchtap="editCalendarSeason" data-id="{{item._id}}">编辑</view>
            <view class="btn-edit" style="color:#ff5050;" catchtap="deleteCalendarSeason" data-id="{{item._id}}">删除</view>
          </view>
        </view>
        <view class="card-item" wx:if="{{!calendarSeasons.length}}">
          <text class="card-meta">暂无赛季。点右上角「新增赛季」录入本赛季活动，前端活动页会显示倒计时板块。</text>
        </view>
      </view>

      <!-- 统计面板 -->
      <view wx:if="{{activeTab === 'stats'}}">
        <view class="section-header"><text class="section-title">{{_l.dataStats}}</text></view>
        <view class="stats-grid">
          <view class="stat-card">
            <text class="stat-num">{{stats.totalUsers}}</text>
            <text class="stat-label">{{_l.totalUsers}}</text>
          </view>
          <view class="stat-card">
            <text class="stat-num">{{announcements.length}}</text>
            <text class="stat-label">{{_l.announceCount}}</text>
          </view>
        </view>
      </view>

      <!-- 出没预设管理 -->
      <view class="tab-content-pane" wx:if="{{activeTab === 'swarm'}}">
        <view class="section-header">
          <text class="section-title">{{_l.swarmPreset}}</text>
          <view class="add-btn" bindtap="openSwarmLocationModal"><text>+ 添加</text></view>
        </view>
        <view class="card-item" wx:for="{{swarmLocations}}" wx:key="*this" style="display:flex; justify-content:space-between; align-items:center;">
          <text class="card-title" style="margin-bottom:0;">{{item}}</text>
          <view class="btn-delete" bindtap="deleteSwarmLocation" data-index="{{index}}" style="margin:0; padding:6rpx 16rpx; background:rgba(255,80,80,0.1); color:#ff5050; border-radius:10rpx; font-size:24rpx;">删除</view>
        </view>
        <view class="empty" wx:if="{{swarmLocations.length === 0}}"><text class="empty-text">暂无预设地点</text></view>
      </view>

      <!-- 系统设置面板 -->
      <view class="tab-content-pane" wx:if="{{activeTab === 'site'}}">
        <view class="section-header">
          <text class="section-title">{{_l.siteSettings}}</text>
        </view>
        <view class="form-card" style="padding: 32rpx; background: rgba(255,255,255,0.04); border-radius: 24rpx; border: 1rpx solid rgba(255,255,255,0.08); margin-bottom: 24rpx;">
          <view class="form-group">
            <text class="form-label" style="display: block; margin-bottom: 16rpx; color: rgba(255,255,255,0.7); font-size: 28rpx;">个人页Logo URL</text>
            <input class="form-input" style="width: 100%; box-sizing: border-box; background: rgba(0,0,0,0.2); border: 1rpx solid rgba(255,255,255,0.1); border-radius: 12rpx; padding: 20rpx; color: #fff;" placeholder="输入个人中心Logo的图片地址" value="{{siteConfig.loginLogoUrl}}" bindinput="onLoginLogoInput" />
            <text class="form-hint" style="display: block; margin-top: 12rpx; font-size: 22rpx; color: rgba(255,255,255,0.4);">留空则使用默认Logo，支持完整网络URL或cloud://云存储路径</text>
          </view>
          <view class="form-actions" style="margin-top: 40rpx;">
            <button class="btn-primary" style="width: 100%; height: 80rpx; background: rgba(0,200,255,0.12); color: #00d4ff; border: 1rpx solid rgba(0,200,255,0.2); border-radius: 40rpx; display: flex; align-items: center; justify-content: center; font-size: 28rpx;" bindtap="saveSiteConfig">保存设置</button>
          </view>
        </view>
        <view class="form-card" style="padding: 32rpx; background: rgba(255,255,255,0.04); border-radius: 24rpx; border: 1rpx solid rgba(255,255,255,0.08); margin-bottom: 24rpx;">
          <view class="form-group">
            <text class="form-label" style="display: block; margin-bottom: 16rpx; color: rgba(255,255,255,0.7); font-size: 28rpx;">🌐 批量翻译旧公告</text>
            <view style="display:flex;gap:12rpx;align-items:center;margin-bottom:12rpx;">
              <text style="font-size:22rpx;color:rgba(255,255,255,0.45);">{{translateProgress || '对未翻译的历史公告补充英/日/韩翻译'}}</text>
            </view>
            <view style="display:flex;gap:16rpx;align-items:center;">
              <button class="admin-btn" bindtap="startBatchTranslate" disabled="{{translating}}" style="flex:1;justify-content:center;font-size:24rpx;">
                {{translating ? (translateCount + '/' + translateTotal + '...') : '开始批量翻译'}}
              </button>
              <button class="admin-btn" bindtap="stopBatchTranslate" wx:if="{{translating}}" style="flex:1;justify-content:center;font-size:24rpx;background:rgba(255,71,87,0.1)!important;border-color:rgba(255,71,87,0.2)!important;color:#ff4757!important;box-shadow:none!important;">停止</button>
            </view>
          </view>
        </view>
      </view>
      <view class="modal-mask" wx:if="{{showModal}}" bindtap="closeModal">
        <view class="modal-box" catchtap="preventClose">
        <view class="modal-header">
          <text class="modal-title">{{editingItem ? '编辑公告' : '发布公告'}}</text>
          <text class="modal-close" catchtap="closeModal">✕</text>
        </view>
        <view class="modal-body">
          <view class="form-group">
            <text class="form-label">类型</text>
            <picker class="form-picker" range="{{['公告', '更新', '活动', '提示']}}" bindchange="onTypeChange">
              <text class="picker-text">{{formType === 'notice' ? '公告' : formType === 'update' ? '更新' : formType === 'event' ? '活动' : '提示'}} ▾</text>
            </picker>
            </view>
            <view class="form-group" wx:if="{{formType === 'event'}}">
              <text class="form-label">活动板块</text>
              <picker class="form-picker" range="{{['常规', '赛季', '联动']}}" bindchange="onSubTypeChange">
                <text class="picker-text">{{formSubType === 'regular' ? '常规' : formSubType === 'season' ? '赛季' : formSubType === 'collab' ? '联动' : '常规'}} ▾</text>
              </picker>
            </view>
            <view class="form-group" wx:if="{{formType === 'event' && formSubType === 'collab'}}">
              <text class="form-label">联动Logo</text>
              <input class="form-input" placeholder-class="form-input-placeholder" placeholder="请输入联动品牌Logo URL (选填)" value="{{formCollabLogo}}" bindinput="onCollabLogoInput" />
            </view>
          <view class="form-group">
            <text class="form-label">标题</text>
            <input class="form-input" placeholder-class="form-input-placeholder" placeholder="输入公告标题" value="{{formTitle}}" bindinput="onTitleInput" maxlength="50" />
          </view>
          <view class="form-group">
            <view class="form-label-row">
              <text class="form-label">内容</text>
              <text class="label-preview-btn" catchtap="openFormPreview">预览</text>
            </view>

            <!-- 富文本编辑工具栏 -->
            <view class="rich-toolbar">
              <view class="toolbar-group-label">格式</view>
              <view class="toolbar-row">
                <view class="tool-btn" catchtap="undo">
                  <text class="tool-icon">↩️</text>
                </view>
                <view class="tool-btn {{currentAlign === 'left' ? 'active' : ''}}" catchtap="alignLeft">
                  <text class="tool-icon" style="font-size:24rpx;">居左</text>
                </view>
                <view class="tool-btn {{currentAlign === 'center' ? 'active' : ''}}" catchtap="alignCenter">
                  <text class="tool-icon" style="font-size:24rpx;">居中</text>
                </view>
                <view class="tool-btn {{currentAlign === 'right' ? 'active' : ''}}" catchtap="alignRight">
                  <text class="tool-icon" style="font-size:24rpx;">居右</text>
                </view>
                <view class="tool-btn {{currentFontWeight === 'bold' ? 'active' : ''}}" catchtap="toggleBold">
                  <text class="tool-icon" style="font-weight:bold;">B</text>
                </view>
                <view class="tool-btn {{currentFontStyle === 'italic' ? 'active' : ''}}" catchtap="toggleItalic">
                  <text class="tool-icon" style="font-style:italic;">I</text>
                </view>
                <view class="tool-btn {{currentUnderline ? 'active' : ''}}" catchtap="toggleUnderline">
                  <text class="tool-icon" style="text-decoration:underline;">U</text>
                </view>
                <view class="tool-btn {{currentStrike ? 'active' : ''}}" catchtap="toggleStrike">
                  <text class="tool-icon" style="text-decoration:line-through;">S</text>
                </view>
                <view class="tool-btn {{currentHeader === 2 ? 'active' : ''}}" catchtap="toggleHeader2">
                  <text class="tool-icon" style="font-weight:bold;">H2</text>
                </view>
                <view class="tool-btn {{currentHeader === 3 ? 'active' : ''}}" catchtap="toggleHeader3">
                  <text class="tool-icon" style="font-weight:bold;">H3</text>
                </view>
                <view class="tool-btn" catchtap="showFontSizePicker">
                  <text class="tool-icon">Aa</text>
                </view>
                <view class="tool-btn" catchtap="showFontColorPicker">
                  <view class="color-preview" style="background:{{currentFontColor}};"></view>
                </view>
                <view class="tool-btn" catchtap="showFontFamilyPicker">
                  <text class="tool-icon">𝐓</text>
                  <text class="tool-text">字体</text>
                </view>
              </view>
              <view class="toolbar-group-label">插入</view>
              <view class="toolbar-row">
                <view class="tool-btn" catchtap="addRichQuoteBlock">
                  <text class="tool-icon">❝</text>
                  <text class="tool-text">引用</text>
                </view>
                <view class="tool-btn" catchtap="showMusicDialog">
                  <text class="tool-icon">🎵</text>
                  <text class="tool-text">音乐</text>
                </view>
                <view class="tool-btn" catchtap="showVideoDialog">
                  <text class="tool-icon">🎬</text>
                  <text class="tool-text">视频</text>
                </view>
                <view class="tool-btn" catchtap="importFileToTable">
                  <text class="tool-icon">📊</text>
                  <text class="tool-text">表格</text>
                </view>
                <view class="tool-btn" catchtap="showAttachmentDialog">
                  <text class="tool-icon">📎</text>
                  <text class="tool-text">附件</text>
                </view>
                <view class="tool-btn" catchtap="showImageBlockDialog">
                  <text class="tool-icon">🖼️</text>
                  <text class="tool-text">插图</text>
                </view>
                <view class="tool-btn" catchtap="showSwiperDialog">
                  <text class="tool-icon">🔄</text>
                  <text class="tool-text">滚动图</text>
                </view>
                <view class="tool-btn" catchtap="showDividerDialog">
                  <text class="tool-icon">➖</text>
                  <text class="tool-text">分割线</text>
                </view>
                <view class="tool-btn" catchtap="showLinkDialog">
                  <text class="tool-icon">🔗</text>
                  <text class="tool-text">链接</text>
                </view>
                <view class="tool-btn" catchtap="addRichTextBlock">
                  <text class="tool-icon">＋</text>
                  <text class="tool-text">新起一段</text>
                </view>
              </view>
              <!-- 字号选择器 -->
              <view class="size-picker" wx:if="{{showSizePicker}}">
                <view class="size-option {{currentFontSize === item ? 'active' : ''}}" wx:for="{{fontSizeOptions}}" wx:key="*this" catchtap="setFontSize" data-size="{{item}}">
                  <text style="font-size:{{item}}rpx;">{{item}}</text>
                </view>
              </view>
              
              <!-- 颜色选择器 -->
              <view class="color-picker" wx:if="{{showColorPicker}}">
                <view class="color-option {{currentFontColor === item.value ? 'active' : ''}}" wx:for="{{fontColorOptions}}" wx:key="value" catchtap="setFontColor" data-color="{{item.value}}">
                  <view class="color-dot" style="background:{{item.value}};"></view>
                  <text class="color-name">{{item.name}}</text>
                </view>
              </view>

              <!-- 字体选择器 -->
              <view class="font-picker" wx:if="{{showFontFamilyPicker}}">
                <view class="font-option {{currentFontFamily === item.value ? 'active' : ''}}" wx:for="{{fontFamilyOptions}}" wx:key="value" catchtap="setFontFamily" data-family="{{item.value}}">
                  <text class="font-preview" style="font-family:{{item.value}};">{{item.name}}</text>
                </view>
              </view>
            </view>
            
            <!-- 已添加的富文本块 -->
            <view class="rich-blocks" wx:if="{{formRichContent.length > 0}}">
              <view class="rich-block {{item.type === 'quote' ? 'quote-block' : ''}} {{item.type === 'music' ? 'music-block-item' : ''}} {{item.type === 'video' ? 'video-block-item' : ''}} {{item.type === 'table' ? 'table-block-item' : ''}} {{item.type === 'divider' ? 'divider-block-item' : ''}} {{item.type === 'link' ? 'link-block-item' : ''}} {{item.type === 'image' || item.type === 'swiper' ? 'media-wide' : ''}}" wx:for="{{formRichContent}}" wx:key="index">
                <view class="block-content">
                  <text wx:if="{{item.type === 'quote'}}" class="block-quote-icon">❝</text>
                  <block wx:elif="{{item.type === 'music'}}">
                    <image wx:if="{{item.cover}}" class="block-cover-preview" src="{{item.cover}}" mode="aspectFill" style="width: 40rpx; height: 40rpx; border-radius: 50%; margin-right: 12rpx; border: 2rpx solid #3d2b1f;" />
                    <text wx:else class="block-music-icon">🎵</text>
                    <text class="block-text music-text-info">{{item.name || '推荐单曲'}}</text>
                  </block>
                  <block wx:elif="{{item.type === 'video'}}">
                    <image wx:if="{{item.cover}}" class="block-cover-preview" src="{{item.cover}}" mode="aspectFill" style="width: 50rpx; height: 36rpx; border-radius: 6rpx; margin-right: 12rpx; border: 2rpx solid #3d2b1f;" />
                    <text wx:else class="block-video-icon">{{item.platform === 'bilibili' ? '📺' : '🎬'}}</text>
