              <view class="form-group row half" style="margin-bottom:0;">
                <text class="form-label">【特殊球】CNY</text>
                <switch checked="{{ballForm.isSpecial}}" bindchange="onBallFormSwitch" data-field="isSpecial" color="#00d4ff" />
              </view>
              <view class="form-group row half" style="margin-bottom:0;">
                <text class="form-label">【活动球】免费</text>
                <switch checked="{{ballForm.isActivity}}" bindchange="onBallFormSwitch" data-field="isActivity" color="#00d4ff" />
              </view>
            </view>
            <view style="margin-top:12rpx; font-size:22rpx; color:rgba(255,193,7,0.85);" wx:if="{{ballForm.isActivity && !ballForm.isBuy && !ballForm.isSpecial}}">
              活动获取默认免费，无需填写价格
            </view>
            <view class="form-row" style="margin-top:24rpx;" wx:if="{{ballForm.isBuy || ballForm.isCraft || ballForm.isSpecial}}">
              <view class="form-group half" wx:if="{{ballForm.isBuy}}" style="margin-bottom:0;">
                <text class="form-label">价格 (洛克贝)</text>
                <input class="form-input" type="number" value="{{ballForm.price}}" bindinput="onBallFormInput" data-field="price" placeholder="例如：200" />
              </view>
              <view class="form-group half" wx:if="{{ballForm.isSpecial}}" style="margin-bottom:0;">
                <text class="form-label">价格 (CNY)</text>
                <input class="form-input" type="digit" value="{{ballForm.cnyPrice}}" bindinput="onBallFormInput" data-field="cnyPrice" placeholder="例如：6" />
              </view>
              <view class="form-group half" wx:if="{{ballForm.isCraft}}" style="margin-bottom:0;">
                <text class="form-label">合成材料 (可选)</text>
                <input class="form-input" value="{{ballForm.craftMaterials}}" bindinput="onBallFormInput" data-field="craftMaterials" placeholder="例如：魔法石x2" />
              </view>
            </view>
            <view style="margin-top:20rpx; padding-top:16rpx; border-top:1rpx dashed rgba(255,255,255,0.08);" wx:if="{{ballForm.isCraft}}">
              <view class="form-group row" style="margin-bottom: {{ballForm.craftCostRoco ? '16rpx' : '0'}}; justify-content:space-between;">
                <text class="form-label" style="color:#ffab40;">【合成消耗洛克贝】（可选）</text>
                <switch checked="{{ballForm.craftCostRoco}}" bindchange="onBallFormSwitch" data-field="craftCostRoco" color="#ffab40" />
              </view>
              <view class="form-group" wx:if="{{ballForm.craftCostRoco}}" style="margin-bottom:0;">
                <text class="form-label">合成消耗 (洛克贝)</text>
                <input class="form-input" type="number" value="{{ballForm.craftPrice}}" bindinput="onBallFormInput" data-field="craftPrice" placeholder="例如：3000" />
              </view>
            </view>
          </view>

          <view class="form-group">
            <text class="form-label">效果描述</text>
            <input class="form-input" value="{{ballForm.desc}}" bindinput="onBallFormInput" data-field="desc" placeholder="例如：捕获率+30%" />
          </view>

          <view class="form-group">
            <text class="form-label">获取途径</text>
            <input class="form-input" value="{{ballForm.source}}" bindinput="onBallFormInput" data-field="source" placeholder="例如：宠物农庄" />
          </view>

          <view class="form-group">
            <view style="display:flex; justify-content:space-between; align-items:flex-end;">
              <text class="form-label">图片URL (可选)</text>
              <image wx:if="{{ballForm.img}}" src="{{ballForm.img}}" style="width: 40rpx; height: 40rpx; border-radius: 50%; border: 2rpx solid #00d4ff; margin-bottom: 8rpx;" mode="aspectFill" />
            </view>
            <input class="form-input" value="{{ballForm.img}}" bindinput="onBallFormInput" data-field="img" placeholder="cloud://..." />
          </view>

          <view class="form-row">
            <view class="form-group half">
              <text class="form-label">主题颜色</text>
              <view style="display:flex; align-items:center; gap: 12rpx;">
                <view style="width:24rpx; height:24rpx; border-radius:50%; background:{{ballForm.color || '#fff'}}; border: 2rpx solid rgba(255,255,255,0.2);"></view>
                <input class="form-input" style="flex:1;" value="{{ballForm.color}}" bindinput="onBallFormInput" data-field="color" placeholder="#ffffff" />
              </view>
            </view>
            <view class="form-group half">
              <text class="form-label">默认图标</text>
              <input class="form-input" value="{{ballForm.icon}}" bindinput="onBallFormInput" data-field="icon" placeholder="⚪" />
            </view>
          </view>
        </scroll-view>
        <view class="modal-footer">
          <view class="modal-btn cancel" catchtap="closeBallModal">取消</view>
          <view class="modal-btn confirm" catchtap="confirmBallForm">确认</view>
        </view>
      </view>
    </view>

    <!-- 异色精灵编辑弹窗 -->
    <view class="modal-mask" wx:if="{{showPetModal}}" bindtap="closePetModal">
      <view class="modal-box" catchtap="preventClose">
        <view class="modal-header">
          <text class="modal-title">{{editingPet ? '编辑异色精灵' : '新增异色精灵'}}</text>
          <text class="modal-close" catchtap="closePetModal">✕</text>
        </view>
        <scroll-view scroll-y style="max-height: 60vh; padding-right: 12rpx;">
          <view class="form-group">
            <text class="form-label">赛季分类</text>
            <picker range="{{petSeasons}}" value="{{petSeasonIndex}}" bindchange="onPetSeasonChange">
              <view class="form-input" style="display:flex; align-items:center; justify-content:space-between;">
                <text>{{petForm.season}}</text>
                <text style="opacity:0.5;">▾</text>
              </view>
            </picker>
          </view>
          <view class="form-group">
            <text class="form-label">精灵名称</text>
            <input class="form-input" value="{{petForm.name}}" bindinput="onPetFormInput" data-field="name" placeholder="请输入精灵名称" />
          </view>
          <view class="form-group">
            <view style="display:flex; justify-content:space-between; align-items:center; margin-bottom:10rpx;">
              <text class="form-label" style="margin-bottom:0;">图片URL (可选，支持多组)</text>
              <view class="add-btn" style="padding: 6rpx 16rpx; font-size: 22rpx;" catchtap="addPetImgRow"><text>+ 添加图片URL</text></view>
            </view>
            <view wx:for="{{petForm.imgs || [petForm.img || '']}}" wx:for-item="pImg" wx:for-index="pImgIdx" wx:key="pImgIdx" style="display:flex; align-items:center; gap:10rpx; margin-bottom:10rpx;">
              <image wx:if="{{pImg}}" src="{{pImg}}" style="width: 48rpx; height: 48rpx; border-radius: 8rpx; border: 2rpx solid #00d4ff; flex-shrink:0;" mode="aspectFill" catchtap="previewBlockImage" data-src="{{pImg}}" />
              <input class="form-input" style="flex:1; min-width:0;" value="{{pImg}}" bindinput="onPetImgItemInput" data-index="{{pImgIdx}}" placeholder="图片URL {{pImgIdx + 1}} (https:// 或 cloud://)" />
              <view wx:if="{{(petForm.imgs && petForm.imgs.length > 1)}}" catchtap="removePetImgRow" data-index="{{pImgIdx}}" style="color:#ff5050; font-size:28rpx; padding:8rpx 12rpx; flex-shrink:0;">✕</view>
            </view>
          </view>
        </scroll-view>
        <view class="modal-footer">
          <view class="modal-btn cancel" catchtap="closePetModal">取消</view>
          <view class="modal-btn confirm" catchtap="confirmPetForm">确认</view>
        </view>
      </view>
    </view>

    <!-- 赛季编辑弹窗 -->
    <view class="modal-mask" wx:if="{{showSeasonModal}}" bindtap="closeSeasonModal">
      <view class="modal-box" catchtap="preventClose">
        <view class="modal-header">
          <text class="modal-title">{{editingSeason ? '重命名赛季' : '新增赛季'}}</text>
          <text class="modal-close" catchtap="closeSeasonModal">✕</text>
        </view>
        <view class="form-group">
          <text class="form-label">赛季名称</text>
          <input class="form-input" value="{{seasonFormName}}" bindinput="onSeasonNameInput" placeholder="例如：S5 / 春季赛" />
        </view>
        <view class="modal-footer">
          <view class="modal-btn cancel" catchtap="closeSeasonModal">取消</view>
          <view class="modal-btn confirm" catchtap="confirmSeasonForm">确认</view>
        </view>
      </view>
    </view>

    <!-- 活动倒计时赛季日历编辑弹窗 -->
    <view class="modal-mask" wx:if="{{showCalendarModal}}" bindtap="closeCalendarModal">
      <view class="modal-box" catchtap="preventClose">
        <view class="modal-header">
          <text class="modal-title">{{calendarEditingId ? '编辑赛季日历' : '新增赛季日历'}}</text>
          <text class="modal-close" catchtap="closeCalendarModal">✕</text>
        </view>
        <view class="modal-body">
          <view class="form-group">
            <text class="form-label">赛季名称</text>
            <input class="form-input" value="{{calendarName}}" bindinput="onCalendarNameInput" placeholder="例如：S2赛季" maxlength="30" />
          </view>
          <view class="form-group">
            <text class="form-label">开始日期</text>
            <picker class="form-picker" mode="date" value="{{calendarStart}}" bindchange="onCalendarStartChange">
              <view>{{calendarStart || '选择开始日期'}}</view>
            </picker>
          </view>
          <view class="form-group">
            <text class="form-label">结束日期</text>
            <picker class="form-picker" mode="date" value="{{calendarEnd}}" bindchange="onCalendarEndChange">
              <view>{{calendarEnd || '选择结束日期'}}</view>
            </picker>
          </view>
          <view class="form-group">
            <view class="form-label-row">
              <text class="form-label">活动列表</text>
              <view class="add-btn cal-add-btn" catchtap="addCalendarItemRow"><text>+ 添加一行</text></view>
            </view>
            <view class="cal-item-row" wx:for="{{calendarItems}}" wx:key="index">
              <view class="cal-row-top">
                <input class="form-input cal-title" value="{{item.title}}" placeholder="活动标题" placeholder-class="form-input-placeholder" bindinput="onCalendarItemTitle" data-index="{{index}}" maxlength="60" />
                <picker wx:if="{{shinyPets && shinyPets.length}}" mode="multiSelector" range="{{calendarPresetPickerRange}}" value="{{calendarPresetPickerValue}}" bindcolumnchange="onCalendarPresetColumnChange" bindchange="onCalendarPickPresetPet" data-index="{{index}}">
                  <view class="add-btn" style="padding: 8rpx 16rpx; font-size: 22rpx; white-space: nowrap;">🐾 选捕捉预设</view>
                </picker>
                <view class="cal-row-del" catchtap="removeCalendarItemRow" data-index="{{index}}"><text>✕</text></view>
              </view>
              <view class="cal-row-mid">
                <picker class="form-picker cal-grp" range="{{calendarGroupNames}}" value="{{item.groupIndex}}" bindchange="onCalendarItemGroup" data-index="{{index}}">
                  <text class="picker-text">{{calendarGroupNames[item.groupIndex]}}</text>
                </picker>
                <picker class="form-picker cal-date" mode="date" value="{{item.start}}" bindchange="onCalendarItemStart" data-index="{{index}}">
                  <text class="picker-text">{{item.start || '开始日期'}}</text>
                </picker>
                <picker class="form-picker cal-date" mode="date" value="{{item.end}}" bindchange="onCalendarItemEnd" data-index="{{index}}">
                  <text class="picker-text">{{item.end || '结束日期(可空)'}}</text>
                </picker>
              </view>
              <view class="cal-icons-wrap" wx:if="{{item.groupIndex === 2 || (item.icons && item.icons.length > 1)}}">
                <view class="cal-icons-head">
                  <text class="cal-icons-tip" style="color:#ff9ff3;">🌺 命定花种图片URL（已添加 {{item.icons ? item.icons.length : 1}} 组）</text>
                  <view class="cal-icon-add" catchtap="addCalendarItemIcon" data-index="{{index}}">+ 添加图片URL</view>
                </view>
                <view class="cal-icon-item" wx:for="{{item.icons || [item.icon || '']}}" wx:for-item="iconUrl" wx:for-index="iconIdx" wx:key="iconIdx">
                  <image wx:if="{{iconUrl}}" src="{{iconUrl}}" class="cal-icon-preview" mode="aspectFill" catchtap="previewBlockImage" data-src="{{iconUrl}}" />
                  <input class="form-input cal-icon" style="flex:1; min-width:0;" value="{{iconUrl}}" placeholder="第 {{iconIdx + 1}} 组图片URL（https:// 或 cloud://）" placeholder-class="form-input-placeholder" bindinput="onCalendarItemIconInput" data-index="{{index}}" data-icon-index="{{iconIdx}}" />
                  <view class="cal-icon-remove" wx:if="{{item.icons && item.icons.length > 1}}" catchtap="removeCalendarItemIcon" data-index="{{index}}" data-icon-index="{{iconIdx}}">✕</view>
                </view>
              </view>
              <view class="cal-icon-item" wx:else>
                <image wx:if="{{(item.icons && item.icons[0]) || item.icon}}" src="{{(item.icons && item.icons[0]) || item.icon}}" class="cal-icon-preview" mode="aspectFill" catchtap="previewBlockImage" data-src="{{(item.icons && item.icons[0]) || item.icon}}" />
                <input class="form-input cal-icon" style="flex:1; min-width:0;" value="{{(item.icons && item.icons[0]) || item.icon}}" placeholder="图标URL（可选）" placeholder-class="form-input-placeholder" bindinput="onCalendarItemIconInput" data-index="{{index}}" data-icon-index="0" />
                <view class="cal-icon-add" catchtap="addCalendarItemIcon" data-index="{{index}}">+ 多图</view>
              </view>
            </view>
            <view class="cal-empty" wx:if="{{!calendarItems.length}}">还没有活动，点「+ 添加一行」开始录入</view>
          </view>
        </view>
        <view class="modal-footer">
          <view class="modal-btn cancel" catchtap="closeCalendarModal">取消</view>
          <view class="modal-btn confirm" catchtap="saveCalendarSeason">保存</view>
        </view>
      </view>
    </view>

    <!-- Swarm Location Modal -->
    <view class="modal-mask" wx:if="{{showSwarmModal}}" bindtap="closeSwarmModal">
      <view class="modal-box" catchtap="preventClose">
        <view class="modal-header">
          <text class="modal-title">添加地点</text>
          <text class="modal-close" bindtap="closeSwarmModal">✕</text>
        </view>
        <input class="modal-input" placeholder="输入地点名称" placeholder-style="color:#484f58" value="{{swarmLocationInput}}" bindinput="onSwarmInput" />
        <view class="modal-footer">
          <button class="modal-cancel" bindtap="closeSwarmModal">取消</button>
          <button class="modal-save" bindtap="saveSwarmLocation">保存</button>
        </view>
      </view>
    </view>

    <!-- 发布前整篇预览 -->
    <view class="modal-mask preview-mask" wx:if="{{showContentPreview}}" bindtap="closeContentPreview">
      <view class="preview-box" catchtap="preventClose">
        <view class="preview-header">
          <text class="preview-title">{{previewKind === 'activity' ? '活动预览' : '公告预览'}}（首页展示效果）</text>
          <text class="modal-close" catchtap="closeContentPreview">✕</text>
        </view>
        <view class="preview-body">
          <view class="preview-feed-card">
            <view class="preview-feed-head">
              <view class="preview-badge">{{previewTypeLabel}}</view>
              <text class="preview-feed-title">{{previewTitle || '（未填标题）'}}</text>
            </view>
            <view class="preview-feed-body">
              <block wx:for="{{previewBlocks}}" wx:key="index">
                <image wx:if="{{item.type === 'image'}}" class="preview-img" src="{{item.url}}" mode="widthFix" catchtap="previewBlockImage" data-src="{{item.url}}" />
                <swiper wx:elif="{{item.type === 'swiper'}}" class="preview-swiper" autoplay circular interval="3000">
                  <swiper-item wx:for="{{item.urls}}" wx:for-item="surl" wx:for-index="si" wx:key="si">
                    <image class="media-live-img" src="{{surl}}" mode="aspectFit" catchtap="previewBlockImage" data-src="{{surl}}" />
                  </swiper-item>
                </swiper>
                <view wx:elif="{{item.type === 'quote'}}" class="preview-quote">{{item.content}}</view>
                <view wx:elif="{{item.type === 'music'}}" class="preview-media-tag">🎵 音乐：{{item.name || '推荐单曲'}}</view>
                <view wx:elif="{{item.type === 'video'}}" class="preview-media-tag">🎬 视频：{{item.name || item.platformName || '在线视频'}}</view>
                <view wx:elif="{{item.type === 'divider'}}" class="preview-divider"></view>
                <view wx:elif="{{item.type === 'link'}}" class="preview-link">{{item.isVideo ? '📺' : '🔗'}} {{item.text}}</view>
                <view wx:elif="{{item.type === 'attachment'}}" class="preview-media-tag">📎 {{item.name}} {{item.sizeText}}</view>
                <view wx:elif="{{item.type === 'table'}}" class="preview-table">
                  <view class="preview-table-row header">
                    <view class="preview-table-cell" wx:for="{{item.headers}}" wx:for-item="h" wx:for-index="hi" wx:key="hi">{{h}}</view>
                  </view>
                  <view class="preview-table-row" wx:for="{{item.rows}}" wx:for-item="row" wx:for-index="ri" wx:key="ri">
                    <view class="preview-table-cell" wx:for="{{row}}" wx:for-item="cell" wx:for-index="ci" wx:key="ci">{{cell}}</view>
                  </view>
                </view>
                <view wx:elif="{{item.type === 'text'}}" class="preview-rich-text">
                  <rich-text wx:if="{{item.html}}" nodes="{{item.html}}" />
                  <text wx:else>{{item.content}}</text>
                </view>
              </block>
              <view wx:if="{{previewEditorHtml}}" class="preview-rich-text">
                <rich-text nodes="{{previewEditorHtml}}" />
              </view>
              <view wx:if="{{previewSource}}" class="preview-source">来源：{{previewSource}}</view>
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>
</view>

