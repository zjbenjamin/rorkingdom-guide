<view class="page">
  <view class="container">
    <view class="no-access" wx:if="{{!loading && !isAdmin}}">
      <text class="no-icon">🔒</text>
      <text class="no-title">无访问权限</text>
      <text class="no-desc">此页面仅限管理者访问</text>
    </view>

    <view class="loading" wx:if="{{loading && isAdmin}}">
      <view class="loading-spinner"></view>
      <text class="loading-text">加载中...</text>
    </view>

    <view wx:if="{{isAdmin}}">
      <!-- 顶部标题栏 (Hero) -->
      <view class="admin-hero">
        <view class="admin-hero-bg"></view>
        <view class="admin-hero-content">
          <view class="admin-hero-left">
            <view class="admin-avatar">
              <text class="admin-avatar-icon">👑</text>
            </view>
            <view class="admin-hero-info">
              <text class="admin-hero-title">管理后台</text>
              <text class="admin-hero-sub">Control Panel</text>
            </view>
          </view>
          <view class="admin-hero-right">
            <view class="admin-stat-pill">
              <text class="stat-pill-num">{{announcements.length || 0}}</text>
              <text class="stat-pill-label">公告</text>
            </view>
            <view class="admin-stat-pill">
              <text class="stat-pill-num">{{adminActivities.length || 0}}</text>
              <text class="stat-pill-label">活动</text>
            </view>
            <view class="refresh-btn" bindtap="refreshData">
              <text class="refresh-icon">🔄</text>
            </view>
          </view>
        </view>
      </view>

      <!-- Tab 栏 -->
      <scroll-view scroll-x class="admin-tabs-scroll">
        <view class="admin-tabs">
          <view class="admin-tab {{activeTab === 'announce' ? 'on' : ''}}" bindtap="switchTab" data-tab="announce">公告</view>
          <view class="admin-tab {{activeTab === 'balls' ? 'on' : ''}}" bindtap="switchTab" data-tab="balls">道具球</view>
          <view class="admin-tab {{activeTab === 'subscribe' ? 'on' : ''}}" bindtap="switchTab" data-tab="subscribe">订阅</view>
          <view class="admin-tab {{activeTab === 'users' ? 'on' : ''}}" bindtap="switchTab" data-tab="users">用户</view>
          <view class="admin-tab {{activeTab === 'pages' ? 'on' : ''}}" bindtap="switchTab" data-tab="pages">页面</view>
          <view class="admin-tab {{activeTab === 'stats' ? 'on' : ''}}" bindtap="switchTab" data-tab="stats">统计</view>
          <view class="admin-tab {{activeTab === 'swarm' ? 'on' : ''}}" bindtap="switchTab" data-tab="swarm">预设</view>
          <view class="admin-tab {{activeTab === 'site' ? 'on' : ''}}" bindtap="switchTab" data-tab="site">设置</view>
        </view>
      </scroll-view>

      <!-- 公告管理 -->
      <view wx:if="{{activeTab === 'announce'}}">
        <view class="section-header">
          <text class="section-title">公告列表</text>
          <view class="add-btn" bindtap="openModal"><text>+ 发布</text></view>
        </view>
        <view class="card-item" wx:for="{{announcements}}" wx:key="_id">
          <view class="card-top">
            <view class="tag tag-{{item.type}}">{{item.type === 'notice' ? '公告' : item.type === 'update' ? '更新' : item.type === 'event' ? '活动' : '提示'}}</view>
            <view class="pin-tag {{item.pinned ? 'on' : ''}}" bindtap="togglePinnedStatus" data-item="{{item}}">{{item.pinned ? '已置顶' : '置顶'}}</view>
          </view>
          <text class="card-title">{{item.title}}</text>
          <text class="card-desc">{{item.previewText || item.content}}</text>
          <view class="card-bottom">
            <text class="card-time">{{item.timeStr}}</text>
            <view class="card-actions">
              <view class="btn-edit" bindtap="openModal" data-item="{{item}}">编辑</view>
              <view class="btn-delete" bindtap="deleteAnnouncement" data-item="{{item}}">删除</view>
            </view>
          </view>
        </view>
        <view class="empty" wx:if="{{announcements.length === 0}}"><text class="empty-text">暂无公告</text></view>
      </view>


      <!-- 活动管理 -->
      <view wx:if="{{activeTab === 'activity'}}">
        <view class="section-header">
          <text class="section-title">活动列表</text>
          <view class="add-btn" bindtap="openActivityModal"><text>+ 新增</text></view>
        </view>
        <view class="card-item" wx:for="{{adminActivities}}" wx:key="_id">
          <view class="card-top">
            <view class="tag tag-event">{{item.type || '活动'}}</view>
            <view class="pin-tag {{item.pinned ? 'on' : ''}}" bindtap="toggleActivityPinned" data-item="{{item}}">{{item.pinned ? '已置顶' : '置顶'}}</view>
          </view>
          <text class="card-title">{{item.title}}</text>
          <text class="card-desc">{{item.previewText || item.content}}</text>
          <view class="card-bottom">
            <text class="card-time">{{item.timeStr}}</text>
            <view class="card-actions">
              <view class="btn-edit" wx:if="{{item.isCloud}}" bindtap="openActivityModal" data-item="{{item}}">编辑</view>
              <view class="btn-delete" bindtap="deleteActivity" data-item="{{item}}">删除</view>
            </view>
          </view>
        </view>
        <view class="empty" wx:if="{{adminActivities.length === 0}}"><text class="empty-text">暂无活动</text></view>
      </view>

      <!-- 咕噜球管理 -->
      <view wx:if="{{activeTab === 'balls'}}">
        <view class="section-header">
          <text class="section-title">咕噜球仓库配置</text>
          <view class="add-btn" bindtap="openBallModal"><text>+ 新增</text></view>
        </view>
        <view class="card-item" wx:for="{{ballsConfig}}" wx:key="id">
          <view class="card-top" style="justify-content: space-between;">
            <view style="display:flex; align-items:center;">
              <image wx:if="{{item.img}}" src="{{item.img}}" style="width:40rpx; height:40rpx; margin-right:12rpx;" mode="aspectFit" />
              <text wx:else style="margin-right:12rpx; font-size: 32rpx;">{{item.icon || '⚪'}}</text>
              <text style="font-weight:bold; color:{{item.color || '#fff'}}">{{item.name}}</text>
            </view>
            <view style="display:flex; gap:10rpx;">
              <view class="tag tag-notice" wx:if="{{item.isBuy}}">购买球</view>
              <view class="tag tag-update" wx:if="{{item.isCraft}}">合成球</view>
            </view>
          </view>
          <view style="padding: 24rpx; background: rgba(0,0,0,0.2); border-radius: 12rpx; margin-bottom: 24rpx;">
            <view style="font-size:24rpx; color:#aaa; margin-bottom: 8rpx;">价格: {{item.price}} 洛克贝</view>
            <view style="font-size:24rpx; color:#aaa; margin-bottom: 8rpx;">描述: {{item.desc}}</view>
            <view style="font-size:24rpx; color:#aaa;">获取: {{item.source || '未知'}}</view>
          </view>
          <view class="card-actions">
            <view class="btn-edit" bindtap="openBallModal" data-item="{{item}}">编辑</view>
            <view class="btn-delete" bindtap="deleteBall" data-id="{{item.id}}">删除</view>
          </view>
        </view>
        <view class="modal-submit" bindtap="saveBallsConfig" style="margin: 40rpx 0; width: 100%; box-sizing: border-box; justify-content:center; {{ballsSubmitting ? 'opacity: 0.5; filter: grayscale(1);' : ''}}">
          <text>{{ballsSubmitting ? '保存中...' : '保存修改到云端'}}</text>
        </view>
      </view>

      <!-- 订阅管理 -->
      <view wx:if="{{activeTab === 'subscribe'}}">
        <view class="sub-section">
          <view class="sub-section-title">
            <text class="sub-section-icon">🔔</text>
            <text>订阅开关</text>
          </view>
          <text class="sub-section-hint">关闭后用户端不显示该订阅按钮</text>
          <view class="sub-grid">
            <view class="sub-toggle-card {{subscribeConfig['announcement'] ? 'active' : ''}}" catchtap="toggleSubscribeType" data-type="announcement">
              <text class="sub-toggle-icon">📢</text>
              <text class="sub-toggle-name">公告</text>
              <view class="toggle {{subscribeConfig['announcement'] ? 'on' : ''}}"><view class="toggle-dot"></view></view>
            </view>
            <view class="sub-toggle-card {{subscribeConfig['activity'] ? 'active' : ''}}" catchtap="toggleSubscribeType" data-type="activity">
              <text class="sub-toggle-icon">📅</text>
              <text class="sub-toggle-name">活动</text>
              <view class="toggle {{subscribeConfig['activity'] ? 'on' : ''}}"><view class="toggle-dot"></view></view>
            </view>
            <view class="sub-toggle-card {{subscribeConfig['merchant'] ? 'active' : ''}}" catchtap="toggleSubscribeType" data-type="merchant">
              <text class="sub-toggle-icon">🛒</text>
              <text class="sub-toggle-name">商人</text>
              <view class="toggle {{subscribeConfig['merchant'] ? 'on' : ''}}"><view class="toggle-dot"></view></view>
            </view>
          </view>
        </view>

        <view class="sub-section">
          <view class="sub-section-title">
            <text class="sub-section-icon">🧪</text>
            <text>测试推送</text>
          </view>
          <view class="sub-test-grid">
            <view class="sub-test-btn" catchtap="testPush" data-type="announcement">
              <text class="sub-test-icon">📢</text>
              <text class="sub-test-text">测试公告</text>
            </view>
            <view class="sub-test-btn" catchtap="testPush" data-type="activity">
              <text class="sub-test-icon">📅</text>
              <text class="sub-test-text">测试活动</text>
            </view>
            <view class="sub-test-btn" catchtap="testPush" data-type="merchant">
              <text class="sub-test-icon">🛒</text>
              <text class="sub-test-text">测试商人</text>
            </view>
          </view>
        </view>

        <view class="sub-section">
          <view class="sub-section-title">
            <text class="sub-section-icon">👥</text>
            <text>订阅用户</text>
            <view class="sub-refresh-btn" catchtap="loadSubscribers"><text>刷新</text></view>
          </view>
          <view class="sub-user-list" wx:if="{{subscribers.length > 0}}">
            <view class="sub-user-item" wx:for="{{subscribers}}" wx:key="_id">
              <view class="sub-user-left">
                <view class="sub-user-type-tag {{item.type}}">{{item.type === 'announcement' ? '公告' : item.type === 'activity' ? '活动' : item.type === 'merchant' ? '商人' : (item.type === 'system' ? '系统' : (item.type === 'interaction' ? '互动' : item.type))}}</view>
                <view class="sub-user-info">
                  <text class="sub-user-count">订阅 {{item.count || 0}} 次</text>
                  <text class="sub-user-time">{{item.timeStr}}</text>
                </view>
              </view>
              <view class="sub-user-right">
                <view class="sub-user-status {{item.status === 'active' ? 'active' : 'expired'}}">{{item.status === 'active' ? '有效' : '过期'}}</view>
                <view class="sub-user-del" catchtap="deleteSubscriber" data-item="{{item}}">删除</view>
              </view>
            </view>
          </view>
          <view class="sub-empty" wx:if="{{subscribers.length === 0}}">
            <text class="sub-empty-text">暂无订阅用户</text>
          </view>
        </view>
      </view>



      <!-- 用户管理 -->
      <view wx:if="{{activeTab === 'users'}}">
        <view class="section-header"><text class="section-title">用户列表</text></view>
        <view class="card-item" wx:for="{{users}}" wx:key="_id">
          <view class="card-top">
            <image class="card-avatar" src="{{item.avatarUrl || '/images/default-avatar.png'}}" mode="aspectFill" />
            <view class="card-user-info">
              <text class="card-author">{{item.nickName}}</text>
              <text class="card-meta">Lv.{{item.level}} · 登录{{item.loginDays ? item.loginDays.length : 0}}天 · {{item.timeStr}}</text>
            </view>
            <view class="ban-tag {{item.banned ? 'banned' : ''}}">{{item.banned ? '已封禁' : '正常'}}</view>
          </view>
          <view class="card-bottom">
            <view class="card-actions">
              <view class="btn-edit" wx:if="{{!item.banned}}" bindtap="banUser" data-item="{{item}}">封禁</view>
              <view class="btn-edit" wx:if="{{item.banned}}" bindtap="unbanUser" data-item="{{item}}">解封</view>
              <view class="btn-edit" wx:if="{{item.role !== 'editor'}}" bindtap="setEditor" data-item="{{item}}">设为小编</view>
              <view class="btn-edit" wx:if="{{item.role === 'editor'}}" bindtap="removeEditor" data-item="{{item}}">取消小编</view>
              <view class="btn-delete" bindtap="deleteUser" data-item="{{item}}">删除</view>
            </view>
          </view>
        </view>
        <view class="empty" wx:if="{{users.length === 0}}"><text class="empty-text">暂无用户</text></view>
      </view>

      <!-- 页面管理 -->
      <view wx:if="{{activeTab === 'pages'}}">
        <view class="section-header"><text class="section-title">页面状态管理</text></view>
        <view class="card-item" wx:for="{{pageConfigs}}" wx:key="id">
          <view class="card-top">
            <view class="page-icon">{{item.icon}}</view>
            <view class="card-user-info">
              <text class="card-author">{{item.name}}</text>
              <text class="card-meta" wx:if="{{item.isNav}}">状态：{{item.maintenance ? '已隐藏' : '显示中'}}</text>
              <text class="card-meta" wx:else>状态：{{item.maintenance ? '维护中（已下线）' : '运行中'}}</text>
            </view>
            <view class="toggle {{item.maintenance ? 'on' : ''}}" catchtap="togglePageMaintenance" data-id="{{item.id}}">
              <view class="toggle-dot"></view>
            </view>
          </view>
          <view class="page-actions" wx:if="{{!item.isNav}}">
            <view class="btn-edit" catchtap="togglePageCustom" data-id="{{item.id}}">自定义：{{item.useCustom ? '开' : '关'}}</view>
          </view>
        </view>
      </view>
      <view class="card-item">
        <view class="card-top">
          <view class="page-icon">📷</view>
          <view class="card-user-info">
            <text class="card-author">捕捉统计生成图片</text>
            <text class="card-meta">状态：{{showLogShareBtn ? '已开启' : '已关闭'}}</text>
          </view>
          <view class="toggle {{showLogShareBtn ? 'on' : ''}}" catchtap="toggleShowLogShareBtn">
            <view class="toggle-dot"></view>
          </view>
        </view>
      </view>

      <!-- 统计面板 -->
      <view wx:if="{{activeTab === 'stats'}}">
        <view class="section-header"><text class="section-title">数据统计</text></view>
        <view class="stats-grid">
          <view class="stat-card">
            <text class="stat-num">{{stats.totalUsers}}</text>
            <text class="stat-label">总用户数</text>
          </view>
          <view class="stat-card">
            <text class="stat-num">{{announcements.length}}</text>
            <text class="stat-label">公告数量</text>
          </view>
        </view>
      </view>

      <!-- 出没预设管理 -->
      <view class="tab-content-pane" wx:if="{{activeTab === 'swarm'}}">
        <view class="section-header">
          <text class="section-title">大量出没地点预设</text>
          <view class="add-btn" bindtap="openSwarmLocationModal"><text>+ 添加</text></view>
        </view>
        <view class="card-item" wx:for="{{swarmLocations}}" wx:key="*this" style="display:flex; justify-content:space-between; align-items:center;">
          <text class="card-title" style="margin-bottom:0;">{{item}}</text>
          <view class="btn-delete" bindtap="deleteSwarmLocation" data-index="{{index}}" style="margin:0; padding:6rpx 16rpx; background:rgba(255,80,80,0.1); color:#ff5050; border-radius:10rpx; font-size:24rpx;">删除</view>
        </view>
        <view class="empty" wx:if="{{swarmLocations.length === 0}}"><text class="empty-text">暂无预设地点</text></view>
      </view>

      <!-- 系统设置面板 -->
      <view class="tab-content-pane" wx:if="{{activeTab === 'site'}}">
        <view class="section-header">
          <text class="section-title">系统设置</text>
        </view>
        <view class="form-card" style="padding: 32rpx; background: rgba(255,255,255,0.04); border-radius: 24rpx; border: 1rpx solid rgba(255,255,255,0.08); margin-bottom: 24rpx;">
          <view class="form-group">
            <text class="form-label" style="display: block; margin-bottom: 16rpx; color: rgba(255,255,255,0.7); font-size: 28rpx;">个人页Logo URL</text>
            <input class="form-input" style="width: 100%; box-sizing: border-box; background: rgba(0,0,0,0.2); border: 1rpx solid rgba(255,255,255,0.1); border-radius: 12rpx; padding: 20rpx; color: #fff;" placeholder="输入个人中心Logo的图片地址" value="{{siteConfig.loginLogoUrl}}" bindinput="onLoginLogoInput" />
            <text class="form-hint" style="display: block; margin-top: 12rpx; font-size: 22rpx; color: rgba(255,255,255,0.4);">留空则使用默认Logo，支持完整网络URL或cloud://云存储路径</text>
          </view>
          <view class="form-actions" style="margin-top: 40rpx;">
            <button class="btn-primary" style="width: 100%; height: 80rpx; background: rgba(0,200,255,0.12); color: #00d4ff; border: 1rpx solid rgba(0,200,255,0.2); border-radius: 40rpx; display: flex; align-items: center; justify-content: center; font-size: 28rpx;" bindtap="saveSiteConfig">保存设置</button>
          </view>
        </view>
      </view>
    </view>

    <!-- 发布/编辑弹窗 -->
    <view class="modal-mask" wx:if="{{showModal}}" bindtap="closeModal">
        <view class="modal-box" catchtap="preventClose">
        <view class="modal-header">
          <text class="modal-title">{{editingItem ? '编辑公告' : '发布公告'}}</text>
          <text class="modal-close" catchtap="closeModal">✕</text>
        </view>
        <view class="modal-body">
          <view class="form-group">
            <text class="form-label">类型</text>
            <picker class="form-picker" range="{{['公告', '更新', '活动', '提示']}}" bindchange="onTypeChange">
              <text class="picker-text">{{formType === 'notice' ? '公告' : formType === 'update' ? '更新' : formType === 'event' ? '活动' : '提示'}} ▾</text>
            </picker>
            </view>
            <view class="form-group" wx:if="{{formType === 'event'}}">
              <text class="form-label">活动板块</text>
              <picker class="form-picker" range="{{['常规', '赛季', '联动']}}" bindchange="onSubTypeChange">
                <text class="picker-text">{{formSubType === 'regular' ? '常规' : formSubType === 'season' ? '赛季' : formSubType === 'collab' ? '联动' : '常规'}} ▾</text>
              </picker>
            </view>
            <view class="form-group" wx:if="{{formType === 'event' && formSubType === 'collab'}}">
              <text class="form-label">联动Logo</text>
              <input class="form-input" placeholder-class="form-input-placeholder" placeholder="请输入联动品牌Logo URL (选填)" value="{{formCollabLogo}}" bindinput="onCollabLogoInput" />
            </view>
            <view class="form-group" wx:if="{{formType === 'event' && formSubType === 'collab'}}">
              <text class="form-label">联动封面</text>
              <input class="form-input" placeholder-class="form-input-placeholder" placeholder="请输入封面图片 URL (选填)" value="{{formCollabCover}}" bindinput="onCollabCoverInput" />
            </view>
          <view class="form-group">
            <text class="form-label">标题</text>
            <input class="form-input" placeholder-class="form-input-placeholder" placeholder="输入公告标题" value="{{formTitle}}" bindinput="onTitleInput" maxlength="50" />
          </view>
          <view class="form-group">
            <view class="form-label-row">
              <text class="form-label">内容</text>
            </view>
            
            <!-- 富文本编辑工具栏 -->
            <view class="rich-toolbar">
              <view class="toolbar-row">
                                  <view class="tool-btn" catchtap="undo">
                    <text class="tool-icon">↩️</text>
                  </view>
                  <view class="tool-btn {{currentAlign === 'left' ? 'active' : ''}}" catchtap="alignLeft">
                    <text class="tool-icon" style="font-size:24rpx;">居左</text>
                  </view>
                  <view class="tool-btn {{currentAlign === 'center' ? 'active' : ''}}" catchtap="alignCenter">
                    <text class="tool-icon" style="font-size:24rpx;">居中</text>
                  </view>
                  <view class="tool-btn {{currentAlign === 'right' ? 'active' : ''}}" catchtap="alignRight">
                    <text class="tool-icon" style="font-size:24rpx;">居右</text>
                  </view>

                  <view class="tool-btn {{currentFontWeight === 'bold' ? 'active' : ''}}" catchtap="toggleBold">
                  <text class="tool-icon" style="font-weight:bold;">B</text>
                </view>
                                  <view class="tool-btn {{currentUnderline ? 'active' : ''}}" catchtap="toggleUnderline">
                    <text class="tool-icon" style="text-decoration:underline;">U</text>
                  </view>
                  <view class="tool-btn {{currentStrike ? 'active' : ''}}" catchtap="toggleStrike">
                    <text class="tool-icon" style="text-decoration:line-through;">S</text>
                  </view>
                  <view class="tool-btn {{currentHeader === 2 ? 'active' : ''}}" catchtap="toggleHeader2">
                    <text class="tool-icon" style="font-weight:bold;">H2</text>
                  </view>
                  <view class="tool-btn {{currentHeader === 3 ? 'active' : ''}}" catchtap="toggleHeader3">
                    <text class="tool-icon" style="font-weight:bold;">H3</text>
                  </view>
                  <view class="tool-btn {{currentFontStyle === 'italic' ? 'active' : ''}}" catchtap="toggleItalic">
                  <text class="tool-icon" style="font-style:italic;">I</text>
                </view>
                <view class="tool-btn" catchtap="showFontSizePicker">
                  <text class="tool-icon">Aa</text>
                </view>
                <view class="tool-btn" catchtap="showFontColorPicker">
                  <view class="color-preview" style="background:{{currentFontColor}};"></view>
                </view>
                <view class="tool-btn" catchtap="showFontFamilyPicker">
                  <text class="tool-icon">𝐓</text>
                  <text class="tool-text">字体</text>
                </view>
                <view class="tool-btn" catchtap="addRichQuoteBlock">
                  <text class="tool-icon">❝</text>
                  <text class="tool-text">引用</text>
                </view>
                <view class="tool-btn" catchtap="showMusicDialog">
                  <text class="tool-icon">🎵</text>
                  <text class="tool-text">音乐</text>
                </view>
                <view class="tool-btn" catchtap="showVideoDialog">
                  <text class="tool-icon">🎬</text>
                  <text class="tool-text">视频</text>
                </view>
                <view class="tool-btn" catchtap="importFileToTable">
                  <text class="tool-icon">📊</text>
                  <text class="tool-text">表格</text>
                </view>
                <view class="tool-btn" catchtap="showAttachmentDialog">
                  <text class="tool-icon">📎</text>
                  <text class="tool-text">附件</text>
                </view>
                <view class="tool-btn" catchtap="showImageBlockDialog">
                  <text class="tool-icon">🖼️</text>
                  <text class="tool-text">正文插图</text>
                </view>
                <view class="tool-btn" catchtap="showSwiperDialog">
