<view class="page">
  <view class="container">
    <!-- 首页大图 -->
    <view class="hero-banner" bindtap="{{isAdmin ? 'toggleBannerModal' : ''}}">
      <block wx:if="{{bannerUrls && bannerUrls.length > 1}}">
        <swiper class="hero-swiper" indicator-dots="true" autoplay="true" interval="4000" duration="500" circular="true">
          <swiper-item wx:for="{{bannerUrls}}" wx:key="index">
            <image lazy-load class="hero-image" src="{{item}}" mode="aspectFit"></image>
          </swiper-item>
        </swiper>
      </block>
      <block wx:else>
        <image lazy-load class="hero-image" src="{{bannerUrls && bannerUrls.length === 1 ? bannerUrls[0] : (bannerUrl || '/images/banner.webp')}}" mode="widthFix"></image>
      </block>
      <view class="hero-overlay"></view>
      <view class="hero-badge" wx:if="{{isAdmin}}">
        <text class="hero-badge-icon">✏️</text>
      </view>
    </view>

    <!-- 头图编辑弹窗 -->
    <view class="modal-mask" wx:if="{{showBannerModal}}" bindtap="toggleBannerModal">
      <view class="modal-box banner-modal" catchtap="preventClose">
        <view class="modal-header">
          <view class="modal-title-box">
            <view class="modal-title-line"></view>
            <text class="modal-title">编辑首页头图</text>
          </view>
          <text class="modal-close" catchtap="toggleBannerModal">✕</text>
        </view>
        <view class="modal-body">
          <view class="banner-preview-label">效果预览</view>
          <view class="banner-preview" wx:if="{{bannerInput}}">
            <image lazy-load class="preview-img" src="{{bannerInput}}" mode="aspectFill" />
            <view class="preview-mask">
              <text class="preview-text">PREVIEW</text>
            </view>
          </view>
          <view class="banner-preview empty" wx:else>
            <text>暂无预览图片</text>
          </view>

          <view class="banner-form">
            <view class="form-label">上传图片</view>
              <view class="input-group" style="align-items: flex-start;">
                <view class="input-icon" style="margin-top: 20rpx;">🔗</view>
                <textarea class="banner-input" style="height: 160rpx; padding: 20rpx 0; line-height: 1.5;" placeholder="单图输入单个URL；滚动图请每行输入一个URL，回车换行" placeholder-style="color:rgba(255,255,255,0.25)" value="{{bannerInput}}" bindinput="onBannerInput" maxlength="-1"></textarea>
              </view>
            </view>
          </view>
        <view class="modal-footer">
          <button class="modal-cancel" catchtap="toggleBannerModal">取消</button>
          <button class="modal-save" catchtap="saveBanner" disabled="{{bannerSaving}}">
            <text>{{bannerSaving ? '正在提交...' : '确认更新头图'}}</text>
          </button>
        </view>
      </view>
    </view>

    <!-- 快捷入口 -->
    <view class="quick-nav-card">
      <view class="quick-nav-header">
        <text class="quick-nav-icon">⚡</text>
        <text class="quick-nav-title">快捷入口</text>
      </view>
      <view class="quick-nav-grid">
        <view class="nav-item" bindtap="go" data-url="/pages/egg/egg">
          <view class="nav-icon-wrap blue">
            <text class="nav-icon">🥚</text>
          </view>
          <text class="nav-text">孵蛋查询</text>
        </view>
        <view class="nav-item" bindtap="go" data-url="/pages/merchant/merchant">
          <view class="nav-icon-wrap orange">
            <text class="nav-icon">🛒</text>
          </view>
          <text class="nav-text">远行商人</text>
        </view>
        <view class="nav-item" bindtap="go" data-url="/pages/activity/activity">
          <view class="nav-icon-wrap pink">
            <text class="nav-icon">📅</text>
          </view>
          <text class="nav-text">活动日历</text>
        </view>
        <view class="nav-item" bindtap="go" data-url="/pages/catch/catch">
          <view class="nav-icon-wrap green">
            <text class="nav-icon">🎯</text>
          </view>
          <text class="nav-text">捕捉统计</text>
        </view>
        <view class="nav-item" bindtap="go" data-url="/pages/about/about">
          <view class="nav-icon-wrap purple">
            <text class="nav-icon">ℹ️</text>
          </view>
          <text class="nav-text">关于我们</text>
        </view>
        <view class="nav-item" bindtap="go" data-url="/pages/redeem/redeem">
          <view class="nav-icon-wrap red">
            <text class="nav-icon">🎫</text>
          </view>
          <text class="nav-text">兑换码</text>
        </view>
        <view class="nav-item" bindtap="go" data-url="/pages/map/map">
          <view class="nav-icon-wrap cyan">
            <text class="nav-icon">🗺️</text>
          </view>
          <text class="nav-text">洛手地图</text>
        </view>
        <view class="nav-item" bindtap="go" data-url="/pages/swarm/swarm">
          <view class="nav-icon-wrap yellow">
            <text class="nav-icon">💥</text>
          </view>
          <text class="nav-text">大量出没</text>
        </view>
      </view>
    </view>

    <!-- 公告栏 -->
    <view class="announce-card" wx:if="{{announcements.length > 0 || isAdmin}}">
      <view class="announce-card-header">
        <view class="announce-header-left">
          <view class="announce-header-icon-wrap">
            <text class="announce-header-icon">📢</text>
          </view>
          <text class="announce-header-title">公告通知</text>
        </view>
        <view class="announce-count-pill" wx:if="{{announcements.length > 1}}">
          <text class="count-text">{{announcements.length}}条</text>
        </view>
      </view>
      <!-- 有公告 -->
      <view wx:if="{{announcements.length > 0}}" class="announce-list">
        <view class="announce-item {{expandedIndex === index ? 'expanded' : ''}}" wx:for="{{announcements}}" wx:key="_id">
          <view class="announce-header" bindtap="showAnnouncement" data-i="{{index}}">
            <view class="announce-tag {{item.pinned ? 'pinned' : item.type}}">{{item.pinned ? '置顶' : (item.typeLabel || (item.type === 'notice' ? '公告' : item.type === 'update' ? '更新' : item.type === 'event' ? '活动' : '提示'))}}</view>
            <text class="announce-title">{{item.title}}</text>
            <text class="announce-time">{{item.timeStr}}</text>
            <view class="announce-arrow {{expandedIndex === index ? 'up' : ''}}">›</view>
          </view>
          <view class="announce-body" wx:if="{{expandedIndex === index}}">
            <text class="announce-auto-delete" wx:if="{{item.autoDeleteDisplay}}">{{item.autoDeleteDisplay}}</text>
            <scroll-view class="announce-content" scroll-y>
              <!-- 编辑器文本内容 -->
              <view wx:if="{{item.content && (!item.richContent || item.richContent.length === 0)}}" class="news-detail-rich">
                <rich-text nodes="{{item.content}}" />
              </view>
              <!-- 富文本内容 -->
              <block wx:if="{{item.richContent && item.richContent.length > 0}}">
                <block wx:for="{{item.richContent}}" wx:for-item="block" wx:key="index">
                  <!-- 音乐 -->
                  <view wx:if="{{block.type === 'music'}}" class="rich-music-block {{currentPlayUrl === block.url && isPlaying ? 'playing' : ''}}" catchtap="playSong" data-url="{{block.url}}" data-name="{{block.name || '推荐单曲'}}" data-cover="{{block.cover || ''}}">
                    <image lazy-load wx:if="{{block.cover}}" class="music-cover" src="{{block.cover}}" mode="aspectFill" />
                    <text class="music-icon {{currentPlayUrl === block.url && isPlaying ? 'rotating' : ''}}">🎵</text>
                    <view class="music-info">
                      <text class="music-name">{{block.name || '推荐单曲'}}</text>
                      <text class="music-url">{{block.url}}</text>
                    </view>
                    <text class="music-play-btn">{{currentPlayUrl === block.url && isPlaying ? '暂停' : '点我听歌'}}</text>
                  </view>
                  <!-- 视频 -->
                  <view wx:elif="{{block.type === 'video' && block.isDirectMp4}}" class="rich-video-inline">
                    <video class="video-player-video" src="{{block.url}}" controls show-center-play-btn object-fit="contain" style="width:100%; border-radius:12rpx; margin-top:10rpx;" />
                  </view>
                  <view wx:elif="{{block.type === 'video'}}" class="rich-video-block" catchtap="openVideo" data-url="{{block.url}}" data-name="{{block.name || '视频'}}">
                    <image lazy-load wx:if="{{block.cover}}" src="{{block.cover}}" mode="aspectFill" style="width: 96rpx; height: 72rpx; border-radius: 12rpx; margin-right: 24rpx; flex-shrink: 0; background: rgba(255,255,255,0.05);" />
                    <text wx:else class="video-icon">
                      <block wx:if="{{block.platform === 'bilibili'}}">📺</block>
                      <block wx:elif="{{block.platform === 'weibo'}}">🎬</block>
                      <block wx:elif="{{block.platform === 'douyin'}}">🎵</block>
                      <block wx:elif="{{block.platform === 'kuaishou'}}">📹</block>
                      <block wx:elif="{{block.platform === 'tencent'}}">📽️</block>
                      <block wx:elif="{{block.platform === 'xiaohongshu'}}">📕</block>
                      <block wx:elif="{{block.platform === 'youtube'}}">🔴</block>
                      <block wx:else>🎥</block>
                    </text>
                    <view class="video-info">
                      <text class="video-name">{{block.name || block.platformName + '视频'}}</text>
                      <text class="video-platform">{{block.platformName || '在线视频'}}</text>
                    </view>
                    <text class="video-play-btn">▶ 观看</text>
                  </view>
                  <!-- 表格 -->
                  <view wx:elif="{{block.type === 'table'}}" class="rich-table-block">
                    <view class="rich-table">
                      <view class="rich-table-row rich-table-header">
                        <view class="rich-table-cell" wx:for="{{block.headers}}" wx:key="index">{{item}}</view>
                      </view>
                      <view class="rich-table-row" wx:for="{{block.rows}}" wx:for-item="row" wx:key="index">
                        <view class="rich-table-cell" wx:for="{{row}}" wx:for-item="cell" wx:key="index">{{cell}}</view>
                      </view>
                    </view>
                  </view>
                  <!-- 滚动图片 -->
                  <view wx:elif="{{block.type === 'swiper'}}" class="rich-swiper-block">
                    <swiper indicator-dots="true" indicator-active-color="#00d4ff" indicator-color="rgba(255,255,255,0.3)" autoplay="true" circular="true" interval="4000" class="rich-swiper">
                      <swiper-item wx:for="{{block.urls}}" wx:for-item="url" wx:for-index="ui" wx:key="ui">
                        <image src="{{url}}" mode="aspectFit" class="rich-swiper-image" catchtap="previewRichImage" data-src="{{url}}"></image>
                      </swiper-item>
                    </swiper>
                  </view>
                  <!-- 图片 -->
                  <view wx:elif="{{block.type === 'image'}}" class="rich-image-block" catchtap="previewRichImage" data-src="{{block.url}}">
                    <image class="rich-image" src="{{block.url}}" mode="widthFix" lazy-load="true" webp="true" show-menu-by-longpress="true" />
                  </view>
                  <!-- 分割线 -->
                  <view wx:elif="{{block.type === 'divider'}}" class="divider-block">
                    <view class="divider-line {{block.style}}"></view>
                  </view>
                  <!-- 链接 -->
                  <view wx:elif="{{block.type === 'link' && block.isVideo}}" class="rich-link-block video-link" catchtap="openVideo" data-url="{{block.url}}" data-name="{{block.text}}">
                    <text class="link-icon">📺</text>
                    <text class="link-text">{{block.text}}</text>
                    <text class="link-badge">点击观看</text>
                  </view>
                  <view wx:elif="{{block.type === 'link'}}" class="rich-link-block" catchtap="openLink" data-url="{{block.url}}" data-text="{{block.text}}">
                    <text class="link-icon">🔗</text>
                    <text class="link-text">{{block.text}}</text>
                    <text class="link-badge">点击复制</text>
                  </view>
                  <!-- 附件 -->
                  <view wx:elif="{{block.type === 'attachment'}}" class="rich-link-block attachment-link" catchtap="downloadAttachment" data-url="{{block.url}}" data-name="{{block.name}}" data-size="{{block.sizeText}}">
                    <text class="link-icon">📎</text>
                    <text class="link-text">{{block.name}} ({{block.sizeText}})</text>
                    <text class="link-badge">下载预览</text>
                  </view>
                  <!-- 引用 -->
                  <view wx:elif="{{block.type === 'quote'}}" class="rich-quote-block">
                    <text class="quote-text">{{block.content}}</text>
                  </view>
                  <!-- 普通文本 -->
                  <view wx:else class="rich-text-block" style="font-size:{{block.size}}rpx;color:{{block.color}};font-weight:{{block.weight || 'normal'}};font-style:{{block.style || 'normal'}};{{block.fontFamily && block.fontFamily !== 'sans-serif' ? 'font-family:' + block.fontFamily + ';' : ''}}">
                    <rich-text nodes="{{block.html || block.content}}" />
                  </view>
                </block>
              </block>
            </scroll-view>
            <!-- 来源 -->
            <view class="announce-source" wx:if="{{item.source}}">
              <text>来源：{{item.source}}</text>
            </view>

          </view>
        </view>
      </view>
      <!-- 无公告 -->
      <view class="empty-notice" wx:if="{{announcements.length === 0 && isAdmin}}">
        <view class="empty-icon-wrap">
          <text class="empty-icon">📭</text>
        </view>
        <text class="empty-notice-text">暂无公告</text>
        <view class="empty-notice-btn" bindtap="goAdmin">
          <text class="btn-icon">✏️</text>
          <text class="btn-text">去发布</text>
        </view>
      </view>
    </view>

    <view class="foot">
      <text wx:if="{{icp}}">{{icp}}</text>
    </view>
  </view>

  <!-- 视频播放器 -->
  <view class="modal-mask" wx:if="{{showVideoPlayer}}" catchtap="closeVideoPlayer" style="z-index:10000;">
    <view class="modal-box video-player-box" catchtap="preventClose">
      <view class="video-player-header">
        <text class="video-player-title">{{videoPlayerName}}</text>
        <text class="modal-close" catchtap="closeVideoPlayer">✕</text>
      </view>
      <view class="video-player-owner" wx:if="{{videoPlayerOwner}}">
        <view class="video-player-owner-bar"></view>
        <text class="video-player-owner-text">UP主: {{videoPlayerOwner}}</text>
      </view>
      <video class="video-player-video" src="{{videoPlayerUrl}}" controls autoplay show-center-play-btn object-fit="contain" />
      <scroll-view scroll-y class="video-player-desc" wx:if="{{videoPlayerDesc}}">
        <text class="video-player-desc-text" space="ensp" decode="true">{{videoPlayerDesc}}</text>
      </scroll-view>
    </view>
  </view>

  <dock current="index" />
</view>