<view class="page {{padLayoutClass}}">
  <!-- Repo Header -->
  <view class="repo-header">
    <view class="repo-header-top">
      <text class="repo-owner" bindtap="goAbout">{{_l.appName}}</text>
      <text class="repo-sep">/</text>
      <text class="repo-name">rorkingdom-guide</text>
      <view class="repo-visibility">Public</view>
    </view>
    <view class="repo-tabs">
      <view class="repo-tab active"><text class="repo-tab-icon">📋</text>{{_l.announceTab}}</view>
      <view class="repo-tab" bindtap="goAdmin" wx:if="{{isAdmin}}"><text class="repo-tab-icon">⚙</text>{{_l.adminTab}}</view>
      <view class="repo-tab" bindtap="go" data-url="/pages/about/about"><text class="repo-tab-icon">ℹ</text>{{_l.aboutTab}}</view>
      <view class="repo-lang-bar">
        <view class="lang-btn {{currentLang === 'zh' ? 'active' : ''}}" bindtap="switchLang" data-lang="zh">
          <image class="lang-flag" src="https://www.emojiall.com/images/60/twitter/1f1e8-1f1f3.png" mode="aspectFit" />
        </view>
        <view class="lang-sep">|</view>
        <view class="lang-btn {{currentLang === 'ja' ? 'active' : ''}}" bindtap="switchLang" data-lang="ja">
          <image class="lang-flag" src="https://www.emojiall.com/images/60/twitter/1f1ef-1f1f5.png" mode="aspectFit" />
        </view>
        <view class="lang-sep">|</view>
        <view class="lang-btn {{currentLang === 'ko' ? 'active' : ''}}" bindtap="switchLang" data-lang="ko">
          <image class="lang-flag" src="https://www.emojiall.com/images/60/twitter/1f1f0-1f1f7.png" mode="aspectFit" />
        </view>
        <view class="lang-sep">|</view>
        <view class="lang-btn {{currentLang === 'en' ? 'active' : ''}}" bindtap="switchLang" data-lang="en">
          <image class="lang-flag" src="https://www.emojiall.com/images/60/twitter/1f1fa-1f1f8.png" mode="aspectFit" />
        </view>
      </view>
    </view>
  </view>

  <!-- Hero Banner：多图自动轮播，无指示点；编辑入口在管理后台-页面管理 -->
  <view class="hero-section" wx:if="{{bannerUrl || (bannerUrls && bannerUrls.length > 0)}}">
    <block wx:if="{{bannerUrls && bannerUrls.length > 1}}">
      <swiper class="hero-swiper" autoplay="true" interval="4000" duration="500" circular="true" style="height: {{heroSwiperH > 0 ? heroSwiperH + 'rpx' : 'auto'}};">
        <swiper-item wx:for="{{bannerUrls}}" wx:key="index">
          <image lazy-load class="hero-image" src="{{item}}" mode="widthFix" bindload="onHeroBannerLoad"></image>
        </swiper-item>
      </swiper>
    </block>
    <block wx:else>
      <image lazy-load class="hero-image" src="{{bannerUrl}}" mode="widthFix"></image>
    </block>
  </view>

  <!-- Quick Nav -->
  <view class="quick-nav">
    <view class="nav-item" bindtap="go" data-url="/pages/merchant/merchant">
      <text class="nav-emoji">🛒</text>
      <text class="nav-label">{{_l.merchant}}</text>
    </view>
    <view class="nav-item" bindtap="go" data-url="/pages/activity/activity">
      <text class="nav-emoji">📅</text>
      <text class="nav-label">{{_l.activityCalendar}}</text>
    </view>
    <view class="nav-item" bindtap="go" data-url="/pages/catch/catch">
      <text class="nav-emoji">🎯</text>
      <text class="nav-label">{{_l.catchStats}}</text>
    </view>
    <view class="nav-item" bindtap="go" data-url="/pages/redeem/redeem">
      <text class="nav-emoji">🎫</text>
      <text class="nav-label">{{_l.redeem}}</text>
    </view>
    <view class="nav-item" bindtap="go" data-url="/pages/map/map">
      <text class="nav-emoji">🗺️</text>
      <text class="nav-label">{{_l.map}}</text>
    </view>
    <view class="nav-item" bindtap="go" data-url="/pages/swarm/swarm">
      <text class="nav-emoji">💥</text>
      <text class="nav-label">{{_l.swarm}}</text>
    </view>
  </view>

  <!-- Announcements Feed -->
  <view class="feed-section">
    <view class="feed-header">
      <text class="feed-title">ROCOKINGDOM{{_l.announcements}}</text>
      <view class="feed-header-right">
        <text class="feed-count" wx:if="{{announcements.length > 0}}">{{announcements.length}}{{_l.unitItems}}</text>
        <text class="feed-sub {{subscribedAnnouncement ? 'active' : ''}}" catchtap="subscribeAnnouncement">{{subscribedAnnouncement ? _l.subscribed + '(' + subscribeCount + '/99)' : _l.subscribeAdd}}</text>
      </view>
    </view>

    <!-- Announcement list -->
    <view wx:if="{{announcements.length > 0}}" class="feed-list">
      <view class="feed-item {{expandedIndex === index ? 'expanded' : ''}}" wx:for="{{announcements}}" wx:key="_id">
        <view class="feed-item-header" bindtap="showAnnouncement" data-i="{{index}}">
          <view class="feed-item-left">
            <view class="feed-badge {{item.pinned ? 'pinned' : item.type}}">{{item.pinned ? _l.pinned : (item.typeLabel || (item.type === 'notice' ? _l.announceTab : item.type === 'update' ? _l.update : item.type === 'event' ? _l.activityCalendar : _l.tip))}}</view>
            <text class="feed-item-title">{{item.title}}</text>
          </view>
          <view class="feed-item-right">
            <text class="feed-time">{{item.timeStr}}</text>
            <text class="feed-arrow {{expandedIndex === index ? 'up' : ''}}">▸</text>
          </view>
        </view>
        <!-- Expanded content -->
        <view class="feed-item-body" wx:if="{{expandedIndex === index}}">
          <text class="feed-auto-delete" wx:if="{{countdowns[index]}}">{{countdowns[index]}}</text>
          <view class="feed-content">
            <view wx:if="{{item.content && (!item.richContent || item.richContent.length === 0)}}" class="news-detail-rich">
              <rich-text nodes="{{item.content}}" />
            </view>
            <block wx:if="{{item.richContent && item.richContent.length > 0}}">
              <block wx:for="{{item.richContent}}" wx:for-item="block" wx:key="index">
                <view wx:if="{{block.type === 'music'}}" class="rich-music-block {{currentPlayUrl === block.url && isPlaying ? 'playing' : ''}}" catchtap="playSong" data-url="{{block.url}}" data-name="{{block.name || _l.music}}" data-cover="{{block.cover || ''}}">
                  <image lazy-load wx:if="{{block.cover}}" class="music-cover" src="{{block.cover}}" mode="aspectFill" />
                  <text class="music-icon {{currentPlayUrl === block.url && isPlaying ? 'rotating' : ''}}">🎵</text>
                  <view class="music-info">
                    <text class="music-name">{{block.name || _l.music}}</text>
                    <text class="music-url">{{block.url}}</text>
                  </view>
                  <view class="music-eq">
                    <view></view>
                    <view></view>
                    <view></view>
                  </view>
                  <text class="music-play-btn">{{currentPlayUrl === block.url && isPlaying ? '⏸' : '▶'}}</text>
                </view>
                <view wx:elif="{{block.type === 'video' && block.isDirectMp4}}" class="rich-video-inline">
                  <video class="rich-inline-video" src="{{block.url}}" controls show-center-play-btn object-fit="contain" />
                </view>
                <view wx:elif="{{block.type === 'video'}}" class="rich-video-block" catchtap="openVideo" data-url="{{block.url}}" data-name="{{block.name || _l.video}}">
                  <image lazy-load wx:if="{{block.cover}}" class="video-thumb" src="{{block.cover}}" mode="aspectFill" />
                  <text wx:else class="video-icon">🎥</text>
                  <view class="video-info">
                    <text class="video-name">{{block.name || _l.video}}</text>
                    <text class="video-platform">{{block.platformName || _l.onlineVideo}}</text>
                  </view>
                  <text class="video-play-btn">▶</text>
                </view>
                <view wx:elif="{{block.type === 'table'}}" class="rich-table-block">
                  <view class="rich-table">
                    <view class="rich-table-row rich-table-header">
                      <view class="rich-table-cell" wx:for="{{block.headers}}" wx:key="index">{{item}}</view>
                    </view>
                    <view class="rich-table-row" wx:for="{{block.rows}}" wx:for-item="row" wx:key="index">
                      <view class="rich-table-cell" wx:for="{{row}}" wx:for-item="cell" wx:key="index">{{cell}}</view>
                    </view>
                  </view>
                </view>
                <view wx:elif="{{block.type === 'swiper'}}" class="rich-swiper-block">
                  <swiper autoplay="true" circular="true" interval="4000" class="rich-swiper" style="height: {{richSwiperHeights[item._id + '_' + index] || 0}}rpx;">
                    <swiper-item wx:for="{{block.urls}}" wx:for-item="url" wx:for-index="ui" wx:key="ui">
                      <image src="{{url}}" mode="widthFix" class="rich-swiper-image" catchtap="previewRichImage" data-src="{{url}}" bindload="onRichSwiperLoad" data-hkey="{{item._id}}_{{index}}" />
                    </swiper-item>
                  </swiper>
                </view>
                <view wx:elif="{{block.type === 'image'}}" class="rich-image-block" catchtap="previewRichImage" data-src="{{block.url}}">
                  <image class="rich-image" src="{{block.url}}" mode="widthFix" lazy-load="true" webp="true" show-menu-by-longpress="true" />
                </view>
                <view wx:elif="{{block.type === 'divider'}}" class="divider-block">
                  <view class="divider-line {{block.style}}"></view>
                </view>
                <view wx:elif="{{block.type === 'link' && block.isVideo}}" class="rich-link-block video-link" catchtap="openVideo" data-url="{{block.url}}" data-name="{{block.text}}">
                  <text class="link-icon">📺</text>
                  <text class="link-text">{{block.text}}</text>
                  <text class="link-badge">{{_l.watch}}</text>
                </view>
                <view wx:elif="{{block.type === 'link'}}" class="rich-link-block" catchtap="openLink" data-url="{{block.url}}" data-text="{{block.text}}">
                  <text class="link-icon">🔗</text>
                  <text class="link-text">{{block.text}}</text>
                  <text class="link-badge">{{_l.copy}}</text>
                </view>
                <view wx:elif="{{block.type === 'attachment'}}" class="rich-link-block attachment-link" catchtap="downloadAttachment" data-url="{{block.url}}" data-name="{{block.name}}" data-size="{{block.sizeText}}">
                  <text class="link-icon">📎</text>
                  <text class="link-text">{{block.name}} ({{block.sizeText}})</text>
                  <text class="link-badge">{{_l.download}}</text>
                </view>
                <view wx:elif="{{block.type === 'quote'}}" class="rich-quote-block">
                  <text class="quote-text">{{block.content}}</text>
                </view>
                <view wx:else class="rich-text-block" style="font-size:{{block.size}}rpx;color:{{block.color}};font-weight:{{block.weight || 'normal'}};font-style:{{block.style || 'normal'}};{{block.fontFamily && block.fontFamily !== 'sans-serif' ? 'font-family:' + block.fontFamily + ';' : ''}}">
                  <rich-text nodes="{{block.html || block.content}}" />
                </view>
              </block>
            </block>
          </view>
          <view class="feed-source" wx:if="{{item.source}}">
            <text>{{_l.sourceLabel}}{{item.source}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- Empty state -->
    <view class="feed-empty" wx:if="{{announcements.length === 0 && isAdmin}}">
      <text class="feed-empty-icon">📭</text>
      <text class="feed-empty-text">{{_l.noAnnounce}}</text>
      <view class="feed-empty-btn" bindtap="goAdmin">
        <text class="btn-text">{{_l.publish}}</text>
      </view>
    </view>
  </view>

  <!-- 远行商人 -->
  <view class="panel merchant-panel" wx:if="{{merchantCard}}">
    <view class="panel-header">
      <view class="panel-header-left">
        <view class="panel-bar merchant"></view>
        <text class="panel-title">{{_l.merchantTitle || '远行商人'}}</text>
        <text class="panel-badge merchant" wx:if="{{merchantCard.badge}}">{{merchantCard.badge}}</text>
      </view>
      <view class="panel-header-right">
        <text class="panel-count" wx:if="{{merchantCard.items.length}}">{{merchantCard.items.length}}{{_l.unitItems || '件'}}</text>
        <text class="sub-btn {{subscribedMerchant ? 'on' : ''}}" catchtap="subscribeMerchantFeed">{{subscribedMerchant ? _l.subscribed : _l.subscribeAdd}}</text>
      </view>
    </view>

    <view class="panel-body" bindtap="go" data-url="/pages/merchant/merchant">
      <!-- 空态 / 维护中 -->
      <view class="panel-empty" wx:if="{{!merchantCard.items.length}}">
        <text class="panel-empty-text">{{merchantCard.desc || _l.broadcastMaintain || '运营数据维护中'}}</text>
      </view>

      <!-- 商品列表 -->
      <view class="goods-list" wx:if="{{merchantCard.items.length}}">
        <!-- 常规商品 -->
        <view class="goods-group" wx:if="{{merchantCard.normalItems.length}}">
          <view class="goods-group-header">
            <text class="goods-group-title">常规商品</text>
            <text class="goods-group-time" wx:if="{{merchantCard.normalOfflineLabel || merchantCard.normalCountdown}}">
              <text wx:if="{{merchantCard.normalOfflineLabel}}">下架 {{merchantCard.normalOfflineLabel}}</text>
              <text wx:if="{{merchantCard.normalCountdown}}" class="goods-group-remain"> · {{merchantCard.normalCountdown}}</text>
            </text>
          </view>
          <view class="goods-row {{expandedGoodsIndex === ('m_' + gi) ? 'open' : ''}}" wx:for="{{merchantCard.normalItems}}" wx:for-item="g" wx:for-index="gi" wx:key="gi" catchtap="toggleBroadcastGoods" data-key="m_{{gi}}">
            <image wx:if="{{g.image}}" class="goods-thumb" src="{{g.image}}" mode="aspectFill" />
            <view wx:else class="goods-thumb goods-thumb-empty"></view>
            <view class="goods-info">
              <view class="goods-title-line">
                <text class="goods-name">{{g.name}}</text>
                <text class="goods-limit" wx:if="{{g.limitCount}}">限{{g.limitCount}}</text>
              </view>
              <text class="goods-effect" wx:if="{{g.effect}}">{{g.effect}}</text>
              <text class="goods-offline" wx:if="{{g.remainText}}">⏳ {{g.remainText}}</text>
            </view>
            <view class="goods-price">
              <image class="roco-icon" src="https://patchwiki.biligame.com/images/nrc/1/10/blxvp7k90uq3p8prz24feerler3yfsi.png" mode="aspectFit" />
              <text class="goods-price-num">{{g.price}}</text>
            </view>
          </view>
        </view>

        <!-- 限时商品 -->
        <view class="goods-group" wx:if="{{merchantCard.limitedItems.length}}">
          <view class="goods-group-header">
            <text class="goods-group-title">限时商品</text>
            <text class="goods-group-time">单独计时下架</text>
          </view>
          <view class="goods-row {{expandedGoodsIndex === ('m_' + gi) ? 'open' : ''}}" wx:for="{{merchantCard.limitedItems}}" wx:for-item="g" wx:for-index="gi" wx:key="gi" catchtap="toggleBroadcastGoods" data-key="lm_{{gi}}">
            <image wx:if="{{g.image}}" class="goods-thumb" src="{{g.image}}" mode="aspectFill" />
            <view wx:else class="goods-thumb goods-thumb-empty"></view>
            <view class="goods-info">
              <view class="goods-title-line">
                <text class="goods-name">{{g.name}}</text>
                <text class="goods-limit" wx:if="{{g.limitCount}}">限{{g.limitCount}}</text>
                <text class="goods-time-tag">限时</text>
              </view>
              <text class="goods-effect" wx:if="{{g.effect}}">{{g.effect}}</text>
              <text class="goods-offline" wx:if="{{g.offlineLabel || g.remainText}}">
                <text wx:if="{{g.offlineLabel}}">⏳ {{g.offlineLabel}}</text>
                <text wx:if="{{g.remainText}}" class="goods-offline-remain"> · {{g.remainText}}</text>
              </text>
            </view>
            <view class="goods-price">
              <image class="roco-icon" src="https://patchwiki.biligame.com/images/nrc/1/10/blxvp7k90uq3p8prz24feerler3yfsi.png" mode="aspectFit" />
              <text class="goods-price-num">{{g.price}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 大量出没：只展示最新一条 -->
  <view class="panel swarm-panel" wx:if="{{swarmItem}}">
    <view class="panel-header">
      <view class="panel-header-left">
        <view class="panel-bar swarm"></view>
        <text class="panel-title">{{_l.swarm || '大量出没'}}</text>
        <text class="panel-badge {{swarmItem.active ? 'swarm-on' : 'swarm-soon'}}">{{swarmItem.badge}}</text>
      </view>
      <view class="panel-header-right">
        <text class="sub-btn {{subscribedSwarm ? 'on' : ''}}" catchtap="subscribeSwarmFeed">{{subscribedSwarm ? _l.subscribed : _l.subscribeAdd}}</text>
      </view>
    </view>

    <view class="panel-body swarm-body" bindtap="go" data-url="/pages/swarm/swarm">
      <view class="swarm-hero">
        <view class="swarm-hero-img-wrap" wx:if="{{swarmItem.image || (swarmItem.images && swarmItem.images.length > 1)}}">
          <swiper class="swarm-hero-img" wx:if="{{swarmItem.images.length > 1}}" autoplay circular interval="3200">
            <swiper-item wx:for="{{swarmItem.images}}" wx:for-item="img" wx:for-index="ii" wx:key="ii">
              <image class="swarm-hero-img" src="{{img}}" mode="aspectFill" />
            </swiper-item>
          </swiper>
          <image wx:elif="{{swarmItem.image}}" class="swarm-hero-img" src="{{swarmItem.image}}" mode="aspectFill" />
        </view>
        <view class="swarm-hero-info">
          <text class="swarm-hero-name">{{swarmItem.name}}</text>
          <text class="swarm-hero-loc" wx:if="{{swarmItem.location}}">{{swarmItem.location}}</text>
          <text class="swarm-hero-time" wx:if="{{swarmItem.time}}">{{swarmItem.time}}</text>
          <text class="swarm-hero-desc" wx:if="{{swarmItem.desc}}">{{swarmItem.desc}}</text>
        </view>
      </view>
      <view class="panel-foot" wx:if="{{swarmItem.countdownText}}">
        <text class="panel-foot-label" wx:if="{{swarmItem.active}}">剩余</text>
        <text class="panel-foot-value">{{swarmItem.countdownText}}</text>
      </view>
    </view>
  </view>

  <!-- Footer -->
  <view class="foot">
    <text wx:if="{{icp}}">{{icp}}</text>
  </view>

  <!-- Video Player -->
  <view class="modal-mask" wx:if="{{showVideoPlayer}}" catchtap="closeVideoPlayer" style="z-index:10000;">
    <view class="modal-box video-player-box" catchtap="preventClose">
      <view class="video-player-header">
        <text class="video-player-title">{{videoPlayerName}}</text>
        <text class="modal-close" catchtap="closeVideoPlayer">✕</text>
      </view>
      <view class="video-player-owner" wx:if="{{videoPlayerOwner}}">
        <text class="video-player-owner-text">{{_l.upOwner}}{{videoPlayerOwner}}</text>
      </view>
      <video class="video-player-video" src="{{videoPlayerUrl}}" controls autoplay show-center-play-btn object-fit="contain" />
      <scroll-view scroll-y class="video-player-desc" wx:if="{{videoPlayerDesc}}">
        <text class="video-player-desc-text" space="ensp" decode="true">{{videoPlayerDesc}}</text>
      </scroll-view>
    </view>
  </view>

  <dock current="index" />
</view>
