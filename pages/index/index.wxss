/* ===== GitHub Dark 首页 ===== */
.page { min-height: 100vh; background: #0d1117; padding-bottom: calc(180rpx + constant(safe-area-inset-bottom)); padding-bottom: calc(180rpx + env(safe-area-inset-bottom)); }
.container { padding: 0; }

/* ── Repo Header ── */
.repo-header {
  padding: 24rpx 24rpx 0;
  background: #161b22;
  border-bottom: 1rpx solid #21262d;
}
.repo-header-top {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 16rpx;
}
.repo-owner { font-size: 24rpx; color: #58a6ff; font-weight: 600; }
.repo-sep { font-size: 24rpx; color: #484f58; }
.repo-name { font-size: 24rpx; color: #58a6ff; font-weight: 700; }
.repo-visibility {
  font-size: 18rpx; color: #8b949e; font-weight: 600;
  margin-left: 12rpx;
  padding: 2rpx 12rpx;
  border: 1rpx solid #30363d;
  border-radius: 20rpx;
}
.repo-tabs {
  display: flex;
  gap: 8rpx;
  overflow-x: auto;
  align-items: center;
}
.repo-tab {
  display: flex; align-items: center; gap: 6rpx;
  padding: 12rpx 20rpx;
  font-size: 22rpx; color: #8b949e; font-weight: 600;
  border-bottom: 2rpx solid transparent;
  transition: all 0.15s;
}
.repo-tab.active {
  color: #e6edf3;
  border-bottom-color: #f78166;
}
.repo-tab-icon { font-size: 20rpx; }

.repo-lang-bar {
  display: flex;
  align-items: center;
  gap: 2rpx;
  margin-left: auto;
}
.lang-btn {
  width: 56rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 600;
  color: #8b949e;
  border-radius: 6rpx;
  border: 1rpx solid transparent;
}
.lang-flag {
  width: 40rpx;
  height: 28rpx;
  border-radius: 4rpx;
  display: block;
}
.lang-btn.active {
  color: #58a6ff;
  border-color: #30363d;
  background: #161b22;
}
.lang-btn:active {
  color: #c9d1d9;
}
.lang-sep {
  font-size: 18rpx;
  color: #30363d;
  padding: 0 2rpx;
}

/* ── Hero Banner ── */
.hero-section {
  margin: 16rpx 0 0;
  /* 无边框、无圆角外框，避免出现一圈难看的框 */
  border: none;
  border-radius: 0;
  overflow: visible;
  background: transparent;
}
.hero-image {
  width: 100%;
  height: auto;
  display: block;
  border: none;
  border-radius: 0;
}
.hero-swiper {
  width: 100%;
  background: transparent;
  overflow: visible;
}
.hero-swiper .hero-image {
  width: 100%;
  height: auto;
  display: block;
  background: transparent;
}
.hero-swiper swiper-item {
  overflow: visible;
  background: transparent;
}

/* ── Quick Nav ── */
.quick-nav {
  display: flex;
  flex-wrap: wrap;
  margin: 20rpx 24rpx;
  border: 1rpx solid #30363d;
  border-radius: 12rpx;
  background: #161b22;
  overflow: hidden;
}
.nav-item {
  flex: 1 0 25%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 24rpx 8rpx;
  gap: 8rpx;
  border-right: 1rpx solid #21262d;
  border-bottom: 1rpx solid #21262d;
  box-sizing: border-box;
}
.nav-item:nth-child(4n) { border-right: none; }
.nav-item:nth-child(n+5) { border-bottom: none; }
.nav-item:active { background: #1c2128; }
.nav-emoji { font-size: 32rpx; }
.nav-label { font-size: 20rpx; color: #8b949e; font-weight: 500; }

/* ── Feed ── */
.feed-section {
  margin: 0 24rpx 24rpx;
  border: 1rpx solid #30363d;
  border-radius: 12rpx;
  background: #161b22;
}
.feed-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 24rpx 16rpx;
  background: #0d1117;
  border-radius: 12rpx 12rpx 0 0;
  border-bottom: 1rpx solid #21262d;
}
.feed-title { font-size: 28rpx; font-weight: 700; color: #e6edf3; }
.layout-pad .feed-title { font-size: 17px; }
.feed-header-right { display: flex; align-items: center; gap: 16rpx; }
.feed-count { font-size: 20rpx; color: #8b949e; }
.feed-sub { font-size: 20rpx; color: #58a6ff; font-weight: 500; }
.feed-sub.active { color: #3fb950; }

/* Feed items */
.feed-list { padding: 0; }
.feed-item {
  border-bottom: 1rpx solid #21262d;
}
.feed-item:last-child { border-bottom: none; }
.feed-item-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx;
  transition: background 0.1s;
}
.feed-item-header:active { background: #1c2128; }
.feed-item-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex: 1;
  min-width: 0;
}
.feed-badge {
  font-size: 18rpx; font-weight: 600; flex-shrink: 0;
  padding: 2rpx 10rpx; border-radius: 20rpx;
  background: #21262d; color: #8b949e;
}
.feed-badge.pinned { background: rgba(248,81,73,0.12); color: #f85149; }
.feed-badge.notice { background: rgba(88,166,255,0.12); color: #58a6ff; }
.feed-badge.update { background: rgba(63,185,80,0.12); color: #3fb950; }
.feed-badge.event { background: rgba(188,140,255,0.12); color: #bc8cff; }
.feed-badge.tip { background: rgba(210,153,34,0.12); color: #d29922; }
.feed-item-title {
  font-size: 26rpx; color: #c9d1d9; font-weight: 600;
  flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.layout-pad .feed-item-title { font-size: 15px; }
.feed-item-right {
  display: flex; align-items: center; gap: 12rpx; flex-shrink: 0; margin-left: 12rpx;
}
.feed-time { font-size: 20rpx; color: #484f58; }
.layout-pad .feed-time { font-size: 12px; }
.feed-arrow {
  font-size: 18rpx; color: #484f58;
  transition: transform 0.2s;
  width: 24rpx; text-align: center;
}
.feed-arrow.up { transform: rotate(90deg); }


/* Expanded */
.feed-item-body {
  padding: 0 24rpx 20rpx;
  border-top: 1rpx solid #21262d;
}
.feed-auto-delete {
  font-size: 20rpx; color: #d29922;
  background: rgba(210,153,34,0.08);
  padding: 6rpx 12rpx; border-radius: 4rpx;
  margin: 16rpx 0 12rpx;
  display: inline-block;
}
.feed-content {
  background: #0d1117;
  border: 1rpx solid #21262d;
  border-radius: 8rpx;
  padding: 20rpx;
}

/* ===== 面板：远行商人 / 大量出没 ===== */
.panel {
  margin: 20rpx 24rpx 0;
  border: 1rpx solid #30363d;
  border-radius: 12rpx;
  background: #161b22;
  overflow: hidden;
}
.panel-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 20rpx 24rpx;
  background: #0d1117;
  border-bottom: 1rpx solid #21262d;
}
.panel-header-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex: 1;
  min-width: 0;
}
.panel-header-right {
  display: flex;
  align-items: center;
  gap: 14rpx;
  flex-shrink: 0;
}
.panel-bar {
  width: 6rpx;
  height: 28rpx;
  border-radius: 3rpx;
  flex-shrink: 0;
}
.panel-bar.merchant { background: #d29922; }
.panel-bar.swarm { background: #00d4ff; }
.panel-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #e6edf3;
}
.panel-badge {
  font-size: 18rpx;
  font-weight: 600;
  padding: 2rpx 10rpx;
  border-radius: 4rpx;
}
.panel-badge.merchant {
  color: #d29922;
  background: rgba(210, 153, 34, 0.12);
}
.panel-badge.swarm-on {
  color: #00d4ff;
  background: rgba(0, 212, 255, 0.12);
}
.panel-badge.swarm-soon {
  color: #d29922;
  background: rgba(210, 153, 34, 0.12);
}
.panel-count {
  font-size: 20rpx;
  color: #8b949e;
}
.sub-btn {
  font-size: 20rpx;
  font-weight: 600;
  color: #58a6ff;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  border: 1rpx solid rgba(88, 166, 255, 0.35);
}
.sub-btn.on {
  color: #3fb950;
  border-color: rgba(63, 185, 80, 0.35);
}
.panel-body {
  padding: 0;
}
.panel-empty {
  padding: 32rpx 24rpx;
}
.panel-empty-text {
  font-size: 22rpx;
  color: #6e7681;
}
.panel-foot {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 14rpx 24rpx;
  border-top: 1rpx solid #21262d;
  background: rgba(210, 153, 34, 0.04);
}
.panel-foot-label {
  font-size: 20rpx;
  color: #8b949e;
}
.panel-foot-value {
  font-size: 20rpx;
  font-weight: 600;
  color: #d29922;
}

/* ── 商人商品行 ── */
.goods-list {
  display: flex;
  flex-direction: column;
}
.goods-group {
  display: flex;
  flex-direction: column;
}
.goods-group + .goods-group {
  border-top: 1rpx solid #21262d;
}
.goods-group-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  padding: 12rpx 24rpx 8rpx;
  background: rgba(210, 153, 34, 0.04);
}
.goods-group-title {
  font-size: 20rpx;
  font-weight: 700;
  color: #d29922;
  flex-shrink: 0;
}
.goods-group-time {
  font-size: 18rpx;
  color: #8b949e;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  min-width: 0;
}
.goods-group-remain {
  color: #d29922;
  font-weight: 600;
}
.goods-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 24rpx;
  border-bottom: 1rpx solid #21262d;
}
.goods-row:last-child { border-bottom: none; }
.goods-row:active { background: #1c2128; }
.goods-thumb {
  width: 64rpx;
  height: 64rpx;
  border-radius: 6rpx;
  flex-shrink: 0;
  background: #0d1117;
  border: 1rpx solid #21262d;
}
.goods-thumb-empty {
  background: #21262d;
}
.goods-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}
.goods-title-line {
  display: flex;
  align-items: center;
  gap: 10rpx;
  min-width: 0;
}
.goods-name {
  font-size: 24rpx;
  font-weight: 600;
  color: #c9d1d9;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.goods-limit {
  flex-shrink: 0;
  font-size: 18rpx;
  color: #d29922;
  background: rgba(210, 153, 34, 0.12);
  border-radius: 4rpx;
  padding: 2rpx 8rpx;
}
.goods-time-tag {
  flex-shrink: 0;
  font-size: 18rpx;
  color: #f85149;
  background: rgba(248, 81, 73, 0.12);
  border-radius: 4rpx;
  padding: 2rpx 8rpx;
}
.goods-offline {
  font-size: 18rpx;
  color: #8b949e;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.goods-offline-remain {
  color: #d29922;
  font-weight: 600;
}
.goods-effect {
  font-size: 20rpx;
  color: #6e7681;
  line-height: 1.5;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.goods-price {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 6rpx;
}
.roco-icon {
  width: 22rpx;
  height: 22rpx;
}
.goods-price-num {
  font-size: 24rpx;
  font-weight: 700;
  color: #d29922;
}

/* ── 大量出没单条 ── */
.swarm-hero {
  display: flex;
  gap: 20rpx;
  padding: 20rpx 24rpx;
}
.swarm-hero-img-wrap {
  width: 140rpx;
  height: 140rpx;
  flex-shrink: 0;
  border-radius: 10rpx;
  overflow: hidden;
  background: #0d1117;
  border: 1rpx solid #21262d;
}
.swarm-hero-img {
  width: 140rpx;
  height: 140rpx;
  display: block;
}
.swarm-hero-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}
.swarm-hero-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #e6edf3;
}
.swarm-hero-loc {
  font-size: 22rpx;
  color: #58a6ff;
}
.swarm-hero-time {
  font-size: 20rpx;
  color: #6e7681;
}
.swarm-hero-desc {
  font-size: 20rpx;
  color: #8b949e;
  line-height: 1.55;
}

/* 旧 broadcast 通用件 */
.broadcast-arrow {
  flex-shrink: 0;
  color: #484f58;
  font-size: 28rpx;
  line-height: 1;
  font-weight: 600;
}

/* Rich content: swiper (滚动图) — 完整比例、无背景框 */
.rich-swiper-block {
  margin: 16rpx 0;
  background: transparent;
  border: none;
  border-radius: 0;
  overflow: visible;
}
.rich-swiper {
  width: 100%;
  background: transparent;
}
.rich-swiper-image {
  width: 100%;
  height: auto;
  display: block;
  background: transparent;
}

/* Rich content: single image (单图) */
.rich-image-block { margin: 16rpx 0; border-radius: 8rpx; overflow: hidden; }
.rich-image { width: 100%; display: block; }

/* Rich content: text block */
.rich-text-block { line-height: 1.8; margin: 8rpx 0; }
.rich-quote-block {
  margin: 12rpx 0; padding: 16rpx 20rpx;
  background: rgba(88,166,255,0.06);
  border-left: 4rpx solid rgba(88,166,255,0.4);
  border-radius: 4rpx;
}
.rich-link-block {
  margin: 12rpx 0; padding: 16rpx 20rpx;
  background: rgba(255,255,255,0.04);
  border-radius: 8rpx;
  display: flex; align-items: center; gap: 12rpx;
}
/* 内联 mp4 播放器 */
.rich-video-inline { margin: 20rpx 0; }
.rich-inline-video {
  width: 100%; height: 380rpx; display: block;
  border-radius: 16rpx; background: #000; overflow: visible;
  box-shadow: 0 12rpx 36rpx rgba(0,0,0,0.35), 0 0 0 1rpx rgba(255,255,255,0.08);
}
.rich-divider-block { margin: 16rpx 0; }
.divider-block { margin: 16rpx 0; }
.divider-line { height: 1rpx; background: rgba(255,255,255,0.15); }
.rich-table-block { margin: 16rpx 0; overflow-x: auto; }

/* Rich table */
.rich-table { width: 100%; border-collapse: collapse; font-size: 22rpx; }
.rich-table-row { display: flex; }
.rich-table-cell {
  flex: 1; padding: 10rpx 8rpx; text-align: center;
  border: 1rpx solid rgba(255,255,255,0.08);
  color: #c9d1d9; min-width: 0; word-break: break-all;
}
.rich-table-header .rich-table-cell {
  background: rgba(0,200,255,0.08); color: #58a6ff; font-weight: 700;
}

/* Empty */
.feed-empty {
  display: flex; flex-direction: column; align-items: center;
  padding: 48rpx 0; gap: 12rpx;
}
.feed-empty-icon { font-size: 48rpx; opacity: 0.5; }
.feed-empty-text { font-size: 24rpx; color: #484f58; }
.feed-empty-btn {
  display: flex; align-items: center; gap: 6rpx;
  padding: 10rpx 24rpx;
  background: #21262d; border: 1rpx solid #30363d;
  border-radius: 8rpx; margin-top: 8rpx;
}
.feed-empty-btn:active { background: #30363d; }
.feed-empty-btn .btn-text { font-size: 22rpx; color: #58a6ff; font-weight: 600; }

/* Feed source */
.feed-source {
  margin-top: 12rpx;
  padding: 8rpx 12rpx;
  background: rgba(210,153,34,0.06);
  border: 1rpx solid rgba(210,153,34,0.12);
  border-radius: 4rpx;
  font-size: 20rpx; color: #d29922;
}

/* ── Footer ── */
.foot { text-align: center; font-size: 20rpx; color: #30363d; padding: 32rpx 0; }

/* ── Modal ── */
.modal-mask { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.6); z-index: 10000; display: flex; align-items: flex-end; }
.modal-box { width: 100%; background: #161b22; border: 1rpx solid #30363d; border-radius: 12rpx 12rpx 0 0; padding: 32rpx; max-height: 90vh; display: flex; flex-direction: column; box-sizing: border-box; }
.modal-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 28rpx; flex-shrink: 0; }
.modal-title { font-size: 32rpx; font-weight: 700; color: #e6edf3; }
.modal-close { font-size: 36rpx; color: #8b949e; padding: 8rpx; }
.modal-close:active { color: #f85149; }
.modal-body { flex: 1; overflow-y: auto; }

.banner-preview { width: 100%; height: 280rpx; border-radius: 8rpx; overflow: hidden; margin-bottom: 28rpx; border: 1rpx solid #30363d; background: #0d1117; }
.banner-preview.empty { display: flex; align-items: center; justify-content: center; font-size: 24rpx; color: #484f58; }
.preview-img { width: 100%; height: 100%; }

.banner-form { background: #0d1117; border: 1rpx solid #30363d; border-radius: 8rpx; padding: 20rpx; }
.form-label { font-size: 22rpx; color: #8b949e; margin-bottom: 16rpx; font-weight: 600; display: block; }
.banner-input { width: 100%; background: #0d1117; border: 1rpx solid #30363d; border-radius: 8rpx; padding: 20rpx; font-size: 24rpx; color: #e6edf3; box-sizing: border-box; }

.modal-footer { display: flex; gap: 16rpx; flex-shrink: 0; padding-top: 28rpx; padding-bottom: calc(20rpx + env(safe-area-inset-bottom)); }
.modal-cancel { flex: 1; background: #21262d !important; color: #c9d1d9 !important; border-radius: 8rpx !important; height: 80rpx !important; font-size: 26rpx !important; border: 1rpx solid #30363d !important; display: flex !important; align-items: center !important; justify-content: center !important; }
.modal-save { flex: 1; background: #238636 !important; color: #fff !important; border-radius: 8rpx !important; height: 80rpx !important; font-size: 26rpx !important; font-weight: 600 !important; border: 1rpx solid rgba(240,246,252,0.1) !important; display: flex !important; align-items: center !important; justify-content: center !important; }
.modal-save:active { background: #2ea043 !important; }
.modal-save[disabled] { opacity: 0.5; background: #21262d !important; }

/* ── Video Player ── */
.video-player-box { background: linear-gradient(180deg, #1e2440 0%, #171b30 40%, #14172a 100%); overflow: visible; max-height: 88vh; box-sizing: border-box; padding-bottom: calc(28rpx + env(safe-area-inset-bottom)); }
.video-player-header { padding: 32rpx 28rpx 0; margin-bottom: 16rpx; display: flex; justify-content: space-between; align-items: center; gap: 16rpx; flex-shrink: 0; }
.video-player-title {
  color: #fff;
  font-size: 30rpx;
  font-weight: 700;
  flex: 1;
  min-width: 0;
  white-space: nowrap;
  overflow-x: auto;
  overflow-y: hidden;
  -webkit-overflow-scrolling: touch;
}
.video-player-owner { padding: 8rpx 28rpx; margin: 0 28rpx 16rpx; flex-shrink: 0; }
.video-player-owner-text { font-size: 22rpx; color: rgba(255,255,255,0.5); }
.video-player-video { width: calc(100% - 56rpx); margin: 0 28rpx 8rpx; height: 360rpx; display: block; border-radius: 16rpx; background: #000; flex-shrink: 0; overflow: visible; box-shadow: 0 16rpx 48rpx rgba(0,0,0,0.45), 0 0 0 1rpx rgba(255,255,255,0.08); }
.video-player-desc { margin: 12rpx 28rpx 0; padding: 20rpx 24rpx; height: 220rpx; box-sizing: border-box; overflow-y: auto; position: relative; background: rgba(255,255,255,0.04); border: 1rpx solid rgba(255,255,255,0.07); border-radius: 16rpx; }
.video-player-desc::after { content: ''; position: absolute; bottom: 0; left: 0; right: 0; height: 40rpx; background: linear-gradient(transparent, rgba(20,23,42,0.95)); pointer-events: none; border-radius: 0 0 16rpx 16rpx; }
.video-player-desc-text { font-size: 24rpx; color: rgba(255,255,255,0.55); line-height: 1.8; word-break: break-all; white-space: pre-wrap; padding-bottom: 40rpx; }

/* ===== 平板适配（class 驱动：layout-pad / layout-wide）===== */

.layout-pad.page {
  max-width: 768px;
  margin: 0 auto;
  padding-bottom: calc(80px + env(safe-area-inset-bottom));
}
.layout-pad .repo-header {
  max-width: 768px;
  margin: 0 auto;
  padding: 14px 16px 0;
  box-sizing: border-box;
}

/* 顶栏单行：禁止逐字竖排 */
.layout-pad .repo-header-top {
  flex-wrap: nowrap;
  gap: 8px;
  margin-bottom: 10px;
}
.layout-pad .repo-owner,
.layout-pad .repo-sep {
  font-size: 15px;
  white-space: nowrap;
  flex-shrink: 0;
}
.layout-pad .repo-name {
  font-size: 15px;
  white-space: nowrap;
  flex-shrink: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
}
.layout-pad .repo-visibility {
  font-size: 11px;
  padding: 2px 10px;
  margin-left: 8px;
  flex-shrink: 0;
  white-space: nowrap;
}

/* tab 行：图标+文字同行，不换行 */
.layout-pad .repo-tabs {
  flex-wrap: nowrap;
  overflow-x: auto;
  gap: 6px;
  -webkit-overflow-scrolling: touch;
}
.layout-pad .repo-tab {
  flex-shrink: 0;
  white-space: nowrap;
  font-size: 13px;
  padding: 8px 12px;
  gap: 4px;
}
.layout-pad .repo-tab-icon { font-size: 13px; }

/* 语言旗固定右侧，不挤压 tab */
.layout-pad .repo-lang-bar {
  margin-left: auto;
  flex-shrink: 0;
  gap: 2px;
  padding-left: 8px;
}
.layout-pad .lang-btn { width: 36px; height: 26px; }
.layout-pad .lang-flag { width: 26px; height: 18px; }
.layout-pad .lang-sep { font-size: 11px; padding: 0 2px; }

/* 快捷入口 3 列 */
.layout-pad .quick-nav {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  margin: 12px 16px;
  border-radius: 10px;
}
.layout-pad .nav-item { padding: 16px 8px; }
.layout-pad .nav-emoji { font-size: 28px; }
.layout-pad .nav-label { font-size: 13px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 100%; }

/* 内容限宽 */
.layout-pad .feed-section { max-width: 768px; margin: 0 auto 16px; }
.layout-pad .panel { max-width: 768px; margin-left: auto; margin-right: auto; box-sizing: border-box; }

/* 弹窗居中 */
.layout-pad .modal-box { max-width: 640px; width: 100%; margin-left: auto; margin-right: auto; border-radius: 12px; box-sizing: border-box; }
.layout-pad .modal-mask { align-items: center !important; justify-content: center !important; }

/* 横屏 layout-wide */
.layout-wide.page { max-width: 1080px; margin: 0 auto; }
.layout-wide .repo-header { max-width: 1080px; margin: 0 auto; padding: 16px 24px 0; }

.layout-wide .repo-header-top { margin-bottom: 8px; }
.layout-wide .repo-owner,
.layout-wide .repo-sep { font-size: 16px; }
.layout-wide .repo-name { font-size: 16px; }
.layout-wide .repo-tab { font-size: 13px; padding: 8px 14px; }

.layout-wide .quick-nav {
  grid-template-columns: repeat(4, 1fr);
  margin: 16px 24px;
}

.layout-wide .feed-section { max-width: 1080px; margin: 0 auto 16px; }
.layout-wide .panel { max-width: 1080px; }
.layout-wide .modal-box { max-width: 720px; width: 100%; }

.layout-wide .feed-item-header { padding: 16px 18px; }
.layout-wide .feed-content { padding: 0 18px 14px; }


