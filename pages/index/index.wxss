/* ===== GitHub Dark 首页 ===== */
.page { min-height: 100vh; background: #0d1117; padding-bottom: calc(180rpx + constant(safe-area-inset-bottom)); padding-bottom: calc(180rpx + env(safe-area-inset-bottom)); }
.container { padding: 0; }

/* ── Repo Header ── */
.repo-header {
  padding: 24rpx 24rpx 0;
  background: #161b22;
  border-bottom: 1rpx solid #21262d;
}
.repo-header-top {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 16rpx;
}
.repo-owner { font-size: 24rpx; color: #58a6ff; font-weight: 600; }
.repo-sep { font-size: 24rpx; color: #484f58; }
.repo-name { font-size: 24rpx; color: #58a6ff; font-weight: 700; }
.repo-visibility {
  font-size: 18rpx; color: #8b949e; font-weight: 600;
  margin-left: 12rpx;
  padding: 2rpx 12rpx;
  border: 1rpx solid #30363d;
  border-radius: 20rpx;
}
.repo-tabs {
  display: flex;
  gap: 8rpx;
  overflow-x: auto;
  align-items: center;
}
.repo-tab {
  display: flex; align-items: center; gap: 6rpx;
  padding: 12rpx 20rpx;
  font-size: 22rpx; color: #8b949e; font-weight: 600;
  border-bottom: 2rpx solid transparent;
  transition: all 0.15s;
}
.repo-tab.active {
  color: #e6edf3;
  border-bottom-color: #f78166;
}
.repo-tab-icon { font-size: 20rpx; }

.repo-lang-bar {
  display: flex;
  align-items: center;
  gap: 2rpx;
  margin-left: auto;
}
.lang-btn {
  width: 56rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 600;
  color: #8b949e;
  border-radius: 6rpx;
  border: 1rpx solid transparent;
}
.lang-flag {
  width: 40rpx;
  height: 28rpx;
  border-radius: 4rpx;
  display: block;
}
.lang-btn.active {
  color: #58a6ff;
  border-color: #30363d;
  background: #161b22;
}
.lang-btn:active {
  color: #c9d1d9;
}
.lang-sep {
  font-size: 18rpx;
  color: #30363d;
  padding: 0 2rpx;
}

/* ── Hero Banner ── */
.hero-section {
  margin: 20rpx 24rpx 0;
  border: 1rpx solid #30363d;
  border-radius: 12rpx;
  overflow: hidden;
}
.hero-image { width: 100%; display: block; }
.hero-swiper { width: 100%; height: 500rpx; background: #0d1117; }
.hero-swiper .hero-image { width: 100%; height: 100%; display: block; background: #0d1117; }

/* ── Quick Nav ── */
.quick-nav {
  display: flex;
  flex-wrap: wrap;
  margin: 20rpx 24rpx;
  border: 1rpx solid #30363d;
  border-radius: 12rpx;
  background: #161b22;
  overflow: hidden;
}
.nav-item {
  flex: 1 0 25%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 24rpx 8rpx;
  gap: 8rpx;
  border-right: 1rpx solid #21262d;
  border-bottom: 1rpx solid #21262d;
  box-sizing: border-box;
}
.nav-item:nth-child(4n) { border-right: none; }
.nav-item:nth-child(n+5) { border-bottom: none; }
.nav-item:active { background: #1c2128; }
.nav-emoji { font-size: 32rpx; }
.nav-label { font-size: 20rpx; color: #8b949e; font-weight: 500; }

/* ── Feed ── */
.feed-section {
  margin: 0 24rpx 24rpx;
  border: 1rpx solid #30363d;
  border-radius: 12rpx;
  background: #161b22;
}
.feed-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 24rpx 16rpx;
  background: #0d1117;
  border-radius: 12rpx 12rpx 0 0;
  border-bottom: 1rpx solid #21262d;
}
.feed-title { font-size: 28rpx; font-weight: 700; color: #e6edf3; }
.feed-header-right { display: flex; align-items: center; gap: 16rpx; }
.feed-count { font-size: 20rpx; color: #8b949e; }
.feed-sub { font-size: 20rpx; color: #58a6ff; font-weight: 500; }
.feed-sub.active { color: #3fb950; }

/* Feed items */
.feed-list { padding: 0; }
.feed-item {
  border-bottom: 1rpx solid #21262d;
}
.feed-item:last-child { border-bottom: none; }
.feed-item-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx;
  transition: background 0.1s;
}
.feed-item-header:active { background: #1c2128; }
.feed-item-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex: 1;
  min-width: 0;
}
.feed-badge {
  font-size: 18rpx; font-weight: 600; flex-shrink: 0;
  padding: 2rpx 10rpx; border-radius: 20rpx;
  background: #21262d; color: #8b949e;
}
.feed-badge.pinned { background: rgba(248,81,73,0.12); color: #f85149; }
.feed-badge.notice { background: rgba(88,166,255,0.12); color: #58a6ff; }
.feed-badge.update { background: rgba(63,185,80,0.12); color: #3fb950; }
.feed-badge.event { background: rgba(188,140,255,0.12); color: #bc8cff; }
.feed-badge.tip { background: rgba(210,153,34,0.12); color: #d29922; }
.feed-item-title {
  font-size: 26rpx; color: #c9d1d9; font-weight: 600;
  flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.feed-item-right {
  display: flex; align-items: center; gap: 12rpx; flex-shrink: 0; margin-left: 12rpx;
}
.feed-time { font-size: 20rpx; color: #484f58; }
.feed-arrow {
  font-size: 18rpx; color: #484f58;
  transition: transform 0.2s;
  width: 24rpx; text-align: center;
}
.feed-arrow.up { transform: rotate(90deg); }
.feed-translate-btn { font-size: 18rpx; color: rgba(0,212,255,0.5); margin-right: 4rpx; }
.feed-translate-btn:active { color: #00d4ff; }

/* Expanded */
.feed-item-body {
  padding: 0 24rpx 20rpx;
  border-top: 1rpx solid #21262d;
}
.feed-auto-delete {
  font-size: 20rpx; color: #d29922;
  background: rgba(210,153,34,0.08);
  padding: 6rpx 12rpx; border-radius: 4rpx;
  margin: 16rpx 0 12rpx;
  display: inline-block;
}
.feed-content {
  background: #0d1117;
  border: 1rpx solid #21262d;
  border-radius: 8rpx;
  padding: 20rpx;
}

/* ROCOKINGDOM广播站 */
.broadcast-section {
  margin-top: 28rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #21262d;
}
.broadcast-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 14rpx;
}
.broadcast-item {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  background: linear-gradient(180deg, rgba(13, 17, 23, 0.95), rgba(13, 17, 23, 0.8));
  border: 1rpx solid #21262d;
  border-radius: 16rpx;
  padding: 18rpx 16rpx;
}
.broadcast-item:active { opacity: 0.88; }
.broadcast-badge {
  flex-shrink: 0;
  font-size: 20rpx;
  font-weight: 700;
  padding: 6rpx 12rpx;
  border-radius: 8rpx;
  margin-top: 2rpx;
}
.broadcast-badge.swarm {
  background: rgba(0, 212, 255, 0.1);
  color: #00d4ff;
  border: 1rpx solid rgba(0, 212, 255, 0.18);
}
.broadcast-badge.merchant {
  background: rgba(255, 171, 64, 0.1);
  color: #ffab40;
  border: 1rpx solid rgba(255, 171, 64, 0.18);
}
.broadcast-body { flex: 1; min-width: 0; }
.broadcast-head {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 10rpx;
}
.broadcast-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #e6edf3;
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.broadcast-tag {
  flex-shrink: 0;
  font-size: 20rpx;
  color: #00d4ff;
  background: rgba(0, 212, 255, 0.08);
  border: 1rpx solid rgba(0, 212, 255, 0.16);
  border-radius: 999rpx;
  padding: 2rpx 12rpx;
}
.broadcast-desc {
  display: block;
  font-size: 22rpx;
  color: rgba(230, 237, 243, 0.65);
  line-height: 1.5;
  word-break: break-word;
}
.broadcast-items {
  margin-top: 4rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}
.broadcast-goods {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 12rpx 14rpx;
  background: rgba(255, 255, 255, 0.03);
  border: 1rpx solid rgba(255, 255, 255, 0.05);
  border-radius: 10rpx;
}
.goods-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}
.goods-name {
  font-size: 24rpx;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.88);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.goods-meta {
  font-size: 18rpx;
  color: rgba(255, 171, 64, 0.8);
}
.goods-price {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 26rpx;
  font-weight: 800;
  color: #ffab40;
  font-family: 'DIN Alternate', monospace;
}
.roco-icon {
  width: 24rpx;
  height: 24rpx;
}
.broadcast-countdown {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #ffd54f;
}
.broadcast-time {
  display: block;
  margin-top: 6rpx;
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.3);
}
.broadcast-arrow {
  flex-shrink: 0;
  color: rgba(255, 255, 255, 0.2);
  font-size: 22rpx;
  margin-top: 6rpx;
}

/* Rich content: swiper (滚动图) — 完整比例、无背景框 */
.rich-swiper-block {
  margin: 16rpx 0;
  background: transparent;
  border: none;
  border-radius: 0;
  overflow: visible;
}
.rich-swiper {
  width: 100%;
  background: transparent;
}
.rich-swiper-image {
  width: 100%;
  height: auto;
  display: block;
  background: transparent;
}

/* Rich content: single image (单图) */
.rich-image-block { margin: 16rpx 0; border-radius: 8rpx; overflow: hidden; }
.rich-image { width: 100%; display: block; }

/* Rich content: text block */
.rich-text-block { line-height: 1.8; margin: 8rpx 0; }
.rich-quote-block {
  margin: 12rpx 0; padding: 16rpx 20rpx;
  background: rgba(88,166,255,0.06);
  border-left: 4rpx solid rgba(88,166,255,0.4);
  border-radius: 4rpx;
}
.rich-music-block, .rich-video-block, .rich-link-block {
  margin: 12rpx 0; padding: 16rpx 20rpx;
  background: rgba(255,255,255,0.04);
  border-radius: 8rpx;
  display: flex; align-items: center; gap: 12rpx;
}
.rich-divider-block { margin: 16rpx 0; }
.divider-block { margin: 16rpx 0; }
.divider-line { height: 1rpx; background: rgba(255,255,255,0.15); }
.rich-table-block { margin: 16rpx 0; overflow-x: auto; }

/* Rich table */
.rich-table { width: 100%; border-collapse: collapse; font-size: 22rpx; }
.rich-table-row { display: flex; }
.rich-table-cell {
  flex: 1; padding: 10rpx 8rpx; text-align: center;
  border: 1rpx solid rgba(255,255,255,0.08);
  color: #c9d1d9; min-width: 0; word-break: break-all;
}
.rich-table-header .rich-table-cell {
  background: rgba(0,200,255,0.08); color: #58a6ff; font-weight: 700;
}

/* Empty */
.feed-empty {
  display: flex; flex-direction: column; align-items: center;
  padding: 48rpx 0; gap: 12rpx;
}
.feed-empty-icon { font-size: 48rpx; opacity: 0.5; }
.feed-empty-text { font-size: 24rpx; color: #484f58; }
.feed-empty-btn {
  display: flex; align-items: center; gap: 6rpx;
  padding: 10rpx 24rpx;
  background: #21262d; border: 1rpx solid #30363d;
  border-radius: 8rpx; margin-top: 8rpx;
}
.feed-empty-btn:active { background: #30363d; }
.feed-empty-btn .btn-text { font-size: 22rpx; color: #58a6ff; font-weight: 600; }

/* Feed source */
.feed-source {
  margin-top: 12rpx;
  padding: 8rpx 12rpx;
  background: rgba(210,153,34,0.06);
  border: 1rpx solid rgba(210,153,34,0.12);
  border-radius: 4rpx;
  font-size: 20rpx; color: #d29922;
}

/* ── Footer ── */
.foot { text-align: center; font-size: 20rpx; color: #30363d; padding: 32rpx 0; }

/* ── Modal ── */
.modal-mask { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.6); z-index: 10000; display: flex; align-items: flex-end; }
.modal-box { width: 100%; background: #161b22; border: 1rpx solid #30363d; border-radius: 12rpx 12rpx 0 0; padding: 32rpx; max-height: 90vh; display: flex; flex-direction: column; box-sizing: border-box; }
.modal-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 28rpx; flex-shrink: 0; }
.modal-title { font-size: 32rpx; font-weight: 700; color: #e6edf3; }
.modal-close { font-size: 36rpx; color: #8b949e; padding: 8rpx; }
.modal-close:active { color: #f85149; }
.modal-body { flex: 1; overflow-y: auto; }

.banner-preview { width: 100%; height: 280rpx; border-radius: 8rpx; overflow: hidden; margin-bottom: 28rpx; border: 1rpx solid #30363d; background: #0d1117; }
.banner-preview.empty { display: flex; align-items: center; justify-content: center; font-size: 24rpx; color: #484f58; }
.preview-img { width: 100%; height: 100%; }

.banner-form { background: #0d1117; border: 1rpx solid #30363d; border-radius: 8rpx; padding: 20rpx; }
.form-label { font-size: 22rpx; color: #8b949e; margin-bottom: 16rpx; font-weight: 600; display: block; }
.banner-input { width: 100%; background: #0d1117; border: 1rpx solid #30363d; border-radius: 8rpx; padding: 20rpx; font-size: 24rpx; color: #e6edf3; box-sizing: border-box; }

.modal-footer { display: flex; gap: 16rpx; flex-shrink: 0; padding-top: 28rpx; padding-bottom: calc(20rpx + env(safe-area-inset-bottom)); }
.modal-cancel { flex: 1; background: #21262d !important; color: #c9d1d9 !important; border-radius: 8rpx !important; height: 80rpx !important; font-size: 26rpx !important; border: 1rpx solid #30363d !important; display: flex !important; align-items: center !important; justify-content: center !important; }
.modal-save { flex: 1; background: #238636 !important; color: #fff !important; border-radius: 8rpx !important; height: 80rpx !important; font-size: 26rpx !important; font-weight: 600 !important; border: 1rpx solid rgba(240,246,252,0.1) !important; display: flex !important; align-items: center !important; justify-content: center !important; }
.modal-save:active { background: #2ea043 !important; }
.modal-save[disabled] { opacity: 0.5; background: #21262d !important; }

/* ── Video Player ── */
.video-player-box { background: #161b22; overflow: visible; max-height: 88vh; box-sizing: border-box; padding-bottom: calc(28rpx + env(safe-area-inset-bottom)); }
.video-player-header { padding: 32rpx 28rpx 0; margin-bottom: 16rpx; display: flex; justify-content: space-between; align-items: center; gap: 16rpx; flex-shrink: 0; }
.video-player-title {
  color: #e6edf3;
  font-size: 30rpx;
  font-weight: 700;
  flex: 1;
  min-width: 0;
  white-space: nowrap;
  overflow-x: auto;
  overflow-y: hidden;
  -webkit-overflow-scrolling: touch;
}
.video-player-owner { padding: 8rpx 28rpx; margin: 0 28rpx 16rpx; flex-shrink: 0; }
.video-player-owner-text { font-size: 22rpx; color: #8b949e; }
.video-player-video { width: calc(100% - 56rpx); margin: 0 28rpx 8rpx; height: 360rpx; display: block; border-radius: 8rpx; background: #000; flex-shrink: 0; overflow: visible; }
.video-player-desc { padding: 20rpx 28rpx; height: 220rpx; box-sizing: border-box; overflow-y: auto; position: relative; }
.video-player-desc::after { content: ''; position: absolute; bottom: 0; left: 0; right: 0; height: 40rpx; background: linear-gradient(transparent, #161b22); pointer-events: none; }
.video-player-desc-text { font-size: 24rpx; color: #8b949e; line-height: 1.8; word-break: break-all; white-space: pre-wrap; padding-bottom: 40rpx; }

/* Pad 竖屏适配 */
@media (min-width: 768px) and (max-width: 1023px) {
  .page { max-width: 720px; margin: 0 auto; }
  .repo-header { max-width: 720px; margin: 0 auto; }
  .quick-nav { display: grid; grid-template-columns: repeat(3, 1fr); }
  .feed-section { max-width: 720px; margin: 0 auto 24rpx; }
  .modal-box { max-width: 640px; margin-left: auto; margin-right: auto; }
}

/* Pad 横屏适配 */
@media (min-width: 1024px) {
  .page { max-width: 960px; margin: 0 auto; }
  .repo-header { max-width: 960px; margin: 0 auto; }
  .quick-nav { display: grid; grid-template-columns: repeat(3, 1fr); }
  .feed-section { max-width: 960px; margin: 0 auto 24rpx; }
  .modal-box { max-width: 720px; margin-left: auto; margin-right: auto; }
}
