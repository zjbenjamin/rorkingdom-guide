/* 远行商人 Liquid Glass */
.page { min-height: 100vh; background-color: #010314; background-image: radial-gradient(ellipse 60% 40% at 60% 30%, rgba(200,100,50,0.06) 0%, transparent 50%), linear-gradient(185deg, #020410 0%, #040c24 100%);  padding-bottom: calc(180rpx + constant(safe-area-inset-bottom)); padding-bottom: calc(180rpx + env(safe-area-inset-bottom)); }
@keyframes pageExpand { from { opacity: 0; } to { opacity: 1; } }

/* 维护卡片 */
.maintain-card { background: rgba(255,255,255,0.04); border: 1rpx solid rgba(255,255,255,0.08); border-radius: 24rpx; padding: 60rpx 40rpx; margin-bottom: 20rpx; box-shadow: 0 0 0 1rpx rgba(255,255,255,0.03) inset, 0 1rpx 0 rgba(255,255,255,0.04) inset, 0 4rpx 16rpx rgba(0,0,0,0.12); display: flex; flex-direction: column; align-items: center; justify-content: center; }
.maintain-icon { font-size: 72rpx; margin-bottom: 24rpx; display: block; }
.maintain-title { font-size: 32rpx; font-weight: 700; color: #fff; margin-bottom: 12rpx; letter-spacing: 2rpx; }
.maintain-desc { font-size: 24rpx; color: rgba(255,255,255,0.6); text-align: center; }

/* 基础卡片 */
.card { background: rgba(255,255,255,0.04); border: 1rpx solid rgba(255,255,255,0.08); border-radius: 24rpx; padding: 28rpx; margin-bottom: 20rpx; box-shadow: 0 0 0 1rpx rgba(255,255,255,0.03) inset, 0 1rpx 0 rgba(255,255,255,0.04) inset, 0 4rpx 16rpx rgba(0,0,0,0.12); }

.card-title { font-size: 26rpx; font-weight: 700; color: #00d4ff; margin-bottom: 20rpx; padding-left: 16rpx; border-left: 3rpx solid rgba(0,200,255,0.3); letter-spacing: 1rpx; }

/* 出差提示 */
.merchant-tip { text-align: center; padding: 20rpx 0; }
.tip-icon { font-size: 64rpx; display: block; margin-bottom: 16rpx; }
.tip-title { font-size: 28rpx; font-weight: 700; color: #fff; }
.tip-desc { font-size: 24rpx; color: rgba(255,255,255,0.6); }
.tip-hint { font-size: 20rpx; color: rgba(0,200,255,0.5); margin-top: 8rpx; display: block; }
.edit-btn { font-size: 22rpx; padding: 4rpx 10rpx; background: rgba(0,200,255,0.1); border: 1rpx solid rgba(0,200,255,0.15); border-radius: 8rpx; color: #00d4ff; text-align: center; }

/* 售卖头部垂直居中堆叠布局 */
.card-header-stacked {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 24rpx;
  gap: 16rpx;
  width: 100%;
}

.card-title-center {
  font-size: 28rpx;
  font-weight: 700;
  color: #00d4ff;
  letter-spacing: 2rpx;
  text-align: center;
  padding: 0 20rpx;
  position: relative;
  margin-bottom: 4rpx;
}

.card-title-center::before,
.card-title-center::after {
  content: '';
  position: absolute;
  top: 50%;
  width: 40rpx;
  height: 2rpx;
  background: linear-gradient(90deg, transparent, rgba(0, 212, 255, 0.4));
}
.card-title-center::before {
  right: 100%;
  background: linear-gradient(270deg, transparent, rgba(0, 212, 255, 0.4));
}
.card-title-center::after {
  left: 100%;
  background: linear-gradient(90deg, transparent, rgba(0, 212, 255, 0.4));
}

.selling-actions-center {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  width: 100%;
  flex-wrap: wrap;
}
.action-btn { display: flex; align-items: center; justify-content: center; gap: 6rpx; padding: 10rpx 20rpx; border-radius: 12rpx; font-size: 22rpx; font-weight: 600; transition: all 0.3s cubic-bezier(0.16,1,0.3,1); border: 1rpx solid; white-space: nowrap; }
.action-btn:active { transform: scale(0.95); }
.action-icon { font-size: 22rpx; }
.action-text { font-size: 22rpx; }
.action-count { font-size: 16rpx; background: rgba(0,200,255,0.2); color: #00d4ff; padding: 0 8rpx; border-radius: 8rpx; font-weight: 700; }
.sub-btn { background: rgba(255,255,255,0.04); border-color: rgba(255,255,255,0.08); color: rgba(255,255,255,0.6); min-width: 140rpx; }
.sub-btn.on { background: rgba(0,200,255,0.1); border-color: rgba(0,200,255,0.25); color: #00d4ff; box-shadow: 0 0 12rpx rgba(0,200,255,0.08); }
.add-btn { background: rgba(52,199,89,0.08); border-color: rgba(52,199,89,0.2); color: #34c759; box-shadow: 0 0 0 1rpx rgba(52,199,89,0.04) inset; }
.add-btn:active { background: rgba(52,199,89,0.15); }
.push-btn { background: rgba(0,200,255,0.1); border-color: rgba(0,200,255,0.2); color: #00d4ff; box-shadow: 0 0 0 1rpx rgba(0,200,255,0.04) inset; }
.push-btn:active { background: rgba(0,200,255,0.18); }

/* ===== 管理员面板全新UI ===== */
.admin-panel-new {
  background: linear-gradient(135deg, rgba(16, 20, 48, 0.95) 0%, rgba(22, 32, 64, 0.95) 100%);
  border: 1rpx solid rgba(255, 171, 64, 0.2);
  border-radius: 28rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.3), inset 0 1rpx 0 rgba(255, 255, 255, 0.05);
}

/* 面板头部 */
.admin-header {
  position: relative;
  padding: 28rpx 24rpx;
  background: linear-gradient(135deg, #1a1040 0%, #0a1628 100%);
  overflow: hidden;
}
.admin-header-bg {
  position: absolute;
  top: -30%;
  right: -10%;
  width: 200rpx;
  height: 200rpx;
  background: radial-gradient(circle, rgba(255, 171, 64, 0.15) 0%, transparent 70%);
  border-radius: 50%;
}
.admin-header-content {
  display: flex;
  align-items: center;
  gap: 16rpx;
  position: relative;
  z-index: 2;
}
.admin-avatar {
  width: 72rpx;
  height: 72rpx;
  background: linear-gradient(135deg, rgba(255, 171, 64, 0.3) 0%, rgba(255, 140, 0, 0.2) 100%);
  border: 2rpx solid rgba(255, 171, 64, 0.4);
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(255, 171, 64, 0.2);
}
.avatar-icon {
  font-size: 36rpx;
}
.admin-info {
  flex: 1;
}
.admin-title {
  font-size: 30rpx;
  font-weight: 800;
  color: #fff;
  display: block;
  letter-spacing: 1rpx;
}
.admin-subtitle {
  font-size: 20rpx;
  color: rgba(255, 171, 64, 0.6);
  display: block;
  margin-top: 4rpx;
}
.admin-badge {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 6rpx 14rpx;
  background: rgba(52, 199, 89, 0.15);
  border: 1rpx solid rgba(52, 199, 89, 0.3);
  border-radius: 20rpx;
}
.badge-dot {
  width: 10rpx;
  height: 10rpx;
  background: #34c759;
  border-radius: 50%;
  animation: pulse 2s infinite;
}
@keyframes pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.5; }
}
.badge-text {
  font-size: 18rpx;
  color: #34c759;
  font-weight: 600;
}

/* 区块样式 */
.admin-section {
  padding: 20rpx 24rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.06);
}
.section-label {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 16rpx;
}
.label-icon {
  font-size: 20rpx;
}
.label-text {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.4);
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 2rpx;
}

/* 开关网格 */
.switch-grid {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}
.switch-card {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 20rpx;
  background: rgba(0, 0, 0, 0.15);
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  border-radius: 16rpx;
  transition: all 0.2s cubic-bezier(0.25, 0.8, 0.25, 1);
}
.switch-card:active {
  background: rgba(0, 0, 0, 0.25);
  transform: scale(0.98);
}
.switch-icon-wrap {
  width: 48rpx;
  height: 48rpx;
  background: rgba(255, 255, 255, 0.06);
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
}
.switch-icon-wrap.active {
  background: rgba(255, 171, 64, 0.2);
  box-shadow: 0 0 12rpx rgba(255, 171, 64, 0.15);
}
.switch-icon {
  font-size: 24rpx;
}
.switch-info {
  flex: 1;
}
.switch-name {
  font-size: 24rpx;
  font-weight: 700;
  color: rgba(255, 255, 255, 0.9);
  display: block;
}
.switch-desc {
  font-size: 18rpx;
  color: rgba(255, 255, 255, 0.3);
  display: block;
  margin-top: 2rpx;
}
.switch-toggle {
  width: 52rpx;
  height: 28rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 14rpx;
  padding: 3rpx;
  transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
}
.switch-toggle.on {
  background: linear-gradient(135deg, #ffab40 0%, #ff8c00 100%);
  box-shadow: 0 2rpx 8rpx rgba(255, 171, 64, 0.3);
}
.toggle-circle {
  width: 22rpx;
  height: 22rpx;
  background: #fff;
  border-radius: 50%;
  box-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.2);
  transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
}
.switch-toggle.on .toggle-circle {
  transform: translateX(24rpx);
}

/* 操作按钮网格 */
.action-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 12rpx;
}
.action-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  padding: 20rpx 16rpx;
  background: rgba(0, 0, 0, 0.15);
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  border-radius: 16rpx;
  transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
}
.action-card:active {
  transform: scale(0.95);
  border-color: rgba(0, 212, 255, 0.3);
}
.action-icon-wrap {
  width: 56rpx;
  height: 56rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
}
.action-icon-wrap.blue {
  background: rgba(0, 212, 255, 0.15);
  border: 1rpx solid rgba(0, 212, 255, 0.3);
}
.action-icon-wrap.green {
  background: rgba(52, 199, 89, 0.15);
  border: 1rpx solid rgba(52, 199, 89, 0.3);
}
.action-icon-wrap.orange {
  background: rgba(255, 171, 64, 0.15);
  border: 1rpx solid rgba(255, 171, 64, 0.3);
}
.action-icon-wrap.purple {
  background: rgba(153, 69, 255, 0.15);
  border: 1rpx solid rgba(153, 69, 255, 0.3);
}
.action-card:active .action-icon-wrap {
  transform: scale(1.1);
}
.action-icon {
  font-size: 28rpx;
}
.action-name {
  font-size: 24rpx;
  font-weight: 700;
  color: rgba(255, 255, 255, 0.9);
}
.action-desc {
  font-size: 18rpx;
  color: rgba(255, 255, 255, 0.3);
}

/* ===== 批量编辑弹窗全新UI ===== */
.batch-modal-box {
  padding: 0 !important;
  overflow: hidden;
}

/* 批量管理头部 */
.batch-modal-header {
  position: relative;
  background: linear-gradient(135deg, #0a1628 0%, #162040 50%, #1a1040 100%);
  padding: 28rpx 24rpx 20rpx;
  flex-shrink: 0;
  overflow: hidden;
}
.batch-header-bg {
  position: absolute;
  top: -50%;
  left: -20%;
  width: 250rpx;
  height: 250rpx;
  background: radial-gradient(circle, rgba(153, 69, 255, 0.15) 0%, transparent 70%);
  border-radius: 50%;
}
.batch-header-content {
  display: flex;
  align-items: center;
  gap: 16rpx;
  position: relative;
  z-index: 2;
}
.batch-header-icon {
  width: 64rpx;
  height: 64rpx;
  background: linear-gradient(135deg, rgba(153, 69, 255, 0.2) 0%, rgba(120, 40, 200, 0.1) 100%);
  border: 1rpx solid rgba(153, 69, 255, 0.3);
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.header-icon {
  font-size: 32rpx;
}
.batch-header-info {
  flex: 1;
}
.batch-header-title {
  font-size: 30rpx;
  font-weight: 800;
  color: #fff;
  display: block;
  letter-spacing: 1rpx;
}
.batch-header-sub {
  font-size: 20rpx;
  color: rgba(153, 69, 255, 0.6);
  display: block;
  margin-top: 4rpx;
}
.batch-close-btn {
  width: 48rpx;
  height: 48rpx;
  background: rgba(255, 255, 255, 0.08);
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}
.batch-close-btn .close-icon {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.5);
}

/* 统计标签 */
.batch-stats {
  display: flex;
  gap: 12rpx;
  margin-top: 16rpx;
  position: relative;
  z-index: 2;
}
.stat-pill {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 6rpx 14rpx;
  background: rgba(255, 255, 255, 0.06);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 20rpx;
}
.stat-pill.active {
  background: rgba(153, 69, 255, 0.15);
  border-color: rgba(153, 69, 255, 0.3);
}
.stat-icon {
  font-size: 16rpx;
}
.stat-text {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.6);
  font-weight: 600;
}
.stat-pill.active .stat-text {
  color: #9945ff;
}

/* 批量管理主体 */
.batch-modal-body {
  padding: 20rpx 24rpx;
  flex: 1;
}

/* 全选操作 */
.batch-select-actions {
  display: flex;
  justify-content: flex-end;
  margin-bottom: 12rpx;
}
.select-all-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 16rpx;
  background: rgba(153, 69, 255, 0.1);
  border: 1rpx solid rgba(153, 69, 255, 0.2);
  border-radius: 20rpx;
  transition: all 0.2s cubic-bezier(0.25, 0.8, 0.25, 1);
}
.select-all-btn:active {
  background: rgba(153, 69, 255, 0.2);
  transform: scale(0.95);
}
.check-icon {
  width: 24rpx;
  height: 24rpx;
  border: 2rpx solid rgba(153, 69, 255, 0.4);
  border-radius: 6rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 16rpx;
  color: #fff;
  transition: all 0.2s cubic-bezier(0.25, 0.8, 0.25, 1);
}
.check-icon.checked {
  background: #9945ff;
  border-color: #9945ff;
}
.select-text {
  font-size: 22rpx;
  color: rgba(153, 69, 255, 0.8);
  font-weight: 600;
}

/* 批量列表项 */
.batch-scroll {
  border-radius: 16rpx;
  background: rgba(0, 0, 0, 0.1);
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  padding: 8rpx;
}
.batch-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx;
  background: rgba(0, 0, 0, 0.1);
  border: 1rpx solid rgba(255, 255, 255, 0.04);
  border-radius: 12rpx;
  margin-bottom: 8rpx;
  transition: all 0.2s cubic-bezier(0.25, 0.8, 0.25, 1);
}
.batch-item:active {
  background: rgba(153, 69, 255, 0.1);
  border-color: rgba(153, 69, 255, 0.2);
}
.batch-item-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex: 1;
  min-width: 0;
}
.batch-checkbox {
  width: 36rpx;
  height: 36rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.2);
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s cubic-bezier(0.25, 0.8, 0.25, 1);
  flex-shrink: 0;
}
.batch-checkbox.checked {
  background: #9945ff;
  border-color: #9945ff;
  box-shadow: 0 0 8rpx rgba(153, 69, 255, 0.3);
}
.checkbox-icon {
  font-size: 20rpx;
  color: #fff;
  font-weight: bold;
}
.batch-item-name {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.batch-item-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.batch-item-price {
  font-size: 22rpx;
  color: #9945ff;
  font-weight: 700;
  font-family: 'DIN Alternate', monospace;
}
.batch-arrow {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.2);
}

/* 编辑表单 */
.batch-edit-form {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

/* 商品预览卡片 */
.batch-preview-card {
  display: flex;
  gap: 16rpx;
  padding: 16rpx;
  background: rgba(0, 0, 0, 0.2);
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  border-radius: 16rpx;
  margin-bottom: 8rpx;
}
.batch-preview-image {
  width: 100rpx;
  height: 100rpx;
  border-radius: 12rpx;
  overflow: hidden;
  flex-shrink: 0;
  background: rgba(0, 0, 0, 0.2);
}
.batch-preview-image .preview-img {
  width: 100%;
  height: 100%;
}
.preview-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}
.placeholder-icon {
  font-size: 36rpx;
  opacity: 0.3;
}
.batch-preview-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}
.preview-name {
  font-size: 28rpx;
  font-weight: 700;
  color: #fff;
}
.preview-price {
  font-size: 24rpx;
  color: #9945ff;
  font-weight: 700;
  font-family: 'DIN Alternate', monospace;
}

/* 表单区块 */
.batch-form-section {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.form-row {
  display: flex;
  gap: 16rpx;
}
.form-field {
  flex: 1;
}
.form-field.full {
  width: 100%;
}
.field-label {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.4);
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 1rpx;
  margin-bottom: 8rpx;
  display: block;
}
.field-input {
  width: 100%;
  height: 72rpx;
  background: rgba(0, 0, 0, 0.2);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 12rpx;
  padding: 0 16rpx;
  font-size: 24rpx;
  color: #fff;
  box-sizing: border-box;
  transition: border-color 0.2s cubic-bezier(0.25, 0.8, 0.25, 1);
}
.field-input:focus {
  border-color: rgba(153, 69, 255, 0.4);
}
.field-picker {
  width: 100%;
  height: 72rpx;
  background: rgba(0, 0, 0, 0.2);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 12rpx;
  padding: 0 16rpx;
  font-size: 24rpx;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
}

/* 图片上传行 */
.image-upload-row {
  display: flex;
  gap: 8rpx;
}
.image-upload-row .field-input.flex {
  flex: 1;
}
.upload-action-btn {
  width: 72rpx;
  height: 72rpx;
  background: rgba(153, 69, 255, 0.1);
  border: 1rpx solid rgba(153, 69, 255, 0.25);
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s cubic-bezier(0.25, 0.8, 0.25, 1);
}
.upload-action-btn:active {
  background: rgba(153, 69, 255, 0.2);
  transform: scale(0.95);
}
.upload-action-btn .btn-icon {
  font-size: 24rpx;
}

/* 图片预览 */
.image-preview-mini {
  position: relative;
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  overflow: hidden;
  margin-top: 12rpx;
  border: 1rpx solid rgba(153, 69, 255, 0.2);
}
.image-preview-mini .preview-img {
  width: 100%;
  height: 100%;
}
.image-preview-mini .remove-btn {
  position: absolute;
  top: 6rpx;
  right: 6rpx;
  width: 32rpx;
  height: 32rpx;
  background: rgba(255, 71, 87, 0.8);
  color: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
