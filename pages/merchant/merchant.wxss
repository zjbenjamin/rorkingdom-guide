/* 弹窗基础 */
.modal-mask { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,2,12,0.8); backdrop-filter: blur(24rpx); -webkit-backdrop-filter: blur(24rpx); z-index: 10000; display: flex; align-items: flex-end; opacity: 0; animation: maskFadeIn 0.3s ease-out forwards; }
@keyframes maskFadeIn { from { opacity: 0; } to { opacity: 1; } }
.modal-box { width: 100%; background: rgba(16, 20, 48, 0.98); border-top: 1rpx solid rgba(255, 255, 255, 0.12); border-radius: 40rpx 40rpx 0 0; padding: 40rpx 32rpx; max-height: 92vh; display: flex; flex-direction: column; box-shadow: 0 -12rpx 60rpx rgba(0,0,0,0.6), inset 0 1rpx 0 rgba(255,255,255,0.06); box-sizing: border-box; transform: translateY(100%); animation: modalSlideUp 0.35s cubic-bezier(0.16,1,0.3,1) forwards; }
@keyframes modalSlideUp { from { transform: translateY(100%); } to { transform: translateY(0); } }
.modal-box.glass-modal { background: linear-gradient(180deg, rgba(20,24,48,0.98) 0%, rgba(10,14,32,0.99) 100%); border-top: 1rpx solid rgba(153,69,255,0.2); }

/* 弹窗关闭动效 */
.modal-mask.closing { animation: maskFadeOut 0.25s ease-in forwards; }
@keyframes maskFadeOut { from { opacity: 1; } to { opacity: 0; } }
.modal-mask.closing .modal-box { animation: modalSlideDown 0.25s ease-in forwards; }
@keyframes modalSlideDown { from { transform: translateY(0); } to { transform: translateY(100%); } }

.modal-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 40rpx; flex-shrink: 0; }
.modal-title-box { display: flex; align-items: center; gap: 16rpx; }
.modal-title-line { width: 6rpx; height: 32rpx; background: linear-gradient(to bottom, #00d4ff, #9945ff); border-radius: 3rpx; }
.modal-title { font-size: 34rpx; font-weight: 700; color: #fff; letter-spacing: 1rpx; }
.modal-close { font-size: 40rpx; color: rgba(255,255,255,0.3); padding: 10rpx; transition: color 0.2s cubic-bezier(0.25, 0.8, 0.25, 1); }
