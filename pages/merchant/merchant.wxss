  background: rgba(0, 212, 255, 0.1);
  border: 1rpx solid rgba(0, 212, 255, 0.25);
  border-radius: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  flex-shrink: 0;
  transition: all 0.2s cubic-bezier(0.25, 0.8, 0.25, 1);
  box-sizing: border-box;
}
.image-action-btn-mini:active {
  background: rgba(0, 212, 255, 0.2);
  transform: scale(0.96);
}
.action-icon-mini {
  font-size: 22rpx;
}
.action-text-mini {
  font-size: 20rpx;
  color: #00d4ff;
  font-weight: 600;
}
.modal-input.mini {
  flex: 1;
  height: 60rpx;
  min-height: 60rpx;
  border-radius: 10rpx;
  padding: 0 16rpx;
  font-size: 22rpx;
  background: rgba(0, 0, 0, 0.2);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
}
.modal-input.mini:focus {
  border-color: rgba(0, 212, 255, 0.4);
}
.selling-edit-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 180rpx;
}
.selling-edit-empty-text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.3);
}
.selling-edit-add-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 80rpx;
  background: rgba(0, 212, 255, 0.05);
  border: 1px dashed rgba(0, 212, 255, 0.25);
  border-radius: 16rpx;
  font-size: 26rpx;
  color: #00d4ff;
  font-weight: 600;
  margin-top: 20rpx;
  transition: all 0.2s cubic-bezier(0.25, 0.8, 0.25, 1);
}
.selling-edit-add-btn:active {
  background: rgba(0, 212, 255, 0.12);
  transform: scale(0.98);
}

/* ===== 上架弹窗全新UI ===== */
.selling-modal-box {
  padding: 0 !important;
  overflow: hidden;
}

/* 粘性头部 */
.selling-modal-header {
  position: relative;
  background: linear-gradient(135deg, #0a1628 0%, #162040 50%, #1a1040 100%);
  padding: 32rpx 28rpx 24rpx;
  flex-shrink: 0;
  overflow: hidden;
}
.selling-header-bg {
  position: absolute;
  top: -50%;
  right: -20%;
  width: 300rpx;
  height: 300rpx;
  background: radial-gradient(circle, rgba(0, 212, 255, 0.15) 0%, transparent 70%);
  border-radius: 50%;
  pointer-events: none;
}
.selling-header-content {
  display: flex;
  align-items: center;
  gap: 20rpx;
  position: relative;
  z-index: 2;
}
.selling-header-icon {
  width: 80rpx;
  height: 80rpx;
  background: linear-gradient(135deg, rgba(0, 212, 255, 0.2) 0%, rgba(0, 180, 255, 0.1) 100%);
  border: 1rpx solid rgba(0, 212, 255, 0.3);
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 212, 255, 0.15);
}
.selling-header-info {
  flex: 1;
}
.selling-header-title {
  font-size: 36rpx;
  font-weight: 800;
  color: #fff;
  display: block;
  letter-spacing: 2rpx;
}
.selling-header-sub {
  font-size: 22rpx;
  color: rgba(0, 212, 255, 0.6);
  display: block;
  margin-top: 6rpx;
}
.selling-close-btn {
  width: 56rpx;
  height: 56rpx;
  background: rgba(255, 255, 255, 0.08);
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s cubic-bezier(0.25, 0.8, 0.25, 1);
}
.selling-close-btn:active {
  background: rgba(255, 71, 87, 0.2);
  border-color: rgba(255, 71, 87, 0.4);
}
.selling-close-btn .close-icon {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.5);
}

/* 统计条 */
.selling-stats-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0;
  margin-top: 24rpx;
  padding: 16rpx 24rpx;
  background: rgba(0, 0, 0, 0.2);
  border-radius: 16rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  position: relative;
  z-index: 2;
}
.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}
.stat-num {
  font-size: 32rpx;
  font-weight: 800;
  color: #00d4ff;
  font-family: 'DIN Alternate', monospace;
}
.stat-label {
  font-size: 18rpx;
  color: rgba(255, 255, 255, 0.4);
  text-transform: uppercase;
  letter-spacing: 1rpx;
}
.stat-divider {
  width: 1rpx;
  height: 48rpx;
  background: rgba(255, 255, 255, 0.1);
}

/* 模态框主体 */
.selling-modal-body {
  padding: 24rpx 28rpx;
  flex: 1;
}

/* 区块样式 */
.selling-section {
  margin-bottom: 28rpx;
}
.section-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
}
.section-icon {
  font-size: 28rpx;
}
.section-title {
  font-size: 26rpx;
  font-weight: 700;
  color: rgba(255, 255, 255, 0.9);
  flex: 1;
}
.section-badge {
  padding: 4rpx 12rpx;
  background: rgba(0, 212, 255, 0.15);
  border: 1rpx solid rgba(0, 212, 255, 0.3);
  border-radius: 20rpx;
}
.section-badge .badge-text {
  font-size: 18rpx;
  font-weight: 700;
  color: #00d4ff;
}
.section-tag {
  padding: 4rpx 12rpx;
  background: rgba(255, 171, 64, 0.15);
  border: 1rpx solid rgba(255, 171, 64, 0.3);
  border-radius: 20rpx;
  font-size: 18rpx;
  color: #ffab40;
  font-weight: 600;
}

/* 商品编辑列表 */
.selling-edit-scroll {
  border-radius: 20rpx;
  background: rgba(0, 0, 0, 0.15);
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  padding: 16rpx;
}
.selling-edit-list {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}
.selling-edit-card {
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.04) 0%, rgba(255, 255, 255, 0.01) 100%);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 20rpx;
  padding: 16rpx;
  position: relative;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.15);
  transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  overflow: hidden;
}
.selling-edit-card:active {
  transform: scale(0.98);
  border-color: rgba(0, 212, 255, 0.3);
}

/* 卡片头部 */
.card-top-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}
.card-index {
  font-size: 18rpx;
  color: rgba(255, 255, 255, 0.2);
  font-weight: 700;
  font-family: 'DIN Alternate', monospace;
}

/* 图片区域 */
.card-image-area {
  margin-bottom: 12rpx;
}
.card-image-area .image-upload-box.mini {
  width: 100%;
  height: 140rpx;
  border-radius: 12rpx;
  overflow: hidden;
  position: relative;
}
.card-image-area .image-upload-box.mini.empty {
  background: rgba(0, 0, 0, 0.2);
  border: 1rpx dashed rgba(255, 255, 255, 0.12);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}
.card-image-area .upload-icon {
  font-size: 32rpx;
}
.card-image-area .upload-text {
  font-size: 18rpx;
  color: rgba(255, 255, 255, 0.3);
}
.card-image-area .preview-img {
  width: 100%;
  height: 100%;
}
.card-image-area .image-remove-btn {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 36rpx;
  height: 36rpx;
  background: rgba(255, 71, 87, 0.8);
  color: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18rpx;
  z-index: 10;
}

/* 商品信息 */
.card-info-area {
  margin-bottom: 12rpx;
}
.card-item-name {
  font-size: 24rpx;
  font-weight: 700;
  color: #fff;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-bottom: 4rpx;
}
.card-item-price {
  font-size: 22rpx;
  font-weight: 800;
  color: #00d4ff;
  font-family: 'DIN Alternate', monospace;
}

/* 操作区域 */
.card-actions-area {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}
.card-input {
  width: 100%;
  height: 48rpx;
  background: rgba(0, 0, 0, 0.2);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 8rpx;
  padding: 0 12rpx;
  font-size: 20rpx;
  color: #fff;
  box-sizing: border-box;
  transition: border-color 0.2s cubic-bezier(0.25, 0.8, 0.25, 1);
}
.card-input:focus {
  border-color: rgba(0, 212, 255, 0.4);
}
.card-input.small {
  flex: 1;
}
.card-action-row {
  display: flex;
  gap: 8rpx;
}
.card-upload-btn {
  width: 48rpx;
  height: 48rpx;
  background: rgba(0, 212, 255, 0.15);
  border: 1rpx solid rgba(0, 212, 255, 0.3);
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s cubic-bezier(0.25, 0.8, 0.25, 1);
}
.card-upload-btn:active {
  background: rgba(0, 212, 255, 0.3);
  transform: scale(0.95);
}
.card-upload-btn .btn-icon {
  font-size: 20rpx;
}

/* 空状态 */
.selling-edit-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 200rpx;
  gap: 12rpx;
}
.empty-icon {
  font-size: 48rpx;
  opacity: 0.5;
}
.empty-text {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.4);
  font-weight: 600;
}
.empty-hint {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.2);
}

/* 下架时间卡片 */
.offline-time-card {
  background: rgba(0, 0, 0, 0.15);
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  border-radius: 16rpx;
  padding: 20rpx;
}
.time-picker-row {
  display: flex;
  gap: 16rpx;
}
.time-picker-btn {
  flex: 1;
  height: 72rpx;
  background: rgba(0, 0, 0, 0.2);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 0 16rpx;
  transition: all 0.2s cubic-bezier(0.25, 0.8, 0.25, 1);
}
.time-picker-btn:active {
  border-color: rgba(0, 212, 255, 0.4);
  background: rgba(0, 212, 255, 0.05);
}
.time-picker-btn.disabled {
  opacity: 0.4;
}
.time-picker-btn .picker-icon {
  font-size: 24rpx;
}
.time-picker-btn .picker-text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
}

/* 下架提示 */
.offline-hint {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 16rpx;
  padding: 12rpx 16rpx;
  background: rgba(0, 212, 255, 0.06);
  border-radius: 10rpx;
  border: 1rpx solid rgba(0, 212, 255, 0.15);
}
.offline-hint.empty {
  background: rgba(255, 255, 255, 0.03);
  border-color: rgba(255, 255, 255, 0.06);
}
.offline-hint .hint-icon {
  font-size: 20rpx;
}
.offline-hint .hint-text {
  font-size: 20rpx;
  color: rgba(0, 212, 255, 0.7);
  flex: 1;
}
.offline-hint.empty .hint-text {
  color: rgba(255, 255, 255, 0.3);
}
.offline-hint .clear-btn {
  font-size: 20rpx;
  color: #ff4757;
  padding: 4rpx 12rpx;
  background: rgba(255, 71, 87, 0.1);
  border-radius: 8rpx;
  font-weight: 600;
}

/* 底部操作栏 */
.selling-modal-footer {
  padding: 20rpx 28rpx;
  padding-bottom: calc(20rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(0, 0, 0, 0.2);
  border-top: 1rpx solid rgba(255, 255, 255, 0.06);
  flex-shrink: 0;
}
.footer-notify {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 12rpx 16rpx;
  background: rgba(255, 171, 64, 0.08);
  border: 1rpx solid rgba(255, 171, 64, 0.15);
  border-radius: 12rpx;
  margin-bottom: 16rpx;
}
.notify-pulse {
  width: 12rpx;
  height: 12rpx;
  background: #ffab40;
  border-radius: 50%;
  animation: pulse 2s infinite;
}
@keyframes pulse {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.5; transform: scale(0.8); }
}
.footer-notify .notify-text {
  font-size: 22rpx;
  color: #ffab40;
  font-weight: 500;
}
.footer-btns {
  display: flex;
  gap: 16rpx;
}
.btn-push {
  flex: 1.5 !important;
  height: 88rpx !important;
  background: linear-gradient(135deg, #00b4ff 0%, #0081ff 100%) !important;
  border: none !important;
  border-radius: 20rpx !important;
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  gap: 10rpx !important;
  box-shadow: 0 8rpx 24rpx rgba(0, 180, 255, 0.3) !important;
  transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1) !important;
}
.btn-push:active {
  transform: translateY(2rpx) !important;
  box-shadow: 0 4rpx 12rpx rgba(0, 180, 255, 0.2) !important;
}
.btn-push[disabled] {
  opacity: 0.5 !important;
  background: #333 !important;
  box-shadow: none !important;
}
.btn-push .btn-icon {
  font-size: 28rpx;
}
.btn-push .btn-text {
  font-size: 28rpx;
  font-weight: 700;
  color: #fff;
}
.btn-silent {
  flex: 1 !important;
  height: 88rpx !important;
  background: rgba(255, 255, 255, 0.06) !important;
  border: 1rpx solid rgba(255, 255, 255, 0.12) !important;
  border-radius: 20rpx !important;
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  gap: 10rpx !important;
  transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1) !important;
}
.btn-silent:active {
  background: rgba(255, 255, 255, 0.1) !important;
  transform: translateY(2rpx) !important;
}
.btn-silent.disabled {
  opacity: 0.5 !important;
}
.btn-silent .btn-icon {
  font-size: 24rpx;
}
.btn-silent .btn-text {
  font-size: 24rpx;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.6);
}
.footer-hint {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.25);
  text-align: center;
  margin-top: 12rpx;
  display: block;
}

/* 商品预览信息 */
.item-preview-info {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: rgba(0, 0, 0, 0.2);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 12rpx;
  padding: 16rpx;
}

.item-preview-info .item-badge {
  font-size: 20rpx;
  padding: 4rpx 8rpx;
  border-radius: 8rpx;
}

.item-preview-info .item-name {
  font-size: 24rpx;
  font-weight: 600;
  color: #fff;
}

.item-preview-info .item-price {
  font-size: 22rpx;
  color: #00d4ff;
  margin-left: auto;
}

/* ===== 正在售卖分组布局样式 ===== */
.selling-group-section {
  margin-bottom: 32rpx;
  position: relative;
  animation: groupFadeIn 0.4s cubic-bezier(0.16, 1, 0.3, 1) both;
}
.selling-group-section:last-child {
  margin-bottom: 12rpx;
}
@keyframes groupFadeIn {
  from { opacity: 0; transform: translateY(10rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.selling-group-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 18rpx;
  padding: 6rpx 8rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.03);
}

.group-header-icon {
  font-size: 26rpx;
  text-shadow: 0 0 10rpx rgba(255, 171, 64, 0.3);
  animation: headerIconPulse 2s infinite alternate;
}
@keyframes headerIconPulse {
  0% { transform: scale(1); opacity: 0.8; }
  100% { transform: scale(1.1); opacity: 1; }
}

.group-header-title {
  font-size: 24rpx;
  font-weight: 800;
  color: #fff;
  letter-spacing: 1rpx;
  background: linear-gradient(90deg, #ffffff 0%, rgba(255, 255, 255, 0.8) 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

.group-header-desc {
  font-size: 18rpx;
  color: rgba(255, 255, 255, 0.4);
  font-weight: 500;
}
