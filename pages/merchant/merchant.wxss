.admin-control-info { flex: 1; }
.admin-control-name { font-size: 26rpx; font-weight: 700; color: rgba(255, 255, 255, 0.9); display: block; }
.admin-control-desc { font-size: 20rpx; color: rgba(255, 255, 255, 0.4); display: block; margin-top: 4rpx; }
.admin-btn { padding: 14rpx 28rpx; background: linear-gradient(135deg, rgba(0, 212, 255, 0.15) 0%, rgba(0, 212, 255, 0.05) 100%); border: 1rpx solid rgba(0, 212, 255, 0.3); border-radius: 16rpx; font-size: 24rpx; font-weight: 700; color: #00d4ff; white-space: nowrap; transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1); box-shadow: 0 4rpx 12rpx rgba(0, 212, 255, 0.15), inset 0 1rpx 0 rgba(255, 255, 255, 0.1); display: flex; align-items: center; justify-content: center; backdrop-filter: blur(8px); }
.admin-btn:active { background: linear-gradient(135deg, rgba(0, 212, 255, 0.25) 0%, rgba(0, 212, 255, 0.1) 100%); transform: translateY(2rpx) scale(0.96); box-shadow: 0 2rpx 6rpx rgba(0, 212, 255, 0.2), inset 0 1rpx 0 rgba(255, 255, 255, 0.05); }

/* 订阅 */
.subscribe-row { display: flex; align-items: center; justify-content: space-between; }
.subscribe-info { flex: 1; }
.subscribe-title { font-size: 26rpx; font-weight: 600; color: #fff; display: block; }
.subscribe-desc { font-size: 20rpx; color: rgba(255,255,255,0.45); display: block; margin-top: 4rpx; }

/* 商品订阅列表 */
.sub-list-card { padding: 28rpx !important; }
.sub-item-scroll { margin-top: 20rpx; padding-right: 4rpx; }
.sub-item-row { display: flex; align-items: center; justify-content: space-between; padding: 16rpx 12rpx; border-bottom: 1rpx solid rgba(255,255,255,0.04); }
