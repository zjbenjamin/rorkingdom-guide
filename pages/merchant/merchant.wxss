}
.filter-chip {
  padding: 8rpx 14rpx;
  background: rgba(0, 0, 0, 0.2);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 20rpx;
  transition: all 0.2s cubic-bezier(0.25, 0.8, 0.25, 1);
}
.filter-chip:active {
