}
.batch-btn.manage {
  background: linear-gradient(135deg, #9945ff 0%, #7828c8 100%) !important;
  border: none !important;
  color: #fff !important;
  box-shadow: 0 4rpx 16rpx rgba(153, 69, 255, 0.3) !important;
}
.batch-btn.manage[disabled] {
  opacity: 0.5 !important;
