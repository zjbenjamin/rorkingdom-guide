  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.search-clear .clear-icon {
  font-size: 18rpx;
  color: rgba(255, 255, 255, 0.5);
}

/* 排序筛选按钮行 */
.sort-filter-row {
  display: flex;
  gap: 12rpx;
  align-items: flex-start;
}

/* 排序按钮 */
.sort-btn {
