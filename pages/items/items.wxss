.page {
  min-height: 100vh;
  background: #010314;
}
.container {
  padding: 40rpx;
}
.header {
  text-align: center;
  margin-bottom: 60rpx;
}
.title {
  font-size: 40rpx;
  font-weight: bold;
  color: #fff;
  display: block;
}
.subtitle {
  font-size: 28rpx;
  color: rgba(255,255,255,0.6);
  display: block;
  margin-top: 16rpx;
}
.content {
  display: flex;
  justify-content: center;
  align-items: center;
  min-height: 400rpx;
}
.placeholder {
  font-size: 32rpx;
  color: rgba(255,255,255,0.4);
}
