<view class="page {{padLayoutClass}}" style="padding-top: {{safeTop}}px;">
  <!-- 童话粒子特效 -->
  <view class="fairytale-overlay" wx:if="{{showFairytaleParticles}}">
    <view class="fairytale-particle p1">🧚</view>
    <view class="fairytale-particle p2">✨</view>
    <view class="fairytale-particle p3">🌟</view>
    <view class="fairytale-particle p4">🦋</view>
    <view class="fairytale-particle p5">🌸</view>
    <view class="fairytale-particle p6">⭐</view>
    <view class="fairytale-particle p7">🪄</view>
    <view class="fairytale-particle p8">✨</view>
    <view class="fairytale-particle p9">🌙</view>
    <view class="fairytale-particle p10">🦋</view>
    <view class="fairytale-particle p11">🦄</view>
    <view class="fairytale-particle p12">⭐</view>
    <view class="fairytale-glow"></view>
  </view>
    <view class="capture-overlay" wx:if="{{captureAnim}}">
    <image class="capture-shiny-badge" src="https://patchwiki.biligame.com/images/rocom/2/2e/buxc6y4s0r7d8ix03zzkahnk4h8urtv.png" mode="aspectFit"></image>
  </view>
  <view class="capture-overlay" wx:if="{{missAnim}}">
    <image class="miss-anim-badge" src="https://patchwiki.biligame.com/images/rocom/4/4f/20dseynhfc393c6jys1rnwhwwf94xvv.png" mode="aspectFit"></image>
  </view>
  <!-- 龙龙骰粒子与中心翻转动画 -->
  <view class="fairytale-overlay" wx:if="{{showDiceParticles}}">
    <view class="fairytale-particle p1"><image class="particle-dice-img" src="https://img.remit.ee/i/bpUFDBGUtlOi" mode="aspectFit" /></view>
    <view class="fairytale-particle p2">✨</view>
    <view class="fairytale-particle p3"><image class="particle-dice-img" src="https://img.remit.ee/i/AincnIOhIo24" mode="aspectFit" /></view>
    <view class="fairytale-particle p4">🌟</view>
    <view class="fairytale-particle p5"><image class="particle-dice-img" src="https://img.remit.ee/i/gtBOE570SHS4" mode="aspectFit" /></view>
    <view class="fairytale-particle p6">✨</view>
    <view class="fairytale-particle p7"><image class="particle-dice-img" src="https://img.remit.ee/i/VWTgWa0JFPeC" mode="aspectFit" /></view>
    <view class="fairytale-particle p8">⭐</view>
    <view class="fairytale-particle p9"><image class="particle-dice-img" src="https://img.remit.ee/i/bpUFDBGUtlOi" mode="aspectFit" /></view>
    <view class="fairytale-particle p10">✨</view>
    <view class="fairytale-particle p11"><image class="particle-dice-img" src="https://img.remit.ee/i/AincnIOhIo24" mode="aspectFit" /></view>
    <view class="fairytale-particle p12">🌟</view>
    <view class="fairytale-glow"></view>
  </view>
  <view class="capture-overlay" wx:if="{{diceAnim}}">
    <image class="dice-anim-img" src="{{diceAnimImg || 'https://img.remit.ee/i/bpUFDBGUtlOi'}}" mode="aspectFit"></image>
  </view>
  <view class="container">
    <!-- 异色捕捉主监控屏 -->
     <view class="premium-card monitor-panel tint-blue">
      <!-- 动效可视化动态条 -->
      <view class="visual-bars">
        <view class="v-bar"></view>
        <view class="v-bar"></view>
        <view class="v-bar"></view>
        <view class="v-bar"></view>
        <view class="v-bar"></view>
      </view>

        <view class="panel-header">
          <view class="panel-title" style="flex-direction: row; align-items: center; gap: 16rpx;">
            <text class="title-main" style="font-size: 32rpx;">{{_l.catchTitleLive}}</text>
            <view class="sync-badge">
              <view class="sync-dot"></view>
              <text>{{sysVersion}}</text>
            </view>
          </view>
          <view class="capsule-btn ghost sm" bindtap="onClearEncounter">{{_l.catchResetData}}</view>
        </view>

      <view wx:if="{{!canStartCapture}}" class="init-loading">
        <view class="radar-scan"></view>
        <view class="init-icon">📡</view>
        <view class="init-text">
          <text class="glitch-text">{{_l.catchWaitSync}}</text>
          <text class="init-sub">{{_l.catchInitHint}}</text>
        </view>
      </view>

      <block wx:if="{{canStartCapture}}">
        <view class="stats-grid">
          <view class="stat-card total">
            <text class="stat-label">{{_l.catchEncounterCount}}</text>
            <text class="stat-value">{{luckyBoxCount}}</text>
          </view>
          <view class="stat-card carnival">
            <view style="display:flex; align-items:center; justify-content:center; gap:6rpx;">
              <image src="https://img.remit.ee/i/bpUFDBGUtlOi" style="width:28rpx; height:28rpx; flex-shrink:0;" mode="aspectFit"></image>
              <text class="stat-label">{{_l.catchCarnival}}</text>
            </view>
            <view style="display:flex; align-items:center; justify-content:center; gap:8rpx;">
              <image src="https://img.remit.ee/i/bpUFDBGUtlOi" style="width:38rpx; height:38rpx; flex-shrink:0;" mode="aspectFit"></image>
              <text class="stat-value">{{carnivalCount}}</text>
            </view>
          </view>
          <view class="stat-card lucky">
            <text class="stat-label">{{_l.catchLuckyBox}}</text>
            <text class="stat-value">{{luckyBoxCount}}</text>
          </view>
        </view>

        <view class="progress-section">
          <view class="section-meta">
            <view class="section-title-group" style="display:flex; align-items:center;">
              <text>{{_l.catchPityTitle}}</text>
              <view class="mode-tag {{autoResetPity?'active':''}}" bindtap="toggleAutoResetPity" style="margin-left:20rpx;">
                <view class="tag-dot"></view>
                <text>{{autoResetPity?_l.catchAutoReset:_l.catchManualReset}}</text>
              </view>
              <view class="mode-tag {{continuePity?'active':''}}" bindtap="toggleContinuePity" wx:if="{{autoResetPity}}" style="margin-left:8rpx;">
                <view class="tag-dot"></view>
                <text>{{continuePity ? _l.catchContinueEnable : _l.catchContinueDisable}}</text>
              </view>
            </view>
            <text class="meta-val">{{pityCount}} / 80</text>
          </view>
          <view class="pity-bar-wrapper">
            <view class="pity-track">
              <view class="pity-fill {{pityCount >= 70 ? 'danger' : pityCount >= 40 ? 'warning' : ''}}" style="width: {{pityCount / 80 * 100}}%"></view>
            </view>
          </view>
          <view class="pity-status" bindtap="onClearPity">
            <text class="status-emoji">{{pityEmoji}}</text>
            <text class="status-text">{{pityHint}}</text>
            <text class="manual-reset-hint" style="font-size:18rpx; color:rgba(255,255,255,0.3); margin-left:10rpx;">({{_l.catchManualReset}})</text>
          </view>
        </view>

        <view class="control-grid">
          <view class="visual-action-btn box-btn" bindtap="onAddLuckyBox" bindlongpress="onLuckyBoxLongPress">
            <text class="btn-icon">📖</text>
            <text class="btn-text">{{_l.catchLuckyBox}}</text>
          </view>
          <view class="visual-action-btn carnival-btn" bindtap="onAddCarnival" bindlongpress="onCarnivalLongPress">
            <image class="btn-icon-img" src="https://img.remit.ee/i/AincnIOhIo24" mode="aspectFit"></image>
            <text class="btn-text">{{_l.catchCarnival}}</text>
          </view>
          <view class="visual-action-btn capture-btn" bindtap="onResult" bindlongpress="onLongResult" data-r="success">
            <image class="btn-icon-img" src="https://patchwiki.biligame.com/images/rocom/2/2e/buxc6y4s0r7d8ix03zzkahnk4h8urtv.png" mode="aspectFit"></image>
            <text class="btn-text">{{_l.catchSuccessBtn}}</text>
          </view>
          <view class="visual-action-btn miss-btn" bindtap="onUseDice">
            <image class="btn-icon-img" src="https://img.remit.ee/i/bpUFDBGUtlOi" mode="aspectFit"></image>
            <text class="btn-text">{{_l.catchUseDiceBtn}}</text>
          </view>
        </view>
        <view class="help-hint" style="display:flex; align-items:center; justify-content:center; gap:8rpx;">
          <image src="https://img.remit.ee/i/bpUFDBGUtlOi" style="width:26rpx; height:26rpx; flex-shrink:0;" mode="aspectFit"></image>
          <text>{{_l.catchCarnivalHint}}</text>
        </view>
        <view wx:if="{{sessionUsedDice}}" style="margin-top: 12rpx; padding: 10rpx 20rpx; border-radius: 12rpx; background: rgba(251, 191, 36, 0.14); border: 1rpx solid rgba(251, 191, 36, 0.45); display: flex; align-items: center; justify-content: center; gap: 10rpx;">
          <image src="https://img.remit.ee/i/bpUFDBGUtlOi" style="width: 30rpx; height: 30rpx; flex-shrink: 0;" mode="aspectFit"></image>
          <text style="font-size: 22rpx; color: #ffd54f; font-weight: bold;">本次已启用「异色龙龙骰染色」· 不占保底和奇遇 · 生成图将明示</text>
        </view>
      </block>
    </view>

    <!-- 洛克贝核心资产看板 -->
    <view class="premium-card wealth-panel tint-warm">
      <view class="panel-header">
        <view style="display:flex; align-items:center; gap:12rpx;">
          <image src="https://r2.image-upload.app/ptImg/yhJkDL2B.png" style="width:40rpx; height:40rpx;" mode="aspectFit"></image>
          <text class="panel-title" style="flex-direction:row;">{{_l.catchWealthPanel}}</text>
        </view>
        <view class="mode-tag {{quickRecordMode?'active':''}}" bindtap="toggleQuickRecord">
          <view class="tag-dot"></view>
          <text>{{quickRecordMode ? _l.catchAutoDeduct : _l.catchManualDeduct}}</text>
        </view>
      </view>
      
      <view class="init-form" wx:if="{{!wealthSet}}">
        <input class="premium-input" placeholder="{{_l.catchInitCoin}}" type="number" value="{{coinInput}}" bindinput="onWealthInput" />
        <view class="visual-btn-primary" bindtap="onSetWealth">{{_l.catchInitAsset}}</view>
      </view>

      <view class="wealth-main" wx:if="{{wealthSet}}">
        <view class="wealth-label-group">
          <text class="label-main">{{_l.catchCurrentAsset}}</text>
          <text class="label-sub">{{_l.catchInitialAmount}}: {{initialWealth}}</text>
        </view>
        <view class="wealth-display">
          <view class="value-group" style="display:flex; align-items:center;">
            <image src="https://r2.image-upload.app/ptImg/yhJkDL2B.png" style="width:48rpx; height:48rpx; margin-right:8rpx;" mode="aspectFit"></image>
            <text class="amount">{{totalWealth}}</text>
          </view>
        </view>
      </view>

      <view wx:if="{{wealthSet && lastWealthAdjust}}" style="margin: 0 0 18rpx; padding: 14rpx 20rpx; border-radius: 12rpx; background: rgba(0,0,0,0.22); border: 1rpx solid rgba(255,255,255,0.08); display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 8rpx; font-size: 22rpx;">
        <text style="color: #94a3b8;">上次 <text style="color:#e2e8f0; font-weight:bold;">{{lastWealthAdjust.prevWealth}}</text> → 本次 <text style="color:#e2e8f0; font-weight:bold;">{{lastWealthAdjust.newWealth}}</text></text>
        <view style="display:flex; gap:16rpx;">
          <text style="color: {{lastWealthAdjust.incVal > 0 ? '#4ade80' : '#64748b'}}; font-weight: bold;">增加 +{{lastWealthAdjust.incVal || 0}}</text>
          <text style="color: {{lastWealthAdjust.decVal > 0 ? '#f87171' : '#64748b'}}; font-weight: bold;">减少 -{{lastWealthAdjust.decVal || 0}}</text>
        </view>
      </view>

      <view class="profit-summary" wx:if="{{wealthSet}}">
        <view class="summary-item">
          <text class="item-label">{{_l.catchNetProfit}}</text>
          <text class="item-val {{accumulatedWealth>=0?'pos':'neg'}}">{{accumulatedWealth>=0?'+':''}}{{accumulatedWealth}}</text>
        </view>
        <view class="summary-divider"></view>
        <view class="summary-item">
          <text class="item-label">{{_l.catchProfitRate}}</text>
          <text class="rate-tag {{accumulatedWealth>=0?'pos':'neg'}}">{{accumulatedWealth>=0?'+':''}}{{profitRate}}%</text>
        </view>
      </view>

      <view class="action-footer" wx:if="{{wealthSet}}">
        <view class="capsule-btn ghost sm" bindtap="onResetWealth">{{_l.catchResetAsset}}</view>
        <view class="capsule-btn" bindtap="openWealthAdjustModal">
          <text>{{_l.catchAssetAdjust}}</text>
        </view>
      </view>
    </view>

    <!-- 咕噜球仓库与操作 -->
    <view class="premium-card ball-panel tint-purple">
      <view class="panel-header">
        <view class="panel-title">
          <text class="title-main">{{_l.catchBallWarehouse}}</text>
          <text class="title-sub">{{_l.catchStockDetail}}</text>
        </view>
        <view class="capsule-btn ghost sm" bindtap="onResetBalls">{{_l.catchResetBalls}}</view>
      </view>

      <view class="sub-tabs-premium">
        <view class="sub-tab-p {{specialTab==='buy'?'on':''}}" bindtap="onSpecialTab" data-t="buy">{{_l.catchBuyBall}}</view>
        <view class="sub-tab-p {{specialTab==='craft'?'on':''}}" bindtap="onSpecialTab" data-t="craft">{{_l.catchCraftBall}}</view>
        <view class="sub-tab-p {{specialTab==='cny'?'on':''}}" bindtap="onSpecialTab" data-t="cny">{{_l.catchSpecialBall}}</view>
      </view>

      <view class="inventory-stats">
        <view class="inv-item">
          <text class="inv-label">{{_l.catchStockTotal}}</text>
          <text class="inv-val">{{totalBallUsed}}</text>
        </view>
        <view class="inv-item">
          <text class="inv-label">{{_l.catchHistUsed}}</text>
          <text class="inv-val used" style="color:#ff4757;">{{usedBallTotal}}</text>
        </view>
      </view>

      <!-- 合成球：若后台配置了合成消耗洛克贝，可选「消耗洛克贝」或「免费合成」 -->
      <view class="inbound-method-row" wx:if="{{specialTab==='craft'}}">
        <text class="form-label-mini">合成方式</text>
        <view class="method-chips">
          <view class="method-chip {{craftUseRoco?'on':''}}" wx:if="{{selectedCraftCostRoco && selectedCraftPrice > 0}}" bindtap="onToggleCraftUseRoco" data-use="1">
            消耗洛克贝 ({{selectedCraftPrice}}/个)
          </view>
          <view class="method-chip {{!craftUseRoco?'on':''}}" bindtap="onToggleCraftUseRoco" data-use="0">
            免费合成 · {{_l.catchFreeTag}}
          </view>
        </view>
      </view>

      <!-- 获取方式：仅特殊球板块可选「活动 · 赠」 -->
      <view class="inbound-method-row" wx:if="{{specialTab==='cny'}}">
        <text class="form-label-mini">{{_l.catchGetMethod}}</text>
        <view class="method-chips">
          <view class="method-chip {{inboundMethod!=='activity'?'on':''}}" bindtap="onInboundMethod" data-m="default">
            {{_l.ballSpecial}}
          </view>
          <view class="method-chip {{inboundMethod==='activity'?'on':''}}" bindtap="onInboundMethod" data-m="activity">
            {{_l.catchActivityType}} · {{_l.catchFreeTag}}
          </view>
        </view>
      </view>

      <!-- 快速采购/合成按钮区 -->
      <view class="quick-add-row-premium">
        <view class="form-group-mini">
          <text class="form-label-mini">{{_l.catchSelectBall}}</text>
          <picker class="premium-picker-new" bindchange="onSpecialBall" range="{{pickerBalls}}" mode="selector">
            <view class="picker-inner-new">
              <text>{{specialBall}}</text>
              <text class="arrow-new">▾</text>
            </view>
          </picker>
        </view>
        <view class="form-group-mini count-group">
          <text class="form-label-mini">{{_l.catchInboundCount}}</text>
          <input class="premium-count-input-new" placeholder="0" type="number" value="{{specialCount}}" bindinput="onSpecialCount" />
        </view>
        <view class="visual-btn-add-new" bindtap="onAddSpecial">
          <text>{{_l.catchConfirmInbound}}</text>
        </view>
      </view>

      <!-- 入库记录 -->
      <view class="special-history-list" wx:if="{{specialHistory.length > 0}}">
        <view class="history-item-mini" wx:for="{{specialHistory}}" wx:key="index">
          <text class="h-type {{item.type === '购买' ? 'buy' : (item.type === '活动' ? 'activity' : 'craft')}}">{{item.type}}</text>
          <view style="display:flex; align-items:center; gap:8rpx;">
              <image wx:if="{{item.img && item.img.length > 5}}" src="{{item.img}}" style="width:28rpx; height:28rpx; border-radius:50%;" mode="aspectFill"></image>
              <image wx:elif="{{item.icon && item.icon.length > 5}}" src="{{item.icon}}" style="width:28rpx; height:28rpx; border-radius:50%;" mode="aspectFill"></image>
              <text wx:elif="{{item.icon}}" style="font-size:28rpx;">{{item.icon}}</text>
              <text class="h-name">{{item.ball}}</text>
            </view>
          <text class="h-count">x{{item.count}}</text>
          <view class="h-cost" wx:if="{{(item.displayCost || item.cost) > 0}}" style="display:flex; align-items:center; gap:4rpx;">
            <image src="https://r2.image-upload.app/ptImg/yhJkDL2B.png" style="width:22rpx; height:22rpx;" mode="aspectFit"></image>
            <text style="font-size:18rpx; font-weight:700; color:#ffab40;">{{item.displayCost || item.cost}}</text>
          </view>
          <text class="h-time">{{item.time}}</text>
        </view>
      </view>

      <!-- 咕噜球列表 -->
      <view class="ball-visual-list">
        <view wx:for="{{balls}}" wx:key="id" wx:if="{{item.count > 0 || item.freeCount > 0}}">
          <view class="ball-item-card {{pinnedBallIndex===index?'pinned':''}} {{expandedBallIndex===index?'expanded':''}}" bindtap="toggleBallDesc" data-index="{{index}}">
            <view class="ball-card-head">
              <view class="ball-icon-circle">
                <image wx:if="{{item.img}}" src="{{item.img}}" mode="aspectFill" class="ball-icon-img" />
                <text wx:else>{{item.icon}}</text>
              </view>
              <view class="ball-head-text">
                <text class="ball-name-txt" style="color: {{item.color || '#fff'}};">{{item.name}}</text>
                <view class="ball-value-tags">
                  <view class="value-tag roco" wx:if="{{item.price > 0 || (item.isCraft && item.craftCostRoco && item.craftPrice > 0)}}">
                    <image class="value-icon" src="https://r2.image-upload.app/ptImg/yhJkDL2B.png" mode="aspectFit" />
                    <text>{{item.isCraft && item.craftCostRoco && item.craftPrice > 0 && !item.isBuy ? '合成 ' + item.craftPrice : item.price}}</text>
                  </view>
                  <view class="value-tag cny" wx:if="{{item.cnyPrice > 0}}">
                    <text>{{item.cnyDisplay || item.cnyPrice}}</text>
                  </view>
                  <view class="value-tag free" wx:if="{{item.price <= 0 && item.cnyPrice <= 0 && !(item.isCraft && item.craftCostRoco && item.craftPrice > 0)}}">
                    <text>{{_l.catchFreeTag}}</text>
                  </view>
                </view>
              </view>
            </view>
            <!-- 简介区：展开时可见 -->
            <view class="ball-desc-scroll {{expandedBallIndex===index?'open':''}}" catchtap="noop">
              <view class="ball-desc-clip">
                <view class="ball-desc-inner">
                  <text wx:if="{{item.rate}}" class="ball-desc-rate">{{item.rate}}</text>
                  <text wx:if="{{item.source}}" class="ball-desc-source">{{_l.catchSource}}: {{item.source}}</text>
                  <view class="ball-meta-tags" wx:if="{{item.freeCount > 0 || (item.count - item.freeCount > 0)}}">
                    <text class="tag buy" wx:if="{{item.count - item.freeCount > 0}}">{{_l.catchBuyTag}} x{{item.count - item.freeCount}}</text>
                    <text class="tag free" wx:if="{{item.freeCount > 0}}">{{_l.catchFreeTag}} x{{item.freeCount}}</text>
                  </view>
                </view>
              </view>
            </view>
            <view class="ball-count-display">
              <text class="num">{{item.count}}</text>
              <text class="unit">{{_l.catchUnit}}</text>
            </view>
            <view class="pinned-indicator" wx:if="{{pinnedBallIndex===index}}">{{_l.catchPinned}}</view>
          </view>
        </view>
      </view>

      <view wx:if="{{!hasActiveBalls}}" class="empty-status">
        <text class="empty-icon">📦</text>
        <text>{{_l.catchEmptyStock}}</text>
      </view>
    </view>

    <!-- 捕捉历史日志 -->
    <view class="premium-card history-panel">
      <view class="panel-header">
        <view class="panel-title">
          <text class="title-main">{{_l.catchLogTitle}}</text>
          <text class="title-sub">{{_l.catchLogSubtitle}}</text>
        </view>
        <view class="history-ops" style="display:flex; gap:12rpx; align-items:center;">
          <view class="capsule-btn primary lg" bindtap="onGenerateImage" wx:if="{{showLogShareBtn}}">{{_l.catchGenImage}}</view>
          <view class="capsule-btn warning md" bindtap="onUndo" wx:if="{{history.length > 0}}">{{_l.catchUndo}}</view>
          <view class="capsule-btn danger sm" bindtap="onClearHistory" wx:if="{{history.length > 0}}">{{_l.catchClear}}</view>
        </view>
      </view>

      <view class="history-log-list">
        <view wx:for="{{history}}" wx:key="index" class="log-item">
          <view class="log-badge {{item.result.indexOf('异色')>=0||item.result.indexOf('成功')>=0?'ok':item.result==='歪了'?'miss':item.result==='盘点'?'check':'other'}}">
            {{item.result.indexOf('异色')>=0 ? (_l.catchResultShiny + (item.capturedCount > 1 ? 'x' + item.capturedCount : '')) : item.result.indexOf('成功')>=0 ? (_l.catchResultSuccess + (item.capturedCount > 1 ? 'x' + item.capturedCount : '')) : item.result==='歪了' ? _l.catchResultMiss : item.result==='盘点' ? _l.catchResultCheck : _l.catchResultEvent}}
          </view>
          <view class="log-content">
            <view style="display:flex; justify-content:space-between; align-items:center; margin-bottom:4rpx;">
              <view style="display:flex; align-items:center; gap:8rpx;">
                <image wx:if="{{item.ballImg}}" src="{{item.ballImg}}" style="width: 36rpx; height: 36rpx; border-radius: 8rpx; flex-shrink: 0;" mode="aspectFit"></image>
                <text wx:elif="{{item.ballIcon}}" style="font-size: 32rpx; margin-right: 8rpx;">{{item.ballIcon}}</text>
                <text class="log-ball">{{item.balls}}</text>
              </view>
            </view>
            <text class="log-pet" wx:if="{{item.targetPet && item.brushMode === 'mixed'}}">{{_l.catchTarget}}: {{item.targetPet}}</text>
            <text class="log-pet" wx:elif="{{item.pet}}">{{_l.catchTarget}}: {{item.pet}}</text>
            <view class="log-details">
              <text class="log-cost" wx:if="{{item.cost>0}}">{{_l.catchCost}}: 💵{{item.cost}}</text>
              <view class="log-cost" wx:if="{{item.usedDice}}" style="display:inline-flex; align-items:center; gap:6rpx; color:#ffd54f; font-weight:bold;">
                <image src="https://img.remit.ee/i/bpUFDBGUtlOi" style="width:24rpx; height:24rpx; flex-shrink:0;" mode="aspectFit"></image>
