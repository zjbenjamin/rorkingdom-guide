<view class="page">
  <!-- 童话粒子特效 -->
  <view class="fairytale-overlay" wx:if="{{showFairytaleParticles}}">
    <view class="fairytale-particle p1">🧚</view>
    <view class="fairytale-particle p2">✨</view>
    <view class="fairytale-particle p3">🌟</view>
    <view class="fairytale-particle p4">🦋</view>
    <view class="fairytale-particle p5">🌸</view>
    <view class="fairytale-particle p6">⭐</view>
    <view class="fairytale-particle p7">🪄</view>
    <view class="fairytale-particle p8">✨</view>
    <view class="fairytale-particle p9">🌙</view>
    <view class="fairytale-particle p10">🦋</view>
    <view class="fairytale-particle p11">🦄</view>
    <view class="fairytale-particle p12">⭐</view>
    <view class="fairytale-glow"></view>
  </view>
    <view class="capture-overlay" wx:if="{{captureAnim}}">
    <image class="capture-shiny-badge" src="https://patchwiki.biligame.com/images/rocom/2/2e/buxc6y4s0r7d8ix03zzkahnk4h8urtv.png" mode="aspectFit"></image>
  </view>
  <view class="capture-overlay" wx:if="{{missAnim}}">
    <image class="miss-anim-badge" src="https://patchwiki.biligame.com/images/rocom/4/4f/20dseynhfc393c6jys1rnwhwwf94xvv.png" mode="aspectFit"></image>
  </view>
  <view class="container">
    <!-- 异色捕捉主监控屏 -->
     <view class="premium-card monitor-panel tint-blue">
      <!-- 动效可视化动态条 -->
      <view class="visual-bars">
        <view class="v-bar"></view>
        <view class="v-bar"></view>
        <view class="v-bar"></view>
        <view class="v-bar"></view>
        <view class="v-bar"></view>
      </view>

        <view class="panel-header">
          <view class="panel-title" style="flex-direction: row; align-items: center; gap: 16rpx;">
            <text class="title-main" style="font-size: 32rpx;">{{_l.catchTitleLive}}</text>
            <view class="sync-badge">
              <view class="sync-dot"></view>
              <text>{{sysVersion}}</text>
            </view>
          </view>
          <view class="capsule-btn warning" bindtap="onClearEncounter">{{_l.catchResetData}}</view>
        </view>

      <view wx:if="{{!canStartCapture}}" class="init-loading">
        <view class="radar-scan"></view>
        <view class="init-icon">📡</view>
        <view class="init-text">
          <text class="glitch-text">{{_l.catchWaitSync}}</text>
          <text class="init-sub">{{_l.catchInitHint}}</text>
        </view>
      </view>

      <block wx:if="{{canStartCapture}}">
        <view class="stats-grid">
          <view class="stat-card total">
            <text class="stat-label">{{_l.catchEncounterCount}}</text>
            <text class="stat-value">{{carnivalCount+luckyBoxCount}}</text>
          </view>
          <view class="stat-card carnival">
            <text class="stat-label">{{_l.catchCarnival}}</text>
            <text class="stat-value">{{carnivalCount}}</text>
          </view>
          <view class="stat-card lucky">
            <text class="stat-label">{{_l.catchLuckyBox}}</text>
            <text class="stat-value">{{luckyBoxCount}}</text>
          </view>
        </view>

        <view class="progress-section">
          <view class="section-meta">
            <view class="section-title-group" style="display:flex; align-items:center;">
              <text>{{_l.catchPityTitle}}</text>
              <view class="mode-tag {{autoResetPity?'active':''}}" bindtap="toggleAutoResetPity" style="margin-left:20rpx;">
                <view class="tag-dot"></view>
                <text>{{autoResetPity?_l.catchAutoReset:_l.catchManualReset}}</text>
              </view>
            </view>
            <text class="meta-val">{{pityCount}} / 80</text>
          </view>
          <view class="pity-bar-wrapper">
            <view class="pity-track">
              <view class="pity-fill {{pityCount >= 70 ? 'danger' : pityCount >= 40 ? 'warning' : ''}}" style="width: {{pityCount / 80 * 100}}%"></view>
            </view>
          </view>
          <view class="pity-status" bindtap="onClearPity">
            <text class="status-emoji">{{pityEmoji}}</text>
            <text class="status-text">{{pityHint}}</text>
            <text class="manual-reset-hint" wx:if="{{!autoResetPity}}" style="font-size:18rpx; color:rgba(255,255,255,0.3); margin-left:10rpx;">({{_l.catchManualReset}})</text>
          </view>
        </view>

        <view class="control-grid">
          <view class="visual-action-btn box-btn" bindtap="onAddLuckyBox" bindlongpress="onLuckyBoxLongPress">
            <text class="btn-icon">📖</text>
            <text class="btn-text">{{_l.catchLuckyBox}}</text>
          </view>
          <view class="visual-action-btn carnival-btn" bindtap="onAddCarnival" bindlongpress="onCarnivalLongPress">
            <text class="btn-icon">🎨</text>
            <text class="btn-text">{{_l.catchCarnival}}</text>
          </view>
          <view class="visual-action-btn capture-btn" bindtap="onResult" bindlongpress="onLongResult" data-r="success">
            <image class="btn-icon-img" src="https://patchwiki.biligame.com/images/rocom/2/2e/buxc6y4s0r7d8ix03zzkahnk4h8urtv.png" mode="aspectFit"></image>
            <text class="btn-text">{{_l.catchSuccessBtn}}</text>
          </view>
          <view class="visual-action-btn miss-btn" bindtap="onResult" bindlongpress="onLongResult" data-r="miss">
            <image class="btn-icon-img" src="https://patchwiki.biligame.com/images/rocom/4/4f/20dseynhfc393c6jys1rnwhwwf94xvv.png" mode="aspectFit"></image>
            <text class="btn-text">{{_l.catchMissBtn}}</text>
          </view>
        </view>
      </block>
    </view>

    <!-- 洛克贝核心资产看板 -->
    <view class="premium-card wealth-panel tint-warm">
      <view class="panel-header">
        <view style="display:flex; align-items:center; gap:12rpx;">
          <image src="https://r2.image-upload.app/ptImg/yhJkDL2B.png" style="width:40rpx; height:40rpx;" mode="aspectFit"></image>
          <text class="panel-title" style="flex-direction:row;">{{_l.catchWealthPanel}}</text>
        </view>
        <view class="mode-tag {{quickRecordMode?'active':''}}" bindtap="toggleQuickRecord">
          <view class="tag-dot"></view>
          <text>{{quickRecordMode ? _l.catchAutoDeduct : _l.catchManualDeduct}}</text>
        </view>
      </view>
      
      <view class="init-form" wx:if="{{!wealthSet}}">
        <input class="premium-input" placeholder="{{_l.catchInitCoin}}" type="number" value="{{coinInput}}" bindinput="onWealthInput" style="background:rgba(0,0,0,0.3); padding:24rpx; border-radius:16rpx; margin-bottom:20rpx; border:1rpx solid rgba(255,255,255,0.1);" />
        <view class="visual-btn-primary" bindtap="onSetWealth">{{_l.catchInitAsset}}</view>
      </view>

      <view class="wealth-main" wx:if="{{wealthSet}}">
        <view class="wealth-label-group">
          <text class="label-main">{{_l.catchCurrentAsset}}</text>
          <text class="label-sub">{{_l.catchInitialAmount}}: {{initialWealth}}</text>
        </view>
        <view class="wealth-display">
          <view class="value-group" style="display:flex; align-items:center;">
            <image src="https://r2.image-upload.app/ptImg/yhJkDL2B.png" style="width:48rpx; height:48rpx; margin-right:8rpx;" mode="aspectFit"></image>
            <text class="amount">{{totalWealth}}</text>
          </view>
        </view>
      </view>

      <view class="profit-summary" wx:if="{{wealthSet}}">
        <view class="summary-item">
          <text class="item-label">{{_l.catchNetProfit}}</text>
          <text class="item-val {{accumulatedWealth>=0?'pos':'neg'}}">{{accumulatedWealth>=0?'+':''}}{{accumulatedWealth}}</text>
        </view>
        <view class="summary-divider"></view>
        <view class="summary-item">
          <text class="item-label">{{_l.catchProfitRate}}</text>
          <text class="rate-tag {{accumulatedWealth>=0?'pos':'neg'}}">{{accumulatedWealth>=0?'+':''}}{{profitRate}}%</text>
        </view>
      </view>

      <view class="action-footer" wx:if="{{wealthSet}}">
        <view class="capsule-btn danger" bindtap="onResetWealth">{{_l.catchResetAsset}}</view>
        <view class="capsule-btn" bindtap="openWealthAdjustModal">
          <text>{{_l.catchAssetAdjust}}</text>
        </view>
      </view>
    </view>

    <!-- 咕噜球仓库与操作 -->
    <view class="premium-card ball-panel tint-purple">
      <view class="panel-header">
        <view class="panel-title">
          <text class="title-main">{{_l.catchBallWarehouse}}</text>
          <text class="title-sub">{{_l.catchStockDetail}}</text>
        </view>
        <view class="capsule-btn danger" bindtap="onResetBalls">{{_l.catchResetBalls}}</view>
      </view>

      <view class="sub-tabs-premium">
        <view class="sub-tab-p {{specialTab==='buy'?'on':''}}" bindtap="onSpecialTab" data-t="buy">{{_l.catchBuyBall}}</view>
        <view class="sub-tab-p {{specialTab==='craft'?'on':''}}" bindtap="onSpecialTab" data-t="craft">{{_l.catchCraftBall}}</view>
      </view>

      <view class="inventory-stats">
        <view class="inv-item">
          <text class="inv-label">{{_l.catchStockTotal}}</text>
          <text class="inv-val">{{totalBallUsed}}</text>
        </view>
        <view class="inv-item">
          <text class="inv-label">{{_l.catchHistUsed}}</text>
          <text class="inv-val used" style="color:#ff4757;">{{usedBallTotal}}</text>
        </view>
      </view>

      <!-- 快速采购/合成按钮区 -->
      <view class="quick-add-row-premium">
        <view class="form-group-mini">
          <text class="form-label-mini">{{_l.catchSelectBall}}</text>
          <picker class="premium-picker-new" bindchange="onSpecialBall" range="{{specialBalls}}" mode="selector">
            <view class="picker-inner-new">
              <text>{{specialBall}}</text>
              <text class="arrow-new">▾</text>
            </view>
          </picker>
        </view>
        <view class="form-group-mini count-group">
          <text class="form-label-mini">{{_l.catchInboundCount}}</text>
          <input class="premium-count-input-new" placeholder="0" type="number" value="{{specialCount}}" bindinput="onSpecialCount" />
        </view>
        <view class="visual-btn-add-new" bindtap="onAddSpecial">
          <text>{{_l.catchConfirmInbound}}</text>
        </view>
      </view>

      <!-- 入库记录 -->
      <view class="special-history-list" wx:if="{{specialHistory.length > 0}}">
        <view class="history-item-mini" wx:for="{{specialHistory}}" wx:key="index">
          <text class="h-type {{item.type === '购买' ? 'buy' : 'craft'}}">{{item.type}}</text>
          <view style="display:flex; align-items:center; gap:8rpx;">
              <image wx:if="{{item.img && item.img.length > 5}}" src="{{item.img}}" style="width:28rpx; height:28rpx; border-radius:50%;" mode="aspectFill"></image>
              <image wx:elif="{{item.icon && item.icon.length > 5}}" src="{{item.icon}}" style="width:28rpx; height:28rpx; border-radius:50%;" mode="aspectFill"></image>
              <text wx:elif="{{item.icon}}" style="font-size:28rpx;">{{item.icon}}</text>
              <text class="h-name">{{item.ball}}</text>
            </view>
          <text class="h-count">x{{item.count}}</text>
          <view class="h-cost" wx:if="{{item.cost > 0}}" style="display:flex; align-items:center; gap:4rpx;">
            <image src="https://r2.image-upload.app/ptImg/yhJkDL2B.png" style="width:22rpx; height:22rpx;" mode="aspectFit"></image>
            <text style="font-size:18rpx; font-weight:700; color:#ffab40;">{{item.cost}}</text>
          </view>
          <text class="h-time">{{item.time}}</text>
        </view>
      </view>

      <!-- 咕噜球列表按钮化 -->
      <view class="ball-visual-list">
        <view wx:for="{{balls}}" wx:key="id" wx:if="{{item.count > 0}}">
          <view class="ball-item-card {{pinnedBallIndex===index?'pinned':''}}" bindtap="toggleBallDesc" data-index="{{index}}">
            <view class="ball-icon-circle">
              <image wx:if="{{item.img}}" src="{{item.img}}" mode="aspectFit" style="width:100%; height:100%; border-radius:50%;" />
              <text wx:else>{{item.icon}}</text>
            </view>
            <view class="ball-info-main">
              <text class="ball-name-txt" style="color: {{item.color || '#fff'}};">{{item.name}}</text>
              <view wx:if="{{expandedBallIndex === index && (item.rate || item.source)}}" class="ball-desc-expanded">
                <text wx:if="{{item.rate}}" style="display:block; margin-bottom:4rpx; font-size:18rpx; color:rgba(255,255,255,0.4); line-height:1.3;">{{item.rate}}</text>
                <text wx:if="{{item.source}}" style="display:block; color:rgba(255,255,255,0.3); font-size:18rpx;">{{_l.catchSource}}: {{item.source}}</text>
                <view class="ball-meta-tags" style="margin-top:8rpx;" wx:if="{{item.freeCount > 0 || (item.count - item.freeCount > 0)}}">
                  <text class="tag buy" wx:if="{{item.count - item.freeCount > 0}}">{{_l.catchBuyTag}} x{{item.count - item.freeCount}}</text>
                  <text class="tag free" wx:if="{{item.freeCount > 0}}">{{_l.catchFreeTag}} x{{item.freeCount}}</text>
                </view>
              </view>
            </view>
            <view class="ball-count-display">
              <text class="num">{{item.count}}</text>
              <text class="unit">{{_l.catchUnit}}</text>
            </view>
            <view class="pinned-indicator" wx:if="{{pinnedBallIndex===index}}">{{_l.catchPinned}}</view>
          </view>
        </view>
      </view>

      <view wx:if="{{!hasActiveBalls}}" class="empty-status">
        <text class="empty-icon">📦</text>
        <text>{{_l.catchEmptyStock}}</text>
      </view>
    </view>

    <!-- 捕捉历史日志 -->
    <view class="premium-card history-panel">
      <view class="panel-header">
        <view class="panel-title">
          <text class="title-main">{{_l.catchLogTitle}}</text>
          <text class="title-sub">{{_l.catchLogSubtitle}}</text>
        </view>
        <view class="history-ops" style="display:flex; gap:12rpx;">
          <view class="capsule-btn info" bindtap="onGenerateImage" wx:if="{{history.length > 0 && showLogShareBtn}}">{{_l.catchGenImage}}</view>
            <view class="capsule-btn warning" bindtap="onUndo" wx:if="{{history.length > 0}}">{{_l.catchUndo}}</view>
          <view class="capsule-btn danger" bindtap="onClearHistory">{{_l.catchClear}}</view>
        </view>
      </view>

      <view class="history-log-list">
        <view wx:for="{{history}}" wx:key="index" class="log-item">
          <view class="log-badge {{item.result.indexOf('异色')>=0||item.result.indexOf('成功')>=0?'ok':item.result==='歪了'?'miss':item.result==='盘点'?'check':'other'}}">
            {{item.result.indexOf('异色')>=0 ? _l.catchResultShiny : item.result.indexOf('成功')>=0 ? _l.catchResultSuccess : item.result==='歪了' ? _l.catchResultMiss : item.result==='盘点' ? _l.catchResultCheck : _l.catchResultEvent}}
          </view>
          <view class="log-content">
            <view style="display:flex; justify-content:space-between; align-items:center; margin-bottom:4rpx;">
              <view style="display:flex; align-items:center; gap:8rpx;">
                <image wx:if="{{item.ballImg}}" src="{{item.ballImg}}" style="width: 32rpx; height: 32rpx; border-radius: 50%; background:rgba(255,255,255,0.1);" mode="aspectFill"></image>
                <text wx:elif="{{item.ballIcon}}" style="font-size: 32rpx; margin-right: 8rpx;">{{item.ballIcon}}</text>
                <text class="log-ball">{{item.balls}}</text>
              </view>
            </view>
            <text class="log-pet" wx:if="{{item.targetPet && item.brushMode === 'mixed'}}">{{_l.catchTarget}}: {{item.targetPet}}</text>
            <text class="log-pet" wx:elif="{{item.pet}}">{{_l.catchTarget}}: {{item.pet}}</text>
            <view class="log-details">
              <text class="log-cost" wx:if="{{item.cost>0}}">{{_l.catchCost}}: 💵{{item.cost}}</text>
              <text class="log-time">{{item.time}}</text>
            </view>
          </view>
        </view>
        <view wx:if="{{history.length===0}}" class="empty-status">
          <text class="empty-icon">📄</text>
          <text>{{_l.catchNoRecord}}</text>
        </view>
      </view>
    </view>

    <view class="foot">浙ICP备2026043884号</view>
  </view>

  <!-- 球剩余记录弹窗 -->
  <view class="modal-mask" wx:if="{{showBallCheckModal}}" bindtap="closeBallCheckModal">
    <view class="modal-box" catchtap="preventClose">
      <view class="modal-header">
        <text class="modal-title">{{_l.catchModalBallRemain}}</text>
        <text class="modal-close" catchtap="closeBallCheckModal">✕</text>
      </view>
      <view class="modal-body">
        <view class="check-hint">{{_l.catchModalHint10}}</view>
        <view class="form-group">
          <view class="ball-check-table">
            <view class="ball-check-header">
              <text class="bch-name">{{_l.catchModalBallType}}</text>
              <text class="bch-stock">{{_l.catchModalCurrent}}</text>
              <text class="bch-last">{{_l.catchModalLast}}</text>
              <text class="bch-remain">{{_l.catchModalRemain}}</text>
            </view>
            <view wx:for="{{checkMultiBalls}}" wx:key="name" class="ball-check-row">
              <text class="bcr-name">{{item.name}}</text>
              <text class="bcr-stock">{{item.currentCount}}</text>
              <text class="bcr-last">{{item.lastRemaining >= 0 ? item.lastRemaining : _l.catchModalNone}}</text>
              <input class="bcr-input" type="number" placeholder="0" value="{{item.remain}}" bindinput="onCheckMultiBallRemainInput" data-index="{{index}}" />
            </view>
          </view>
        </view>
      </view>
      <view class="modal-footer">
        <button class="modal-cancel" catchtap="closeBallCheckModal">{{_l.catchModalCancel}}</button>
        <button class="modal-save" catchtap="onBallCheckConfirm">{{_l.catchModalConfirm}}</button>
      </view>
    </view>
  </view>

  <!-- 异色/成功/歪了结果弹窗 -->
  <view class="modal-mask" wx:if="{{showResultBallModal}}" bindtap="closeResultBallModal">
    <view class="modal-box result-modal" catchtap="preventClose">
      <!-- 顶部彩色状态头 -->
      <view class="result-header {{resultType === 'success' ? 'success' : 'miss'}}">
        <view class="result-header-left">
          <view class="result-header-icon">
            <image wx:if="{{resultType === 'success'}}" src="https://patchwiki.biligame.com/images/rocom/2/2e/buxc6y4s0r7d8ix03zzkahnk4h8urtv.png" mode="aspectFit"></image>
            <image wx:else src="https://patchwiki.biligame.com/images/rocom/4/4f/20dseynhfc393c6jys1rnwhwwf94xvv.png" mode="aspectFit"></image>
          </view>
          <view>
            <text class="result-header-title">{{resultType === 'success' ? _l.catchModalResultTitle : _l.catchMissBtn}}</text>
            <text class="result-header-sub">{{_l.catchModalResultSub}}</text>
          </view>
        </view>
        <text class="result-header-close" catchtap="closeResultBallModal">✕</text>
      </view>

      <view class="modal-body result-body">
        <!-- 单刷 / 混刷 模式切换 -->
        <view class="result-section">
          <view class="check-mode-tabs enhanced">
            <view class="check-mode-tab {{brushMode === 'single' ? 'on' : ''}}" catchtap="onBrushModeSwitch" data-mode="single">
              <text class="tab-icon">🔹</text>
              <text>{{_l.catchSingle}}</text>
            </view>
            <view class="check-mode-tab {{brushMode === 'mixed' ? 'on' : ''}}" catchtap="onBrushModeSwitch" data-mode="mixed">
              <text class="tab-icon">🔸</text>
              <text>{{_l.catchMixed}}</text>
            </view>
          </view>
        </view>

        <!-- 球类消费 -->
        <view class="result-section">
          <view class="section-head">
            <text class="section-icon">🎯</text>
            <text class="section-title">{{_l.catchBallConsumed}}</text>
          </view>
          <view class="ball-check-table">
            <view class="ball-check-header">
              <text class="bch-name">{{_l.catchModalBallType}}</text>
              <text class="bch-stock">{{_l.catchModalStock}}</text>
              <text class="bch-remain">{{_l.catchModalUsed}}</text>
              <text class="bch-remain">{{_l.catchModalRemain}}</text>
            </view>
            <view wx:for="{{resultMultiBalls}}" wx:key="name" class="ball-check-row">
              <text class="bcr-name">{{item.name}}</text>
              <text class="bcr-stock">{{item.currentCount}}</text>
              <text class="bcr-last" style="color:#ffab40;">{{item.remain !== '' ? item.currentCount - item.remain : '-'}}</text>
              <input class="bcr-input" type="number" placeholder="{{_l.catchModalInputRemain}}" value="{{item.remain}}" bindinput="onResultMultiBallRemainInput" data-index="{{index}}" />
            </view>
          </view>
        </view>

        <!-- 捕捉状态 -->
        <view class="result-section" wx:if="{{resultType === 'miss'}}">
          <view class="section-head">
            <text class="section-icon">🔄</text>
            <text class="section-title">{{_l.catchContinueSettings}}</text>
          </view>
          <view class="switch-row">
            <switch checked="{{continuePity}}" bindchange="onContinuePityChange" color="#00d4ff" />
            <text class="switch-label">{{continuePity ? _l.catchContinueEnable : _l.catchContinueDisable}}</text>
          </view>
        </view>

        <!-- 洛克贝收益 -->
        <view class="result-section">
          <view class="section-head">
            <text class="section-icon">💰</text>
            <text class="section-title">{{_l.catchThisGain}}</text>
          </view>
          <view class="input-with-icon">
            <image src="https://r2.image-upload.app/ptImg/yhJkDL2B.png" mode="aspectFit" class="input-prefix-img"></image>
            <input class="form-input enhanced" type="number" placeholder="{{_l.catchCoinPlaceholder}}" value="{{resultGainInput}}" bindinput="onResultGainInput" />
          </view>
        </view>

        <!-- 单刷：精灵名称 -->
        <view class="result-section" wx:if="{{brushMode === 'single'}}">
          <view class="section-head">
            <text class="section-icon">🐾</text>
            <text class="section-title">{{_l.catchTargetPet}}</text>
          </view>
          <view class="input-with-icon">
            <text class="input-prefix-icon">🐾</text>
            <input class="form-input enhanced" placeholder="{{_l.catchPetNamePlaceholder}}" value="{{resultPetName}}" bindinput="onResultPetNameInput" />
          </view>
        </view>

        <!-- 混刷：动态精灵列表 -->
        <view class="result-section" wx:if="{{brushMode === 'mixed'}}">
          <view class="section-head">
            <text class="section-icon">🐾</text>
            <text class="section-title">{{_l.catchMixedList}}</text>
          </view>
          <view wx:for="{{resultMixedPets}}" wx:key="index" class="ball-pick-row">
            <view class="input-with-icon" style="flex:1; margin:0;">
              <text class="input-prefix-icon">🐾</text>
              <input class="form-input enhanced" style="flex:1; margin-bottom:0;" placeholder="{{_l.catchPetNamePlaceholder}}" value="{{item.name}}" bindinput="onMixedPetNameInput" data-index="{{index}}" />
            </view>
            <view class="ball-row-del" bindtap="onRemoveMixedPet" data-index="{{index}}" wx:if="{{resultMixedPets.length > 1}}">✕</view>
          </view>
          <view class="section-add-btn" bindtap="onAddMixedPet">
            <text class="add-icon">+</text>
            <text>{{_l.catchAddPet}}</text>
          </view>
        </view>

        <!-- 混刷结果目标 -->
        <view class="result-section" wx:if="{{brushMode === 'mixed'}}">
          <view class="section-head">
            <text class="section-icon">{{resultType === 'success' ? '🌟' : '💫'}}</text>
            <text class="section-title">{{resultType === 'success' ? _l.catchShinyTarget : _l.catchMissTarget}}</text>
            <text class="section-title-hint">{{_l.catchTargetHintPre}}{{resultType === 'success' ? _l.catchTargetHintMid : _l.catchResultMiss}}{{_l.catchTargetHintPost}}</text>
          </view>
          <view class="input-with-icon">
            <text class="input-prefix-icon">🐾</text>
            <input class="form-input enhanced" placeholder="{{_l.catchPetNamePlaceholder}}" value="{{resultTargetPet}}" bindinput="onTargetPetInput" />
          </view>
        </view>

        <!-- 精灵图片链接 -->
        <view class="result-section">
          <view class="section-head">
            <text class="section-icon">🖼️</text>
            <text class="section-title">{{_l.catchPetImgUrl}}</text>
          </view>
          <input class="form-input enhanced" placeholder="https://..." value="{{resultPetImageUrl}}" bindinput="onResultPetImageUrlInput" />
        </view>
        <!-- 捕捉耗时 -->
        <view class="result-section">
          <view class="section-head">
            <text class="section-icon">⏱️</text>
            <text class="section-title">{{_l.catchCatchDuration}}</text>
          </view>
          <input class="form-input enhanced" placeholder="{{_l.catchDurationPlaceholder}}" value="{{resultElapsedTime}}" bindinput="onResultElapsedTimeInput" />
        </view>
        <!-- 备注 -->
        <view class="result-section">
          <view class="section-head">
            <text class="section-icon">📝</text>
            <text class="section-title">{{_l.catchRemark}}</text>
          </view>
          <input class="form-input enhanced" placeholder="{{_l.catchRemarkPlaceholder}}" value="{{resultRemark}}" bindinput="onResultRemarkInput" />
        </view>
      </view>

      <view class="modal-footer result-footer">
        <button class="modal-cancel" catchtap="closeResultBallModal">{{_l.catchModalCancel}}</button>
        <button class="modal-save result-save-btn {{resultType === 'success' ? 'btn-success-glow' : 'btn-miss-glow'}}" catchtap="onResultBallConfirm">{{_l.catchConfirmRecord}}</button>
      </view>
    </view>
  </view>

  <!-- 资产微调弹窗 -->
  <view class="modal-mask" wx:if="{{showWealthAdjustModal}}" bindtap="closeWealthAdjustModal">
    <view class="modal-box" catchtap="preventClose">
      <view class="modal-header">
        <text class="modal-title">{{_l.catchWealthAdjust}}</text>
        <text class="modal-close" catchtap="closeWealthAdjustModal">✕</text>
      </view>
      <view class="modal-body">
        <view class="check-mode-tabs">
          <view class="check-mode-tab {{adjustType === 'add' ? 'on' : ''}}" catchtap="onAdjustTypeSwitch" data-type="add">{{_l.catchAddAsset}}</view>
          <view class="check-mode-tab {{adjustType === 'sub' ? 'on' : ''}}" catchtap="onAdjustTypeSwitch" data-type="sub">{{_l.catchSubAsset}}</view>
          <view class="check-mode-tab {{adjustType === 'encounter10' ? 'on' : ''}}" catchtap="onAdjustTypeSwitch" data-type="encounter10">{{_l.catch10Encounters}}</view>
        </view>
        <view class="form-group">
          <text class="form-label">{{adjustType === 'encounter10' ? _l.catchEncounterGain : _l.catchAdjustAmount}}</text>
          <input class="form-input" type="number" placeholder="{{adjustType === 'encounter10' ? _l.catchAdjustAmountPlaceholder10 : _l.catchAdjustAmountPlaceholder}}" value="{{adjustAmount}}" bindinput="onAdjustAmountInput" />
        </view>
        <view class="form-group" wx:if="{{adjustType !== 'encounter10'}}">
          <text class="form-label">{{_l.catchAdjustRemark}}</text>
          <input class="form-input" placeholder="{{_l.catchAdjustRemarkPlaceholder}}" value="{{adjustRemark}}" bindinput="onAdjustRemarkInput" />
        </view>
      </view>
      <view class="modal-footer">
        <button class="modal-cancel" catchtap="closeWealthAdjustModal">{{_l.catchModalCancel}}</button>
        <button class="modal-save" catchtap="onConfirmAdjustWealth">{{_l.catchConfirmAdjust}}</button>
      </view>
    </view>
  </view>

  <canvas type="2d" id="shareCanvas" style="width: 400px; height: 700px; position: fixed; top: -9999px;"></canvas>
  <dock current="catch" />
</view>
