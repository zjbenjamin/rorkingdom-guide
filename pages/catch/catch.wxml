          <view class="form-group">
            <text class="form-label">本次现有洛克贝</text>
            <input class="form-input" type="number" placeholder="输入当前现有洛克贝数值" value="{{adjustAmount}}" bindinput="onAdjustAmountInput" />
          </view>
          <view class="form-group">
            <text class="form-label">{{_l.catchAdjustRemark}}</text>
            <input class="form-input" placeholder="{{_l.catchAdjustRemarkPlaceholder}}" value="{{adjustRemark}}" bindinput="onAdjustRemarkInput" />
          </view>
        </block>

        <block wx:else>
          <view class="form-group">
            <text class="form-label">{{_l.catchEncounterGain}}</text>
            <input class="form-input" type="number" placeholder="{{_l.catchAdjustAmountPlaceholder10}}" value="{{adjustAmount}}" bindinput="onAdjustAmountInput" />
          </view>
        </block>
      </view>
      <view class="modal-footer">
        <button class="modal-cancel" catchtap="closeWealthAdjustModal">{{_l.catchModalCancel}}</button>
        <button class="modal-save" catchtap="onConfirmAdjustWealth">{{_l.catchConfirmAdjust}}</button>
      </view>
    </view>
  </view>

  <!-- 龙龙骰类型选择弹窗（带四类官方图标与今日统计） -->
  <view class="modal-mask" wx:if="{{showDicePickerModal}}" bindtap="closeDicePickerModal">
    <view class="modal-box dice-picker-modal" catchtap="preventClose">
      <view class="modal-header">
        <view style="display:flex; align-items:center; gap:12rpx;">
          <image src="https://img.remit.ee/i/bpUFDBGUtlOi" style="width:42rpx; height:42rpx;" mode="aspectFit"></image>
          <text class="modal-title">选择获得龙龙骰类型</text>
        </view>
        <text class="modal-close" catchtap="closeDicePickerModal">✕</text>
      </view>
      <view class="modal-body">
        <view class="check-hint" style="margin-bottom:20rpx;">仅「异色龙龙骰」计入剩余面板，四类均计入战报「当日获骰」且不占保底与奇遇</view>
        <view class="dice-picker-grid">
          <view class="dice-picker-card" wx:for="{{dicePickerOptions}}" wx:key="type" catchtap="onSelectDiceType" data-type="{{item.type}}" style="border-color: {{item.borderColor}};">
            <image class="dice-picker-icon" src="{{item.img}}" mode="aspectFit"></image>
            <text class="dice-picker-name" style="color: {{item.color}};">{{item.type}}</text>
            <text class="dice-picker-desc">{{item.desc}}</text>
            <view class="dice-picker-foot">
              <text class="dice-picker-tag" style="color: {{item.color}}; background: {{item.tagBg}};">{{item.tag}}</text>
              <text class="dice-picker-today">今日 +{{item.todayCount || 0}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <canvas type="2d" id="shareCanvas" style="width: 400px; height: 700px; position: fixed; top: -9999px;"></canvas>
  <dock current="catch" />
</view>
