/* ── 捕捉统计 · 极光玻璃 Aurora Glass ──   深空紫蓝底 + 磨砂玻璃卡片 + 青紫渐变点缀──────────────────────────────────────────── */.page  {
  min-height: 100vh;
  /* 兜底：JS 算出 safeTop 前先避开状态栏+胶囊 */  padding-top: 88px;
  background: linear-gradient(180deg, #0b0d1c 0%, #12142e 45%, #0d1024 100%);
  color: #eef0ff;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Segoe UI', sans-serif;
  font-size: 14px;
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
}
.container  {
 padding: 16rpx 22rpx 48rpx;
 }
.foot  {
  text-align: center;
  padding: 36rpx 0 24rpx;
  font-size: 20rpx;
  color: rgba(255,255,255,0.28);
  letter-spacing: 1rpx;
}
/* ── 动效浮层 ── */.fairytale-overlay  {
  position: fixed;
 inset: 0;
 z-index: 999;
  pointer-events: none;
 overflow: hidden;
}
.fairytale-particle  {
 position: absolute;
 font-size: 40rpx;
 opacity: 0.9;
 animation: fairyFloat 3.2s ease-in-out infinite;
 }
.fairytale-particle.p1  {
 left: 8%;
 top: 20%;
 animation-delay: 0s;
 }
.fairytale-particle.p2  {
 left: 22%;
 top: 48%;
 animation-delay: .3s;
 }
.fairytale-particle.p3  {
 left: 40%;
 top: 16%;
 animation-delay: .6s;
 }
.fairytale-particle.p4  {
 left: 58%;
 top: 42%;
 animation-delay: .9s;
 }
.fairytale-particle.p5  {
 left: 74%;
 top: 22%;
 animation-delay: 1.2s;
 }
.fairytale-particle.p6  {
 left: 88%;
 top: 52%;
 animation-delay: 1.5s;
 }
.fairytale-particle.p7  {
 left: 14%;
 top: 72%;
 animation-delay: .4s;
 }
.fairytale-particle.p8  {
 left: 32%;
 top: 80%;
 animation-delay: .7s;
 }
.fairytale-particle.p9  {
 left: 52%;
 top: 70%;
 animation-delay: 1s;
 }
.fairytale-particle.p10  {
 left: 68%;
 top: 82%;
 animation-delay: 1.3s;
 }
.fairytale-particle.p11  {
 left: 82%;
 top: 68%;
 animation-delay: 1.6s;
 }
.fairytale-particle.p12  {
 left: 46%;
 top: 34%;
 animation-delay: 1.9s;
 }
@keyframes fairyFloat  {
  0%, 100%  {
 transform: translateY(0) scale(1);
 opacity: .85;
 }
  50%  {
 transform: translateY(-28rpx) scale(1.12);
 opacity: 1;
 }
}
.fairytale-glow  {
  position: absolute;
 inset: 0;
  background:    radial-gradient(ellipse at 20% 15%, rgba(124,92,255,0.18), transparent 50%),    radial-gradient(ellipse at 85% 70%, rgba(34,211,238,0.12), transparent 50%);
}
.capture-overlay  {
  position: fixed;
 inset: 0;
 z-index: 998;
  display: flex;
 align-items: center;
 justify-content: center;
  background: rgba(8,10,24,0.6);
  animation: captureFadeOut 0.6s ease-out forwards;
}
.capture-shiny-badge  {
  width: 400rpx;
 height: 400rpx;
  animation: capturePop 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;
  filter: drop-shadow(0 0 56rpx rgba(124,92,255,0.85));
}
@keyframes capturePop  {
  0%  {
 transform: scale(0) rotate(-45deg);
 opacity: 0;
 filter: brightness(2) blur(8px);
 }
  60%  {
 transform: scale(1.25) rotate(12deg);
 opacity: 1;
 filter: brightness(1.4);
 }
  100%  {
 transform: scale(1) rotate(0);
 opacity: 1;
 }
}
@keyframes captureFadeOut  {
  0%, 70%  {
 opacity: 1;
 }
  100%  {
 opacity: 0;
 }
}
.miss-anim-badge  {
  width: 400rpx;
 height: 400rpx;
  animation: missPop 0.5s cubic-bezier(0.68, -0.55, 0.265, 1.55) forwards;
  filter: drop-shadow(0 0 56rpx rgba(244,114,182,0.7));
}
.dice-anim-badge {
  font-size: 240rpx;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  animation: diceRollPop 0.7s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;
  filter: drop-shadow(0 0 56rpx rgba(251, 191, 36, 0.9));
}
@keyframes diceRollPop {
  0% {
    transform: scale(0.2) rotate(-180deg);
    opacity: 0;
  }
  60% {
    transform: scale(1.25) rotate(20deg);
    opacity: 1;
  }
  80% {
    transform: scale(0.95) rotate(-8deg);
    opacity: 1;
  }
  100% {
    transform: scale(1) rotate(0deg);
    opacity: 1;
  }
}
@keyframes missPop  {
  0%  {
 transform: scale(1.5) rotate(18deg) translateY(-40px);
 opacity: 0;
 filter: grayscale(1) blur(4px);
 }
  100%  {
 transform: scale(1) rotate(0) translateY(0);
 opacity: 1;
 filter: none;
 }
}
/* ── 玻璃卡片 ── */.premium-card  {
  position: relative;
  background: linear-gradient(165deg, rgba(255,255,255,0.07), rgba(255,255,255,0.025));
  border: 1rpx solid rgba(255,255,255,0.1);
  border-radius: 28rpx;
  padding: 28rpx 26rpx;
  margin-bottom: 22rpx;
  overflow: hidden;
  /* 降低 blur 半径：每帧重算代价大，展开动画容易掉到 30fps */  backdrop-filter: blur(8rpx);
  -webkit-backdrop-filter: blur(8rpx);
  box-shadow: 0 16rpx 48rpx rgba(4,6,20,0.35), inset 0 1rpx 0 rgba(255,255,255,0.08);
}
.premium-card.tint-blue  {
  background: linear-gradient(165deg, rgba(34,211,238,0.1), rgba(255,255,255,0.03) 55%);
  border-color: rgba(34,211,238,0.22);
}
.premium-card.tint-warm  {
  background: linear-gradient(165deg, rgba(251,191,36,0.1), rgba(255,255,255,0.03) 55%);
  border-color: rgba(251,191,36,0.2);
}
.premium-card.tint-purple  {
  background: linear-gradient(165deg, rgba(124,92,255,0.12), rgba(255,255,255,0.03) 55%);
  border-color: rgba(124,92,255,0.24);
}
.panel-header  {
  display: flex;
 align-items: center;
 justify-content: space-between;
  gap: 16rpx;
  padding-bottom: 20rpx;
  margin-bottom: 22rpx;
  border-bottom: 1rpx solid rgba(255,255,255,0.08);
}
.panel-title  {
 display: flex;
 flex-direction: column;
 gap: 4rpx;
 min-width: 0;
 }
.title-main  {
  font-size: 31rpx;
 font-weight: 700;
 color: #fff;
  letter-spacing: 0.5rpx;
}
.title-sub  {
 font-size: 21rpx;
 color: rgba(255,255,255,0.45);
 }
/* 顶部动态条 */.visual-bars  {
  display: flex;
 gap: 10rpx;
  height: 10rpx;
 margin-bottom: 22rpx;
}
.v-bar  {
  flex: 1;
 height: 100%;
  background: rgba(255,255,255,0.08);
  border-radius: 999rpx;
  overflow: hidden;
}
.v-bar::after  {
  content: '';
 display: block;
 height: 100%;
  background: linear-gradient(90deg, #7c5cff, #22d3ee);
  border-radius: 999rpx;
  animation: barPulse 2.4s ease-in-out infinite;
}
.v-bar:nth-child(1)::after  {
 animation-delay: 0s;
 }
.v-bar:nth-child(2)::after  {
 animation-delay: 0.2s;
 }
.v-bar:nth-child(3)::after  {
 animation-delay: 0.4s;
 }
.v-bar:nth-child(4)::after  {
 animation-delay: 0.6s;
 }
.v-bar:nth-child(5)::after  {
 animation-delay: 0.8s;
 }
@keyframes barPulse  {
  0%, 100%  {
 width: 28%;
 opacity: .55;
 }
  50%  {
 width: 100%;
 opacity: 1;
 }
}
/* ── 同步徽章 ── */.sync-badge  {
  display: inline-flex;
 align-items: center;
 gap: 8rpx;
  padding: 6rpx 16rpx;
  background: rgba(52,211,153,0.15);
  border: 1rpx solid rgba(52,211,153,0.35);
  border-radius: 999rpx;
  font-size: 19rpx;
  color: #6ee7b7;
}
.sync-dot  {
  width: 10rpx;
 height: 10rpx;
 border-radius: 50%;
  background: #34d399;
  box-shadow: 0 0 10rpx rgba(52,211,153,0.8);
  animation: dotBlink 1.6s ease-in-out infinite;
}
@keyframes dotBlink  {
  0%, 100%  {
 opacity: 1;
 }
  50%  {
 opacity: .35;
 }
}
/* ── 按钮 ── */.capsule-btn  {
  display: inline-flex;
 align-items: center;
 justify-content: center;
  padding: 12rpx 28rpx;
  font-size: 22rpx;
 font-weight: 600;
  color: #eef0ff;
  background: rgba(255,255,255,0.1);
  border: 1rpx solid rgba(255,255,255,0.14);
  border-radius: 999rpx;
  white-space: nowrap;
  transition: all 0.2s;
}
.capsule-btn:active  {
 background: rgba(255,255,255,0.18);
 transform: scale(0.97);
 }
.capsule-btn.sm  {
 padding: 8rpx 18rpx;
 font-size: 20rpx;
 }
.capsule-btn.md  {
 padding: 10rpx 22rpx;
 font-size: 21rpx;
 }
.capsule-btn.lg  {
 padding: 12rpx 30rpx;
 font-size: 22rpx;
 }
.capsule-btn.ghost  {
  background: transparent;
  color: rgba(255,255,255,0.5);
  border-color: rgba(255,255,255,0.14);
}
.capsule-btn.ghost:active  {
 background: rgba(255,255,255,0.1);
 color: #fff;
 }
.capsule-btn.primary  {
  background: linear-gradient(135deg, #7c5cff, #22d3ee);
  border: none;
  color: #fff;
  box-shadow: 0 8rpx 24rpx rgba(124,92,255,0.35);
}
.capsule-btn.primary:active  {
 filter: brightness(1.1);
 }
.capsule-btn.warning  {
  background: rgba(251,191,36,0.12);
  color: #fcd34d;
  border-color: rgba(251,191,36,0.35);
}
.capsule-btn.warning:active  {
 background: rgba(251,191,36,0.22);
 }
.capsule-btn.danger  {
  background: rgba(244,114,182,0.12);
  color: #f9a8d4;
  border-color: rgba(244,114,182,0.35);
}
.capsule-btn.danger:active  {
 background: rgba(244,114,182,0.22);
 }
.visual-btn-primary  {
  display: flex;
 align-items: center;
 justify-content: center;
  padding: 24rpx;
  background: linear-gradient(135deg, #7c5cff, #4f46e5);
  color: #fff;
  font-size: 27rpx;
 font-weight: 700;
  border-radius: 999rpx;
  box-shadow: 0 12rpx 32rpx rgba(124,92,255,0.4);
}
.visual-btn-primary:active  {
 filter: brightness(1.12);
 transform: scale(0.98);
 }
.visual-btn-add-new  {
  display: flex;
 align-items: center;
 justify-content: center;
  padding: 18rpx 32rpx;
  background: linear-gradient(135deg, #7c5cff, #22d3ee);
  color: #fff;
  font-size: 23rpx;
 font-weight: 700;
  border-radius: 999rpx;
  align-self: flex-end;
  height: 72rpx;
  box-sizing: border-box;
  white-space: nowrap;
  box-shadow: 0 8rpx 22rpx rgba(124,92,255,0.35);
}
.visual-btn-add-new:active  {
 filter: brightness(1.12);
 }
/* ── 初始化加载 ── */.init-loading  {
  display: flex;
 flex-direction: column;
 align-items: center;
  padding: 60rpx 20rpx;
  gap: 20rpx;
  position: relative;
}
.radar-scan  {
  position: absolute;
 top: 20rpx;
  width: 180rpx;
 height: 180rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(124,92,255,0.4);
  animation: radarPing 1.8s ease-out infinite;
}
@keyframes radarPing  {
  0%  {
 transform: scale(.6);
 opacity: .8;
 }
  100%  {
 transform: scale(1.6);
 opacity: 0;
 }
}
.init-icon  {
 font-size: 64rpx;
 }
.init-text  {
 display: flex;
 flex-direction: column;
 align-items: center;
 gap: 8rpx;
 }
.glitch-text  {
  font-size: 26rpx;
 font-weight: 700;
  background: linear-gradient(90deg, #a78bfa, #22d3ee);
  -webkit-background-clip: text;
  color: transparent;
}
.init-sub  {
 font-size: 21rpx;
 color: rgba(255,255,255,0.45);
 }
/* ── 统计卡 ── */.stats-grid  {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
  margin-bottom: 22rpx;
}
.stat-card  {
  background: rgba(255,255,255,0.05);
  border: 1rpx solid rgba(255,255,255,0.1);
  border-radius: 20rpx;
  padding: 20rpx 12rpx;
  display: flex;
 flex-direction: column;
 gap: 8rpx;
  align-items: center;
}
.stat-label  {
 font-size: 20rpx;
 color: rgba(255,255,255,0.48);
 }
.stat-value  {
  font-size: 38rpx;
 font-weight: 800;
  font-variant-numeric: tabular-nums;
}
.stat-card.total .stat-value  {
  background: linear-gradient(135deg, #22d3ee, #67e8f9);
  -webkit-background-clip: text;
 color: transparent;
}
.stat-card.carnival .stat-value  {
  background: linear-gradient(135deg, #c4b5fd, #f0abfc);
  -webkit-background-clip: text;
 color: transparent;
}
.stat-card.lucky .stat-value  {
  background: linear-gradient(135deg, #fcd34d, #fbbf24);
  -webkit-background-clip: text;
 color: transparent;
}
/* ── 保底进度 ── */.progress-section  {
  background: rgba(0,0,0,0.22);
  border: 1rpx solid rgba(255,255,255,0.08);
  border-radius: 20rpx;
  padding: 20rpx;
  margin-bottom: 22rpx;
}
.section-meta  {
  display: flex;
 align-items: center;
 justify-content: space-between;
  margin-bottom: 16rpx;
 gap: 12rpx;
}
.section-title-group  {
  display: flex;
 align-items: center;
 flex-wrap: wrap;
 gap: 10rpx;
  font-size: 23rpx;
 color: #fff;
 font-weight: 600;
}
.meta-val  {
  font-size: 22rpx;
 color: rgba(255,255,255,0.5);
  font-variant-numeric: tabular-nums;
}
.mode-tag  {
  display: inline-flex;
 align-items: center;
 gap: 6rpx;
  padding: 6rpx 16rpx;
  font-size: 19rpx;
  color: rgba(255,255,255,0.5);
  background: rgba(255,255,255,0.08);
  border: 1rpx solid rgba(255,255,255,0.12);
  border-radius: 999rpx;
}
.mode-tag.active  {
  color: #a7f3d0;
  background: rgba(52,211,153,0.16);
  border-color: rgba(52,211,153,0.4);
}
.tag-dot  {
 width: 10rpx;
 height: 10rpx;
 border-radius: 50%;
 background: currentColor;
 }
.pity-bar-wrapper  {
 width: 100%;
 }
.pity-track  {
  height: 16rpx;
  background: rgba(255,255,255,0.08);
  border-radius: 999rpx;
  overflow: hidden;
}
.pity-fill  {
  height: 100%;
  background: linear-gradient(90deg, #7c5cff, #22d3ee);
  border-radius: 999rpx;
  transition: width 0.35s ease;
  box-shadow: 0 0 16rpx rgba(124,92,255,0.5);
}
.pity-fill.warning  {
 background: linear-gradient(90deg, #f59e0b, #fcd34d);
 box-shadow: 0 0 16rpx rgba(245,158,11,0.45);
 }
.pity-fill.danger  {
 background: linear-gradient(90deg, #ef4444, #f472b6);
 box-shadow: 0 0 16rpx rgba(239,68,68,0.45);
 }
.pity-status  {
  display: flex;
 align-items: center;
 gap: 10rpx;
  margin-top: 16rpx;
}
.status-emoji  {
 font-size: 26rpx;
 }
.status-text  {
 font-size: 22rpx;
 color: rgba(255,255,255,0.55);
 }
.manual-reset-hint  {
 font-size: 18rpx;
 color: rgba(255,255,255,0.3);
 margin-left: 8rpx;
 }
/* ── 主操作按钮组：浮动标识 ── */.control-grid  {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 18rpx 14rpx;
}
.visual-action-btn  {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  padding: 22rpx 10rpx;
  min-height: 84rpx;
  box-sizing: border-box;
  background: rgba(255,255,255,0.08);
  border: 1rpx solid rgba(255,255,255,0.14);
  border-radius: 999rpx;
  transition: all 0.2s;
}
.visual-action-btn:active  {
 transform: scale(0.94);
 opacity: 0.85;
 }
.visual-action-btn .btn-icon  {
  font-size: 32rpx;
  line-height: 1;
  flex-shrink: 0;
}
.visual-action-btn .btn-icon-img  {
  display: block;
  width: 40rpx;
  height: 40rpx;
  flex-shrink: 0;
  background: transparent;
  box-sizing: border-box;
}
.visual-action-btn .btn-text  {
  display: block;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1.2;
  letter-spacing: 1rpx;
  flex-shrink: 0;
}
/* 浮动标识：彩色半透明胶囊，可点击 */.capture-btn .btn-text  {
  color: #6ee7b7;
  text-shadow: 0 2rpx 16rpx rgba(52,211,153,0.55);
}
.capture-btn  {
  background: rgba(52,211,153,0.14);
  border-color: rgba(52,211,153,0.38);
  filter: drop-shadow(0 6rpx 18rpx rgba(52,211,153,0.28));
}
.capture-btn:active  {
 background: rgba(52,211,153,0.28);
 }
.visual-action-btn.full-span  {
  grid-column: 1 / -1;
}
.miss-btn .btn-text  {
  color: #f9a8d4;
  text-shadow: 0 2rpx 16rpx rgba(244,114,182,0.5);
}
.miss-btn  {
  background: rgba(244,114,182,0.14);
  border-color: rgba(244,114,182,0.38);
  filter: drop-shadow(0 6rpx 18rpx rgba(244,114,182,0.25));
}
.miss-btn:active  {
 background: rgba(244,114,182,0.28);
 }
.box-btn .btn-text  {
  color: #fcd34d;
  text-shadow: 0 2rpx 16rpx rgba(251,191,36,0.5);
}
.box-btn  {
  background: rgba(251,191,36,0.14);
  border-color: rgba(251,191,36,0.38);
  filter: drop-shadow(0 6rpx 18rpx rgba(251,191,36,0.22));
}
.box-btn:active  {
 background: rgba(251,191,36,0.28);
 }
.carnival-btn .btn-text  {
  color: #c4b5fd;
  text-shadow: 0 2rpx 16rpx rgba(124,92,255,0.55);
}
.carnival-btn  {
  background: rgba(124,92,255,0.16);
  border-color: rgba(124,92,255,0.4);
  filter: drop-shadow(0 6rpx 18rpx rgba(124,92,255,0.28));
}
.carnival-btn:active  {
 background: rgba(124,92,255,0.3);
 }
.help-hint  {
  margin-top: 14rpx;
  font-size: 20rpx;
  color: rgba(255,255,255,0.35);
  text-align: center;
}
.dice-notice-bar {
  margin-top: 18rpx;
  padding: 14rpx 20rpx;
  border-radius: 18rpx;
  background: linear-gradient(135deg, rgba(124, 92, 255, 0.12) 0%, rgba(251, 191, 36, 0.07) 100%);
  border: 1rpx solid rgba(196, 181, 253, 0.22);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  flex-wrap: wrap;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.08);
}
.dice-notice-main {
  display: flex;
  align-items: center;
  gap: 10rpx;
  min-width: 0;
  flex: 1;
}
.dice-notice-icon-wrap {
  width: 36rpx;
  height: 36rpx;
  border-radius: 10rpx;
  background: rgba(251, 191, 36, 0.14);
  border: 1rpx solid rgba(251, 191, 36, 0.32);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.dice-notice-icon {
  width: 24rpx;
  height: 24rpx;
}
.dice-notice-text {
  font-size: 21rpx;
  color: rgba(238, 240, 255, 0.85);
  font-weight: 600;
  letter-spacing: 0.5rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.dice-notice-badge {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(251, 191, 36, 0.14);
  border: 1rpx solid rgba(251, 191, 36, 0.35);
  font-size: 18rpx;
  font-weight: 700;
  color: #fcd34d;
  flex-shrink: 0;
  font-variant-numeric: tabular-nums;
}
.dice-notice-badge-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #fbbf24;
  box-shadow: 0 0 8rpx rgba(251, 191, 36, 0.8);
}
/* ── 资产面板 ── */.init-form  {
 margin-top: 8rpx;
 display: flex;
 flex-direction: column;
 gap: 20rpx;
 }
.premium-input  {
  width: 100%;
  height: 76rpx;
  box-sizing: border-box;
  background: rgba(0,0,0,0.28);
