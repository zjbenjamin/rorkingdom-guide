/* 展开动画：grid 0fr↔1fr 精确撑开 + 内容 transform/opacity（GPU 合成，避免 max-height 重排掉帧） */.ball-desc-scroll  {
  display: grid;
  grid-template-rows: 0fr;
  margin-top: 0;
  overflow: hidden;
  transform: translateZ(0);
  transition: grid-template-rows 0.24s cubic-bezier(0.22, 1, 0.36, 1),              margin-top 0.24s cubic-bezier(0.22, 1, 0.36, 1);
}
.ball-desc-scroll.open  {
  grid-template-rows: 1fr;
  margin-top: 12rpx;
}
.ball-desc-clip  {
  overflow: hidden;
  min-height: 0;
}
.ball-desc-inner  {
  padding: 14rpx 16rpx;
  background: rgba(0,0,0,0.25);
  border: 1rpx solid rgba(255,255,255,0.08);
  border-radius: 16rpx;
  display: flex;
 flex-direction: column;
 gap: 8rpx;
  transform: translateY(-10rpx);
  opacity: 0;
  transition: transform 0.24s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.18s ease;
  will-change: transform, opacity;
}
.ball-desc-scroll.open .ball-desc-inner  {
  transform: translateY(0);
  opacity: 1;
}
