/* ===== GitHub Dark 登录页 ===== */
page { background: #0d1117; overflow: hidden; }
.page { min-height: 100vh; display: flex; flex-direction: column; justify-content: center; padding-bottom: calc(180rpx + constant(safe-area-inset-bottom)); padding-bottom: calc(180rpx + env(safe-area-inset-bottom)); background: #0d1117; overflow-x: hidden; }
.container { padding: 24rpx; width: 100%; box-sizing: border-box; overflow-x: hidden; }

/* ── Header ── */
.login-header { text-align: center; padding: 40rpx 0 28rpx; }
.logo-box { width: 100rpx; height: 100rpx; background: #21262d; border: 2rpx solid #30363d; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 16rpx; }
.logo-image { width: 100%; height: 100%; border-radius: 50%; }
.app-name { font-size: 36rpx; font-weight: 700; color: #e6edf3; display: block; }
.app-desc { font-size: 20rpx; color: #8b949e; display: block; margin-top: 4rpx; }

/* ── Login Card ── */
.login-card { background: #161b22; border: 1rpx solid #30363d; border-radius: 12rpx; padding: 40rpx 32rpx; margin-bottom: 20rpx; box-sizing: border-box; max-width: 100%; }

/* ── Avatar Section ── */
.avatar-section { display: flex; flex-direction: column; align-items: center; margin-bottom: 28rpx; }
.avatar-btn { background: transparent !important; border: none !important; padding: 0 !important; margin: 0 !important; line-height: normal !important; display: flex !important; align-items: center !important; justify-content: center !important; }
.avatar-btn::after { border: none; }
.avatar-ring {
  width: 120rpx; height: 120rpx;
  border-radius: 50%;
  background: #0d1117;
  border: 3rpx dashed #30363d;
  display: flex; align-items: center; justify-content: center;
  position: relative;
  transition: all 0.3s;
}
.avatar-ring.has-avatar { border-style: solid; border-color: #238636; }
.avatar-img { width: 100%; height: 100%; border-radius: 50%; }
.avatar-empty { display: flex; align-items: center; justify-content: center; width: 100%; height: 100%; }
.avatar-plus { font-size: 48rpx; color: #484f58; line-height: 1; }
.avatar-hint { font-size: 18rpx; color: #58a6ff; margin-top: 10rpx; font-weight: 500; }

/* ── Nickname Section ── */
.nick-section { margin-bottom: 24rpx; max-width: 560rpx; margin-left: auto; margin-right: auto; }
.nick-label { font-size: 22rpx; color: #8b949e; font-weight: 600; display: block; margin-bottom: 10rpx; text-align: center; }
.nick-input-wrap { background: #0d1117; border: 1rpx solid #30363d; border-radius: 8rpx; transition: border-color 0.2s; box-sizing: border-box; max-width: 100%; }
.nick-input-wrap:focus-within { border-color: #58a6ff; }
.nick-input { width: 100%; height: 72rpx; padding: 0 16rpx; font-size: 26rpx; color: #e6edf3; box-sizing: border-box; }
.nick-hint { font-size: 18rpx; color: #484f58; margin-top: 8rpx; display: block; text-align: center; }

/* ── Submit Button ── */
.submit-btn { width: 560rpx !important; max-width: calc(100% - 64rpx) !important; height: 76rpx !important; margin-left: auto !important; margin-right: auto !important; background: #238636 !important; color: #fff !important; border-radius: 8rpx !important; font-size: 28rpx !important; font-weight: 600 !important; letter-spacing: 4rpx; border: none !important; margin-bottom: 14rpx !important; display: flex !important; align-items: center !important; justify-content: center !important; text-align: center !important; box-sizing: border-box !important; }
.submit-btn::after { border: none; }
.submit-btn:active { background: #2ea043 !important; }
.submit-btn[disabled] { opacity: 0.5; background: #21262d !important; }

/* ── Agree ── */
.agree-section { display: flex; align-items: center; justify-content: center; flex-wrap: wrap; font-size: 20rpx; color: #8b949e; margin-top: 10rpx; gap: 4rpx; max-width: 560rpx; margin-left: auto; margin-right: auto; box-sizing: border-box; }
.agree-checkbox-group { display: inline-block; }
.agree-label { display: flex; align-items: center; }
.agree-checkbox { transform: scale(0.65); margin-right: -4rpx; }
.agree-text-span { font-size: 20rpx; color: #8b949e; }
.agree-section .link { color: #58a6ff; font-weight: 500; }

/* ── User Card (已登录) ── */
.user-card { background: #161b22; border: 1rpx solid #30363d; border-radius: 12rpx; padding: 28rpx; margin-bottom: 20rpx; box-sizing: border-box; max-width: 100%; }
.user-header { display: flex; align-items: center; gap: 16rpx; margin-bottom: 20rpx; }
.user-card .avatar-wrap { width: 88rpx; height: 88rpx; position: relative; flex-shrink: 0; border-radius: 50%; overflow: visible; background: #21262d; }
.user-avatar-wrap::after { display: none; }
.user-avatar { width: 88rpx; height: 88rpx; border-radius: 50%; border: 2rpx solid #30363d; position: relative; z-index: 1; }
.level-tag { position: absolute; bottom: -4rpx; left: 50%; transform: translateX(-50%); font-size: 16rpx; font-weight: 700; padding: 2rpx 10rpx; border-radius: 10rpx; white-space: nowrap; border: 1rpx solid; display: flex; align-items: center; gap: 2rpx; }
.level-icon { font-size: 14rpx; }
.level-num { font-size: 16rpx; }
.user-title-text { font-size: 20rpx; font-weight: 600; display: block; margin-bottom: 4rpx; }
.user-detail { flex: 1; }
.user-name { font-size: 28rpx; font-weight: 700; color: #e6edf3; }
.user-name-row { display: flex; align-items: center; gap: 8rpx; margin-bottom: 6rpx; }
.role-tag { padding: 2rpx 8rpx; border-radius: 6rpx; font-size: 16rpx; font-weight: 600; }
.role-tag.editor { background: rgba(88,166,255,0.12); color: #58a6ff; border: 1rpx solid rgba(88,166,255,0.2); }
.role-tag.developer { background: rgba(210,153,34,0.12); color: #d29922; border: 1rpx solid rgba(210,153,34,0.2); }
.user-exp { font-size: 20rpx; color: #8b949e; display: block; margin-bottom: 10rpx; }
.exp-bar { width: 100%; height: 6rpx; background: #21262d; border-radius: 3rpx; overflow: hidden; }
.exp-fill { height: 100%; background: linear-gradient(90deg, #58a6ff, #bc8cff); border-radius: 3rpx; }

/* ── Expire Bar ── */
.expire-bar { background: rgba(210,153,34,0.06); border: 1rpx solid rgba(210,153,34,0.15); border-radius: 8rpx; padding: 12rpx 16rpx; margin-bottom: 16rpx; font-size: 22rpx; color: #d29922; }

/* ── UID Card ── */
.uid-card { display: flex; align-items: center; justify-content: space-between; background: #0d1117; border: 1rpx solid #21262d; border-radius: 8rpx; padding: 16rpx 20rpx; margin-bottom: 16rpx; box-sizing: border-box; max-width: 100%; }
.uid-left { flex: 1; }
.uid-label { font-size: 22rpx; color: #8b949e; display: block; margin-bottom: 2rpx; }
.uid-value { font-size: 30rpx; font-weight: 700; color: #58a6ff; display: block; font-family: monospace; }
.uid-empty { font-size: 22rpx; color: #8b949e; display: block; text-align: center; }
.uid-arrow { font-size: 28rpx; color: #8b949e; }

/* ── Stats ── */
.stat-grid { display: flex; gap: 10rpx; margin-bottom: 20rpx; box-sizing: border-box; max-width: 100%; }
.stat-box { flex: 1; text-align: center; background: #0d1117; border: 1rpx solid #21262d; border-radius: 8rpx; padding: 16rpx 0; box-sizing: border-box; min-width: 0; }
.stat-num { font-size: 28rpx; font-weight: 700; color: #58a6ff; display: block; font-family: monospace; }
.stat-name { font-size: 20rpx; color: #8b949e; display: block; margin-top: 4rpx; }

/* ── Notify Section ── */
.notify-section { background: #161b22; border: 1rpx solid #30363d; border-radius: 12rpx; padding: 24rpx; margin-bottom: 16rpx; box-sizing: border-box; max-width: 100%; }
.notify-title { display: flex; align-items: center; gap: 8rpx; margin-bottom: 20rpx; flex-wrap: wrap; }
.notify-title-icon { font-size: 28rpx; }
.notify-title-text { font-size: 26rpx; font-weight: 700; color: #e6edf3; letter-spacing: 1rpx; }
.notify-title-hint { font-size: 18rpx; color: #484f58; width: 100%; margin-top: 4rpx; padding-left: 36rpx; }
.notify-item { display: flex; align-items: center; justify-content: space-between; padding: 16rpx 0; border-bottom: 1rpx solid #21262d; }
.notify-item:last-of-type { border-bottom: none; }
.notify-info { flex: 1; }
.notify-name { font-size: 24rpx; color: #e6edf3; display: block; margin-bottom: 4rpx; font-weight: 500; }
.notify-desc { font-size: 20rpx; color: #8b949e; display: block; }
.notify-right { flex-shrink: 0; display: flex; align-items: center; gap: 10rpx; }
.notify-counter { display: flex; align-items: center; gap: 10rpx; }
.notify-reset { font-size: 18rpx; color: #f85149; padding: 4rpx 12rpx; background: rgba(248,81,73,0.08); border: 1rpx solid rgba(248,81,73,0.15); border-radius: 6rpx; }
.counter-btn { width: 48rpx; height: 48rpx; background: #21262d; border: 1rpx solid #30363d; border-radius: 8rpx; display: flex; align-items: center; justify-content: center; }
.counter-btn:active { background: #30363d; }
.counter-plus { font-size: 28rpx; color: #58a6ff; font-weight: 300; line-height: 1; }
.counter-badge { min-width: 32rpx; height: 32rpx; background: rgba(88,166,255,0.12); border-radius: 16rpx; display: flex; align-items: center; justify-content: center; padding: 0 8rpx; border: 1rpx solid rgba(88,166,255,0.2); }
.counter-num { font-size: 20rpx; color: #58a6ff; font-weight: 700; }
.notify-na { font-size: 18rpx; color: #484f58; background: #0d1117; padding: 8rpx 16rpx; border-radius: 6rpx; border: 1rpx solid #21262d; }
.notify-tip { text-align: center; padding-top: 12rpx; }
.notify-tip-text { font-size: 20rpx; color: #58a6ff; text-decoration: underline; }

/* ── Action List ── */
.action-list { border-top: 1rpx solid #21262d; padding-top: 8rpx; }
.action-item { display: flex; align-items: center; padding: 16rpx 12rpx; border-radius: 8rpx; margin-bottom: 6rpx; background: #0d1117; border: 1rpx solid #21262d; }
.action-item:active { background: #1c2128; }
.admin-item { background: rgba(188,140,255,0.04); border-color: rgba(188,140,255,0.12); }
.action-icon-wrap { width: 44rpx; height: 44rpx; border-radius: 10rpx; display: flex; align-items: center; justify-content: center; margin-right: 12rpx; }
.admin-icon-wrap { background: rgba(188,140,255,0.1); border: 1rpx solid rgba(188,140,255,0.2); }
.danger-icon-wrap { background: rgba(248,81,73,0.08); border: 1rpx solid rgba(248,81,73,0.15); }
.action-icon { font-size: 24rpx; }
.action-text { flex: 1; font-size: 24rpx; color: #c9d1d9; font-weight: 500; }
.danger-text { color: #f85149; }
.action-arrow { font-size: 24rpx; color: #8b949e; }

/* ── Feature Grid ── */
.feature-grid { display: flex; gap: 10rpx; margin-bottom: 16rpx; box-sizing: border-box; max-width: 100%; }
.feature-box { flex: 1; background: #161b22; border: 1rpx solid #30363d; border-radius: 8rpx; padding: 20rpx 6rpx; text-align: center; box-sizing: border-box; min-width: 0; }
.feature-emoji { font-size: 36rpx; display: block; margin-bottom: 6rpx; }
.feature-title { font-size: 22rpx; font-weight: 600; color: #e6edf3; display: block; margin-bottom: 2rpx; }
.feature-desc { font-size: 18rpx; color: #8b949e; display: block; }

/* ── Notice Box ── */
.notice-box { background: #161b22; border: 1rpx solid #30363d; border-radius: 8rpx; padding: 20rpx; margin-bottom: 16rpx; box-sizing: border-box; max-width: 100%; }
.notice-title { font-size: 24rpx; font-weight: 600; color: #e6edf3; display: block; margin-bottom: 10rpx; }
.notice-text { font-size: 22rpx; color: #8b949e; display: block; line-height: 2; word-break: break-all; }

/* ── Version ── */
.version { text-align: center; font-size: 20rpx; color: #484f58; display: block; padding: 20rpx 0; word-break: break-all; }

/* ── Modal ── */
.modal-mask { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.6); z-index: 10000; display: flex; align-items: center; justify-content: center; }
.modal-box { width: 82%; max-width: 600rpx; background: #161b22; border: 1rpx solid #30363d; border-radius: 12rpx; padding: 28rpx; box-sizing: border-box; }
.modal-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20rpx; }
.modal-title { font-size: 28rpx; font-weight: 700; color: #e6edf3; }
.modal-close { font-size: 32rpx; color: #8b949e; padding: 8rpx; }
.modal-close:active { color: #f85149; }
.modal-body { margin-bottom: 20rpx; }
.modal-input { width: 100%; min-height: 72rpx; background: #0d1117; border: 1rpx solid #30363d; border-radius: 8rpx; padding: 16rpx; font-size: 26rpx; color: #e6edf3; box-sizing: border-box; }
.modal-input:focus { border-color: #58a6ff; }
.modal-hint { font-size: 20rpx; color: #8b949e; display: block; margin-top: 10rpx; }
.modal-footer { display: flex; gap: 12rpx; }
.modal-cancel { flex: 1; background: #21262d !important; color: #c9d1d9 !important; border-radius: 8rpx !important; height: 72rpx !important; font-size: 24rpx !important; border: 1rpx solid #30363d !important; display: flex !important; align-items: center !important; justify-content: center !important; }
.modal-cancel::after { border: none; }
.modal-save { flex: 1; background: #238636 !important; color: #fff !important; border-radius: 8rpx !important; height: 72rpx !important; font-size: 24rpx !important; font-weight: 600 !important; border: none !important; display: flex !important; align-items: center !important; justify-content: center !important; }
.modal-save::after { border: none; }
.modal-save:active { background: #2ea043 !important; }

/* ── Privacy Modal ── */
.privacy-modal-mask { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.7); z-index: 20000; display: flex; align-items: center; justify-content: center; }
.privacy-modal-box { width: 82%; max-width: 600rpx; background: #161b22; border: 1rpx solid #30363d; border-radius: 12rpx; padding: 40rpx 28rpx 28rpx; position: relative; overflow: hidden; box-sizing: border-box; }
.privacy-modal-box::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 3rpx; background: #58a6ff; }
.privacy-modal-icon { text-align: center; font-size: 48rpx; margin-bottom: 16rpx; }
.privacy-modal-header { margin-bottom: 16rpx; text-align: center; }
.privacy-modal-title { font-size: 28rpx; font-weight: 800; color: #e6edf3; display: block; }
.privacy-modal-body { margin-bottom: 28rpx; line-height: 1.6; text-align: center; background: #0d1117; border: 1rpx solid #21262d; border-radius: 8rpx; padding: 20rpx 16rpx; }
.privacy-modal-desc { font-size: 24rpx; color: #8b949e; }
.privacy-modal-link-inline { font-size: 24rpx; color: #58a6ff; text-decoration: underline; font-weight: 700; display: inline; }
.privacy-modal-footer { display: flex; gap: 16rpx; }
.privacy-btn-cancel { flex: 1; background: #21262d !important; color: #8b949e !important; border: 1rpx solid #30363d !important; border-radius: 8rpx !important; height: 76rpx !important; font-size: 24rpx !important; font-weight: 600 !important; display: flex !important; align-items: center !important; justify-content: center !important; }
.privacy-btn-cancel::after { border: none; }
.privacy-btn-confirm { flex: 1.5; background: #238636 !important; color: #fff !important; border-radius: 8rpx !important; height: 76rpx !important; font-size: 24rpx !important; font-weight: 700 !important; border: none !important; display: flex !important; align-items: center !important; justify-content: center !important; }
.privacy-btn-confirm::after { border: none; }
.privacy-btn-confirm:active { background: #2ea043 !important; }
