<view class="page">
  <view class="container">
    <view class="login-header">
      <text class="app-name">{{loginLabels.appName}}</text>
      <text class="app-desc">{{loginLabels.appDesc}}</text>
    </view>

    <!-- 未登录 -->
    <view class="login-card" wx:if="{{!hasUserInfo}}">
      <view class="avatar-section">
        <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
          <view class="avatar-ring {{tempAvatar ? 'has-avatar' : ''}}">
            <image lazy-load class="avatar-img" src="{{tempAvatar}}" wx:if="{{tempAvatar}}" mode="aspectFill" />
            <view class="avatar-empty" wx:else>
              <text class="avatar-plus">+</text>
            </view>
          </view>
        </button>
        <text class="avatar-hint">{{tempAvatar ? loginLabels.tapChangeAvatar : loginLabels.tapSelectAvatar}}</text>
      </view>

      <view class="nick-section">
        <text class="nick-label">{{loginLabels.nickname}}</text>
        <form bindsubmit="onNickFormSubmit">
          <view class="nick-input-wrap">
            <input class="nick-input" type="nickname" name="nickname" placeholder="{{loginLabels.nicknamePlaceholder}}" placeholder-style="color:#484f58;font-size:24rpx" value="{{tempNickName}}" bindinput="onNickNameInput" bindblur="onNickNameBlur" />
          </view>
        </form>
        <text class="nick-hint">{{loginLabels.nicknameHint}}</text>
      </view>

      <button class="submit-btn" bindtap="onLogin" loading="{{isLogging}}" disabled="{{isLogging}}">{{loginLabels.loginBtn}}</button>

      <view class="agree-section">
        <checkbox-group class="agree-checkbox-group" bindchange="onAgreeChange">
          <label class="agree-label">
            <checkbox class="agree-checkbox" value="agree" checked="{{isAgreed}}" />
            <text class="agree-text-span">{{loginLabels.agreeText}}</text>
          </label>
        </checkbox-group>
        <text class="link" bindtap="showAgreement">{{loginLabels.agreement}}</text>
        <text class="agree-text-span">{{loginLabels.agreeAnd}}</text>
        <text class="link" bindtap="showPrivacy">{{loginLabels.privacy}}</text>
      </view>
    </view>

    <!-- 已登录 -->
    <view class="user-card" wx:if="{{hasUserInfo}}">
      <view class="user-header">
        <view class="avatar-wrap user-avatar-wrap">
          <image lazy-load class="user-avatar" src="{{userInfo.avatarUrl}}" mode="aspectFill"></image>
        </view>
        <view class="user-detail">
          <view class="user-name-row">
            <text class="user-name">{{userInfo.nickName}}</text>
            <view class="level-tag" style="background: {{levelColor.bg}}; color: {{levelColor.text}}; border-color: {{levelColor.border}};">
              <text class="level-icon">{{levelIcon}}</text>
              <text class="level-num">Lv.{{level}}</text>
            </view>
            <view class="role-tag editor" wx:if="{{userRole === 'editor'}}">{{loginLabels.editor}}</view>
            <view class="role-tag developer" wx:if="{{userRole === 'developer'}}">{{loginLabels.developer}}</view>
            <text class="user-title-text" style="color: {{levelColor.border}};">{{levelName}}</text>
          </view>
          <text class="user-exp">{{loginLabels.loginDays}}: {{loginDays}} · {{loginLabels.level}}: Lv.{{level}}{{nextLevelText}}{{nextXPText}}</text>
          <view class="exp-bar">
            <view class="exp-fill" style="width: {{loginDays >= nextLevelDays ? 100 : (loginDays / nextLevelDays * 100)}}%"></view>
          </view>
        </view>
      </view>

      <view class="expire-bar">{{loginLabels.loginExpire}}{{loginExpire}}</view>

      <view class="uid-card" bindtap="toggleUidModal">
        <view class="uid-left">
          <text class="uid-label">{{loginLabels.rocoUID}}</text>
          <text class="uid-value" wx:if="{{gameUid}}">{{gameUid}}</text>
          <text class="uid-empty" wx:else>{{loginLabels.tapSetUID}}</text>
        </view>
        <text class="uid-arrow">›</text>
      </view>

      <view class="stat-grid">
        <view class="stat-box">
          <text class="stat-num">Lv.{{level}}</text>
          <text class="stat-name">{{loginLabels.level}}</text>
        </view>
        <view class="stat-box">
          <text class="stat-num">{{loginDays}}</text>
          <text class="stat-name">{{loginLabels.loginDays}}</text>
        </view>
        <view class="stat-box">
          <text class="stat-num">{{todayLogin ? '✓' : '—'}}</text>
          <text class="stat-name">{{loginLabels.checkIn}}</text>
        </view>
      </view>

      <view class="notify-section">
        <view class="notify-title">
          <text class="notify-title-icon">🔔</text>
          <text class="notify-title-text">{{loginLabels.notifyTitle}}</text>
          <text class="notify-title-hint">{{loginLabels.notifyTapHint}}</text>
        </view>
        <view class="notify-item" wx:if="{{notifyConfigured.announcement && subscribeConfig.announcement !== false}}">
          <view class="notify-info">
            <text class="notify-name">{{loginLabels.notifyAnnounce}}</text>
            <text class="notify-desc">{{loginLabels.notifyAnnounceDesc}}</text>
          </view>
          <view class="notify-right">
            <view wx:if="{{notifyConfigured.announcement}}" class="notify-counter" data-type="announcement" catchtap="onNotifyAdd">
              <view class="counter-btn"><text class="counter-plus">+</text></view>
              <view class="counter-badge" wx:if="{{notifyCount.announcement > 0}}"><text class="counter-num">{{notifyCount.announcement}}</text></view>
            </view>
            <view wx:else class="notify-na">{{loginLabels.notifyNa}}</view>
            <view class="notify-reset" catchtap="onResetSubscribe" data-type="announcement">{{loginLabels.reset}}</view>
          </view>
        </view>
        <view class="notify-item" wx:if="{{notifyConfigured.activity && subscribeConfig.activity !== false}}">
          <view class="notify-info">
            <text class="notify-name">{{loginLabels.notifyActivity}}</text>
            <text class="notify-desc">{{loginLabels.notifyActivityDesc}}</text>
          </view>
          <view class="notify-right">
            <view wx:if="{{notifyConfigured.activity}}" class="notify-counter" data-type="activity" catchtap="onNotifyAdd">
              <view class="counter-btn"><text class="counter-plus">+</text></view>
              <view class="counter-badge" wx:if="{{notifyCount.activity > 0}}"><text class="counter-num">{{notifyCount.activity}}</text></view>
            </view>
            <view wx:else class="notify-na">{{loginLabels.notifyNa}}</view>
            <view class="notify-reset" catchtap="onResetSubscribe" data-type="activity">{{loginLabels.reset}}</view>
          </view>
        </view>
        <view class="notify-item" wx:if="{{notifyConfigured.merchant && subscribeConfig.merchant !== false}}">
          <view class="notify-info">
            <text class="notify-name">{{loginLabels.notifyMerchant}}</text>
            <text class="notify-desc">{{loginLabels.notifyMerchantDesc}}</text>
          </view>
          <view class="notify-right">
            <view wx:if="{{notifyConfigured.merchant}}" class="notify-counter" data-type="merchant" catchtap="onNotifyAdd">
              <view class="counter-btn"><text class="counter-plus">+</text></view>
              <view class="counter-badge" wx:if="{{notifyCount.merchant > 0}}"><text class="counter-num">{{notifyCount.merchant}}</text></view>
            </view>
            <view wx:else class="notify-na">{{loginLabels.notifyNa}}</view>
            <view class="notify-reset" catchtap="onResetSubscribe" data-type="merchant">{{loginLabels.reset}}</view>
          </view>
        </view>
        <view class="notify-tip" bindtap="onNotifySetting">
          <text class="notify-tip-text">{{loginLabels.notifySettingTip}}</text>
        </view>
      </view>

      <view class="action-list">
        <view class="action-item admin-item" wx:if="{{isAdmin}}" bindtap="goAdmin">
          <view class="action-icon-wrap admin-icon-wrap"><text class="action-icon">⚙</text></view>
          <text class="action-text">{{loginLabels.adminPanel}}</text>
          <text class="action-arrow">›</text>
        </view>
        <view class="action-item danger-item" bindtap="onDeleteAccount">
          <view class="action-icon-wrap danger-icon-wrap"><text class="action-icon">🗑️</text></view>
          <text class="action-text danger-text">{{loginLabels.deleteAccount}}</text>
          <text class="action-arrow">›</text>
        </view>
        <view class="action-item danger-item" bindtap="onLogout">
          <view class="action-icon-wrap danger-icon-wrap"><text class="action-icon">🚪</text></view>
          <text class="action-text danger-text">{{loginLabels.logout}}</text>
          <text class="action-arrow">›</text>
        </view>
      </view>
    </view>

    <view class="feature-grid">
      <view class="feature-box">
        <text class="feature-emoji">📖</text>
        <text class="feature-title">{{loginLabels.feat1Title}}</text>
        <text class="feature-desc">{{loginLabels.feat1Desc}}</text>
      </view>
      <view class="feature-box">
        <text class="feature-emoji">🎯</text>
        <text class="feature-title">{{loginLabels.feat2Title}}</text>
        <text class="feature-desc">{{loginLabels.feat2Desc}}</text>
      </view>
      <view class="feature-box">
        <text class="feature-emoji">📅</text>
        <text class="feature-title">{{loginLabels.feat3Title}}</text>
        <text class="feature-desc">{{loginLabels.feat3Desc}}</text>
      </view>
    </view>

    <view class="notice-box">
      <text class="notice-title">{{loginLabels.noticeTitle}}</text>
      <text class="notice-text">{{loginLabels.notice1}}</text>
      <text class="notice-text">{{loginLabels.notice2}}</text>
      <text class="notice-text">{{loginLabels.notice3}}</text>
      <text class="notice-text">{{loginLabels.notice4}}</text>
      <text class="notice-text">{{loginLabels.notice5}}</text>
    </view>

    <text class="version">浙ICP备2026043884号</text>
  </view>

  <!-- UID Modal -->
  <view class="modal-mask" wx:if="{{showUidModal}}" bindtap="toggleUidModal">
    <view class="modal-box" catchtap="preventClose">
      <view class="modal-header">
        <text class="modal-title">{{loginLabels.setUIDTitle}}</text>
        <text class="modal-close" bindtap="toggleUidModal">✕</text>
      </view>
      <view class="modal-body">
        <input class="modal-input" placeholder="{{loginLabels.uidPlaceholder}}" placeholder-style="color:#484f58" value="{{uidInput}}" bindinput="onUidInput" type="number" />
        <text class="modal-hint">{{loginLabels.uidHint}}</text>
      </view>
      <view class="modal-footer">
        <button class="modal-cancel" bindtap="toggleUidModal">{{loginLabels.cancel}}</button>
        <button class="modal-save" bindtap="saveUid">{{loginLabels.save}}</button>
      </view>
    </view>
  </view>

  <!-- 微信官方隐私授权弹窗 -->
  <view class="privacy-modal-mask" wx:if="{{showWechatPrivacyModal}}" catchtouchmove="preventClose">
    <view class="privacy-modal-box">
      <view class="privacy-modal-icon">🔐</view>
      <view class="privacy-modal-header">
        <text class="privacy-modal-title">{{loginLabels.privacyModalTitle}}</text>
      </view>
      <view class="privacy-modal-body">
        <text class="privacy-modal-desc">{{loginLabels.privacyModalDesc1}}</text>
        <text class="privacy-modal-link-inline" bindtap="showPrivacy">{{loginLabels.privacy}}</text>
        <text class="privacy-modal-desc">{{loginLabels.privacyModalDesc2}}</text>
      </view>
      <view class="privacy-modal-footer">
        <button class="privacy-btn-cancel" bindtap="handleDisagreePrivacy">{{loginLabels.reject}}</button>
        <button class="privacy-btn-confirm" open-type="agreePrivacyAuthorization" id="agree-btn" bindagreeprivacyauthorization="handleAgreePrivacy">{{loginLabels.agreeContinue}}</button>
      </view>
    </view>
  </view>

  <dock current="login" />
</view>
