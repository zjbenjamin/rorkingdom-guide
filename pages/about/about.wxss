/* ===== GitHub Dark 关于页 ===== */
.page { min-height: 100vh; background: #0d1117; padding-bottom: calc(180rpx + constant(safe-area-inset-bottom)); padding-bottom: calc(180rpx + env(safe-area-inset-bottom)); }
.container { padding: 24rpx; }

/* ── Profile Header ── */
.profile-header {
  display: flex; flex-direction: column; align-items: center;
  padding: 48rpx 32rpx 36rpx;
  border-bottom: 1rpx solid #21262d;
  margin-bottom: 24rpx;
}
.profile-avatar { width: 120rpx; height: 120rpx; border-radius: 50%; overflow: hidden; border: 2rpx solid #30363d; margin-bottom: 20rpx; }
.avatar-img { width: 100%; height: 100%; }
.profile-name { font-size: 32rpx; font-weight: 700; color: #e6edf3; margin-bottom: 6rpx; }
.profile-role { font-size: 22rpx; color: #8b949e; margin-bottom: 16rpx; }
.profile-meta { display: flex; gap: 12rpx; margin-bottom: 20rpx; flex-wrap: wrap; justify-content: center; }
.meta-badge { display: flex; align-items: center; gap: 6rpx; padding: 4rpx 14rpx; background: #21262d; border: 1rpx solid #30363d; border-radius: 20rpx; }
.meta-badge-dot { width: 8rpx; height: 8rpx; border-radius: 50%; }
.meta-badge-dot.online { background: #3fb950; }
.meta-badge-text { font-size: 20rpx; color: #8b949e; }
.profile-tags { display: flex; gap: 8rpx; flex-wrap: wrap; justify-content: center; }
.tag { padding: 4rpx 14rpx; background: rgba(88,166,255,0.1); border: 1rpx solid rgba(88,166,255,0.2); border-radius: 20rpx; font-size: 20rpx; color: #58a6ff; }

/* ── Section Card ── */
.section {
  border: 1rpx solid #30363d;
  border-radius: 12rpx;
  background: #161b22;
  margin-bottom: 16rpx;
  overflow: hidden;
}
.section-title {
  font-size: 24rpx; font-weight: 700; color: #e6edf3;
  padding: 20rpx 24rpx;
  border-bottom: 1rpx solid #21262d;
  background: #0d1117;
}
.section-title-row {
  display: flex; align-items: center; justify-content: space-between;
  padding: 20rpx 24rpx;
  border-bottom: 1rpx solid #21262d;
  background: #0d1117;
}
.section-title-row .section-title { padding: 0; border: none; background: transparent; }
.section-title-action {
  display: flex; align-items: center; gap: 4rpx;
  padding: 4rpx 12rpx;
  background: rgba(88,166,255,0.1); border: 1rpx solid rgba(88,166,255,0.2);
  border-radius: 16rpx;
}
.action-plus { font-size: 20rpx; color: #58a6ff; font-weight: 700; }
.action-text { font-size: 20rpx; color: #58a6ff; }
.section-body { padding: 0; }
.section-empty { padding: 32rpx 24rpx; text-align: center; font-size: 24rpx; color: #484f58; }

/* ── List Items ── */
.list-item {
  display: flex; align-items: center; gap: 12rpx;
  padding: 16rpx 24rpx;
  border-bottom: 1rpx solid #21262d;
}
.list-item:last-child { border-bottom: none; }
.list-item:active { background: #1c2128; }
.list-item-icon { font-size: 28rpx; flex-shrink: 0; }
.list-item-info { flex: 1; min-width: 0; }
.list-item-name { font-size: 24rpx; color: #c9d1d9; font-weight: 600; display: block; }
.list-item-url { font-size: 20rpx; color: #8b949e; display: block; margin-top: 2rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.list-item-text { flex: 1; font-size: 24rpx; color: #c9d1d9; line-height: 1.5; }
.list-item-del { font-size: 24rpx; color: #f85149; padding: 8rpx; flex-shrink: 0; }
.list-add { display: flex; align-items: center; justify-content: center; gap: 6rpx; padding: 14rpx 24rpx; border-top: 1rpx solid #21262d; }
.list-add:active { background: #1c2128; }
.list-add-icon { font-size: 24rpx; color: #58a6ff; }
.list-add-text { font-size: 22rpx; color: #58a6ff; }

/* Copy buttons */
.copy-btn { padding: 8rpx 20rpx; background: #21262d; border: 1rpx solid #30363d; border-radius: 6rpx; font-size: 24rpx; color: #58a6ff; font-weight: 600; flex-shrink: 0; }
.copy-btn:active { background: #30363d; }
.copy-btn-sm { padding: 4rpx 12rpx; background: transparent; border: 1rpx solid #30363d; border-radius: 6rpx; font-size: 20rpx; color: #8b949e; flex-shrink: 0; }

/* ── UID ── */
.uid-row { display: flex; align-items: center; justify-content: space-between; padding: 20rpx 24rpx; }
.uid-info { flex: 1; }
.uid-label { font-size: 20rpx; color: #8b949e; display: block; margin-bottom: 4rpx; }
.uid-val { font-size: 40rpx; font-weight: 800; color: #58a6ff; font-family: 'DIN Alternate', monospace; }

/* ── Tip ── */
.tip-box {
  display: flex; align-items: flex-start; gap: 10rpx;
  margin: 12rpx 24rpx 16rpx;
  padding: 12rpx 16rpx;
  background: rgba(88,166,255,0.06);
  border: 1rpx dashed rgba(88,166,255,0.2);
  border-radius: 8rpx;
}
.tip-icon { font-size: 22rpx; flex-shrink: 0; margin-top: 2rpx; }
.tip-text { font-size: 22rpx; color: #58a6ff; line-height: 1.5; }

/* ── Disclaimer ── */
.disclaimer { font-size: 22rpx; color: #8b949e; display: block; padding: 12rpx 24rpx; border-bottom: 1rpx solid #21262d; line-height: 1.6; }
.disclaimer:last-child { border-bottom: none; }

/* ── Admin ── */
.admin-tip { display: flex; align-items: center; gap: 10rpx; padding: 12rpx 24rpx; background: rgba(210,153,34,0.08); border-bottom: 1rpx solid #21262d; }
.admin-tip-icon { font-size: 24rpx; }
.admin-tip-text { font-size: 22rpx; color: #d29922; }
.setting-row { display: flex; align-items: center; justify-content: space-between; padding: 16rpx 24rpx; border-bottom: 1rpx solid #21262d; }
.setting-row:last-child { border-bottom: none; }
.setting-info { flex: 1; }
.setting-name { font-size: 24rpx; color: #e6edf3; font-weight: 600; display: block; }
.setting-desc { font-size: 20rpx; color: #8b949e; display: block; margin-top: 4rpx; }
.toggle { width: 52rpx; height: 28rpx; background: #21262d; border: 1rpx solid #30363d; border-radius: 14rpx; padding: 3rpx; transition: all 0.2s; }
.toggle.on { background: #238636; border-color: #2ea043; }
.toggle-dot { width: 20rpx; height: 20rpx; background: #c9d1d9; border-radius: 50%; transition: transform 0.2s; }
.toggle.on .toggle-dot { transform: translateX(22rpx); }

/* ── Changelog ── */
.changelog-item { padding: 16rpx 24rpx; border-bottom: 1rpx solid #21262d; }
.changelog-item:last-child { border-bottom: none; }
.changelog-header { display: flex; align-items: center; gap: 12rpx; margin-bottom: 10rpx; flex-wrap: wrap; }
.changelog-tag { padding: 2rpx 10rpx; background: rgba(88,166,255,0.12); border: 1rpx solid rgba(88,166,255,0.2); border-radius: 16rpx; font-size: 22rpx; color: #58a6ff; font-weight: 700; }
.changelog-date { font-size: 20rpx; color: #484f58; }
.changelog-actions { display: flex; gap: 8rpx; margin-left: auto; }
.action-btn-sm { font-size: 20rpx; padding: 2rpx 10rpx; border-radius: 4rpx; background: rgba(88,166,255,0.1); border: 1rpx solid rgba(88,166,255,0.2); color: #58a6ff; }
.action-btn-sm.danger { background: rgba(248,81,73,0.1); border-color: rgba(248,81,73,0.2); color: #f85149; }
.changelog-body { padding-left: 4rpx; }
.cl-add { font-size: 22rpx; color: #3fb950; display: block; line-height: 1.8; }
.cl-opt { font-size: 22rpx; color: #c9d1d9; display: block; line-height: 1.8; }
.cl-fix { font-size: 22rpx; color: #d29922; display: block; line-height: 1.8; }
.cl-del { font-size: 22rpx; color: #f85149; display: block; line-height: 1.8; }

/* ── Feedback ── */
.feedback-btn {
  display: flex; align-items: center; justify-content: center; gap: 10rpx;
  margin-bottom: 16rpx; padding: 24rpx;
  background: #161b22; border: 1rpx solid #30363d;
  border-radius: 12rpx;
}
.feedback-btn:active { background: #1c2128; }
.feedback-icon { font-size: 28rpx; }
.feedback-text { font-size: 26rpx; color: #58a6ff; font-weight: 600; }

/* ── Footer ── */
.about-foot { text-align: center; padding: 24rpx 0; }
.foot-text { font-size: 20rpx; color: #484f58; display: block; margin-bottom: 4rpx; }

/* ── Modal ── */
.modal-mask { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.6); z-index: 10000; display: flex; align-items: center; justify-content: center; }
.modal-box { width: 82%; background: #161b22; border: 1rpx solid #30363d; border-radius: 12rpx; padding: 32rpx; }
.modal-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 24rpx; }
.modal-title { font-size: 30rpx; font-weight: 700; color: #e6edf3; }
.modal-close { font-size: 36rpx; color: #8b949e; padding: 8rpx; }
.modal-close:active { color: #f85149; }
.modal-input { width: 100%; min-height: 72rpx; background: #0d1117; border: 1rpx solid #30363d; border-radius: 8rpx; padding: 16rpx; font-size: 26rpx; color: #e6edf3; box-sizing: border-box; margin-bottom: 16rpx; }
.modal-textarea { width: 100%; height: 300rpx; background: #0d1117; border: 1rpx solid #30363d; border-radius: 8rpx; padding: 16rpx; font-size: 26rpx; color: #e6edf3; box-sizing: border-box; margin-bottom: 16rpx; }
.modal-footer { display: flex; gap: 16rpx; margin-top: 8rpx; }
.modal-cancel { flex: 1; background: #21262d !important; color: #c9d1d9 !important; border-radius: 8rpx !important; height: 72rpx !important; font-size: 26rpx !important; border: 1rpx solid #30363d !important; display: flex !important; align-items: center !important; justify-content: center !important; }
.modal-save { flex: 1; background: #238636 !important; color: #fff !important; border-radius: 8rpx !important; height: 72rpx !important; font-size: 26rpx !important; font-weight: 600 !important; border: 1rpx solid rgba(240,246,252,0.1) !important; display: flex !important; align-items: center !important; justify-content: center !important; }
.modal-save:active { background: #2ea043 !important; }
.modal-save[disabled] { opacity: 0.5; background: #21262d !important; }
.changelog-modal { max-height: 85vh; }
.changelog-modal .modal-body { max-height: 60vh; overflow-y: auto; }
.changelog-form { display: flex; flex-direction: column; gap: 16rpx; }
.form-row { display: flex; gap: 16rpx; }
.form-field { flex: 1; }
.form-field.full { width: 100%; }
.field-label { font-size: 22rpx; color: #8b949e; font-weight: 600; margin-bottom: 8rpx; display: block; }
.field-hint { font-size: 18rpx; color: #484f58; margin-bottom: 8rpx; display: block; }
.field-input { width: 100%; height: 64rpx; background: #0d1117; border: 1rpx solid #30363d; border-radius: 8rpx; padding: 0 12rpx; font-size: 24rpx; color: #e6edf3; box-sizing: border-box; }
.field-picker { width: 100%; height: 64rpx; background: #0d1117; border: 1rpx solid #30363d; border-radius: 8rpx; padding: 0 12rpx; font-size: 24rpx; color: #e6edf3; display: flex; align-items: center; justify-content: space-between; box-sizing: border-box; }
.picker-arrow { font-size: 18rpx; color: #484f58; }
.field-textarea { width: 100%; height: 240rpx; background: #0d1117; border: 1rpx solid #30363d; border-radius: 8rpx; padding: 12rpx; font-size: 24rpx; color: #e6edf3; box-sizing: border-box; line-height: 1.6; }
