<view class="page">
  <view class="container">
    <!-- Profile Header -->
    <view class="profile-header">
      <view class="profile-avatar">
        <image lazy-load class="avatar-img" src="{{aboutData.devAvatar || '/images/avatar.jpg'}}" mode="aspectFill"></image>
      </view>
      <text class="profile-name" bindtap="{{isAdmin ? 'onEdit' : ''}}" data-field="devName" data-value="{{aboutData.devName}}">{{aboutData.devName}}</text>
      <text class="profile-role">{{_l.aboutDevLabel}}</text>
      <view class="profile-meta">
        <view class="meta-badge">
          <text class="meta-badge-dot online"></text>
          <text class="meta-badge-text">{{aboutData.version || _l.profileLoading}}</text>
        </view>
        <view class="meta-badge" wx:if="{{updateReady || hasUpdate}}" catchtap="manualCheckUpdate">
          <text class="meta-badge-text">{{updateReady ? _l.updateReady : _l.updateAvailable}}</text>
        </view>
      </view>
      <text class="version-note" wx:if="{{aboutData.versionNote}}">{{aboutData.versionNote}}</text>
      
      <view class="profile-tags">
        <view class="tag">离线可用</view>
        <view class="tag">数据安全</view>
        <view class="tag">免费使用</view>
      </view>
    </view>

    <!-- Admin Panel -->
    <view class="section" wx:if="{{isAdmin}}">
      <view class="section-title">{{_l.adminPanelTitle}}</view>
      <view class="section-body">
        <view class="admin-tip">
          <text class="admin-tip-icon">💡</text>
          <text class="admin-tip-text">{{_l.adminModeHint}}</text>
        </view>
      </view>
    </view>

    <!-- UID -->
    <view class="section">
      <view class="section-title">{{_l.myUID}}</view>
      <view class="section-body">
        <view class="uid-row" bindtap="onEdit" data-field="uid" data-value="{{aboutData.uid || '476200'}}">
          <view class="uid-info">
            <text class="uid-label">{{_l.aboutDevUID}}</text>
            <text class="uid-val">{{aboutData.uid || '476200'}}</text>
          </view>
          <view class="copy-btn" catchtap="copyUID">{{_l.copy}}</view>
        </view>
      </view>
    </view>

    <!-- Gifts -->
    <view class="section">
      <view class="section-title">{{_l.freeGifts}}</view>
      <view class="section-body">
        <view wx:for="{{aboutData.gifts}}" wx:key="index" class="list-item">
          <text class="list-item-icon">🎁</text>
          <text class="list-item-text">{{item}}</text>
          <view class="list-item-del" catchtap="deleteGift" data-idx="{{index}}" wx:if="{{isAdmin}}">✕</view>
        </view>
        <view class="list-add" catchtap="addGift" wx:if="{{isAdmin}}">
          <text class="list-add-icon">+</text>
          <text class="list-add-text">添加福利</text>
        </view>
      </view>
    </view>

    <!-- Platforms -->
    <view class="section">
      <view class="section-title">音乐/应用平台</view>
      <view class="section-body">
        <view wx:for="{{aboutData.platforms}}" wx:key="index" class="list-item" bindtap="copyPlatformUrl" data-item="{{item}}">
          <text class="list-item-icon">🎵</text>
          <view class="list-item-info">
            <text class="list-item-name">{{item.name}}</text>
            <text class="list-item-url">{{item.url}}</text>
          </view>
          <view class="copy-btn-sm">复制</view>
          <view class="list-item-del" catchtap="deletePlatform" data-idx="{{index}}" wx:if="{{isAdmin}}">✕</view>
        </view>
        <view class="list-add" catchtap="addPlatform" wx:if="{{isAdmin}}">
          <text class="list-add-icon">+</text>
          <text class="list-add-text">添加平台外链</text>
        </view>
      </view>
    </view>

    <!-- Contact -->
    <view class="section">
      <view class="section-title">{{_l.contact}}</view>
      <view class="section-body">
        <view class="list-item" bindtap="copyEmail">
          <text class="list-item-icon">📧</text>
          <view class="list-item-info" catchtap="onEdit" data-field="contact" data-value="{{aboutData.contact || 'flyzccboard@yeah.net'}}">
            <text class="list-item-name">{{_l.email}}</text>
            <text class="list-item-url">{{aboutData.contact || 'flyzccboard@yeah.net'}}</text>
          </view>
          <view class="copy-btn-sm">复制</view>
        </view>
      </view>
    </view>

    <!-- Data Sources -->
    <view class="section">
      <view class="section-title">{{_l.dataSource}}</view>
      <view class="section-body">
        <view class="list-item"><text class="list-item-icon">📖</text><text class="list-item-text">精灵图鉴：洛克王国手游WIKI（CC BY-NC-SA 4.0）</text></view>
        <view class="list-item"><text class="list-item-icon">🎒</text><text class="list-item-text">道具图鉴：洛克王国手游WIKI（CC BY-NC-SA 4.0）</text></view>
        <view class="list-item"><text class="list-item-icon">🥚</text><text class="list-item-text">蛋组数据：洛克王国WIKI（CC BY-NC-SA 4.0）</text></view>
        <view class="list-item"><text class="list-item-icon">📅</text><text class="list-item-text">活动动态：洛克王国世界微信公众号</text></view>
        <view class="list-item"><text class="list-item-icon">🎯</text><text class="list-item-text">捕捉规则：洛克王国世界官方客服</text></view>
        <view class="list-item"><text class="list-item-icon">🎨</text><text class="list-item-text">页面图片：设计师手绘与开放社区授权视觉素材</text></view>
        <view class="list-item"><text class="list-item-icon">🔗</text><text class="list-item-text">数据来源：https://wiki.biligame.com/rocom</text></view>
        <view class="list-item"><text class="list-item-icon">📋</text><text class="list-item-text">授权协议：CC BY-NC-SA 4.0</text></view>
      </view>
    </view>

    <!-- Levels -->
    <view class="section">
      <view class="section-title">等级系统</view>
      <view class="section-body">
        <view class="list-item"><text class="list-item-icon">🐣</text><view class="list-item-info"><text class="list-item-name">Lv.1 小洛克</text><text class="list-item-url">初始等级</text></view></view>
        <view class="list-item"><text class="list-item-icon">🎓</text><view class="list-item-info"><text class="list-item-name">Lv.2 见习魔法生</text><text class="list-item-url">累计登录3天</text></view></view>
        <view class="list-item"><text class="list-item-icon">✨</text><view class="list-item-info"><text class="list-item-name">Lv.4 高级魔法生</text><text class="list-item-url">累计登录15天</text></view></view>
        <view class="list-item"><text class="list-item-icon">📖</text><view class="list-item-info"><text class="list-item-name">Lv.6 精灵研究员</text><text class="list-item-url">累计登录60天</text></view></view>
        <view class="list-item"><text class="list-item-icon">🔮</text><view class="list-item-info"><text class="list-item-name">Lv.8 魔法大师</text><text class="list-item-url">累计登录120天</text></view></view>
        <view class="list-item"><text class="list-item-icon">🏰</text><view class="list-item-info"><text class="list-item-name">Lv.10 王国守护者</text><text class="list-item-url">累计登录365天</text></view></view>
        <view class="list-item"><text class="list-item-icon">👑</text><view class="list-item-info"><text class="list-item-name">Lv.15 至尊洛克</text><text class="list-item-url">累计登录365天+UID+250次捕捉</text></view></view>
        <view class="tip-box">
          <text class="tip-icon">💡</text>
          <text class="tip-text">额外加成：设置洛克王国UID +1级，每50次捕捉 +1级（最高20级）</text>
        </view>
      </view>
    </view>

    <!-- Credits -->
    <view class="section">
      <view class="section-title">{{_l.specialThanks}}</view>
      <view class="section-body">
        <view class="list-item"><text class="list-item-icon">🏆</text><text class="list-item-text">洛克王国手游WIKI团队</text></view>
        <view class="list-item"><text class="list-item-icon">💎</text><text class="list-item-text">洛克王国世界官方客服</text></view>
        <view class="list-item"><text class="list-item-icon">🌟</text><text class="list-item-text">洛克王国世界微信公众号</text></view>
        <view class="list-item"><text class="list-item-icon">🎮</text><text class="list-item-text">腾讯魔方工作室群</text></view>
        <view class="list-item"><text class="list-item-icon">❤️</text><text class="list-item-text">所有支持本小程序的玩家</text></view>
        <view class="list-item"><text class="list-item-icon">🤖</text><text class="list-item-text">先进开发工具与开源技术社区参考参与修补维护</text></view>
        <view class="list-item"><text class="list-item-icon">☁️</text><text class="list-item-text">第三方合规图床提供静态资源云托管服务</text></view>
      </view>
    </view>

    <!-- Privacy -->
    <view class="section">
      <view class="section-title">{{_l.privacy}}</view>
      <view class="section-body">
        <view class="list-item"><text class="list-item-icon">💾</text><text class="list-item-text">本地存储：偏好设置、捕捉统计等数据仅保存在设备本地</text></view>
        <view class="list-item"><text class="list-item-icon">🔒</text><text class="list-item-text">无第三方SDK：不存在数据共享和行为追踪</text></view>
        <view class="list-item"><text class="list-item-icon">📤</text><text class="list-item-text">分享功能：仅用于转发页面内容</text></view>
        <view class="list-item"><text class="list-item-icon">🔐</text><text class="list-item-text">登录数据：登录授权保留365天，到期或主动注销时清除本地授权</text></view>
      </view>
    </view>

    <!-- Disclaimer -->
    <view class="section">
      <view class="section-title">{{_l.disclaimer}}</view>
      <view class="section-body">
        <text class="disclaimer">1. 本应用为非官方攻略工具，与腾讯魔方工作室群无关</text>
        <text class="disclaimer">2. 游戏数据仅供参考，以游戏内实际数据为准</text>
        <text class="disclaimer">3. 仅供学习交流使用，请勿用于商业用途</text>
      </view>
    </view>

    <!-- Changelog -->
    <view class="section">
      <view class="section-title-row">
        <text class="section-title">{{_l.changelog || '更新日志'}}</text>
        <view class="section-title-action" wx:if="{{isAdmin}}" catchtap="openChangelogModal">
          <text class="action-plus">+</text>
          <text class="action-text">{{_l.addBtnNew}}</text>
        </view>
      </view>
      <view class="section-body" wx:if="{{changelogList.length > 0}}">
        <view wx:for="{{changelogList}}" wx:key="index" class="changelog-item">
          <view class="changelog-header">
            <view class="changelog-tag">v{{item.version}}</view>
            <text class="changelog-date">{{item.date}}</text>
            <view class="changelog-actions" wx:if="{{isAdmin}}">
              <view class="action-btn-sm" catchtap="editChangelog" data-index="{{index}}">{{_l.edit}}</view>
              <view class="action-btn-sm danger" catchtap="deleteChangelog" data-index="{{index}}">{{_l.delete}}</view>
            </view>
          </view>
          <view class="changelog-body">
            <block wx:for="{{item.lines}}" wx:for-item="line" wx:key="text">
              <text class="cl-{{line.type}}">{{line.text}}</text>
            </block>
          </view>
        </view>
      </view>
      <view class="section-empty" wx:else>
        <text>{{_l.noAnnounce}}</text>
      </view>
    </view>

    <!-- Feedback -->
    <view class="feedback-btn" bindtap="onFeedback">
      <text class="feedback-icon">💬</text>
      <text class="feedback-text">{{_l.aboutTab}}</text>
    </view>

    <!-- Footer -->
    <view class="about-foot">
      <text class="foot-text">© 2026 洛手助手</text>
      <text class="foot-text" wx:if="{{aboutData.icp}}">{{aboutData.icp}}</text>
    </view>
  </view>

  <!-- Edit Modal -->
  <view class="modal-mask" wx:if="{{showModal}}" bindtap="closeModal">
    <view class="modal-box" catchtap="preventClose">
      <view class="modal-header">
        <text class="modal-title">{{editModalTitle}}</text>
        <text class="modal-close" bindtap="closeModal">✕</text>
      </view>
      <block wx:if="{{editMode === 'addPlatform'}}">
        <input class="modal-input" placeholder="平台名称（如：QQ音乐）" placeholder-style="color:#484f58" value="{{platformName}}" bindinput="onPlatformNameInput" maxlength="50" />
        <input class="modal-input" placeholder="平台外链 URL" placeholder-style="color:#484f58" value="{{platformUrl}}" bindinput="onPlatformUrlInput" maxlength="200" />
      </block>
      <textarea class="modal-textarea" wx:elif="{{editingField === 'changelogContent'}}" placeholder="每行一条更新日志" placeholder-style="color:#484f58" value="{{editValue}}" bindinput="onEditInput" maxlength="1000" />
      <input class="modal-input" wx:else placeholder="请输入内容" placeholder-style="color:#484f58" value="{{editValue}}" bindinput="onEditInput" maxlength="50" />
      <view class="modal-footer">
        <button class="modal-cancel" bindtap="closeModal">{{_l.cancel}}</button>
        <button class="modal-save" bindtap="saveEdit" disabled="{{submitting}}">{{submitting ? _l.submitting : _l.save}}</button>
      </view>
    </view>
  </view>

  <!-- Changelog Modal -->
  <view class="modal-mask" wx:if="{{showChangelogModal}}" bindtap="closeChangelogModal">
    <view class="modal-box changelog-modal" catchtap="preventClose">
      <view class="modal-header">
        <text class="modal-title">{{changelogEditIndex >= 0 ? '编辑日志' : '新增日志'}}</text>
        <text class="modal-close" bindtap="closeChangelogModal">✕</text>
      </view>
      <view class="modal-body">
        <view class="changelog-form">
          <view class="form-row">
            <view class="form-field">
              <text class="field-label">版本号</text>
              <input class="field-input" placeholder="如：1.0.3" placeholder-style="color:#484f58" value="{{changelogVersion}}" bindinput="onChangelogVersionInput" />
            </view>
            <view class="form-field">
              <text class="field-label">日期</text>
              <picker mode="date" value="{{changelogDate}}" bindchange="onChangelogDateChange">
                <view class="field-picker">
                  <text>{{changelogDate || '选择日期'}}</text>
                  <text class="picker-arrow">▾</text>
                </view>
              </picker>
            </view>
          </view>
          <view class="form-field full">
            <text class="field-label">更新内容</text>
            <text class="field-hint">每行一条，支持前缀：新增：/优化：/修复：/下线：</text>
            <textarea class="field-textarea" placeholder="新增：xxx功能&#10;优化：xxx体验" placeholder-style="color:#484f58" value="{{changelogContent}}" bindinput="onChangelogContentInput" maxlength="2000" />
          </view>
        </view>
      </view>
      <view class="modal-footer">
        <button class="modal-cancel" bindtap="closeChangelogModal">{{_l.cancel}}</button>
        <button class="modal-save" bindtap="saveChangelog" disabled="{{changelogSaving}}">{{changelogSaving ? _l.submitting : _l.save}}</button>
      </view>
    </view>
  </view>
  <dock current="about" />
</view>
