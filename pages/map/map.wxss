.page { min-height: 100vh; background: #0a1a2e; padding-bottom: calc(120rpx + env(safe-area-inset-bottom)); }
.container { padding: 16rpx; height: calc(100vh - 200rpx); display: flex; flex-direction: column; }

/* 工具栏 */
.map-toolbar { display: flex; gap: 12rpx; margin-bottom: 12rpx; }
.search-box { flex: 1; display: flex; align-items: center; background: rgba(255,255,255,0.08); border: 1rpx solid rgba(255,255,255,0.12); border-radius: 12rpx; padding: 0 16rpx; height: 72rpx; }
.search-icon { font-size: 24rpx; margin-right: 8rpx; }
.search-input { flex: 1; height: 72rpx; font-size: 26rpx; color: #fff; }
.search-input::placeholder { color: rgba(255,255,255,0.3); }
.search-clear { width: 36rpx; height: 36rpx; display: flex; align-items: center; justify-content: center; background: rgba(255,255,255,0.1); border-radius: 50%; font-size: 18rpx; color: rgba(255,255,255,0.5); }
.toolbar-btn { display: flex; align-items: center; justify-content: center; padding: 0 24rpx; height: 72rpx; background: rgba(0,200,255,0.12); border: 1rpx solid rgba(0,200,255,0.25); border-radius: 12rpx; font-size: 24rpx; color: #00d4ff; font-weight: 600; }

/* 筛选面板 */
.filter-panel { background: rgba(255,255,255,0.04); border: 1rpx solid rgba(255,255,255,0.08); border-radius: 16rpx; margin-bottom: 12rpx; overflow: hidden; }
.filter-header { display: flex; align-items: center; justify-content: space-between; padding: 16rpx 20rpx; border-bottom: 1rpx solid rgba(255,255,255,0.06); }
.filter-title { font-size: 26rpx; font-weight: 700; color: #fff; }
.filter-actions { display: flex; gap: 16rpx; }
.filter-action { font-size: 22rpx; color: #00d4ff; padding: 4rpx 12rpx; background: rgba(0,200,255,0.08); border-radius: 8rpx; }
.filter-scroll { max-height: 400rpx; }
.filter-group-header { display: flex; align-items: center; gap: 10rpx; padding: 14rpx 20rpx; border-bottom: 1rpx solid rgba(255,255,255,0.04); }
.filter-group-icon { font-size: 24rpx; }
.filter-group-name { flex: 1; font-size: 24rpx; font-weight: 600; color: rgba(255,255,255,0.85); }
.filter-group-count { font-size: 20rpx; color: rgba(255,255,255,0.35); }
.filter-group-arrow { font-size: 18rpx; color: rgba(255,255,255,0.3); }
.filter-group-items { display: flex; flex-wrap: wrap; gap: 8rpx; padding: 8rpx 20rpx 16rpx; }
.filter-item { display: flex; align-items: center; gap: 6rpx; padding: 6rpx 14rpx; background: rgba(255,255,255,0.04); border: 1rpx solid rgba(255,255,255,0.08); border-radius: 20rpx; }
.filter-item.active { background: rgba(0,200,255,0.12); border-color: rgba(0,200,255,0.3); }
.filter-item-dot { width: 12rpx; height: 12rpx; border-radius: 50%; }
.filter-item-name { font-size: 20rpx; color: rgba(255,255,255,0.7); }
.filter-item.active .filter-item-name { color: #00d4ff; }
.filter-item-count { font-size: 16rpx; color: rgba(255,255,255,0.3); }

/* 地图画布 */
.map-canvas-wrap { flex: 1; position: relative; border-radius: 16rpx; overflow: hidden; border: 1rpx solid rgba(255,255,255,0.08); background: #050e1a; }
.map-canvas { width: 100%; height: 100%; display: block; }
.map-loading { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); padding: 16rpx 32rpx; background: rgba(0,0,0,0.6); border-radius: 12rpx; z-index: 5; }
.map-loading-text { font-size: 24rpx; color: rgba(255,255,255,0.7); }

/* 标记弹窗 */
.marker-popup { position: absolute; bottom: 20rpx; left: 20rpx; right: 20rpx; z-index: 10; }
.marker-popup-content { display: flex; align-items: center; gap: 16rpx; padding: 20rpx 24rpx; background: rgba(10,26,46,0.95); border: 1rpx solid rgba(0,200,255,0.2); border-radius: 16rpx; backdrop-filter: blur(10px); }
.marker-popup-dot { width: 16rpx; height: 16rpx; border-radius: 50%; flex-shrink: 0; }
.marker-popup-info { flex: 1; }
.marker-popup-name { display: block; font-size: 28rpx; font-weight: 700; color: #fff; }
.marker-popup-type { display: block; font-size: 20rpx; color: rgba(255,255,255,0.5); margin-top: 4rpx; }
.marker-popup-region { display: block; font-size: 20rpx; color: rgba(0,200,255,0.6); margin-top: 2rpx; }
.marker-popup-close { width: 48rpx; height: 48rpx; display: flex; align-items: center; justify-content: center; font-size: 24rpx; color: rgba(255,255,255,0.4); }

/* 坐标指示 */
.map-coords { position: absolute; bottom: 8rpx; right: 16rpx; font-size: 18rpx; color: rgba(255,255,255,0.25); font-family: monospace; }

/* 维护 */
.maintain-card { display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 120rpx 40rpx; }
.maintain-icon { font-size: 80rpx; margin-bottom: 24rpx; }
.maintain-title { font-size: 36rpx; font-weight: 700; color: #fff; margin-bottom: 12rpx; }
.maintain-desc { font-size: 26rpx; color: rgba(255,255,255,0.5); }
