.page {
  height: 100vh;
  background: #0d0f1d;
  overflow: hidden;
}

.map-wrapper {
  position: relative;
  width: 100%;
  height: 100vh;
  overflow: hidden;
}

.map-view {
  width: 100%;
  height: 100%;
}

/* Floating Search Bar Container */
.search-bar-container {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  z-index: 20;
  padding: 32rpx 24rpx 16rpx;
  background: linear-gradient(180deg, rgba(13, 15, 29, 0.85) 0%, rgba(13, 15, 29, 0) 100%);
  pointer-events: none;
}

.search-box {
  pointer-events: auto;
  display: flex;
  align-items: center;
  height: 96rpx;
  background: rgba(22, 26, 48, 0.85);
  backdrop-filter: blur(24rpx);
  -webkit-backdrop-filter: blur(24rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  border-radius: 48rpx;
  padding: 0 32rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.25);
  transition: all 0.3s;
}

.search-icon {
  font-size: 32rpx;
  margin-right: 16rpx;
  color: rgba(255, 255, 255, 0.5);
}

.search-input {
  flex: 1;
  height: 100%;
  font-size: 28rpx;
  color: #ffffff;
}

.search-clear {
  padding: 10rpx;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.4);
}

.category-scroll {
  pointer-events: auto;
  white-space: nowrap;
}

.category-list {
  display: inline-flex;
  padding: 0 4rpx;
  gap: 12rpx;
}

.category-tag {
  display: inline-flex;
  align-items: center;
  padding: 12rpx 28rpx;
  background: rgba(22, 26, 48, 0.8);
  backdrop-filter: blur(16rpx);
  -webkit-backdrop-filter: blur(16rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 36rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
  white-space: nowrap;
  transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.15);
}

.category-tag.active {
  background: rgba(0, 255, 170, 0.15);
  border-color: rgba(0, 255, 170, 0.5);
  color: #00ffaa;
  font-weight: 600;
  box-shadow: 0 0 16rpx rgba(0, 255, 170, 0.2);
}

/* Floating Search Results Dropdown */
.search-results {
  position: absolute;
  top: 148rpx;
  left: 24rpx;
  right: 24rpx;
  z-index: 25;
  background: rgba(18, 20, 38, 0.95);
  backdrop-filter: blur(32rpx);
  -webkit-backdrop-filter: blur(32rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 24rpx;
  max-height: 520rpx;
  overflow-y: auto;
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.4);
  padding: 8rpx 0;
}

.search-result-item {
  display: flex;
  align-items: center;
  flex-direction: column; gap: 12rpx;
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.05);
  transition: background 0.2s;
}

.search-result-item:active {
  background: rgba(255, 255, 255, 0.05);
}

.result-details {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.result-name {
  font-size: 28rpx;
  color: #ffffff;
  font-weight: 500;
}

.result-region {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.4);
}

.result-tag {
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  border: 1rpx solid;
  font-weight: bold;
}

/* Navigation Banner Overlay */
.nav-banner {
  position: absolute;
  top: 32rpx;
  left: 24rpx;
  right: 24rpx;
  z-index: 20;
  display: flex;
  align-items: center;
  background: rgba(10, 32, 24, 0.85);
  backdrop-filter: blur(24rpx);
  -webkit-backdrop-filter: blur(24rpx);
  border: 1rpx solid rgba(0, 255, 170, 0.35);
  border-radius: 24rpx;
  padding: 24rpx 32rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.3), 0 0 20rpx rgba(0, 255, 170, 0.1);
  animation: slideDown 0.3s cubic-bezier(0.16, 1, 0.3, 1);
}

@keyframes slideDown {
  from { transform: translateY(-40rpx); opacity: 0; }
  to { transform: translateY(0); opacity: 1; }
}

.nav-banner-arrow {
  font-size: 48rpx;
  margin-right: 24rpx;
  color: #00ffaa;
  animation: pulseArrow 1.5s infinite;
}

@keyframes pulseArrow {
  0% { transform: scale(1); }
  50% { transform: scale(1.15); }
  100% { transform: scale(1); }
}

.nav-banner-info {
  flex: 1;
}

.nav-banner-title {
  font-size: 28rpx;
  color: #ffffff;
  font-weight: bold;
  margin-bottom: 4rpx;
}

.nav-banner-subtitle {
  font-size: 22rpx;
  color: rgba(0, 255, 170, 0.75);
  font-family: monospace;
}

.nav-banner-close {
  padding: 10rpx 16rpx;
  font-size: 28rpx;
  color: rgba(255, 74, 74, 0.7);
  font-weight: bold;
}

/* Redesigned Bottom Panel (Baidu/Gaode style) */
.detail-panel {
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  bottom: 24rpx;
  background: rgba(18, 20, 38, 0.9);
  backdrop-filter: blur(32rpx);
  -webkit-backdrop-filter: blur(32rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 36rpx;
  padding: 12rpx 0 24rpx;
  transform: translateY(110%);
  transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  z-index: 30;
  box-shadow: 0 -8rpx 48rpx rgba(0, 0, 0, 0.4);
}

.detail-panel.show {
  transform: translateY(0);
}

.panel-handle {
  display: flex;
  justify-content: center;
  padding: 12rpx 0 16rpx;
}

.handle-bar {
  width: 72rpx;
  height: 8rpx;
  background: rgba(255, 255, 255, 0.15);
  border-radius: 4rpx;
}

.panel-content {
  padding: 0 36rpx;
}

.panel-header {
  display: flex;
  flex-direction: column; gap: 12rpx;
  align-items: flex-start;
  margin-bottom: 12rpx;
}

.panel-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #ffffff;
  flex: 1;
  padding-right: 16rpx;
}

.panel-coords {
  font-size: 24rpx;
  color: #00ffaa;
  font-family: monospace;
  background: rgba(0, 255, 170, 0.08);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  border: 1rpx solid rgba(0, 255, 170, 0.15);
  white-space: nowrap;
}

.panel-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.panel-tag {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.6);
  background: rgba(255, 255, 255, 0.06);
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.06);
}

.panel-tag.region {
  background: rgba(0, 150, 255, 0.1);
  color: #4fc3f7;
  border-color: rgba(0, 150, 255, 0.15);
}

.panel-tag.distance {
  background: rgba(0, 255, 170, 0.1);
  color: #00ffaa;
  border-color: rgba(0, 255, 170, 0.15);
}

.panel-desc {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.5);
  display: block;
  line-height: 1.4;
  margin-bottom: 32rpx;
}

/* Premium Action Buttons */
.panel-actions {
  display: flex;
  gap: 16rpx;
}

.action-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 84rpx;
  border-radius: 42rpx;
  font-size: 26rpx;
  font-weight: 600;
  transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  padding: 0;
  margin: 0;
  border: none;
}

.action-btn::after {
  display: none;
}

.action-btn:active {
  transform: scale(0.96);
}

.btn-icon {
  font-size: 28rpx;
  margin-right: 8rpx;
}

.go-btn {
  background: linear-gradient(135deg, #00ffaa 0%, #00bfff 100%);
  color: #0d0f1d;
  box-shadow: 0 8rpx 24rpx rgba(0, 255, 170, 0.35);
}

.center-btn {
  background: rgba(255, 255, 255, 0.06);
  color: #ffffff;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
}

.center-btn:active {
  background: rgba(255, 255, 255, 0.12);
}

.copy-btn {
  background: rgba(255, 255, 255, 0.06);
  color: #ffffff;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
}

.copy-btn:active {
  background: rgba(255, 255, 255, 0.12);
}

/* Floating Sliding Dock Wrapper */
.dock-wrapper {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 9999;
  height: 0;
  overflow: visible;
  transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.3s;
}

.dock-wrapper.dock-hidden {
  transform: translateY(160rpx);
  opacity: 0;
  pointer-events: none;
}

/* ===== 平板（iPad）地图专属排版优化 ===== */
@media (min-width: 768px) {
  .search-bar-container { width: 400px !important; padding: 32px 24px 16px !important; background: transparent !important; pointer-events: none; }
  .search-results { width: 352px !important; left: 24px !important; right: auto !important; }
  .detail-panel { width: 352px !important; left: 24px !important; right: auto !important; bottom: 32px !important; border-radius: 24px !important; }
  .nav-banner { width: 352px !important; left: 24px !important; right: auto !important; top: 120px !important; }
  .search-box, .category-scroll { pointer-events: auto; }
  .panel-title { font-size: 22px !important; }
  .panel-desc { font-size: 14px !important; margin-bottom: 24px !important; }
  .action-btn { height: 44px !important; font-size: 14px !important; }
  .btn-icon { font-size: 16px !important; }
  .search-input { font-size: 15px !important; }
  .result-name { font-size: 16px !important; }
  .result-region { font-size: 12px !important; }
}

