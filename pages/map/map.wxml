<view class="page">
  <view class="container" wx:if="{{!maintenance}}">
    <!-- 顶部工具栏 -->
    <view class="map-toolbar">
      <view class="search-box">
        <text class="search-icon">🔍</text>
        <input class="search-input" placeholder="搜索地点/资源..." value="{{searchVal}}" bindinput="onSearch" />
        <view class="search-clear" wx:if="{{searchVal}}" catchtap="clearSearch">✕</view>
      </view>
      <view class="toolbar-btn" catchtap="togglePanel">
        <text>{{showPanel ? '收起' : '筛选'}}</text>
      </view>
    </view>

    <!-- 分类面板 -->
    <view class="filter-panel" wx:if="{{showPanel}}">
      <view class="filter-header">
        <text class="filter-title">地图标记 ({{filteredMarkers.length}})</text>
        <view class="filter-actions">
          <view class="filter-action" catchtap="selectAllCats">全选</view>
          <view class="filter-action" catchtap="clearAllCats">清空</view>
        </view>
      </view>
      <scroll-view scroll-y class="filter-scroll">
        <view class="filter-group" wx:for="{{catGroups}}" wx:key="name">
          <view class="filter-group-header" catchtap="toggleCatGroup" data-name="{{item.name}}">
            <text class="filter-group-icon">{{item.icon}}</text>
            <text class="filter-group-name">{{item.name}}</text>
            <text class="filter-group-count">{{item.count}}</text>
            <text class="filter-group-arrow">{{item.open ? '▾' : '▸'}}</text>
          </view>
          <view class="filter-group-items" wx:if="{{item.open}}">
            <view class="filter-item {{activeCats[c.id] ? 'active' : ''}}" wx:for="{{item.items}}" wx:for-item="c" wx:key="id" catchtap="toggleCat" data-id="{{c.id}}">
              <view class="filter-item-dot" style="background:{{c.color}};"></view>
              <text class="filter-item-name">{{c.name}}</text>
              <text class="filter-item-count">{{c.count}}</text>
            </view>
          </view>
        </view>
      </scroll-view>
    </view>

    <!-- 地图画布 -->
    <view class="map-canvas-wrap">
      <canvas type="2d" id="mapCanvas" class="map-canvas" bindtouchstart="onTouchStart" bindtouchmove="onTouchMove" bindtouchend="onTouchEnd"></canvas>
      <!-- 隐藏的瓦片预加载 -->
      <view style="position:absolute;width:0;height:0;overflow:hidden;opacity:0;">
        <image wx:for="{{tileUrls}}" wx:key="index" src="{{item}}" mode="aspectFill" lazy-load="{{false}}" bindload="onTileLoaded" binderror="onTileError" data-idx="{{index}}" />
        <image wx:for="{{iconUrls}}" wx:key="name" src="{{item.url}}" mode="aspectFit" lazy-load="{{false}}" bindload="onIconLoaded" binderror="onIconError" data-name="{{item.name}}" />
      </view>
      <view class="map-loading" wx:if="{{tileProgress < 100}}">
        <text class="map-loading-text">地图加载中 {{tileProgress}}%</text>
      </view>
      <!-- 标记详情弹窗 -->
      <view class="marker-popup" wx:if="{{selectedMarker}}" catchtap="closeMarkerPopup">
        <view class="marker-popup-content" catchtap="">
          <view class="marker-popup-dot" style="background:{{selectedMarker.color}};"></view>
          <view class="marker-popup-info">
            <text class="marker-popup-name">{{selectedMarker.name}}</text>
            <text class="marker-popup-type">{{selectedMarker.typeName}}</text>
            <text class="marker-popup-region" wx:if="{{selectedMarker.region}}">{{selectedMarker.region}}</text>
          </view>
          <view class="marker-popup-close" catchtap="closeMarkerPopup">✕</view>
        </view>
      </view>
      <!-- 坐标指示 -->
      <view class="map-coords">
        <text>X: {{cursorX}} Y: {{cursorY}}</text>
      </view>
    </view>
  </view>

  <!-- 维护模式 -->
  <view class="container" wx:if="{{maintenance}}">
    <view class="maintain-card">
      <text class="maintain-icon">🚧</text>
      <text class="maintain-title">页面维护中</text>
      <text class="maintain-desc">该功能正在开发或维护中，请稍后再来</text>
    </view>
  </view>

  <dock current="map" />
</view>
