<view class="page">
  <view class="container">
    
    <view class="subscribe-bar" wx:if="{{subscribeConfig.activity}}">
      <view class="sub-info">
        <text class="sub-title">{{_l.activityNotifyTitle}}</text>
        <text class="sub-desc">{{_l.activityNotifyDesc}}</text>
      </view>
      <view class="sub-btn {{subscribedActivity ? 'active' : ''}}" bindtap="subscribeActivity">
        {{subscribedActivity ? _l.activitySubscribed + '(' + subscribeCount + ')' : _l.activitySubscribeBtn}}
      </view>
    </view>
    <view class="tabs">
      <view class="tab {{status===item?'on':''}}" wx:for="{{statuses}}" wx:key="*this" bindtap="onStatus" data-s="{{item}}">{{item}}</view>
    </view>
    <view class="act-list">
      <view class="act-card headline" wx:for="{{filtered}}" wx:key="id" wx:if="{{item.status==='置顶'}}">
        <view class="act-header" bindtap="onExpand" data-id="{{item.id}}">
          
          <view class="act-badges">
            <image lazy-load wx:if="{{item.subType === 'collab' && item.collabLogo}}" src="{{item.collabLogo}}" mode="aspectFit" class="collab-logo" style="width:100rpx; height:40rpx; border-radius:4rpx; margin-right:10rpx;" />
            <view class="badge badge-top" wx:if="{{item.pinned}}">📌 置顶</view>
            <view class="badge badge-official" wx:if="{{item.subType === 'regular'}}">常规</view>
            <view class="badge badge-soon" wx:if="{{item.subType === 'season'}}">赛季</view>
            <view class="badge badge-official" wx:if="{{item.subType === 'collab'}}">联动</view>
          </view>

          <text class="act-title headline-title">{{item.title}}</text>
          <block wx:if="{{item.richContent && item.richContent.length > 0}}">
            <view class="act-rich-content">
              <block wx:for="{{item.richContent}}" wx:for-item="block" wx:key="index">
                <view wx:if="{{block.type === 'music'}}" class="rich-music-block {{currentPlayUrl === block.url && isPlaying ? 'playing' : ''}}" catchtap="playSong" data-url="{{block.url}}" data-name="{{block.name || '推荐单曲'}}" data-cover="{{block.cover || ''}}">
                  <image lazy-load wx:if="{{block.cover}}" class="music-cover" src="{{block.cover}}" mode="aspectFill" />
                  <text class="music-icon {{currentPlayUrl === block.url && isPlaying ? 'rotating' : ''}}">🎵</text>
                  <view class="music-info">
                    <text class="music-name">{{block.name || '推荐单曲'}}</text>
                    <text class="music-url">{{block.url}}</text>
                  </view>
                  <text class="music-play-btn">{{currentPlayUrl === block.url && isPlaying ? '⏸' : '▶'}}</text>
                </view>
                <view wx:elif="{{block.type === 'iframe'}}" class="rich-iframe-block">
                  <text class="iframe-icon">🌐</text>
                  <view class="iframe-info">
                    <text class="iframe-name">{{block.name || '外部网页'}}</text>
                    <text class="iframe-url">{{block.url}}</text>
                  </view>
                  <view class="iframe-actions">
                    <view class="iframe-btn open" catchtap="openIframe" data-url="{{block.url}}">打开</view>
                    <view class="iframe-btn copy" catchtap="copyIframe" data-url="{{block.url}}">复制</view>
                  </view>
                </view>
                <view wx:elif="{{block.type === 'quote'}}" class="rich-quote-block">
                  <text class="quote-text">{{block.content}}</text>
                </view>
                <view wx:elif="{{block.type === 'swiper'}}" class="rich-swiper-block">
                  <swiper class="rich-swiper" indicator-dots="true" autoplay="true" interval="3000" duration="500" circular="true">
                    <swiper-item wx:for="{{block.urls}}" wx:for-item="url" wx:key="index">
                      <image lazy-load src="{{url}}" mode="aspectFit" class="rich-swiper-image" catchtap="previewRichImage" data-src="{{url}}" />
                    </swiper-item>
                  </swiper>
                </view>
                <view wx:elif="{{block.type === 'video'}}" class="rich-video-block" catchtap="openVideo" data-url="{{block.url}}" data-name="{{block.name || '视频'}}">
                  <text class="video-icon">
                    <block wx:if="{{block.platform === 'bilibili'}}">📺</block>
                    <block wx:elif="{{block.platform === 'weibo'}}">🎬</block>
                    <block wx:elif="{{block.platform === 'douyin'}}">🎵</block>
                    <block wx:elif="{{block.platform === 'kuaishou'}}">📹</block>
                    <block wx:elif="{{block.platform === 'tencent'}}">📽️</block>
                    <block wx:elif="{{block.platform === 'xiaohongshu'}}">📕</block>
                    <block wx:elif="{{block.platform === 'youtube'}}">🔴</block>
                    <block wx:else>🎥</block>
                  </text>
                  <view class="video-info">
                    <text class="video-name">{{block.name || block.platformName + '视频'}}</text>
                    <text class="video-platform">{{block.platformName || '在线视频'}}</text>
                  </view>
                  <text class="video-play-btn">▶ {{_l.watch}}</text>
                </view>
                <view wx:elif="{{block.type === 'table'}}" class="rich-table-block">
                  <view class="rich-table">
                    <view class="rich-table-row rich-table-header">
                      <view class="rich-table-cell" wx:for="{{block.headers}}" wx:key="index">{{item}}</view>
                    </view>
                    <view class="rich-table-row" wx:for="{{block.rows}}" wx:for-item="row" wx:key="index">
                      <view class="rich-table-cell" wx:for="{{row}}" wx:for-item="cell" wx:key="index">{{cell}}</view>
                    </view>
                  </view>
                </view>
                <view wx:elif="{{block.type === 'image' && block.url !== item.image}}" class="rich-image-block" catchtap="previewRichImage" data-src="{{block.url}}">
                  <image lazy-load class="rich-image" src="{{block.url}}" mode="widthFix" />
                </view>
                <view wx:elif="{{block.type === 'divider'}}" class="divider-block">
                  <view class="divider-line {{block.style}}"></view>
                </view>
                <view wx:elif="{{block.type === 'link' && block.isVideo}}" class="rich-link-block video-link" catchtap="openVideo" data-url="{{block.url}}" data-name="{{block.text}}">
                  <text class="link-icon">📺</text>
                  <text class="link-text">{{block.text}}</text>
                  <text class="link-badge">{{_l.watch}}</text>
                </view>
                <view wx:elif="{{block.type === 'link'}}" class="rich-link-block" catchtap="openLink" data-url="{{block.url}}" data-text="{{block.text}}">
                  <text class="link-icon">🔗</text>
                  <text class="link-text">{{block.text}}</text>
                  <text class="link-badge">{{_l.copy}}</text>
                </view>
                <view wx:elif="{{block.type === 'attachment'}}" class="rich-link-block attachment-link" catchtap="downloadAttachment" data-url="{{block.url}}" data-name="{{block.name}}" data-size="{{block.sizeText}}">
                  <text class="link-icon">📎</text>
                  <text class="link-text">{{block.name}} ({{block.sizeText}})</text>
                  <text class="link-badge">{{_l.download}}</text>
                </view>
                <view wx:else class="rich-text-block" style="font-size:{{block.size}}rpx;color:{{block.color}};font-weight:{{block.weight || 'normal'}};font-style:{{block.style || 'normal'}};{{block.fontFamily && block.fontFamily !== 'sans-serif' ? 'font-family:' + block.fontFamily + ';' : ''}}">
                  <rich-text nodes="{{block.html || block.content}}" />
                </view>
              </block>
            </view>
          </block>
          <view class="act-summary" wx:else><rich-text nodes="{{item.desc}}" /></view>
        </view>
        <view class="act-source" wx:if="{{item.source}}">{{_l.sourceLabel}}{{item.source}}</view>
        <view class="act-footer" wx:if="{{item.rewards.length > 0 || item.start}}">
          <view class="act-rewards" wx:if="{{item.rewards.length > 0}}">
            <text class="act-reward" wx:for="{{item.rewards}}" wx:for-item="r" wx:key="*this">{{r}}</text>
          </view>
          <text class="act-date" wx:if="{{item.start}}">{{item.start}} {{item.startTime || ''}}~{{item.end}} {{item.endTime || ''}}</text>
        </view>
        
          
      </view>
    </view>
    <view class="section-title" wx:if="{{status==='全部'}}">
      <text class="section-line"></text>
      <text class="section-text">{{_l.otherActivities}}</text>
      <text class="section-line"></text>
    </view>
    <view class="act-list">
      <view class="act-card" wx:for="{{filtered}}" wx:key="id" wx:if="{{item.status!=='置顶'}}">
        
        <view class="act-badges">
          <image lazy-load wx:if="{{item.subType === 'collab' && item.collabLogo}}" src="{{item.collabLogo}}" mode="aspectFit" class="collab-logo" style="width:100rpx; height:40rpx; border-radius:4rpx; margin-right:10rpx;" />
          <view class="badge badge-go" wx:if="{{item.subType === 'regular'}}">常规</view>
          <view class="badge badge-soon" wx:if="{{item.subType === 'season'}}">赛季</view>
          <view class="badge badge-top" wx:if="{{item.subType === 'collab'}}">联动</view>

        </view>
        <text class="act-title">{{item.title}}</text>
        <image lazy-load class="act-image" wx:if="{{item.image}}" src="{{item.image}}" mode="widthFix" />
        <block wx:if="{{item.richContent && item.richContent.length > 0}}">
          <view class="act-rich-content">
            <block wx:for="{{item.richContent}}" wx:for-item="block" wx:key="index">
              <view wx:if="{{block.type === 'music'}}" class="rich-music-block {{item.subType === 'collab' ? 'collab-theme' : ''}} {{currentPlayUrl === block.url && isPlaying ? 'playing' : ''}}" catchtap="playSong" data-url="{{block.url}}" data-name="{{block.name || '推荐单曲'}}" data-cover="{{block.cover || ''}}">
                <image lazy-load wx:if="{{block.cover}}" class="music-cover" src="{{block.cover}}" mode="aspectFill" />
                <view class="music-icon {{currentPlayUrl === block.url && isPlaying ? 'rotating' : ''}} {{item.subType === 'collab' && (block.cover || item.image) ? 'collab-icon-box' : ''}}">
                  <image lazy-load wx:if="{{item.subType === 'collab' && (block.cover || item.image)}}" src="{{block.cover || item.image}}" class="collab-logo-image circle" mode="aspectFill" />
                  <block wx:else>🎵</block>
                </view>
                <view class="music-info">
                  <text class="music-name">{{block.name || '推荐单曲'}}</text>
                  <text class="music-url">{{block.url}}</text>
                </view>
                <text class="music-play-btn">{{currentPlayUrl === block.url && isPlaying ? '暂停' : '点我听歌'}}</text>
              </view>
              <view wx:elif="{{block.type === 'iframe'}}" class="rich-iframe-block">
                <text class="iframe-icon">🌐</text>
                <view class="iframe-info">
                  <text class="iframe-name">{{block.name || '外部网页'}}</text>
                  <text class="iframe-url">{{block.url}}</text>
                </view>
                <view class="iframe-actions">
                  <view class="iframe-btn open" catchtap="openIframe" data-url="{{block.url}}">打开</view>
                  <view class="iframe-btn copy" catchtap="copyIframe" data-url="{{block.url}}">复制</view>
                </view>
              </view>
              <view wx:elif="{{block.type === 'quote'}}" class="rich-quote-block">
                <text class="quote-text">{{block.content}}</text>
              </view>
              <view wx:elif="{{block.type === 'swiper'}}" class="rich-swiper-block">
                <swiper class="rich-swiper" indicator-dots="true" autoplay="true" interval="3000" duration="500" circular="true">
                  <swiper-item wx:for="{{block.urls}}" wx:for-item="url" wx:key="index">
                    <image lazy-load src="{{url}}" mode="aspectFit" class="rich-swiper-image" catchtap="previewRichImage" data-src="{{url}}" />
                  </swiper-item>
                </swiper>
              </view>
              <view wx:elif="{{block.type === 'video' && block.isDirectMp4}}" class="rich-video-inline {{item.subType === 'collab' ? 'collab-theme' : ''}}">
                <video src="{{block.url}}" controls show-center-play-btn object-fit="contain" style="width:100%; border-radius:16rpx; margin-top:16rpx; box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.3);" />
              </view>
              <view wx:elif="{{block.type === 'video'}}" class="rich-video-block {{item.subType === 'collab' ? 'collab-theme' : ''}}" catchtap="openVideo" data-url="{{block.url}}" data-name="{{block.name || '视频'}}">
                <image lazy-load wx:if="{{block.cover && item.subType !== 'collab'}}" src="{{block.cover}}" mode="aspectFill" style="width: 100rpx; height: 72rpx; border-radius: 12rpx; margin-right: 24rpx; flex-shrink: 0; background: rgba(255,255,255,0.05);" />
                <view wx:else class="video-icon {{item.subType === 'collab' && (block.cover || item.image) ? 'collab-icon-box' : ''}}">
                  <image lazy-load wx:if="{{item.subType === 'collab' && (block.cover || item.image)}}" src="{{block.cover || item.image}}" class="collab-logo-image rounded" mode="aspectFill" />
                  <block wx:else>
                    <block wx:if="{{block.platform === 'bilibili'}}">📺</block>
                    <block wx:elif="{{block.platform === 'weibo'}}">🎬</block>
                    <block wx:elif="{{block.platform === 'douyin'}}">🎵</block>
                    <block wx:elif="{{block.platform === 'kuaishou'}}">📹</block>
                    <block wx:elif="{{block.platform === 'tencent'}}">📽️</block>
                    <block wx:elif="{{block.platform === 'xiaohongshu'}}">📕</block>
                    <block wx:elif="{{block.platform === 'youtube'}}">🔴</block>
                    <block wx:else>🎥</block>
                  </block>
                </view>
                <view class="video-info">
                  <text class="video-name">{{block.name || block.platformName + '视频'}}</text>
                  <text class="video-platform">{{block.platformName || '在线视频'}}</text>
                </view>
                <text class="video-play-btn">▶ 观看</text>
              </view>
              <view wx:elif="{{block.type === 'table'}}" class="rich-table-block">
                <view class="rich-table">
                  <view class="rich-table-row rich-table-header">
                    <view class="rich-table-cell" wx:for="{{block.headers}}" wx:key="index">{{item}}</view>
                  </view>
                  <view class="rich-table-row" wx:for="{{block.rows}}" wx:for-item="row" wx:key="index">
                    <view class="rich-table-cell" wx:for="{{row}}" wx:for-item="cell" wx:key="index">{{cell}}</view>
                  </view>
                </view>
              </view>
              <view wx:elif="{{block.type === 'image' && block.url !== item.image}}" class="rich-image-block" catchtap="previewRichImage" data-src="{{block.url}}">
                <image lazy-load class="rich-image" src="{{block.url}}" mode="widthFix" />
              </view>
              <view wx:elif="{{block.type === 'divider'}}" class="divider-block">
                <view class="divider-line {{block.style}}"></view>
              </view>
              <view wx:elif="{{block.type === 'link' && block.isVideo}}" class="rich-link-block video-link" catchtap="openVideo" data-url="{{block.url}}" data-name="{{block.text}}">
                <text class="link-icon">📺</text>
                <text class="link-text">{{block.text}}</text>
                <text class="link-badge">点击观看</text>
              </view>
              <view wx:elif="{{block.type === 'link'}}" class="rich-link-block" catchtap="openLink" data-url="{{block.url}}" data-text="{{block.text}}">
                <text class="link-icon">🔗</text>
                <text class="link-text">{{block.text}}</text>
                <text class="link-badge">点击复制</text>
              </view>
              <view wx:elif="{{block.type === 'attachment'}}" class="rich-link-block attachment-link" catchtap="downloadAttachment" data-url="{{block.url}}" data-name="{{block.name}}" data-size="{{block.sizeText}}">
                <text class="link-icon">📎</text>
                <text class="link-text">{{block.name}} ({{block.sizeText}})</text>
                <text class="link-badge">下载预览</text>
              </view>
              <view wx:else class="rich-text-block" style="font-size:{{block.size}}rpx;color:{{block.color}};font-weight:{{block.weight || 'normal'}};font-style:{{block.style || 'normal'}};{{block.fontFamily && block.fontFamily !== 'sans-serif' ? 'font-family:' + block.fontFamily + ';' : ''}}">
                <rich-text nodes="{{block.html || block.content}}" />
              </view>
            </block>
          </view>
        </block>
        <view class="act-desc" wx:else><rich-text nodes="{{item.desc}}" /></view>
        <view class="act-source" wx:if="{{item.source}}">{{_l.sourceLabel}}{{item.source}}</view>
        <view class="act-footer" wx:if="{{item.rewards.length > 0 || item.start}}">
          <view class="act-rewards" wx:if="{{item.rewards.length > 0}}">
            <text class="act-reward" wx:for="{{item.rewards}}" wx:for-item="r" wx:key="*this">{{r}}</text>
          </view>
          <text class="act-date" wx:if="{{item.start}}">{{item.start}} {{item.startTime || ''}}~{{item.end}} {{item.endTime || ''}}</text>
        </view>
        
          
      </view>
    </view>
    <view class="empty" wx:if="{{filtered.length===0}}">{{_l.noActivity}}</view>
  </view>

  <!-- 视频播放器 -->
  <view class="modal-mask" wx:if="{{showVideoPlayer}}" catchtap="closeVideoPlayer" style="z-index:10000;">
    <view class="modal-box video-player-box" catchtap="preventClose">
      <view class="video-player-header">
        <text class="video-player-title">{{videoPlayerName}}</text>
        <text class="modal-close" catchtap="closeVideoPlayer">×</text>
      </view>
      <view class="video-player-owner" wx:if="{{videoPlayerOwner}}">
        <view class="video-player-owner-bar"></view>
        <text class="video-player-owner-text">{{_l.upOwner}}{{videoPlayerOwner}}</text>
      </view>
      <video
        class="video-player-video"
        src="{{videoPlayerUrl}}"
        autoplay="true"
        controls="true"
        show-center-play-btn="true"
        show-mute-btn="true"
        object-fit="contain"
        binderror="onVideoError"
      />
      <scroll-view scroll-y class="video-player-desc" wx:if="{{videoPlayerDesc}}">
        <text class="video-player-desc-text" user-select="true">{{videoPlayerDesc}}</text>
      </scroll-view>
    </view>
  </view>

  <dock current="activity" />
</view>
