/* pages/swarm/swarm.wxss */

.page {
  min-height: 100vh;
  background-color: #010314;
  background-image: 
    radial-gradient(ellipse 60% 40% at 80% 20%, rgba(153, 69, 255, 0.08) 0%, transparent 60%),
    radial-gradient(ellipse 50% 30% at 20% 70%, rgba(0, 212, 255, 0.05) 0%, transparent 50%),
    linear-gradient(185deg, #020410 0%, #040c24 100%);
  animation: pageExpand 0.5s cubic-bezier(0.22, 0.61, 0.36, 1);
  padding-bottom: calc(60rpx + env(safe-area-inset-bottom));
}

@keyframes pageExpand {
  from { opacity: 0; transform: scale(0.97); }
  to { opacity: 1; transform: scale(1); }
}

.container {
  padding: 30rpx 24rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

/* ===== 头部 Banner ===== */
.swarm-banner {
  position: relative;
  border-radius: 28rpx;
  overflow: hidden;
  padding: 44rpx 32rpx;
  background: linear-gradient(135deg, rgba(22, 20, 48, 0.8) 0%, rgba(10, 15, 36, 0.8) 100%);
  border: 1rpx solid rgba(153, 69, 255, 0.25);
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.35), inset 0 1rpx 0 rgba(255, 255, 255, 0.06);
}

.banner-glow {
  position: absolute;
  top: -50%; right: -20%;
  width: 300rpx; height: 300rpx;
  background: radial-gradient(circle, rgba(153, 69, 255, 0.25) 0%, transparent 70%);
  border-radius: 50%;
  filter: blur(10rpx);
  pointer-events: none;
}

.banner-content {
  position: relative;
  z-index: 2;
}

.banner-title {
  font-size: 34rpx;
  font-weight: 900;
  color: #fff;
  letter-spacing: 2rpx;
  display: block;
  text-shadow: 0 0 12rpx rgba(153, 69, 255, 0.6);
  background: linear-gradient(90deg, #ffffff 0%, #d8b4fe 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

.banner-subtitle {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.45);
  display: block;
  margin-top: 8rpx;
  letter-spacing: 1rpx;
}

/* ===== 订阅推送卡片 ===== */
.card {
  background: rgba(255, 255, 255, 0.03);
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  border-radius: 24rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.15);
}

.subscribe-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  background: linear-gradient(90deg, rgba(153, 69, 255, 0.05) 0%, rgba(255, 255, 255, 0.01) 100%);
  border: 1rpx solid rgba(153, 69, 255, 0.15);
}

.sub-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.sub-icon-wrap {
  width: 64rpx;
  height: 64rpx;
  background: rgba(153, 69, 255, 0.15);
  border: 1rpx solid rgba(153, 69, 255, 0.3);
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.sub-icon {
  font-size: 28rpx;
  text-shadow: 0 0 8rpx rgba(153, 69, 255, 0.4);
}

.sub-info {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.sub-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #fff;
}

.sub-desc {
  font-size: 18rpx;
  color: rgba(255, 255, 255, 0.4);
}

.action-btn {
  padding: 12rpx 24rpx;
  border-radius: 14rpx;
  font-size: 20rpx;
  font-weight: 700;
  white-space: nowrap;
  transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  border: 1rpx solid;
}

.action-btn:active {
  transform: scale(0.95);
}

.sub-btn {
  background: rgba(255, 255, 255, 0.04);
  border-color: rgba(255, 255, 255, 0.1);
  color: rgba(255, 255, 255, 0.6);
}

.sub-btn.on {
  background: rgba(153, 69, 255, 0.15);
  border-color: rgba(153, 69, 255, 0.35);
  color: #c084fc;
  box-shadow: 0 0 16rpx rgba(153, 69, 255, 0.2);
}

/* ===== 管理员控制台 ===== */
.admin-panel-swarm {
  background: linear-gradient(135deg, rgba(20, 24, 48, 0.95) 0%, rgba(10, 15, 32, 0.95) 100%);
  border: 1rpx solid rgba(255, 171, 64, 0.25);
  border-radius: 24rpx;
  padding: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(0,0,0,0.3);
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.admin-header {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.admin-icon {
  font-size: 24rpx;
}

.admin-title {
  font-size: 24rpx;
  font-weight: 800;
  color: rgba(255, 171, 64, 0.95);
  letter-spacing: 1rpx;
}

.admin-actions {
  display: flex;
  gap: 12rpx;
}

.admin-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 14rpx 0;
  border-radius: 14rpx;
  font-size: 22rpx;
  font-weight: 700;
  border: 1rpx solid;
  line-height: 1;
  background: transparent;
  transition: all 0.2s;
}

.admin-btn::after {
  display: none;
}

.admin-btn:active {
  transform: scale(0.96);
}

.admin-btn.add {
  background: rgba(0, 212, 255, 0.1);
  border-color: rgba(0, 212, 255, 0.25);
  color: #00d4ff;
}

.admin-btn.reset {
  background: rgba(255, 255, 255, 0.03);
  border-color: rgba(255, 255, 255, 0.1);
  color: rgba(255, 255, 255, 0.6);
}

/* ===== 出没精灵列表 ===== */
.swarm-section {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.section-title-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 4rpx;
}

.section-title {
  font-size: 26rpx;
  font-weight: 800;
  color: #00d4ff;
  letter-spacing: 1rpx;
  text-shadow: 0 0 10rpx rgba(0, 212, 255, 0.25);
}

.section-count {
  font-size: 18rpx;
  color: rgba(255, 255, 255, 0.35);
  font-weight: 600;
}

.swarm-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

/* 精灵卡片 (Liquid Glass 玻璃态) */
.swarm-item-card {
  position: relative;
  background: linear-gradient(135deg, rgba(255,255,255,0.04) 0%, rgba(255,255,255,0.01) 100%);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 24rpx;
  padding: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.15), inset 0 1rpx 0 rgba(255,255,255,0.05);
  overflow: hidden;
  transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
}

.swarm-item-card:active {
  transform: translateY(-2rpx);
  box-shadow: 0 12rpx 30rpx rgba(153, 69, 255, 0.05);
}

/* 状态样式 */
.swarm-item-card.active {
  border-color: rgba(52, 199, 89, 0.25);
  background: linear-gradient(135deg, rgba(52, 199, 89, 0.04) 0%, rgba(255, 255, 255, 0.01) 100%);
}

.swarm-item-card.upcoming {
  border-color: rgba(255, 171, 64, 0.25);
  background: linear-gradient(135deg, rgba(255, 171, 64, 0.04) 0%, rgba(255, 255, 255, 0.01) 100%);
}

.swarm-item-card.ending {
  border-color: rgba(255, 69, 58, 0.25);
  background: linear-gradient(135deg, rgba(255, 69, 58, 0.04) 0%, rgba(255, 255, 255, 0.01) 100%);
}

.swarm-item-card.ended {
  opacity: 0.65;
  border-color: rgba(255, 255, 255, 0.04);
}

.item-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.status-badge {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  border: 1rpx solid;
}

.badge-dot {
  width: 8rpx; height: 8rpx;
  border-radius: 50%;
}

.badge-text {
  font-size: 16rpx;
  font-weight: 700;
}

/* 状态颜色 */
.status-badge.status-active {
  background: rgba(52, 199, 89, 0.12);
  border-color: rgba(52, 199, 89, 0.25);
  color: #30d158;
}
.status-badge.status-active .badge-text {
  color: #ff9f0a;
  text-shadow: 0 0 10rpx rgba(255, 159, 10, 0.4);
  font-weight: bold;
}
.status-badge.status-active .badge-dot {
  background: #30d158;
  animation: badgeBlink 1.5s infinite alternate;
}

.status-badge.status-upcoming {
  background: rgba(255, 171, 64, 0.12);
  border-color: rgba(255, 171, 64, 0.25);
  color: #ffab40;
}
.status-badge.status-upcoming .badge-dot {
  background: #ffab40;
}

.status-badge.status-ending {
  background: rgba(255, 69, 58, 0.12);
  border-color: rgba(255, 69, 58, 0.25);
  color: #ff453a;
}
.status-badge.status-ending .badge-dot {
  background: #ff453a;
  animation: badgeBlink 1s infinite alternate;
}

.status-badge.status-ended {
  background: rgba(255, 255, 255, 0.04);
  border-color: rgba(255, 255, 255, 0.06);
  color: rgba(255, 255, 255, 0.35);
}
.status-badge.status-ended .badge-dot {
  background: rgba(255, 255, 255, 0.25);
}

@keyframes badgeBlink {
  0% { opacity: 0.4; }
  100% { opacity: 1; }
}

/* 管理操作 */
.admin-item-actions {
  display: flex;
  gap: 18rpx;
  z-index: 10;
}

.action-edit, .action-delete {
  font-size: 20rpx;
  padding: 6rpx;
  transition: opacity 0.2s;
  cursor: pointer;
}

.action-edit:active, .action-delete:active {
  opacity: 0.6;
}

.action-delete {
  color: rgba(255, 255, 255, 0.3);
  font-size: 24rpx;
  line-height: 1;
}

/* 主体内容 */
.item-main {
  display: flex;
  gap: 20rpx;
}

.swarm-image-wrap {
  position: relative;
  width: 110rpx;
  height: 110rpx;
  flex-shrink: 0;
}

.shiny-badge {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  width: 44rpx;
  height: 44rpx;
  z-index: 2;
  animation: floatBadge 3s ease-in-out infinite;
}

@keyframes floatBadge {
  0% { transform: translateY(0); }
  50% { transform: translateY(-2px); }
  100% { transform: translateY(0); }
}

.swarm-image {
  width: 100%;
  height: 100%;
  border-radius: 16rpx;
  background: rgba(0, 0, 0, 0.2);
  border: 1rpx solid rgba(255, 255, 255, 0.06);
}

.item-details {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 8rpx;
}

.swarm-name {
  font-size: 26rpx;
  font-weight: 800;
  color: #fff;
  letter-spacing: 1rpx;
}

.detail-row {
  display: flex;
  align-items: center;
}

.detail-label {
  font-size: 18rpx;
  color: rgba(255, 255, 255, 0.35);
}

.detail-value {
  font-size: 18rpx;
  color: rgba(255, 255, 255, 0.7);
  font-weight: 600;
}

.detail-value.text-glow {
  color: #00d4ff;
  text-shadow: 0 0 8rpx rgba(0, 212, 255, 0.2);
}

/* 说明脚注 */
.item-footer {
  display: flex;
  gap: 8rpx;
  margin-top: 16rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.03);
}

.footer-icon {
  font-size: 18rpx;
}

.footer-text {
  font-size: 18rpx;
  color: rgba(255, 255, 255, 0.35);
  line-height: 1.4;
  flex: 1;
}

/* ===== 空状态 ===== */
.swarm-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx 0;
  text-align: center;
}

.empty-icon {
  font-size: 72rpx;
  margin-bottom: 16rpx;
  opacity: 0.3;
}

.empty-text {
  font-size: 24rpx;
  font-weight: 700;
  color: rgba(255, 255, 255, 0.5);
  display: block;
}

.empty-desc {
  font-size: 18rpx;
  color: rgba(255, 255, 255, 0.3);
  display: block;
  margin-top: 6rpx;
}

/* ===== 版权与说明 ===== */
.footer-card {
  text-align: center;
  margin-top: 24rpx;
}

.source {
  font-size: 18rpx;
  color: rgba(255, 255, 255, 0.2);
}

/* ===== 添加/编辑弹窗 (Premium Cyber Glassmorphism) ===== */
.modal-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(1, 3, 16, 0.82);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  animation: modalFadeIn 0.25s cubic-bezier(0.16, 1, 0.3, 1);
}

.modal-box {
  position: relative;
  width: 680rpx;
  max-height: 85vh;
  background: linear-gradient(135deg, rgba(16, 20, 48, 0.96) 0%, rgba(6, 10, 26, 0.98) 100%);
  border: 1rpx solid rgba(153, 69, 255, 0.28);
  border-radius: 36rpx;
  box-shadow: 
    0 24rpx 72rpx rgba(0, 0, 0, 0.65), 
    0 0 40rpx rgba(153, 69, 255, 0.12),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.08);
  display: flex;
  flex-direction: column;
  overflow: hidden;
  animation: modalScaleIn 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.modal-glow-top {
  position: absolute;
  top: 0; left: 50%;
  transform: translateX(-50%);
  width: 320rpx;
  height: 4rpx;
  background: linear-gradient(90deg, transparent, #9945ff, #00d4ff, transparent);
  box-shadow: 0 0 16rpx rgba(153, 69, 255, 0.8);
  pointer-events: none;
}

.modal-header {
  padding: 40rpx 40rpx 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.06);
}

.modal-title {
  font-size: 32rpx;
  font-weight: 900;
  color: #fff;
  background: linear-gradient(90deg, #ffffff 0%, #d8b4fe 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  text-shadow: 0 0 10rpx rgba(153, 69, 255, 0.3);
  letter-spacing: 1rpx;
}

.modal-close {
  font-size: 34rpx;
  color: rgba(255, 255, 255, 0.35);
  padding: 10rpx;
  line-height: 1;
  transition: all 0.2s ease;
}

.modal-close:active {
  transform: scale(0.8);
  color: #ff453a;
}

.modal-body-scroll {
  flex: 1;
  max-height: calc(85vh - 280rpx);
}

.modal-body {
  padding: 32rpx 40rpx 40rpx;
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}

.form-grid-row {
  display: flex;
  gap: 24rpx;
}

.form-grid-row .form-group {
  flex: 1;
}

.form-group {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.pet-select-row {
  display: flex;
  gap: 16rpx;
}

.pet-picker {
  flex: 1;
}

.pet-type-picker {
  flex: 0 0 40%;
}

.pet-name-picker {
  flex: 1;
}

.picker-value.disabled {
  opacity: 0.4;
  pointer-events: none;
}

.date-time-picker {
  flex: 1;
}

.form-label {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.form-label-icon {
  font-size: 26rpx;
  filter: drop-shadow(0 0 6rpx rgba(153, 69, 255, 0.4));
}

.form-label-text {
  font-size: 22rpx;
  font-weight: 800;
  color: rgba(255, 255, 255, 0.65);
  letter-spacing: 1rpx;
}

.modal-input {
  height: 80rpx;
  background: rgba(0, 0, 0, 0.4);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 18rpx;
  padding: 0 24rpx;
  font-size: 24rpx;
  color: #fff;
  transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
}

.modal-input:focus {
  border-color: #00d4ff;
  background: rgba(0, 212, 255, 0.02);
  box-shadow: 0 0 16rpx rgba(0, 212, 255, 0.2);
}

.input-placeholder {
  color: rgba(255, 255, 255, 0.25);
  font-size: 22rpx;
}

.picker-value {
  height: 80rpx;
  background: rgba(0, 0, 0, 0.4);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 18rpx;
  padding: 0 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 24rpx;
  transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
}

.picker-status-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  margin-right: 14rpx;
}

.picker-status-text {
  flex: 1;
  text-align: left;
}

.picker-arrow {
  color: rgba(255, 255, 255, 0.3);
  font-size: 22rpx;
}

/* 弹窗中选择器的状态配色 */
.picker-value.status-active {
  border-color: rgba(52, 199, 89, 0.25);
  background: rgba(52, 199, 89, 0.03);
}
.picker-value.status-active .picker-status-dot {
  background: #30d158;
  box-shadow: 0 0 10rpx rgba(48, 209, 88, 0.6);
}
.picker-value.status-active .picker-status-text {
  color: #30d158;
  font-weight: 700;
}

.picker-value.status-upcoming {
  border-color: rgba(255, 171, 64, 0.25);
  background: rgba(255, 171, 64, 0.03);
}
.picker-value.status-upcoming .picker-status-dot {
  background: #ffab40;
  box-shadow: 0 0 10rpx rgba(255, 171, 64, 0.6);
}
.picker-value.status-upcoming .picker-status-text {
  color: #ffab40;
  font-weight: 700;
}

.picker-value.status-ended {
  border-color: rgba(255, 255, 255, 0.08);
}
.picker-value.status-ended .picker-status-dot {
  background: rgba(255, 255, 255, 0.3);
}
.picker-value.status-ended .picker-status-text {
  color: rgba(255, 255, 255, 0.4);
}

.modal-textarea {
  width: 100%;
  height: 160rpx;
  background: rgba(0, 0, 0, 0.4);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 18rpx;
  padding: 20rpx 24rpx;
  font-size: 24rpx;
  color: #fff;
  box-sizing: border-box;
  transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
}

.modal-textarea:focus {
  border-color: #9945ff;
  background: rgba(153, 69, 255, 0.02);
  box-shadow: 0 0 16rpx rgba(153, 69, 255, 0.2);
}

.modal-footer {
  padding: 24rpx 40rpx 40rpx;
  display: flex;
  gap: 20rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.06);
  background: rgba(0, 0, 0, 0.15);
}

.modal-btn {
  flex: 1;
  height: 84rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 800;
  transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  border: 1rpx solid;
  line-height: 1;
  box-sizing: border-box;
}

.modal-btn::after {
  display: none;
}

.modal-btn:active {
  transform: scale(0.96);
}

.modal-cancel {
  background: rgba(255, 255, 255, 0.04);
  border-color: rgba(255, 255, 255, 0.1);
  color: rgba(255, 255, 255, 0.7);
}
.modal-cancel:active {
  background: rgba(255, 255, 255, 0.08);
}

.modal-save {
  background: linear-gradient(135deg, #00d4ff 0%, #9945ff 100%);
  border-color: transparent;
  color: #fff;
  box-shadow: 0 8rpx 24rpx rgba(153, 69, 255, 0.3);
}

.modal-save[disabled] {
  background: rgba(255, 255, 255, 0.08) !important;
  border-color: transparent !important;
  color: rgba(255, 255, 255, 0.25) !important;
  box-shadow: none !important;
}

.modal-save-only {
  background: rgba(0, 212, 255, 0.15);
  border-color: rgba(0, 212, 255, 0.3);
  color: #00d4ff;
}

.modal-save-only[disabled] {
  background: rgba(255, 255, 255, 0.08) !important;
  border-color: transparent !important;
  color: rgba(255, 255, 255, 0.25) !important;
}

/* ===== 动效关键帧 ===== */
@keyframes modalFadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes modalScaleIn {
  from {
    opacity: 0;
    transform: scale(0.92) translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: scale(1) translateY(0);
  }
}

/* 即将下架状态的 picker */
.picker-value.status-ending {
  border-color: rgba(255, 69, 58, 0.25);
  background: rgba(255, 69, 58, 0.03);
}
.picker-value.status-ending .picker-status-dot {
  background: #ff453a;
  box-shadow: 0 0 10rpx rgba(255, 69, 58, 0.6);
}
.picker-value.status-ending .picker-status-text {
  color: #ff453a;
  font-weight: 700;
}
