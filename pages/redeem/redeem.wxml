<view class="page">
  <view class="container">
    <view class="maintain-card" wx:if="{{maintenance && !isAdmin}}">
      <text class="maintain-icon">🚧</text>
      <text class="maintain-title">{{_l.maintenanceTitle}}</text>
      <text class="maintain-desc">{{_l.maintenanceDesc}}</text>
    </view>

    <view wx:if="{{!maintenance || isAdmin}}">
      <view class="card admin-bar" wx:if="{{isAdmin}}">
        <view class="admin-bar-row" style="justify-content: space-between;">
          <view style="display:flex;align-items:center;">
            <text class="admin-bar-label">{{_l.adminControlBar}}</text>
            <text class="admin-bar-text">{{_l.redeemTitle}}</text>
          </view>
          <view class="admin-action-btn" bindtap="addCode" style="background:#667eea;margin:0;">{{_l.redeemAddBtn}}</view>
        </view>
      </view>

      <view class="card">
        <view class="card-title">🎫 {{_l.redeemTitle}}</view>
        <view class="card-desc">{{_l.redeemDesc}}</view>
      </view>

      <view class="loading-card" wx:if="{{loading}}">
        <text class="loading-text">{{_l.loadingText}}</text>
      </view>

      <view wx:elif="{{codes.length > 0}}">
        <view class="code-card {{item.isExpired ? 'is-expired-card' : ''}}" wx:for="{{codes}}" wx:key="_id">
          <view class="expired-watermark" wx:if="{{item.isExpired}}">{{_l.redeemExpired}}</view>
          <view class="code-header">
            <text class="code-title">{{item.title || _l.redeemTitle}}</text>
            <text class="code-time">{{item.createTimeStr || ''}}</text>
          </view>
          <view class="code-body">
            <view class="code-content">
              <text class="code-label">{{_l.redeemCodeLabel}}</text>
              <text class="code-value" user-select="true">{{item.code}}</text>
            </view>
            <view class="code-rewards" wx:if="{{item.rewards}}">
              <text class="code-label">{{_l.redeemRewardLabel}}</text>
              <text class="code-desc">{{item.rewards}}</text>
            </view>
            <view class="code-expire" wx:if="{{item.expireTime || item.isExpired}}">
              <text class="code-label">{{_l.redeemExpireLabel}}</text>
              <text class="code-desc {{item.isExpired ? 'expired' : ''}}">{{item.isExpired && !item.expireTime ? _l.redeemExpired : (item.expireTimeStr || item.expireTime)}}</text>
            </view>
          </view>
          <view class="code-footer" wx:if="{{!item.isExpired}}">
            <button class="copy-btn" data-code="{{item.code}}" bindtap="copyCode">{{_l.redeemCopyBtn}}</button>
          </view>
          <view class="admin-actions" wx:if="{{isAdmin}}">
            <view class="admin-action-btn" data-item="{{item}}" bindtap="editCode">{{_l.edit}}</view>
            <view class="admin-action-btn" data-id="{{item._id}}" data-expired="{{item.isExpired}}" bindtap="toggleExpire">{{item.isExpired ? _l.redeemValid : _l.redeemInvalid}}</view>
            <view class="admin-action-btn delete" data-id="{{item._id}}" bindtap="deleteCode">{{_l.delete}}</view>
          </view>
        </view>
      </view>

      <view class="empty-card" wx:elif="{{!loading}}">
        <text class="empty-icon">📭</text>
        <text class="empty-text">{{_l.redeemEmpty}}</text>
        <text class="empty-desc">{{_l.redeemEmptyHint}}</text>
      </view>
    </view>
  </view>

  <view class="modal-mask" wx:if="{{showAddModal}}">
    <view class="modal-box">
      <view class="modal-title">{{editingId ? _l.redeemEditTitle : _l.redeemAddTitle}}</view>
      <input class="modal-input" placeholder="输入标题" value="{{formTitle}}" bindinput="onInputTitle" />
      <textarea class="modal-textarea" placeholder="输入兑换码" value="{{formCode}}" bindinput="onInputCode"></textarea>
      <input class="modal-input" placeholder="奖励内容" value="{{formRewards}}" bindinput="onInputRewards" />
      <input class="modal-input" placeholder="有效期至" value="{{formExpireTime}}" bindinput="onInputExpireTime" />
      <view class="modal-btns">
        <view class="modal-btn cancel" bindtap="closeAddModal">{{_l.cancel}}</view>
        <view class="modal-btn confirm" bindtap="submitAddCode">{{editingId ? _l.redeemSaveEdit : _l.redeemConfirmAdd}}</view>
      </view>
    </view>
  </view>

  <dock current="redeem" />
</view>
