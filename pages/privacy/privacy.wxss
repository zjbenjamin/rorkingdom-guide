.page {
  min-height: 100vh;
  background: linear-gradient(185deg, #020410 0%, #040c24 30%, #030618 70%, #020410 100%);
}
.privacy-container {
  padding: 32rpx;
  color: rgba(255,255,255,0.8);
  line-height: 1.8;
  max-width: 700rpx;
  margin: 0 auto;
}
.p-section {
  margin-bottom: 40rpx;
  background: rgba(255,255,255,0.025);
  border: 1rpx solid rgba(255,255,255,0.05);
  border-radius: 20rpx;
  padding: 28rpx 24rpx;
}
.p-title {
  font-size: 30rpx;
  font-weight: 800;
  color: #00d4ff;
  margin-bottom: 20rpx;
  display: block;
  letter-spacing: 1rpx;
}
.p-text {
  font-size: 26rpx;
  display: block;
  margin-bottom: 14rpx;
  color: rgba(255,255,255,0.7);
}
.p-highlight {
  color: #ffab40;
  font-weight: 700;
}
.p-header {
  text-align: center;
  margin-bottom: 48rpx;
  padding-bottom: 28rpx;
  border-bottom: 1rpx solid rgba(255,255,255,0.1);
}
.p-main-title {
  font-size: 38rpx;
  font-weight: 900;
  color: #ffffff;
  display: block;
  margin-bottom: 14rpx;
  letter-spacing: 2rpx;
  text-shadow: 0 0 20rpx rgba(0,212,255,0.3);
}
.p-subtitle {
  font-size: 22rpx;
  color: rgba(255,255,255,0.35);
  display: block;
  margin-top: 4rpx;
}
.foot {
  text-align: center;
  padding: 48rpx 0;
  color: rgba(255,255,255,0.15);
  font-size: 22rpx;
}
