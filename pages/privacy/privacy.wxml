<view class="page">
  <view class="privacy-container">
    <view class="p-header">
      <text class="p-main-title">{{headerTitle}}</text>
      <text class="p-subtitle">{{updateDate}}</text>
      <text class="p-subtitle" wx:if="{{effectiveDate}}">{{effectiveDate}}</text>
    </view>

    <view class="p-section" wx:for="{{sections}}" wx:key="title">
      <text class="p-title">{{item.title}}</text>
      <block wx:for="{{item.items}}" wx:for-item="line" wx:key="index">
        <!-- highlight model: prefix + highlight + suffix -->
        <text class="p-text" wx:if="{{line.highlight !== undefined}}">{{line.prefix || ''}}<text class="p-highlight">{{line.highlight}}</text>{{line.suffix || ''}}</text>
        <!-- simple model: plain text -->
        <text class="p-text" wx:else>{{line.text}}</text>
      </block>
    </view>

    <view class="foot">{{icp}}</view>
  </view>
</view>
