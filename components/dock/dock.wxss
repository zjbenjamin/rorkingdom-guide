.dock {
  position: fixed;
  bottom: 28rpx;
  bottom: calc(28rpx + constant(safe-area-inset-bottom));
  bottom: calc(28rpx + env(safe-area-inset-bottom));
  left: 50%;
  transform: translateX(-50%);
  z-index: 9999;
  /* 独立合成层：滚动时避免整页重绘带动模糊重算 */
  will-change: transform;
}
.dock-inner {
  display: flex;
  gap: 24rpx;
  align-items: center;
  padding: 16rpx 36rpx;
  border-radius: 60rpx;
  box-sizing: border-box;
  overflow: hidden;
  /* 毛玻璃：底色渐变 + 模糊；不支持 backdrop-filter 时仍有玻璃质感 */
  background:
    linear-gradient(165deg, rgba(255, 255, 255, 0.16), rgba(255, 255, 255, 0.04) 46%, rgba(255, 255, 255, 0.02)),
    rgba(16, 20, 48, 0.64);
  /* px 半径更稳定；saturate 提亮透出的颜色，更接近 iOS 磨砂 */
  backdrop-filter: blur(18px) saturate(165%);
  -webkit-backdrop-filter: blur(18px) saturate(165%);
  border: 1rpx solid rgba(255, 255, 255, 0.14);
  box-shadow:
    0 1rpx 0 rgba(255, 255, 255, 0.16) inset,
    0 -1rpx 0 rgba(255, 255, 255, 0.04) inset,
    0 0 0 1rpx rgba(255, 255, 255, 0.03) inset,
    0 12rpx 48rpx rgba(0, 0, 0, 0.38),
    0 4rpx 12rpx rgba(0, 0, 0, 0.18);
  transform: translateZ(0);
}
.dock-item {
  width: 72rpx;
  height: 72rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  background: transparent;
  box-sizing: border-box;
  margin: 0;
  padding: 0;
  line-height: 1;
}
.dock-item:active {
  transform: scale(0.82);
  background: rgba(0, 200, 255, 0.16);
  transition: transform 0.1s ease, background 0.08s ease;
}
.dock-item.active {
  background: linear-gradient(165deg, rgba(255, 255, 255, 0.18), rgba(255, 255, 255, 0.08));
  box-shadow:
    0 1rpx 0 rgba(255, 255, 255, 0.2) inset,
    0 0 16rpx rgba(0, 212, 255, 0.16);
}
.dock-icon {
  font-size: 36rpx;
  line-height: 1;
}
