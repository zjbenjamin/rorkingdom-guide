.dock {
  position: fixed;
  bottom: 28rpx;
  bottom: calc(28rpx + constant(safe-area-inset-bottom));
  bottom: calc(28rpx + env(safe-area-inset-bottom));
  left: 50%;
  transform: translateX(-50%);
  z-index: 9999;
  /* 独立合成层：滚动时避免整页重绘带动模糊重算 */
  will-change: transform;
}
.dock-inner {
  position: relative;
  display: flex;
  gap: 24rpx;
  align-items: center;
  padding: 16rpx 36rpx;
  border-radius: 60rpx;
  box-sizing: border-box;
  overflow: hidden;
  /* Liquid Glass: 底色高通透渐变 + 硬件加速模糊 */
  background:
    linear-gradient(165deg, rgba(255, 255, 255, 0.16), rgba(255, 255, 255, 0.04) 46%, rgba(255, 255, 255, 0.02)),
    rgba(16, 20, 48, 0.68);
  /* 苹果高通透磨砂与色饱和度提亮 */
  backdrop-filter: blur(22px) saturate(180%);
  -webkit-backdrop-filter: blur(22px) saturate(180%);
  border: 1rpx solid rgba(255, 255, 255, 0.18);
  box-shadow:
    inset 0 1rpx 1rpx 0 rgba(255, 255, 255, 0.38),
    inset 0 -1rpx 2rpx 0 rgba(0, 0, 0, 0.25),
    0 16rpx 48rpx rgba(0, 0, 0, 0.42),
    0 4rpx 14rpx rgba(0, 0, 0, 0.22);
  transform: translateZ(0);
}
/* 顶部流体折射彩虹微光 (模拟 feDisplacementMap 边缘色散) */
.dock-inner::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 2rpx;
  background: linear-gradient(
    90deg,
    rgba(255, 255, 255, 0) 0%,
    rgba(140, 210, 255, 0.5) 25%,
    rgba(215, 170, 255, 0.45) 50%,
    rgba(140, 255, 220, 0.35) 75%,
    rgba(255, 255, 255, 0) 100%
  );
  pointer-events: none;
  z-index: 2;
}
.dock-item {
  width: 72rpx;
  height: 72rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform 0.24s cubic-bezier(0.16, 1, 0.3, 1), background 0.18s ease, box-shadow 0.18s ease;
  background: transparent;
  box-sizing: border-box;
  margin: 0;
  padding: 0;
  line-height: 1;
  transform: translateZ(0);
}
.dock-item:active {
  transform: scale3d(0.88, 0.88, 1);
  background: rgba(0, 200, 255, 0.16);
  transition: transform 0.08s cubic-bezier(0.2, 0.8, 0.2, 1), background 0.08s ease;
}
.dock-item.active {
  background: linear-gradient(165deg, rgba(255, 255, 255, 0.18), rgba(255, 255, 255, 0.08));
  box-shadow:
    0 1rpx 0 rgba(255, 255, 255, 0.2) inset,
    0 0 16rpx rgba(0, 212, 255, 0.16);
}
.dock-icon {
  font-size: 36rpx;
  line-height: 1;
}
