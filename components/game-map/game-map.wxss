.game-map-container {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  overflow: hidden;
  background: #1a1c2e;
}

.tile-canvas {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

/* HUD Coords Display */
.hud-coords {
  position: absolute;
  left: 24rpx;
  bottom: 260rpx;
  z-index: 10;
  display: flex;
  flex-direction: column;
  padding: 12rpx 20rpx;
  border-radius: 16rpx;
  background: rgba(10, 12, 28, 0.72);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  border: 1rpx solid rgba(0, 255, 170, 0.25);
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.2), 0 0 10rpx rgba(0, 255, 170, 0.05);
}
.hud-coords-label {
  font-size: 18rpx;
  color: #00ffaa;
  text-transform: uppercase;
  font-weight: 700;
  letter-spacing: 2rpx;
  margin-bottom: 4rpx;
}
.hud-coords-val {
  font-size: 26rpx;
  color: #ffffff;
  font-family: monospace;
  font-weight: bold;
}

/* Compass HUD */
.hud-compass {
  position: absolute;
  right: 24rpx;
  bottom: 260rpx;
  z-index: 15;
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: rgba(10, 12, 28, 0.72);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 24rpx rgba(0,0,0,0.3);
}
.compass-ring {
  position: absolute;
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  border: 1rpx dashed rgba(255,255,255,0.15);
}
.compass-marker {
  position: absolute;
  font-size: 14rpx;
  font-weight: bold;
  color: rgba(255,255,255,0.4);
}
.compass-marker.n { top: 2rpx; left: 50%; transform: translateX(-50%); color: #ff4a4a; }
.compass-marker.s { bottom: 2rpx; left: 50%; transform: translateX(-50%); }
.compass-marker.e { right: 4rpx; top: 50%; transform: translateY(-50%); }
.compass-marker.w { left: 4rpx; top: 50%; transform: translateY(-50%); }

.compass-needle {
  position: absolute;
  width: 6rpx;
  height: 60rpx;
  transition: transform 0.15s ease-out;
  pointer-events: none;
}
.compass-needle::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 0;
  height: 0;
  border-left: 3rpx solid transparent;
  border-right: 3rpx solid transparent;
  border-bottom: 30rpx solid #ff4a4a;
}
.compass-needle::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  width: 0;
  height: 0;
  border-left: 3rpx solid transparent;
  border-right: 3rpx solid transparent;
  border-top: 30rpx solid rgba(255,255,255,0.4);
}
.compass-text {
  position: absolute;
  font-size: 18rpx;
  color: #00ffaa;
  font-weight: 700;
  background: rgba(10,12,28,0.9);
  padding: 2rpx 6rpx;
  border-radius: 6rpx;
  font-family: monospace;
}

/* Map Controls overlay */
.map-controls {
  position: absolute;
  right: 24rpx;
  bottom: 180rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  z-index: 10;
}
.control-btn {
  width: 80rpx;
  height: 80rpx;
  background: rgba(10, 12, 28, 0.72);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  border-radius: 50%;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.3);
  transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
}
.zoom-group {
  display: flex;
  flex-direction: column;
  border-radius: 40rpx;
  background: rgba(10, 12, 28, 0.72);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.3);
  overflow: hidden;
}
.zoom-group .control-btn {
  background: transparent;
  border: none;
  backdrop-filter: none;
  box-shadow: none;
  border-radius: 0;
}
.zoom-group .zoom-btn:first-child {
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.08);
}
.btn-hover {
  background: rgba(0, 255, 170, 0.15) !important;
  border-color: rgba(0, 255, 170, 0.3) !important;
  transform: scale(0.92);
}
.control-icon {
  font-size: 36rpx;
  color: rgba(255, 255, 255, 0.85);
  font-weight: bold;
}
.zoom-level {
  position: absolute;
  left: 24rpx;
  bottom: 180rpx;
  background: rgba(10, 12, 28, 0.72);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  border-radius: 12rpx;
  padding: 8rpx 16rpx;
  z-index: 10;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
}
.zoom-text {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.4);
  font-family: monospace;
}


