/* ===== Apple Liquid Glass Component (原生微信小程序复刻版) ===== */
.liquid-glass-wrapper {
  position: relative;
  box-sizing: border-box;
  overflow: hidden;
  transform: translateZ(0);
  -webkit-transform: translateZ(0);
  will-change: transform, backdrop-filter;
  transition: transform 0.24s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.2s ease, background 0.2s ease;
}

/* 顶部流体边缘彩虹折射光带 (模拟 feDisplacementMap 边缘色散) */
.liquid-glass-wrapper.with-specular::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 2rpx;
  background: linear-gradient(
    90deg,
    rgba(255, 255, 255, 0) 0%,
    rgba(140, 210, 255, 0.5) 25%,
    rgba(215, 170, 255, 0.45) 50%,
    rgba(140, 255, 220, 0.35) 75%,
    rgba(255, 255, 255, 0) 100%
  );
  pointer-events: none;
  z-index: 2;
}

/* ──────────────── 1. 模式: 卡片 (Card) ──────────────── */
.liquid-glass-wrapper.mode-card {
  border-radius: 20rpx;
  background:
    linear-gradient(145deg, rgba(255, 255, 255, 0.09) 0%, rgba(255, 255, 255, 0.02) 100%),
    rgba(18, 22, 36, 0.72);
  backdrop-filter: blur(20px) saturate(180%);
  -webkit-backdrop-filter: blur(20px) saturate(180%);
  border: 1rpx solid rgba(255, 255, 255, 0.14);
  box-shadow:
    inset 0 1rpx 1rpx 0 rgba(255, 255, 255, 0.35),
    inset 0 -1rpx 2rpx 0 rgba(0, 0, 0, 0.25),
    0 12rpx 36rpx 0 rgba(0, 0, 0, 0.32),
    0 2rpx 8rpx 0 rgba(0, 0, 0, 0.15);
}

/* ──────────────── 2. 模式: 导航/浮动栏 (Nav / Dock) ──────────────── */
.liquid-glass-wrapper.mode-nav {
  border-radius: 40rpx;
  background:
    linear-gradient(165deg, rgba(255, 255, 255, 0.13) 0%, rgba(255, 255, 255, 0.04) 50%, rgba(255, 255, 255, 0.01) 100%),
    rgba(13, 17, 28, 0.78);
  backdrop-filter: blur(24px) saturate(190%);
  -webkit-backdrop-filter: blur(24px) saturate(190%);
  border: 1rpx solid rgba(255, 255, 255, 0.16);
  box-shadow:
    inset 0 1rpx 1rpx 0 rgba(255, 255, 255, 0.4),
    inset 0 -1rpx 1rpx 0 rgba(0, 0, 0, 0.3),
    0 16rpx 48rpx 0 rgba(0, 0, 0, 0.4);
}

/* ──────────────── 3. 模式: 弹窗/浮层 (Modal) ──────────────── */
.liquid-glass-wrapper.mode-modal {
  border-radius: 28rpx;
  background:
    linear-gradient(150deg, rgba(255, 255, 255, 0.11) 0%, rgba(255, 255, 255, 0.02) 100%),
    rgba(18, 24, 38, 0.88);
  backdrop-filter: blur(28px) saturate(190%);
  -webkit-backdrop-filter: blur(28px) saturate(190%);
  border: 1rpx solid rgba(255, 255, 255, 0.18);
  box-shadow:
    inset 0 1rpx 2rpx 0 rgba(255, 255, 255, 0.5),
    inset 0 -2rpx 3rpx 0 rgba(0, 0, 0, 0.35),
    0 24rpx 64rpx 0 rgba(0, 0, 0, 0.6);
}

/* ──────────────── 4. 模式: 按钮 (Button) ──────────────── */
.liquid-glass-wrapper.mode-button {
  border-radius: 999rpx;
  background:
    linear-gradient(135deg, rgba(255, 255, 255, 0.18) 0%, rgba(255, 255, 255, 0.05) 100%),
    rgba(22, 28, 46, 0.7);
  backdrop-filter: blur(16px) saturate(175%);
  -webkit-backdrop-filter: blur(16px) saturate(175%);
  border: 1rpx solid rgba(255, 255, 255, 0.22);
  box-shadow:
    inset 0 1rpx 1rpx 0 rgba(255, 255, 255, 0.45),
    inset 0 -1rpx 2rpx 0 rgba(0, 0, 0, 0.25),
    0 8rpx 20rpx 0 rgba(0, 0, 0, 0.25);
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

/* 按压液体弹性反馈交互 */
.liquid-glass-wrapper.is-interactive:active {
  transform: scale3d(0.976, 0.976, 1);
  box-shadow:
    inset 0 1rpx 2rpx 0 rgba(255, 255, 255, 0.58),
    inset 0 -1rpx 2rpx 0 rgba(0, 0, 0, 0.35),
    0 6rpx 18rpx 0 rgba(0, 0, 0, 0.24);
  transition: transform 0.08s cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 0.08s ease;
}

/* 减弱动态适配 */
@media (prefers-reduced-motion: reduce) {
  .liquid-glass-wrapper {
    transition: none !important;
  }
}
